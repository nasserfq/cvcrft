<%# Arabic PDPL privacy policy. Keep in step with _body_en.html.erb and docs/pdpl.md. %>
<%# Bump PrivacyPolicy::VERSION (app/models/privacy_policy.rb) on any material change. %>
<!-- Introduction -->
<section>
  <p class="text-gray-600 dark:text-gray-300 leading-8">
    توضح هذه السياسة كيف تجمع منصة "سيرة" بياناتك الشخصية وتستخدمها وتحفظها وتشاركها، وما حقوقك تجاهها، وذلك وفقًا لنظام حماية البيانات الشخصية في المملكة العربية السعودية ولوائحه التنفيذية. باستخدامك للخدمة وموافقتك عند تسجيل الدخول، فإنك تقرّ بأنك اطّلعت على هذه السياسة.
  </p>
</section>

<!-- Controller and contact -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">1</span>
    جهة التحكم وبيانات التواصل
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">
    جهة التحكم المسؤولة عن بياناتك الشخصية هي منصة "سيرة" (cvcrft.com)، ويديرها:
  </p>
  <div class="p-5 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5 space-y-3">
    <div class="flex items-center gap-3 text-gray-600 dark:text-gray-300">
      <%= seera_icon("solar:buildings-2-bold", width: 24, class: "text-primary flex-shrink-0") %>
      <span>شركة هضاب التقنية لتقنية المعلومات (<span dir="ltr">Hodab Altiqnia Company</span>)، الرقم الوطني الموحد <span dir="ltr">7053973447</span></span>
    </div>
    <div class="flex items-center gap-3 text-gray-600 dark:text-gray-300">
      <%= seera_icon("solar:mailbox-bold", width: 24, class: "text-primary flex-shrink-0") %>
      <a href="mailto:nasser@cvcrft.com" class="text-primary hover:text-primaryHover transition-colors" dir="ltr">nasser@cvcrft.com</a>
    </div>
  </div>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mt-4">
    يُعدّ هذا البريد نقطة التواصل المعتمدة لجميع الأسئلة والطلبات المتعلقة بالخصوصية وحماية البيانات.
  </p>
</section>

<!-- Data we collect -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">2</span>
    البيانات التي نجمعها
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">نجمع البيانات التالية فقط، وبالقدر اللازم لتقديم الخدمة:</p>
  <ul class="space-y-4 text-gray-600 dark:text-gray-300">
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">بيانات الحساب:</strong> البريد الإلكتروني، والاسم، واللغة المفضلة، ورموز التحقق المؤقتة لتسجيل الدخول، وتاريخ موافقتك على هذه السياسة ورقم إصدارها.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">بيانات السيرة الذاتية:</strong> ما تدخله أو ترفعه بنفسك، مثل الاسم، ورقم الجوال، والمدينة، والخبرات المهنية، والتعليم، والمهارات، والشهادات، واللغات، إضافة إلى النص المستخرج من الملفات التي ترفعها أو من ملفك في LinkedIn عند الاستيراد.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">مخرجات الذكاء الاصطناعي:</strong> نتائج تحليل السيرة، والسير الذاتية المُنشأة وملفات PDF الخاصة بها، والترجمات، ومحادثاتك مع المدرب الذكي.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">بيانات الرصيد والمدفوعات:</strong> سجل الرصيد، والباقات المشتراة، ومبالغها، وحالتها، ورقم الفاتورة لدى بوابة الدفع. لا نطّلع على بيانات بطاقتك ولا نخزنها، إذ تُدخلها مباشرة في صفحة الدفع لدى ميسّر.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">البيانات التقنية:</strong> ملفات تعريف الارتباط الضرورية لتشغيل الموقع (جلسة الدخول واللغة)، وسجلات الخادم، وتقارير الأخطاء التقنية. أما ملفات تعريف الارتباط التحليلية فلا تُفعَّل إلا بعد موافقتك عليها، ويمكنك سحب هذه الموافقة في أي وقت من إعدادات ملفات تعريف الارتباط.</span>
    </li>
  </ul>
</section>

<!-- Purposes -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">3</span>
    أغراض المعالجة
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">نستخدم بياناتك للأغراض التالية فقط:</p>
  <ul class="space-y-4 text-gray-600 dark:text-gray-300">
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:user-check-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>إنشاء حسابك وتسجيل دخولك عبر رمز تحقق يُرسل إلى بريدك الإلكتروني.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:magic-stick-3-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>تحليل سيرتك الذاتية وتحسينها وترجمتها وإنشاء نسخ منها، وتقديم إجابات المدرب الذكي، باستخدام نماذج الذكاء الاصطناعي.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:cloud-storage-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>حفظ سيرك الذاتية وملفاتك لتتمكن من الرجوع إليها من حسابك.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:card-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>معالجة مشترياتك من الرصيد وإدارته.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:shield-check-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>حماية الخدمة وأمنها، ورصد الأعطال التقنية وإصلاحها، ومنع إساءة الاستخدام.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:chart-2-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>فهم طريقة استخدام الموقع وتحسينه، وذلك بعد موافقتك على ملفات تعريف الارتباط التحليلية فقط.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:letter-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>مراسلتك بشأن حسابك أو التغييرات الجوهرية في الخدمة أو في هذه السياسة.</span>
    </li>
  </ul>
</section>

<!-- Legal basis -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">4</span>
    الأساس النظامي للمعالجة
  </h2>
  <div class="space-y-4">
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:check-square-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">الموافقة</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-7">نطلب موافقتك على هذه السياسة عند تسجيل الدخول، ونسجّل تاريخها ورقم إصدار السياسة. ونعتمد على موافقتك كذلك في ملفات تعريف الارتباط التحليلية. ويحق لك سحب موافقتك في أي وقت.</p>
      </div>
    </div>
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:document-text-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">تنفيذ الاتفاقية معك</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-7">معالجة بيانات حسابك وسيرتك الذاتية ومشترياتك لازمة لتقديم الخدمة التي طلبتها وفق <%= link_to "الشروط والأحكام", terms_path, class: "text-primary hover:text-primaryHover transition-colors" %>.</p>
      </div>
    </div>
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:shield-user-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">المصلحة المشروعة</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-7">نعالج البيانات التقنية اللازمة لأمن الخدمة ورصد أعطالها ومنع إساءة استخدامها، بما لا يمسّ حقوقك ومصالحك.</p>
      </div>
    </div>
  </div>
</section>

<!-- Processors and locations -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">5</span>
    مقدمو الخدمات الذين نشاركهم البيانات
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">
    لا نبيع بياناتك. ونستعين بمقدمي الخدمات التالين بصفتهم جهات معالجة تعمل لحسابنا، ولا يتلقى كل منهم إلا ما يلزم لأداء مهمته:
  </p>
  <ul class="space-y-4 text-gray-600 dark:text-gray-300">
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:server-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">netcup (ألمانيا):</strong> استضافة الموقع وقاعدة البيانات التي تُحفظ فيها جميع بيانات حسابك وسيرك الذاتية.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:magic-stick-3-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">Amazon Web Services – Bedrock (الولايات المتحدة):</strong> نماذج الذكاء الاصطناعي التي تحلل سيرتك وتحسّنها وتترجمها وتجيب في المدرب الذكي. يُرسل إليها نص سيرتك الذاتية، بما فيه بيانات التواصل الواردة فيه.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:letter-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">Amazon Web Services – SES (الولايات المتحدة):</strong> إرسال رسائل البريد الإلكتروني، ومنها رموز التحقق.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:checklist-minimalistic-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">TypeSafe – Jev (الولايات المتحدة):</strong> فحص جودة إجابات المدرب الذكي بالذكاء الاصطناعي، ويتلقى نص المحادثة ذات الصلة.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:bug-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">Sentry (الولايات المتحدة):</strong> رصد الأعطال التقنية في الموقع وتشخيصها.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:chart-2-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">PostHog (الولايات المتحدة):</strong> تحليلات الاستخدام، ولا يعمل إلا بعد موافقتك على ملفات تعريف الارتباط التحليلية.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:card-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">ميسّر Moyasar (المملكة العربية السعودية):</strong> معالجة المدفوعات، وتتلقى بيانات بطاقتك مباشرة منك.</span>
    </li>
  </ul>
  <div id="auto-apply" class="flex items-start gap-4 p-5 mt-4 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
    <%= seera_icon("solar:letter-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
    <div>
      <h3 class="font-semibold text-gray-900 dark:text-white mb-1">التقديم التلقائي: جهات العمل التي تتقدم إليها</h3>
      <p class="text-gray-600 dark:text-gray-300 text-sm leading-7">التقديم التلقائي اختياري، ويبقى متوقفًا حتى تفعّله وتمنح موافقتك في صفحته. بعد ذلك، وفي كل طلب توافق عليه (أو تسمح به في الوضع التلقائي)، تُرسل سيرتك الذاتية وملف PDF الخاص بها وبيانات التواصل وخطاب التقديم وإجابات أسئلة نموذج جهة العمل إلى تلك الجهة عبر موقع التوظيف الخاص بها، من إضافة سيرة في متصفحك. وتكون جهة العمل جهة تحكم مستقلة بتلك البيانات وفق سياسة الخصوصية الخاصة بها. لا يُرسل شيء قبل موافقتك، ويمكنك إيقاف التقديم التلقائي مؤقتًا أو إلغاء ربط الإضافة أو حذف طلباتك في أي وقت.</p>
    </div>
  </div>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mt-4">
    وقد نفصح عن البيانات أيضًا إذا ألزمنا بذلك نظام نافذ أو جهة مختصة.
  </p>
</section>

<!-- Cross-border transfer -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">6</span>
    نقل البيانات خارج المملكة
  </h2>
  <div class="p-5 rounded-xl bg-primary/5 dark:bg-primary/10 border border-primary/20">
    <p class="text-gray-600 dark:text-gray-300 leading-8">
      تُحفظ بياناتك على خوادم في ألمانيا، ويُنقل بعضها إلى الولايات المتحدة لمعالجتها بالذكاء الاصطناعي وإرسال البريد الإلكتروني ورصد الأعطال والتحليلات، على النحو المبيّن أعلاه. ونقصر هذا النقل على الحد الأدنى اللازم لتقديم الخدمة، ونعتمد فيه على اتفاقيات معالجة البيانات مع مقدمي الخدمات بما تتضمنه من ضمانات مناسبة لحماية البيانات، وفقًا لما يقتضيه نظام حماية البيانات الشخصية ولائحة نقل البيانات الشخصية إلى خارج المملكة.
    </p>
  </div>
</section>

<!-- Retention -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">7</span>
    مدة الاحتفاظ بالبيانات
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">لا نحتفظ ببياناتك إلا للمدة اللازمة لتحقيق الغرض منها، وتتولى مهمة آلية يومية حذف ما انتهت مدته:</p>
  <ul class="space-y-4 text-gray-600 dark:text-gray-300">
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">رموز التحقق لتسجيل الدخول:</strong> تُحذف بعد يوم واحد.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">عمليات التحليل والاستيراد التي لم تكتمل:</strong> تُحذف بعد 30 يومًا.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">النص المستخرج من الملفات المرفوعة ومن LinkedIn:</strong> يُمسح بعد 30 يومًا، وتبقى السيرة الذاتية الناتجة عنه في حسابك.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>

<%# English PDPL privacy policy. Keep in step with _body_ar.html.erb and docs/pdpl.md. %>
<%# Bump PrivacyPolicy::VERSION (app/models/privacy_policy.rb) on any material change. %>
<!-- Introduction -->
<section>
  <p class="text-gray-600 dark:text-gray-300 leading-8">
    This policy explains how Seera collects, uses, stores and shares your personal data, and what rights you have over it, under the Saudi Personal Data Protection Law (PDPL) and its Implementing Regulations. By using the service and giving your consent at sign-in, you confirm that you have read this policy.
  </p>
</section>

<!-- Controller and contact -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">1</span>
    Controller and contact
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">
    The controller responsible for your personal data is Seera (cvcrft.com), operated by:
  </p>
  <div class="p-5 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5 space-y-3">
    <div class="flex items-center gap-3 text-gray-600 dark:text-gray-300">
      <%= seera_icon("solar:buildings-2-bold", width: 24, class: "text-primary flex-shrink-0") %>
      <span>Hodab Altiqnia Company, Unified National Number 7053973447</span>
    </div>
    <div class="flex items-center gap-3 text-gray-600 dark:text-gray-300">
      <%= seera_icon("solar:mailbox-bold", width: 24, class: "text-primary flex-shrink-0") %>
      <a href="mailto:nasser@cvcrft.com" class="text-primary hover:text-primaryHover transition-colors">nasser@cvcrft.com</a>
    </div>
  </div>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mt-4">
    This address is our point of contact for all privacy and data protection questions and requests.
  </p>
</section>

<!-- Data we collect -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">2</span>
    Data we collect
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">We collect only the following data, and only as much as the service needs:</p>
  <ul class="space-y-4 text-gray-600 dark:text-gray-300">
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">Account data:</strong> your email address, name, preferred language, temporary sign-in codes, and when you accepted this policy and which version.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">CV data:</strong> what you enter or upload yourself, such as your name, phone number, city, work experience, education, skills, certifications and languages, plus the text extracted from files you upload or from your LinkedIn profile when you import it.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">AI results:</strong> CV analysis results, generated CVs and their PDF files, translations, and your conversations with the AI coach.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">Credits and payments:</strong> your credit history, the packs you bought, their amounts and status, and the payment provider's invoice number. We never see or store your card details: you enter them directly on Moyasar's payment page.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">Technical data:</strong> cookies the site needs to work (your session and language), server logs, and technical error reports. Analytics cookies are only switched on after you accept them, and you can withdraw that consent at any time in the cookie settings.</span>
    </li>
  </ul>
</section>

<!-- Purposes -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">3</span>
    Why we process your data
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">We use your data only for these purposes:</p>
  <ul class="space-y-4 text-gray-600 dark:text-gray-300">
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:user-check-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>Creating your account and signing you in with a code sent to your email.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:magic-stick-3-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>Analysing, improving, translating and generating versions of your CV, and answering you in the AI coach, using AI models.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:cloud-storage-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>Saving your CVs and files so you can return to them from your account.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:card-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>Processing your credit purchases and managing your balance.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:shield-check-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>Keeping the service secure, detecting and fixing technical errors, and preventing abuse.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:chart-2-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>Understanding how the site is used so we can improve it, only after you accept analytics cookies.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:letter-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>Contacting you about your account or material changes to the service or this policy.</span>
    </li>
  </ul>
</section>

<!-- Legal basis -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">4</span>
    Legal basis
  </h2>
  <div class="space-y-4">
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:check-square-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Consent</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-7">We ask for your consent to this policy when you sign in, and record the date and the policy version. Analytics cookies also rely on your consent. You can withdraw your consent at any time.</p>
      </div>
    </div>
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:document-text-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Our agreement with you</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-7">Processing your account, CV and purchase data is necessary to provide the service you asked for under our <%= link_to "Terms and Conditions", terms_path, class: "text-primary hover:text-primaryHover transition-colors" %>.</p>
      </div>
    </div>
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:shield-user-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Legitimate interest</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm leading-7">We process the technical data needed to keep the service secure, detect errors and prevent abuse, in a way that does not override your rights and interests.</p>
      </div>
    </div>
  </div>
</section>

<!-- Processors and locations -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">5</span>
    Service providers we share data with
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">
    We do not sell your data. We use the following providers as processors acting on our behalf, and each receives only what it needs for its task:
  </p>
  <ul class="space-y-4 text-gray-600 dark:text-gray-300">
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:server-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">netcup (Germany):</strong> hosting for the site and the database that holds all your account and CV data.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:magic-stick-3-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">Amazon Web Services – Bedrock (USA):</strong> the AI models that analyse, improve and translate your CV and answer in the AI coach. They receive your CV text, including any contact details in it.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:letter-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">Amazon Web Services – SES (USA):</strong> sending emails, including your sign-in codes.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:checklist-minimalistic-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">TypeSafe – Jev (USA):</strong> an AI quality check of the AI coach's answers; it receives the relevant conversation text.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:bug-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">Sentry (USA):</strong> detecting and diagnosing technical errors on the site.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:chart-2-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">PostHog (USA):</strong> usage analytics, active only after you accept analytics cookies.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:card-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span><strong class="text-gray-900 dark:text-white">Moyasar (Saudi Arabia):</strong> payment processing; it receives your card details directly from you.</span>
    </li>
  </ul>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mt-4">
    We may also disclose data when an applicable law or a competent authority requires us to.
  </p>
</section>

<!-- Cross-border transfer -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">6</span>
    Transfers outside Saudi Arabia
  </h2>
  <div class="p-5 rounded-xl bg-primary/5 dark:bg-primary/10 border border-primary/20">
    <p class="text-gray-600 dark:text-gray-300 leading-8">
      Your data is stored on servers in Germany, and some of it is transferred to the USA for AI processing, email delivery, error monitoring and analytics, as listed above. We limit these transfers to the minimum the service needs, and rely on data processing agreements with our providers that include appropriate safeguards, as required by the PDPL and the Regulation on Personal Data Transfer outside the Kingdom.
    </p>
  </div>
</section>

<!-- Retention -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">7</span>
    How long we keep your data
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">We keep your data only as long as its purpose requires. A daily automated job removes what has expired:</p>
  <ul class="space-y-4 text-gray-600 dark:text-gray-300">
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">Sign-in codes:</strong> deleted after 1 day.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">Failed analyses and imports:</strong> deleted after 30 days.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">Text extracted from uploaded files and LinkedIn:</strong> cleared after 30 days; the CV built from it stays in your account.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">PDFs you generated:</strong> kept in your account as your own documents until you delete your account.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">Account data, CVs, analyses, translations and coach chats:</strong> kept until you delete your account.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">Credit history and purchases:</strong> deleted with your account; Moyasar keeps its own payment records under its legal obligations.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <span class="mt-1 w-2 h-2 rounded-full bg-action flex-shrink-0"></span>
      <span><strong class="text-gray-900 dark:text-white">Server logs:</strong> overwritten periodically under the host's log rotation settings.</span>
    </li>
  </ul>
</section>

<!-- Your rights -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">8</span>
    Your rights
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">The PDPL gives you the following rights:</p>
  <div class="space-y-4">
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:eye-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Right to be informed and to access</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm">To know how we process your data and to see it.</p>
      </div>
    </div>
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:download-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Right to a copy</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm">To get a copy of your data in a clear, readable format.</p>
      </div>
    </div>
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:pen-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Right to correction</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm">To correct, complete or update your data.</p>
      </div>
    </div>
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:trash-bin-trash-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Right to deletion</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm">To have your data deleted once it is no longer needed.</p>
      </div>
    </div>
    <div class="flex items-start gap-4 p-5 rounded-xl bg-action/5 dark:bg-action/10 border border-action/20">
      <%= seera_icon("solar:undo-left-round-bold", width: 24, class: "text-action flex-shrink-0 mt-0.5") %>
      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">Right to withdraw consent</h3>
        <p class="text-gray-600 dark:text-gray-300 text-sm">To withdraw your consent at any time, without affecting processing that took place before.</p>
      </div>
    </div>
  </div>
</section>

<!-- How to exercise your rights -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">9</span>
    How to exercise your rights
  </h2>
  <ul class="space-y-4 text-gray-600 dark:text-gray-300">
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:user-circle-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>On your <%= link_to "profile page", profile_path, class: "text-primary hover:text-primaryHover transition-colors" %>: "Download my data" gives you a full copy of your data as a JSON file, and "Delete My Account Permanently" deletes your account and all data linked to it.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:pen-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>You can edit your CV data directly at any time, and withdraw consent to analytics cookies in the cookie settings.</span>
    </li>
    <li class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5">
      <%= seera_icon("solar:mailbox-bold", width: 20, class: "text-action flex-shrink-0 mt-0.5") %>
      <span>For any other request, email <a href="mailto:nasser@cvcrft.com" class="text-primary hover:text-primaryHover transition-colors">nasser@cvcrft.com</a> from the address registered on your account. We will answer within 30 days.</span>
    </li>
  </ul>
</section>

<!-- Security and breach -->
<section>
  <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-3">
    <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-action text-white grid place-items-center text-sm font-bold shadow-lg shadow-primary/25">10</span>
    Security and incidents
  </h2>
  <p class="text-gray-600 dark:text-gray-300 leading-8 mb-4">We take appropriate organisational and technical measures to protect your data:</p>
  <div class="grid gap-4 sm:grid-cols-3">
    <div class="p-5 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5 text-center">
      <%= seera_icon("solar:lock-keyhole-bold", width: 32, class: "text-primary mx-auto mb-3") %>
      <p class="text-sm text-gray-600 dark:text-gray-300">Data encrypted in transit with HTTPS</p>
    </div>
    <div class="p-5 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5 text-center">
      <%= seera_icon("solar:key-bold", width: 32, class: "text-primary mx-auto mb-3") %>
      <p class="text-sm text-gray-600 dark:text-gray-300">Sign-in with a one-time code and limited attempts</p>
    </div>
    <div class="p-5 rounded-xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/5 text-center">
      <%= seera_icon("solar:shield-user-bold", width: 32, class: "text-primary mx-auto mb-3") %>
      <p class="text-sm text-gray-600 dark:text-gray-300">Access to data limited to those who need it to run the service</p>
    </div>
  </div>
  <div class="p-5 rounded-xl bg-primary/5 dark:bg-primary/10 border border-primary/20 mt-4">
    <p class="text-gray-600 dark:text-gray-300 leading-8">
      If your personal data is leaked or breached, we will notify the Saudi Data and AI Authority (SDAIA) within 72 hours of becoming aware of it, and notify you without undue delay if it may harm you, explaining what happened, what we have done and what you can do to protect yourself.
    </p>
  </div>
</section>


<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>جاري المعالجة... — سيرة</title>
    <meta name="theme-color" content="#10b981" />
    <%= render 'shared/posthog' %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= csrf_meta_tags %>
  </head>
  <body class="antialiased bg-gradient-to-b from-white via-emerald-50 to-white text-slate-900 font-sans min-h-screen flex items-center justify-center" style="font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;">
    <!-- Background Accents -->
    <div class="pointer-events-none fixed inset-0 -z-10">
      <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-emerald-400/20 blur-3xl"></div>
      <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-emerald-300/20 blur-3xl"></div>
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[38rem] h-[38rem] bg-gradient-to-b from-emerald-200/30 to-transparent rounded-full blur-3xl"></div>
    </div>

    <main class="text-center px-4">
      <!-- Processing State -->
      <div id="processing-state" class="<%= @linkedin_import.failed? ? 'hidden' : '' %>">
        <div class="mb-8">
          <div class="w-20 h-20 mx-auto relative">
            <svg class="animate-spin w-20 h-20 text-emerald-600" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
        </div>
        <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-4">
          جاري تحليل سيرتك الذاتية
        </h1>
        <p class="text-slate-600 mb-8 max-w-md mx-auto">
          نستخدم الذكاء الاصطناعي لاستخراج البيانات من ملفك. قد تستغرق العملية حتى دقيقة واحدة.
        </p>
        <div class="space-y-2 text-sm text-slate-500">
          <div class="flex items-center justify-center gap-3" id="step-1">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>تم رفع الملف</span>
          </div>
          <div class="flex items-center justify-center gap-3" id="step-2">
            <svg class="w-5 h-5 text-slate-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span>استخراج النص...</span>
          </div>
          <div class="flex items-center justify-center gap-3" id="step-3">
            <svg class="w-5 h-5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span class="text-slate-400">تحليل الذكاء الاصطناعي</span>
          </div>
          <div class="flex items-center justify-center gap-3" id="step-4">
            <svg class="w-5 h-5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
            </svg>
            <span class="text-slate-400">تجهيز المحرر</span>
          </div>
        </div>
      </div>

      <!-- Failed State -->
      <div id="failed-state" class="<%= @linkedin_import.failed? ? '' : 'hidden' %>">
        <div class="mb-8">
          <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto">
            <svg class="w-10 h-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
        </div>
        <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 mb-4">
          حدث خطأ
        </h1>
        <p class="text-slate-600 mb-4 max-w-md mx-auto">
          عذراً، لم نتمكن من معالجة الملف. يرجى المحاولة مرة أخرى.
        </p>
        <p class="text-sm text-red-600 mb-8" id="error-message">
          <%= @linkedin_import.error_message %>
        </p>
        <a href="<%= linkedin_import_path %>" class="inline-flex items-center justify-center gap-2 bg-emerald-600 text-white py-3 px-6 rounded-xl font-semibold hover:bg-emerald-700 transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          <span>حاول مرة أخرى</span>
        </a>
      </div>
    </main>

    <script>
      const statusUrl = '<%= linkedin_import_status_path(@linkedin_import, format: :json) %>';
      const editUrl = '<%= linkedin_import_edit_path(@linkedin_import) %>';
      const processingState = document.getElementById('processing-state');
      const failedState = document.getElementById('failed-state');
      const step2 = document.getElementById('step-2');
      const step3 = document.getElementById('step-3');
      const step4 = document.getElementById('step-4');

      let pollCount = 0;

      function updateStepToComplete(step) {
        step.innerHTML = `
          <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="text-emerald-700">${step.querySelector('span').textContent}</span>
        `;
      }

      function updateStepToProcessing(step) {
        step.innerHTML = `
          <svg class="w-5 h-5 text-slate-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span>${step.querySelector('span').textContent}</span>
        `;
      }

      async function checkStatus() {
        try {
          const response = await fetch(statusUrl);
          const data = await response.json();

          if (data.completed) {
            // Update all steps to complete
            updateStepToComplete(step2);
            updateStepToComplete(step3);
            updateStepToComplete(step4);
            // Redirect to editor after a short delay
            setTimeout(() => {
              window.location.href = editUrl;
            }, 500);
            return;
          }

          if (data.failed) {
            processingState.classList.add('hidden');
            failedState.classList.remove('hidden');
            document.getElementById('error-message').textContent = data.error_message || 'حدث خطأ غير متوقع';
            return;
          }

          // Update visual progress based on poll count
          pollCount++;
          if (pollCount > 2) {
            updateStepToComplete(step2);
            updateStepToProcessing(step3);
          }
          if (pollCount > 5) {
            updateStepToComplete(step3);
            updateStepToProcessing(step4);
          }

          // Continue polling
          setTimeout(checkStatus, 2000);
        } catch (error) {
          console.error('Error checking status:', error);
          setTimeout(checkStatus, 3000);
        }
      }

      // Start polling
      <% unless @linkedin_import.failed? %>
        checkStatus();
      <% end %>
    </script>
  </body>
</html>

<% unless user_signed_in? %>
  <script>
    window.location.href = '/auth/login';
  </script>
<% else %>
  <!DOCTYPE html>
  <html lang="ar" dir="rtl">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>منشئ السيرة الذاتية بالذكاء الاصطناعي — CV•AI</title>
      <meta name="description" content="أنشئ سيرة ذاتية احترافية خلال دقائق باستخدام الذكاء الاصطناعي. قوالب حديثة، تحسين تلقائي للنقاط، وتصدير PDF بجودة عالية." />
      <meta name="theme-color" content="#10b981" />
      <meta name="csrf-token" content="<%= form_authenticity_token %>" />
      <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
      <meta name="format-detection" content="telephone=no" />
      <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
      <script src="https://cdn.tailwindcss.com"></script>
      <script src="https://unpkg.com/lucide@latest"></script>
      <style>
        .line-clamp-3 {
          display: -webkit-box;
          -webkit-line-clamp: 3;
          -webkit-box-orient: vertical;
          overflow: hidden;
        }

        /* PDF viewer styles */
        .pdf-viewer {
          width: 100%;
          height: 100%;
          border: none;
          background: #f8f9fa;
        }

        .pdf-container {
          position: relative;
          width: 100%;
          height: 100vh;
          overflow: hidden;
        }

        /* Mobile-friendly PDF modal */
        @media (max-width: 768px) {
          .pdf-modal {
            padding: 1rem;
          }
          .pdf-modal .modal-content {
            max-height: 90vh;
            margin: 0;
          }
          .pdf-modal iframe {
            min-height: 60vh;
          }
        }

        /* PDF preview window styles */
        .pdf-preview-window {
          width: 100%;
          height: 100vh;
          margin: 0;
          padding: 0;
          overflow: hidden;
        }

        .pdf-preview-frame {
          width: 100%;
          height: 100%;
          border: none;
          margin: 0;
          padding: 0;
        }
      </style>
    </head>
    <body class="antialiased bg-gradient-to-b from-white via-emerald-50 to-white text-slate-900 font-sans" style="font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;">
      <!-- Background Accents -->
      <div class="pointer-events-none fixed inset-0 -z-10">
        <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-emerald-400/20 blur-3xl"></div>
        <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-emerald-300/20 blur-3xl"></div>
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[38rem] h-[38rem] bg-gradient-to-b from-emerald-200/30 to-transparent rounded-full blur-3xl"></div>
      </div>
      <!-- Flash Messages -->
      <% if flash[:notice] %>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4">
          <div class="rounded-lg bg-emerald-50 border border-emerald-200 p-4">
            <div class="flex items-center gap-3">
              <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600"></i>
              <p class="text-sm text-emerald-800"><%= flash[:notice] %></p>
            </div>
          </div>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4">
          <div class="rounded-lg bg-red-50 border border-red-200 p-4">
            <div class="flex items-center gap-3">
              <i data-lucide="alert-circle" class="w-5 h-5 text-red-600"></i>
              <p class="text-sm text-red-800"><%= flash[:alert] %></p>
            </div>
          </div>
        </div>
      <% end %>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100 text-emerald-700 px-3 py-1 text-xs ring-1 ring-emerald-500/20 mb-4">
            <i data-lucide="sparkles" class="w-4 h-4"></i>
            <span>منشئ السيرة الذاتية بالذكاء الاصطناعي</span>
          </div>
          <h1 class="text-3xl font-bold text-slate-900 mb-2">أنشئ سيرة ذاتية احترافية</h1>
          <p class="text-slate-600">استخدم الذكاء الاصطناعي لإنشاء ملخص مهني مخصص بناءً على وصف الوظيفة</p>
        </div>
        <!-- React Component Container -->
        <div id="cv-generation-results">
          <!-- React component will render here -->
        </div>
      </div>
      <!-- React Libraries -->
      <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
      <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
      <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
      <script type="text/babel">
        const { useState, useEffect } = React;

          // NOTE: Inline Babel cannot import local modules. Avoid imports here.

        // Error Boundary Component
        class ErrorBoundary extends React.Component {
          constructor(props) {
            super(props);
            this.state = { hasError: false, error: null };
          }

          static getDerivedStateFromError(error) {
            return { hasError: true, error };
          }

          componentDidCatch(error, errorInfo) {
            console.error('🔴 React Error:', error);
            console.error('Error Info:', errorInfo);
          }

          render() {
            if (this.state.hasError) {
              return (
                <div className="bg-red-50 border border-red-200 rounded-lg p-4">
                  <h2 className="text-red-800 font-medium">عذراً، حدث خطأ ما</h2>
                  <p className="text-red-600 text-sm mt-2">{this.state.error?.message || 'خطأ غير معروف'}</p>
                </div>
              );
            }
            return this.props.children;
          }
        }

        const DebugWrapper = ({ children }) => {
          try {
            return children;
          } catch (error) {
            console.error('🔴 Render Error:', error);
            return (
              <div className="bg-red-50 border border-red-200 rounded-lg p-4">
                <h2 className="text-red-800 font-medium">عذراً، حدث خطأ في العرض</h2>
                <p className="text-red-600 text-sm mt-2">{error.message}</p>
              </div>
            );
          }
        };

        const CvGeneratorApp = () => {
          console.log('🔄 CvGeneratorApp component rendering...');

          // Form state
          const [jobDescription, setJobDescription] = useState('');
          const [selectedResumeId, setSelectedResumeId] = useState('');
          const [isGenerating, setIsGenerating] = useState(false);
          const [isLoading, setIsLoading] = useState(true);

          // Results state
          const [cvData, setCvData] = useState(null);
          const [error, setError] = useState(null);
          const [showPdfModal, setShowPdfModal] = useState(false);
          const [showResults, setShowResults] = useState(false);
          const [resumes, setResumes] = useState([]);

          // Preview Modal state
          const [showPreviewModal, setShowPreviewModal] = useState(false);
          const [previewPdfUrl, setPreviewPdfUrl] = useState('');
          const [previewTitle, setPreviewTitle] = useState('');

          // Safe access helper
          const safeGet = (obj, path, fallback = '') => {
            try {
              return path.split('.').reduce((acc, key) => acc[key], obj) || fallback;
            } catch (e) {
              return fallback;
            }
          };
            // Helper to get unique id for resume or CV
            const getResumeId = (resume) => resume.id || resume.cv_gen_id || resume.cv_generation_id || resume._id || '';

          // CV Generation limit state
          const [userCvCount, setUserCvCount] = useState(0);
          const [maxCvGenerations, setMaxCvGenerations] = useState(150);

          // Download handler function
          const handleDownload = async (url, filename) => {
            try {
              const response = await fetch(url);
              if (!response.ok) {
                throw new Error('Download failed');
              }

              const blob = await response.blob();
              const downloadUrl = window.URL.createObjectURL(blob);
              const link = document.createElement('a');
              link.href = downloadUrl;
              link.download = filename || 'cv.pdf';
              document.body.appendChild(link);
              link.click();
              document.body.removeChild(link);
              window.URL.revokeObjectURL(downloadUrl);
            } catch (error) {
              console.error('Download error:', error);
              alert('فشل في تحميل الملف. يرجى المحاولة مرة أخرى.');
            }
          };

          // Fetch user CV count
          const fetchUserCvCount = async () => {
            try {
              const response = await fetch('/cv_generations/count.json');
              if (response.ok) {
                const data = await response.json();
                setUserCvCount(data.count || 0);
                setMaxCvGenerations(data.limit || 150);
              }
            } catch (error) {
              console.error('Error fetching CV count:', error);
              setUserCvCount(0);
            }
          };

          // Load resumes and CV generations (moved outside useEffect so it can be called by delete handlers)
          const loadResumesWithGenerations = async () => {
            setIsLoading(true);
            try {
              console.log('📊 Fetching CV count...');
              await fetchUserCvCount();

              // Fetch CV Builder resumes only
              console.log('📝 Loading CV Builder resumes...');
              let builderResumes = [];
              try {
                const rawResumesResponse = await fetch('/resumes.json');
                if (rawResumesResponse.ok) {
                  const rawResumesData = await rawResumesResponse.json();
                  builderResumes = rawResumesData.map(resume => ({
                    ...resume,
                    is_cv_builder: true
                  }));
                }
              } catch (e) {
                console.error('Error loading CV Builder resumes:', e);
              }

              // Fetch generated CVs only
              console.log('📝 Loading generated CVs...');
              let generatedCVs = [];
              try {
                const cvGenerationsResponse = await fetch('/cv_generations.json');
                if (cvGenerationsResponse.ok) {
                  const cvGenerationsData = await cvGenerationsResponse.json();
                  generatedCVs = cvGenerationsData
                    .filter(cv => cv.status === 'completed')
                    .map(cv => ({
                      id: `cv_gen_${cv.id}`,
                      complete_name: cv.metadata?.complete_name || `سيرة ذاتية مبنية #${cv.id}`,
                      email: cv.metadata?.email || 'غير محدد',
                      professional_summary: cv.generated_content || 'محتوى مبنية بالذكاء الاصطناعي',
                      professional_summary_english: cv.generated_content || 'AI Generated Content',
                      latest_cv_generation: cv,
                      last_generated: new Date(cv.created_at),
                      pdf_url: cv.metadata?.pdf_generated ? `/cv_generations/${cv.id}/view_pdf` : null,
                      pdf_metadata: cv.metadata,
                      is_cv_builder: false,
                      is_ai_generated: true,
                      job_description: cv.job_description,
                      created_at: cv.created_at
                    }));
                }
              } catch (e) {
                console.error('Error loading generated CVs:', e);
              }

              // Combine both lists, but do NOT merge or overwrite
              const allResumes = [...builderResumes, ...generatedCVs];
              // Sort by creation date (newest first)
              allResumes.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
              setResumes(allResumes || []);
            } catch (err) {
              setResumes([]);
              setError('Failed to load CVs: ' + err.message);
            } finally {
              setIsLoading(false);
              console.log('✅ Initial data loading complete');
            }
          };

          // Load resumes and CV generations on component mount
          useEffect(() => {
            console.log('🔄 Initial data loading effect running...');
            loadResumesWithGenerations();
          }, []); // Empty dependency array means this effect runs once on mount

          // Check for CV generation ID in URL on page load (for direct links)
          useEffect(() => {
            const urlParams = new URLSearchParams(window.location.search);
            const cvGenerationId = urlParams.get('cv_generation_id');

            if (cvGenerationId) {
              console.log('🔍 Found CV Generation ID in URL:', cvGenerationId);
              setShowResults(true);
              setIsGenerating(true);

              // Load existing CV data if it's already completed
              const loadExistingCv = async () => {
                try {
                  const response = await fetch(`/cv_generations/${cvGenerationId}.json`);
                  const data = await response.json();

                  if (data && data.status === 'completed') {
                    console.log('✅ CV already completed, loading data');
                    console.log('📄 CV Data:', data);
                    console.log('📄 PDF Metadata:', data.metadata);
                    console.log('📄 PDF Path:', data.metadata?.pdf_path);
                    setCvData(data);
                    setIsGenerating(false);

                    if (data.metadata?.pdf_generated === true || data.metadata?.pdf_generated === 'true') {
                      setShowPdfModal(true);
                    }
                  } else if (data && data.status === 'processing') {
                    // Start polling for completion
                    let pollAttempts = 0;
                    const maxPollAttempts = 30;

                    const pollForResults = async () => {
                      try {
                        const pollResponse = await fetch(`/cv_generations/${cvGenerationId}.json`);
                        const pollData = await pollResponse.json();

                        if (pollData && pollData.status === 'completed') {
                          console.log('✅ CV generation completed!');
                          setCvData(pollData);
                          setIsGenerating(false);

                          if (pollData.metadata?.pdf_generated === true || pollData.metadata?.pdf_generated === 'true') {
                            setShowPdfModal(true);
                          }
                        } else if (pollData && pollData.status === 'failed') {
                          setError('CV generation failed');
                          setIsGenerating(false);
                        } else {
                          pollAttempts++;
                          if (pollAttempts < maxPollAttempts) {
                            setTimeout(pollForResults, 2000);
                          } else {
                            setError('CV generation is taking too long');
                            setIsGenerating(false);
                          }
                        }
                      } catch (err) {
                        console.error('❌ Error polling for results:', err);
                        setError('Error checking generation status');
                        setIsGenerating(false);
                      }
                    };

                    pollForResults();
                  }
                } catch (err) {
                  console.error('❌ Error loading CV data:', err);
                  setError('Error loading CV data');
                  setIsGenerating(false);
                }
              };

              loadExistingCv();
            }
          }, []); // Empty dependency array means this effect runs once on mount

          // PDF download handler
          const downloadPdf = async () => {
            if (!cvData || !cvData.id) {
              console.error('No CV data available for download');
              return;
            }

            try {
              await handleDownload(
                `/cv_generations/${cvData.id}/download_pdf`,
                `cv_generated_${cvData.id}.pdf`
              );
            } catch (error) {
              console.error('Error downloading PDF:', error);
              alert('فشل في تحميل الملف. يرجى المحاولة مرة أخرى.');
            }
          };

          // Delete handlers
          const getCsrfToken = () => document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

          const deleteResume = async (resumeId) => {
            if (!resumeId) return;
            if (!confirm('هل تريد حذف هذه السيرة الذاتية؟ لا يمكن التراجع عن هذا الإجراء.')) return;
            try {
              const res = await fetch(`/resumes/${resumeId}`, {
                method: 'DELETE',
                headers: {
                  'X-CSRF-Token': getCsrfToken() || '',
                  'Accept': 'application/json'
                }
              });
              if (res.ok || res.status === 204 || res.status === 404) {
                // Remove the deleted resume from state without reloading
                setResumes(prevResumes => prevResumes.filter(r => r.id !== resumeId));
              } else {
                const txt = await res.text();
                console.error('Failed to delete resume:', res.status, txt);
                alert('فشل حذف السيرة الذاتية.');
              }
            } catch (e) {
              console.error('Error deleting resume:', e);
              alert('حدث خطأ أثناء حذف السيرة الذاتية.');
            }
          };

          const deleteCvGeneration = async (cvGenId) => {
            if (!cvGenId) return;
            if (!confirm('هل تريد حذف هذه السيرة الذاتية المُولدة؟')) return;
            try {
              const res = await fetch(`/cv_generations/${cvGenId}`, {
                method: 'DELETE',
                headers: {
                  'X-CSRF-Token': getCsrfToken() || '',
                  'Accept': 'application/json'
                }
              });
              if (res.ok || res.status === 204 || res.status === 404) {
                // Remove the deleted CV generation from state without reloading
                // CV generations have IDs like 'cv_gen_123'
                setResumes(prevResumes => prevResumes.filter(r => r.id !== `cv_gen_${cvGenId}`));
              } else {
                const txt = await res.text();
                console.error('Failed to delete CV generation:', res.status, txt);
                alert('فشل حذف السيرة الذاتية المبنية.');
              }
            } catch (e) {
              console.error('Error deleting CV generation:', e);
              alert('حدث خطأ أثناء حذف السيرة الذاتية المبنية.');
            }
          };


          // Form submission handler
          const handleSubmit = async (e) => {
            e.preventDefault();

            if (!selectedResumeId || !jobDescription.trim()) {
              alert('Please select a resume and enter a job description');
              return;
            }

            // Check CV generation limit
            if (userCvCount >= maxCvGenerations) {
              alert(`لقد وصلت إلى الحد الأقصى من إنشاء السير الذاتية (${maxCvGenerations}). يرجى المحاولة لاحقاً.`);
              return;
            }

            setIsGenerating(true);
            setError(null);
            setShowResults(true);

            try {
              // Use fetch to submit the form data
              const formData = new URLSearchParams();
              formData.append('cv_generation[job_description]', jobDescription.trim());
              formData.append('cv_generation[resume_id]', selectedResumeId);
              formData.append('cv_generation[temperature]', '0.7');
              formData.append('cv_generation[max_tokens]', '15000');
              formData.append('cv_generation[complete_name]', '');
              formData.append('cv_generation[email]', '');

              const response = await fetch('/cv_generations', {
                method: 'POST',
                body: formData,
                headers: {
                  'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
                  'Accept': 'application/json',
                  'Content-Type': 'application/x-www-form-urlencoded'
                }
              });

              if (response.ok) {
                const result = await response.json();
                console.log('✅ Form submitted successfully:', result);

                if (result.cv_generation_id) {
                  // Start polling for this specific CV generation
                  const cvGenerationId = result.cv_generation_id;
                  console.log('🔍 Starting to poll for CV ID:', cvGenerationId);

                  // Poll for results
                  let pollAttempts = 0;
                  const maxPollAttempts = 30;

                  const pollForResults = async () => {
                    try {
                      const pollResponse = await fetch(`/cv_generations/${cvGenerationId}.json`);
                      const data = await pollResponse.json();

                      if (data && data.status === 'completed') {
                        console.log('✅ CV generation completed!');
                        console.log('📊 CV Data:', data);
                        console.log('📄 PDF Generated:', data.metadata?.pdf_generated);
                        console.log('📄 PDF Generated Type:', typeof data.metadata?.pdf_generated);
                        console.log('📄 Has PDF Data:', !!data.metadata?.pdf_data);
                        setCvData(data);
                        setIsGenerating(false);

                        // Show PDF modal immediately if PDF is generated
                        const pdfGenerated = data.metadata?.pdf_generated;
                        console.log('📄 PDF Generated Value:', pdfGenerated);
                        console.log('📄 PDF Generated Type:', typeof pdfGenerated);

                        if (pdfGenerated === true || pdfGenerated === 'true' || pdfGenerated === 1) {
                          console.log('📄 PDF generated, showing modal immediately');
                          setShowPdfModal(true);
                        } else {
                          console.log('❌ PDF not generated for this CV');
                          console.log('📄 PDF Error:', data.metadata?.pdf_error);
                        }
                      } else if (data && data.status === 'failed') {
                        console.log('❌ CV generation failed');
                        setError('CV generation failed');
                        setIsGenerating(false);
                      } else {
                        pollAttempts++;
                        if (pollAttempts < maxPollAttempts) {
                          setTimeout(pollForResults, 2000);
                        } else {
                          setError('CV generation is taking too long');
                          setIsGenerating(false);
                        }
                      }
                    } catch (err) {
                      console.error('❌ Error polling for results:', err);
                      setError('Error checking generation status');
                      setIsGenerating(false);
                    }
                  };

                  // Start polling immediately
                  pollForResults();
                }
              } else {
                const errorText = await response.text();
                console.error('❌ Form submission failed:', response.status, errorText);
                setError(`Failed to submit CV generation request (Status: ${response.status})`);
                setIsGenerating(false);
              }
            } catch (err) {
              console.error('❌ Error submitting form:', err);
              setError('Error submitting form: ' + err.message);
              setIsGenerating(false);
            }
          };


          if (isLoading) {
            return (
              <div className="text-center py-8">
                <div className="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-emerald-600"></div>
                <p className="mt-4 text-slate-600">جاري تحميل البيانات...</p>
              </div>
            );
          }

          return (
            <div className="cv-generator-app">
              {error && (
                <div className="mb-4 bg-red-50 border border-red-200 rounded-lg p-4">
                  <p className="text-red-800">{error}</p>
                </div>
              )}

              {/* Job Description Section */}
              <div className="mb-8">
                <label className="block text-sm font-medium text-slate-700 mb-2">
                  وصف الوظيفة
                </label>
                <textarea
                  value={jobDescription}
                  onChange={(e) => setJobDescription(e.target.value)}
                  placeholder="أدخل وصف الوظيفة التي تريد التقدم إليها..."
                  className="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 resize-none"
                  rows="4"
                />
              </div>

              {/* Resume Selection */}
              <div className="mb-8">
                <label className="block text-sm font-medium text-slate-700 mb-2">
                  اختيار السيرة الذاتية
                </label>
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  {resumes && resumes.length > 0 ? resumes.map(resume => {
                    const resumeId = resume.id || resume.cv_gen_id;
                    // Always show AI-generated summary for raw CVs if available, otherwise fallback
                    let displaySummary = '';
                    let summarySource = '';
                    if (resume.is_cv_builder) {
                      // CV Builder resume
                      displaySummary = resume.professional_summary || '';
                      summarySource = 'CV_BUILDER';
                    } else {
                      // Generated CV (from /cv_generations.json)
                      displaySummary = resume.professional_summary_english || resume.professional_summary || '';
                      summarySource = 'AI_GENERATED';
                    }
                    // Debug log for summary source
                    console.log(`CV Card [${resumeId}] summary source: ${summarySource}`, displaySummary);
                    return (
                      <div
                        key={resumeId}
                        className={`p-4 border rounded-lg cursor-pointer transition-all ${
                          selectedResumeId === resumeId.toString()
                            ? 'border-emerald-500 bg-emerald-50'
                            : 'border-slate-200 hover:border-slate-300'
                        }`}
                        onClick={() => setSelectedResumeId(resumeId.toString())}
                      >
                      {/* Header */}
                      <div className="mb-3">
                        <div className="flex items-center justify-between mb-1">
                          <h3 className="font-medium text-slate-900">{resume.complete_name}</h3>
                          {resume.is_cv_builder && (
                            <span className="px-2 py-1 text-xs bg-blue-100 text-blue-700 rounded-full font-medium">
                              CV Builder
                            </span>
                          )}
                          {resume.is_ai_generated && (
                            <span className="px-2 py-1 text-xs bg-emerald-100 text-emerald-700 rounded-full font-medium">
                              مبنية بالذكاء الاصطناعي
                            </span>
                          )}
                        </div>
                        <p className="text-sm text-slate-600">{resume.email}</p>
                      </div>

                      {/* Professional Summary Preview */}
                      {/* Remove the original professional summary preview for CV Builder resumes */}


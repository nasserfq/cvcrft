                      {resume.is_ai_generated && resume.job_description && (
                        <div className="mb-3">
                          <p className="text-xs text-slate-500 font-medium mb-1">وصف الوظيفة:</p>
                          <p className="text-xs text-slate-700 line-clamp-2 leading-relaxed">
                            {resume.job_description.substring(0, 80)}
                            {resume.job_description.length > 80 ? '...' : ''}
                          </p>
                        </div>
                      )}
                      {/* CV Generation Info */}
                      {resume.latest_cv_generation ? (
                        <div className="mb-3 p-2 bg-slate-50 rounded border">
                          <div className="flex items-center justify-between mb-1">
                            <span className="text-xs font-medium text-slate-700">آخر إنشاء:</span>
                            <span className="text-xs text-slate-600">
                              {resume.last_generated ? new Date(resume.last_generated).toLocaleDateString('en-GB') : 'غير محدد'}
                            </span>
                          </div>
                          <div className="flex items-center gap-2">
                            <div className="flex items-center gap-1">
                              <div className={`w-2 h-2 rounded-full ${
                                resume.latest_cv_generation.status === 'completed' ? 'bg-emerald-500' :
                                resume.latest_cv_generation.status === 'processing' ? 'bg-yellow-500' :
                                resume.latest_cv_generation.status === 'failed' ? 'bg-red-500' : 'bg-gray-500'
                              }`}></div>
                              <span className={`text-xs ${
                                resume.latest_cv_generation.status === 'completed' ? 'text-emerald-700' :
                                resume.latest_cv_generation.status === 'processing' ? 'text-yellow-700' :
                                resume.latest_cv_generation.status === 'failed' ? 'text-red-700' : 'text-gray-700'
                              }`}>
                                {resume.latest_cv_generation.status === 'completed' ? 'PDF متوفر' :
                                 resume.latest_cv_generation.status === 'processing' ? 'جاري المعالجة' :
                                 resume.latest_cv_generation.status === 'failed' ? 'فشل التوليد' : 'غير محدد'}
                              </span>
                            </div>
                            {resume.latest_cv_generation.metadata?.pdf_size && (
                              <span className="text-xs text-slate-500">
                                {(resume.latest_cv_generation.metadata.pdf_size / 1024).toFixed(1)} KB
                              </span>
                            )}
                          </div>
                          {/* Show AI-generated summary for latest built CV */}
                          {(resume.latest_cv_generation.professional_summary_english || resume.latest_cv_generation.professional_summary) && (
                            <div className="text-xs text-emerald-700 mt-2">
                              <span className="font-semibold">الملخص المهني:</span>
                              <span> {(resume.latest_cv_generation.professional_summary_english || resume.latest_cv_generation.professional_summary).substring(0, 120)}
                                {(resume.latest_cv_generation.professional_summary_english || resume.latest_cv_generation.professional_summary).length > 120 ? '...' : ''}
                              </span>
                            </div>
                          )}
                        </div>
                      ) : resume.is_cv_builder ? (
                        <div className="mb-3 p-2 bg-blue-50 rounded border border-blue-200">
                          <div className="flex items-center gap-2">
                            <div className="flex items-center gap-1">
                              <div className="w-2 h-2 bg-blue-500 rounded-full"></div>
                              <span className="text-xs text-blue-700 font-medium">سيرة ذاتية مبنية</span>
                            </div>
                            <span className="text-xs text-blue-600">جاهزة للتحسين</span>
                          </div>
                          <div className="text-xs text-blue-600 mt-1">
                            تم إنشاؤها: {resume.created_at ? new Date(resume.created_at).toLocaleDateString('en-GB') : 'غير محدد'}
                          </div>
                          {/* Show fallback summary for CV Builder resumes if no latest CV */}
                          {(resume.professional_summary_english || resume.professional_summary) && (
                            <div className="text-xs text-blue-700 mt-2">
                              <span className="font-semibold">الملخص المهني:</span>
                              <span> {(resume.professional_summary_english || resume.professional_summary).substring(0, 120)}
                                {(resume.professional_summary_english || resume.professional_summary).length > 120 ? '...' : ''}
                              </span>
                            </div>
                          )}
                        </div>
                      ) : (
                        <div className="mb-3 p-2 bg-slate-50 rounded border">
                          <div className="flex items-center gap-2">
                            <div className="flex items-center gap-1">
                              <div className="w-2 h-2 bg-slate-400 rounded-full"></div>
                              <span className="text-xs text-slate-600">سيرة ذاتية أساسية</span>
                            </div>
                          </div>
                        </div>
                      )}
                      {/* Contact Info */}
                      <div className="text-xs text-slate-500">
                        {resume.phone_number && <div>📞 {resume.phone_number}</div>}
                        {resume.city && resume.country && <div>📍 {resume.city}, {resume.country}</div>}
                      </div>
                      {/* CV Actions */}
                      <div className="mt-3 space-y-2">
                        {/* Actions for AI Generated CVs */}
                        {resume.is_ai_generated && resume.latest_cv_generation?.metadata?.pdf_generated && (
                          <div className="flex gap-2">
                            <button
                              onClick={() => {
                                setPreviewPdfUrl(`/cv_generations/${resume.latest_cv_generation.id}/view_pdf`);
                                setPreviewTitle(resume.complete_name);
                                setShowPreviewModal(true);
                              }}
                              className="flex-1 bg-blue-500 hover:bg-blue-600 text-white text-xs py-2 px-3 rounded-md transition-colors flex items-center justify-center gap-1"
                            >
                              <i data-lucide="eye" class="w-3 h-3"></i>
                              معاينة
                            </button>
                            <button
                              onClick={() => handleDownload(`/cv_generations/${resume.latest_cv_generation.id}/download_pdf`, `cv_generated_${resume.latest_cv_generation.id}.pdf`)}
                              className="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white text-xs py-2 px-3 rounded-md transition-colors flex items-center justify-center gap-1"
                            >
                              <i data-lucide="download" class="w-3 h-3"></i>
                              تحميل PDF
                            </button>
                            <button
                              onClick={() => deleteCvGeneration(resume.latest_cv_generation.id)}
                              className="flex-1 bg-red-500 hover:bg-red-600 text-white text-xs py-2 px-3 rounded-md transition-colors flex items-center justify-center gap-1"
                            >
                              <i data-lucide="trash" class="w-3 h-3"></i>
                              حذف
                            </button>
                          </div>
                        )}
                        {/* Actions for CV Builder Resumes */}
                        {resume.is_cv_builder && (
                          <div className="flex gap-2">
                            <button
                              onClick={() => {
                                console.log('🔍 Opening CV Builder preview for resume:', resume);
                                console.log('📄 PDF URL from database:', resume.pdf_url);
                                 const pdfUrl = resume.pdf_url ? `${resume.pdf_url}?preview=true` : `/resumes/${resume.id}/generate_pdf?preview=true`;
                                 console.log('📄 Final PDF URL with preview param:', pdfUrl);
                                 setPreviewPdfUrl(pdfUrl);
                                setPreviewTitle(resume.complete_name);
                                setShowPreviewModal(true);
                              }}
                              className="flex-1 bg-blue-500 hover:bg-blue-600 text-white text-xs py-2 px-3 rounded-md transition-colors flex items-center justify-center gap-1"
                            >
                              <i data-lucide="eye" class="w-3 h-3"></i>
                              معاينة
                            </button>
                            <button
                              onClick={() => handleDownload(`/resumes/${resume.id}/generate_pdf`, `${resume.complete_name || 'resume'}_${resume.id}.pdf`)}
                              className="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white text-xs py-2 px-3 rounded-md transition-colors flex items-center justify-center gap-1"
                            >
                              <i data-lucide="download" class="w-3 h-3"></i>
                              تحميل PDF
                            </button>
                            <button
                              onClick={() => deleteResume(resume.id)}
                              className="flex-1 bg-red-500 hover:bg-red-600 text-white text-xs py-2 px-3 rounded-md transition-colors flex items-center justify-center gap-1"
                            >
                              <i data-lucide="trash" class="w-3 h-3"></i>
                              حذف
                            </button>
                          </div>
                        )}
                      </div>
                      {/* Selection Indicator */}
                      {selectedResumeId === resumeId.toString() && (
                        <div className="mt-3 flex items-center justify-center">
                          <div className="flex items-center gap-2 text-emerald-600">
                            <i data-lucide="check-circle" class="w-4 h-4"></i>
                            <span className="text-sm font-medium">محدد</span>
                          </div>
                        </div>
                      )}
                      </div>
                    );
                  }) : (
                    <div className="col-span-full text-center py-8">
                      <p className="text-slate-600">لا توجد سير ذاتية متاحة</p>
                    </div>
                  )}
                </div>
                <button
                  type="button"
                  onClick={handleSubmit}
                  disabled={isGenerating || !selectedResumeId || !jobDescription.trim() || userCvCount >= maxCvGenerations}
                  className="w-full bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  {isGenerating ? 'جاري الإنشاء...' :
                   userCvCount >= maxCvGenerations ? `وصلت للحد الأقصى (${maxCvGenerations})` :
                   'إنشاء السيرة الذاتية'}
                </button>
              </div>

              {/* Results Section */}
              {showResults && (
        <div className="mt-8">
          {isGenerating && (
            <div className="text-center py-8">
              <div className="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-emerald-600"></div>
              <p className="mt-4 text-slate-600">جاري إنشاء السيرة الذاتية...</p>
              <p className="text-sm text-slate-500">يرجى الانتظار بينما نقوم بإنشاء سيرتك الذاتية...</p>
            </div>
          )}

          {error && (
            <div className="bg-red-50 border border-red-200 rounded-lg p-4">
              <p className="text-red-800">{error}</p>
            </div>
          )}

          {cvData && !isGenerating && (
            <div className="bg-white border border-slate-200 rounded-lg p-6">
              {/* CV Actions Integration */}
              <div>
                <div className="flex items-center justify-between mb-4">
                  <h3 className="text-lg font-semibold text-slate-900">تم إنشاء السيرة الذاتية بنجاح!</h3>
                <div className="flex items-center gap-2 text-emerald-600">
                  <i data-lucide="file-text" class="w-5 h-5"></i>
                  <span className="text-sm font-medium">PDF جاهز</span>
                </div>
              </div>

                <div className="mb-4">
                  <h4 className="font-medium text-slate-700 mb-2">الملخص المهني الجديد:</h4>
                  <p className="text-slate-600 leading-relaxed">{cvData.generated_content}</p>
                </div>
              {/* Show PDF buttons only if PDF was generated */}
              {(cvData.metadata?.pdf_generated === true || cvData.metadata?.pdf_generated === 'true' || cvData.metadata?.pdf_generated === 1) ? (
                <div className="flex flex-col sm:flex-row gap-3">
                  <button
                    onClick={() => setShowPdfModal(true)}
                    className="flex-1 bg-emerald-600 text-white px-4 py-3 rounded-lg hover:bg-emerald-700 flex items-center justify-center gap-2 font-medium"
                  >
                    <i data-lucide="eye" class="w-4 h-4"></i>
                    معاينة PDF
                  </button>
                  <button
                    onClick={downloadPdf}
                    className="flex-1 bg-slate-600 text-white px-4 py-3 rounded-lg hover:bg-slate-700 flex items-center justify-center gap-2 font-medium"
                  >
                    <i data-lucide="download" class="w-4 h-4"></i>
                    تحميل PDF
                  </button>
                </div>
              ) : (
                <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                  <div className="flex items-center gap-2 text-yellow-800">
                    <i data-lucide="alert-circle" class="w-5 h-5"></i>
                    <span className="font-medium">PDF غير متوفر</span>
                  </div>
                  <p className="text-sm text-yellow-700 mt-1">
                    لم يتم إنشاء PDF لهذه السيرة الذاتية. يرجى المحاولة مرة أخرى.
                  </p>
                  {cvData.metadata?.pdf_error && (
                    <p className="text-xs text-yellow-600 mt-2">
                      خطأ: {cvData.metadata.pdf_error}
                    </p>
                  )}
                </div>
              )}
              </div>
          </div>
        )}
        </div>
              )}

        {/* PDF Preview Integration */}
              {showPdfModal && cvData && (
                <div className="fixed inset-0 z-50 flex flex-col bg-white">
                  <div className="flex items-center justify-between p-4 border-b">
                    <h3 className="text-lg font-semibold text-slate-900">معاينة السيرة الذاتية</h3>
                    <button
                      onClick={() => setShowPdfModal(false)}
                      className="text-slate-500 hover:text-slate-700 text-xl font-bold"
                    >
                      ✕
                    </button>
                  </div>

                  {/* PDF Content */}
                  <div className="flex-1 overflow-hidden">
                    <iframe
                      src={cvData.metadata?.pdf_path ? `/${cvData.metadata.pdf_path}` : `/cv_generations/${cvData.id}/download_pdf`}
                      title="CV Preview"
                      className="w-full h-full pdf-viewer"
                      onLoad={() => console.log('✅ PDF iframe loaded successfully')}
                      onError={() => console.error('❌ PDF iframe failed to load')}
                    />
                  </div>
                  {/* Mobile-friendly action buttons */}
                  <div className="p-4 border-t bg-slate-50">
                    <div className="flex gap-3">
                      <button
                        onClick={downloadPdf}
                        className="flex-1 bg-emerald-600 text-white px-4 py-3 rounded-lg hover:bg-emerald-700 flex items-center justify-center gap-2 font-medium"
                      >
                        <i data-lucide="download" className="w-4 h-4"></i>
                        تحميل PDF
                      </button>
                      <button
                        onClick={() => setShowPdfModal(false)}
                        className="px-6 py-3 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 font-medium"
                      >
                        إغلاق
                      </button>
                    </div>
                  </div>
                </div>
              )}

              {/* PDF Preview Modal */}
              {showPreviewModal && (
                <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
                  <div className="bg-white rounded-lg w-full max-w-4xl max-h-[90vh] flex flex-col">
                    <div className="flex items-center justify-between p-4 border-b">
                      <h2 className="text-lg font-bold text-slate-900">معاينة السيرة الذاتية</h2>
                      <button onClick={() => setShowPreviewModal(false)} className="text-slate-600 hover:text-red-600 font-bold text-lg">×</button>
                    </div>
                    <div className="flex-1 overflow-hidden relative">
                      {/* PDF Loading Indicator */}
                      <div id="pdf-loading" className="absolute inset-0 flex items-center justify-center bg-white z-10">
                        <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                        <span className="ml-3 text-blue-700">جاري تحميل PDF...</span>
                      </div>
                      {/* PDF Preview Iframe */}
                      <iframe
                        className="pdf-preview-frame"
                        src={previewPdfUrl}
                        style={{ width: '100%', height: '80vh', border: 'none', background: '#f8f9fa' }}
                        onLoad={() => { const el = document.getElementById('pdf-loading'); if (el) el.style.display = 'none'; }}
                      ></iframe>
                    </div>
                    <div className="flex justify-end gap-2 p-4 border-t bg-slate-50">
                      <button
                        className="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg inline-flex items-center transition-colors duration-150"
                        onClick={() => window.open(previewPdfUrl, '_blank')}
                      >
                        <span className="mr-2">👁️</span>
                        فتح في نافذة جديدة
                      </button>
                      <button
                        className="bg-slate-200 hover:bg-slate-300 text-slate-700 px-4 py-2 rounded-lg inline-flex items-center transition-colors duration-150"
                        onClick={() => setShowPreviewModal(false)}
                      >
                        إغلاق
                      </button>
                    </div>
                  </div>
                </div>
              )}
            </div>
          );
        }; // CLOSE CvGeneratorApp function

        // Wait for DOM to be ready
        const startApp = () => {
          try {
            console.log('🚀 Starting React application...');
            const container = document.getElementById('cv-generation-results');
            if (!container) {
              console.error('❌ Could not find root container element!');
              return;
            }

            console.log('📦 Creating React root...');
            const root = ReactDOM.createRoot(container);
            console.log('🎨 Rendering app...');

            root.render(
              <ErrorBoundary>
                <DebugWrapper>
                  <React.StrictMode>
                    <CvGeneratorApp />
                  </React.StrictMode>
                </DebugWrapper>
              </ErrorBoundary>
            );

            console.log('✅ React app mounted successfully');
          } catch (error) {
            console.error('🔴 Error starting React app:', error);
          }
        };

        // Initialize the app when the document is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', startApp);
        } else {
          startApp();
        }
      </script>
      <script>
        // Initialize Lucide icons
        document.addEventListener('DOMContentLoaded', () => {
          if (typeof lucide !== 'undefined') {
            lucide.createIcons({
              attrs: { 'stroke-width': 1.5 }
            });
          }
        });
      </script>
    </body>
  </html>
<% end %>

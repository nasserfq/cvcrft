<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>منشئ السيرة الذاتية بالذكاء الاصطناعي — CV•AI</title>
    <meta name="description" content="أنشئ سيرة ذاتية احترافية خلال دقائق باستخدام الذكاء الاصطناعي. قوالب حديثة، تحسين تلقائي للنقاط، وتصدير PDF بجودة عالية." />
    <meta name="theme-color" content="#10b981" />
    <meta name="csrf-token" content="<%= form_authenticity_token %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
      .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
    </style>
  </head>
  <body class="antialiased bg-gradient-to-b from-white via-emerald-50 to-white text-slate-900 font-sans" style="font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;">
    <!-- Background Accents -->
    <div class="pointer-events-none fixed inset-0 -z-10">
      <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-emerald-400/20 blur-3xl"></div>
      <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-emerald-300/20 blur-3xl"></div>
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[38rem] h-[38rem] bg-gradient-to-b from-emerald-200/30 to-transparent rounded-full blur-3xl"></div>
    </div>
    <!-- Flash Messages -->
    <% if flash[:notice] %>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4">
        <div class="rounded-lg bg-emerald-50 border border-emerald-200 p-4">
          <div class="flex items-center gap-3">
            <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600"></i>
            <p class="text-sm text-emerald-800"><%= flash[:notice] %></p>
          </div>
        </div>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-4">
        <div class="rounded-lg bg-red-50 border border-red-200 p-4">
          <div class="flex items-center gap-3">
            <i data-lucide="alert-circle" class="w-5 h-5 text-red-600"></i>
            <p class="text-sm text-red-800"><%= flash[:alert] %></p>
          </div>
        </div>
      </div>
    <% end %>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <!-- Header -->
      <div class="mb-8">
        <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100 text-emerald-700 px-3 py-1 text-xs ring-1 ring-emerald-500/20 mb-4">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
          <span>منشئ السيرة الذاتية بالذكاء الاصطناعي</span>
        </div>
        <h1 class="text-3xl font-bold text-slate-900 mb-2">أنشئ سيرة ذاتية احترافية</h1>
        <p class="text-slate-600">استخدم الذكاء الاصطناعي لإنشاء ملخص مهني مخصص بناءً على وصف الوظيفة</p>
      </div>
      <!-- React Component Container -->
      <div id="cv-generation-results">
        <!-- React component will render here -->
      </div>
    </div>
    <!-- React Libraries -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script type="text/babel">
      const { useState, useEffect } = React;

      function CvGeneratorApp() {
        // Form state
        const [jobDescription, setJobDescription] = useState('');
        const [selectedResumeId, setSelectedResumeId] = useState('');
        const [isGenerating, setIsGenerating] = useState(false);

        // Results state
        const [cvData, setCvData] = useState(null);
        const [error, setError] = useState(null);
        const [showPdfModal, setShowPdfModal] = useState(false);
        const [showResults, setShowResults] = useState(false);
        const [resumes, setResumes] = useState([]);

        // Load resumes and their CV generations on component mount
        useEffect(() => {
          const loadResumesWithGenerations = async () => {
            try {
              // Load resumes
              const resumesResponse = await fetch('/resumes.json');
              const resumesData = await resumesResponse.json();

              // Load CV generations for each resume
              const resumesWithGenerations = await Promise.all(
                resumesData.map(async (resume) => {
                  try {
                    const cvResponse = await fetch(`/cv_generations.json?resume_id=${resume.id}`);
                    const cvData = await cvResponse.json();
                    const latestCv = cvData.find(cv => cv.resume_id === resume.id && cv.status === 'completed');

                    return {
                      ...resume,
                      latest_cv_generation: latestCv,
                      last_generated: latestCv ? new Date(latestCv.created_at) : null
                    };
                  } catch (err) {
                    console.error(`Error loading CV for resume ${resume.id}:`, err);
                    return {
                      ...resume,
                      latest_cv_generation: null,
                      last_generated: null
                    };
                  }
                })
              );

              setResumes(resumesWithGenerations);
            } catch (err) {
              console.error('Error loading resumes:', err);
            }
          };

          loadResumesWithGenerations();
        }, []);

        // Check for CV generation ID in URL on page load (for direct links)
        useEffect(() => {
          const urlParams = new URLSearchParams(window.location.search);
          const cvGenerationId = urlParams.get('cv_generation_id');

          if (cvGenerationId) {
            console.log('🔍 Found CV Generation ID in URL:', cvGenerationId);
            setShowResults(true);
            setIsGenerating(true);

            // Load existing CV data if it's already completed
            const loadExistingCv = async () => {
              try {
                const response = await fetch(`/cv_generations/${cvGenerationId}.json`);
                const data = await response.json();

                if (data && data.status === 'completed') {
                  console.log('✅ CV already completed, loading data');
                  setCvData(data);
                  setIsGenerating(false);

                  if (data.metadata?.pdf_generated === true || data.metadata?.pdf_generated === 'true') {
                    setShowPdfModal(true);
                  }
                } else if (data && data.status === 'processing') {
                  // Start polling for completion
                  let pollAttempts = 0;
                  const maxPollAttempts = 30;

                  const pollForResults = async () => {
                    try {
                      const pollResponse = await fetch(`/cv_generations/${cvGenerationId}.json`);
                      const pollData = await pollResponse.json();

                      if (pollData && pollData.status === 'completed') {
                        console.log('✅ CV generation completed!');
                        setCvData(pollData);
                        setIsGenerating(false);

                        if (pollData.metadata?.pdf_generated === true || pollData.metadata?.pdf_generated === 'true') {
                          setShowPdfModal(true);
                        }
                      } else if (pollData && pollData.status === 'failed') {
                        setError('CV generation failed');
                        setIsGenerating(false);
                      } else {
                        pollAttempts++;
                        if (pollAttempts < maxPollAttempts) {
                          setTimeout(pollForResults, 2000);
                        } else {
                          setError('CV generation is taking too long');
                          setIsGenerating(false);
                        }
                      }
                    } catch (err) {
                      console.error('❌ Error polling for results:', err);
                      setError('Error checking generation status');
                      setIsGenerating(false);
                    }
                  };

                  pollForResults();
                }
              } catch (err) {
                console.error('❌ Error loading CV data:', err);
                setError('Error loading CV data');
                setIsGenerating(false);
              }
            };

            loadExistingCv();
          }
        }, []);

        // Auto-show PDF modal when CV data is loaded with PDF
        useEffect(() => {
          if (cvData && !isGenerating && (cvData.metadata?.pdf_generated === true || cvData.metadata?.pdf_generated === 'true')) {
            console.log('🔄 Auto-showing PDF modal for loaded CV data');
            setShowPdfModal(true);
          }
        }, [cvData, isGenerating]);

        // Download PDF function
        const downloadPdf = async () => {
          if (!cvData || !cvData.id) {
            console.error('No CV data available for download');
            return;
          }

          try {
            const response = await fetch(`/cv_generations/${cvData.id}/view_pdf`);
            if (response.ok) {
              const blob = await response.blob();
              const url = window.URL.createObjectURL(blob);
              const link = document.createElement('a');
              link.href = url;
              link.download = `cv_${cvData.id}_${new Date().toISOString().split('T')[0]}.pdf`;
              document.body.appendChild(link);
              link.click();
              document.body.removeChild(link);
              window.URL.revokeObjectURL(url);
              console.log('✅ PDF downloaded successfully');
            } else {
              console.error('❌ Failed to download PDF:', response.status);
              alert('فشل في تحميل الملف. يرجى المحاولة مرة أخرى.');
            }
          } catch (error) {
            console.error('❌ Error downloading PDF:', error);
            alert('حدث خطأ أثناء تحميل الملف. يرجى المحاولة مرة أخرى.');
          }
        };

        // Handle form submission - Pure React approach without page refresh
        const handleSubmit = async (e) => {
          e.preventDefault();

          if (!selectedResumeId || !jobDescription.trim()) {
            alert('Please select a resume and enter a job description');
            return;
          }

          setIsGenerating(true);
          setError(null);
          setShowResults(true);

          try {
            // Use fetch to submit the form data
            const formData = new URLSearchParams();
            formData.append('cv_generation[job_description]', jobDescription.trim());
            formData.append('cv_generation[resume_id]', selectedResumeId);
            formData.append('cv_generation[temperature]', '0.7');
            formData.append('cv_generation[max_tokens]', '15000');
            formData.append('cv_generation[complete_name]', '');
            formData.append('cv_generation[email]', '');

            const response = await fetch('/cv_generations', {
              method: 'POST',
              body: formData,
              headers: {
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
              }
            });

            if (response.ok) {
              const result = await response.json();
              console.log('✅ Form submitted successfully:', result);

              if (result.cv_generation_id) {
                // Start polling for this specific CV generation
                const cvGenerationId = result.cv_generation_id;
                console.log('🔍 Starting to poll for CV ID:', cvGenerationId);

                // Poll for results
                let pollAttempts = 0;
                const maxPollAttempts = 30;

                const pollForResults = async () => {
                  try {
                    const pollResponse = await fetch(`/cv_generations/${cvGenerationId}.json`);
                    const data = await pollResponse.json();

                    if (data && data.status === 'completed') {
                      console.log('✅ CV generation completed!');
                      console.log('📊 CV Data:', data);
                      console.log('📄 PDF Generated:', data.metadata?.pdf_generated);
                      console.log('📄 PDF Generated Type:', typeof data.metadata?.pdf_generated);
                      console.log('📄 Has PDF Data:', !!data.metadata?.pdf_data);
                      setCvData(data);
                      setIsGenerating(false);

                      // Show PDF modal immediately if PDF is generated
                      const pdfGenerated = data.metadata?.pdf_generated;
                      console.log('📄 PDF Generated Value:', pdfGenerated);
                      console.log('📄 PDF Generated Type:', typeof pdfGenerated);

                      if (pdfGenerated === true || pdfGenerated === 'true' || pdfGenerated === 1) {
                        console.log('📄 PDF generated, showing modal immediately');
                        setShowPdfModal(true);
                      } else {
                        console.log('❌ PDF not generated for this CV');
                        console.log('📄 PDF Error:', data.metadata?.pdf_error);
                      }
                    } else if (data && data.status === 'failed') {
                      console.log('❌ CV generation failed');
                      setError('CV generation failed');
                      setIsGenerating(false);
                    } else {
                      pollAttempts++;
                      if (pollAttempts < maxPollAttempts) {
                        setTimeout(pollForResults, 2000);
                      } else {
                        setError('CV generation is taking too long');
                        setIsGenerating(false);
                      }
                    }
                  } catch (err) {
                    console.error('❌ Error polling for results:', err);
                    setError('Error checking generation status');
                    setIsGenerating(false);
                  }
                };

                // Start polling immediately
                pollForResults();
              }
            } else {
              const errorText = await response.text();
              console.error('❌ Form submission failed:', response.status, errorText);
              setError(`Failed to submit CV generation request (Status: ${response.status})`);
              setIsGenerating(false);
            }
          } catch (err) {
            console.error('❌ Error submitting form:', err);
            setError('Error submitting form: ' + err.message);
            setIsGenerating(false);
          }
        };

        return (
          <div>
            {/* Job Description Section */}
            <div className="mb-8">
              <label className="block text-sm font-medium text-slate-700 mb-2">
                وصف الوظيفة
              </label>
              <textarea
                value={jobDescription}
                onChange={(e) => setJobDescription(e.target.value)}
                placeholder="أدخل وصف الوظيفة التي تريد التقدم إليها..."
                className="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 resize-none"
                rows="4"
              />
            </div>

            {/* Resume Selection */}
            <div className="mb-8">
              <label className="block text-sm font-medium text-slate-700 mb-2">
                اختيار السيرة الذاتية
              </label>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {resumes.map((resume) => (
                  <div
                    key={resume.id}
                    className={`p-4 border rounded-lg cursor-pointer transition-all ${
                      selectedResumeId === resume.id.toString()
                        ? 'border-emerald-500 bg-emerald-50'
                        : 'border-slate-200 hover:border-slate-300'
                    }`}
                    onClick={() => setSelectedResumeId(resume.id.toString())}
                  >
                    {/* Header */}
                    <div className="mb-3">
                      <h3 className="font-medium text-slate-900 mb-1">{resume.complete_name}</h3>
                      <p className="text-sm text-slate-600">{resume.email}</p>
                    </div>

                    {/* Professional Summary Preview */}
                    {(resume.professional_summary_english || resume.professional_summary) && (
                      <div className="mb-3">
                        <p className="text-xs text-slate-500 font-medium mb-1">الملخص المهني:</p>
                        <p className="text-xs text-slate-700 line-clamp-3 leading-relaxed">
                          {(resume.professional_summary_english || resume.professional_summary)?.substring(0, 120)}
                          {(resume.professional_summary_english || resume.professional_summary)?.length > 120 ? '...' : ''}
                        </p>
                      </div>
                    )}

                    {/* CV Generation Info */}
                    {resume.latest_cv_generation && (
                      <div className="mb-3 p-2 bg-slate-50 rounded border">
                        <div className="flex items-center justify-between mb-1">
                          <span className="text-xs font-medium text-slate-700">آخر إنشاء:</span>
                          <span className="text-xs text-slate-600">
                            {resume.last_generated ? resume.last_generated.toLocaleDateString('ar-SA') : 'غير محدد'}
                          </span>
                        </div>
                        <div className="flex items-center gap-2">
                          <div className="flex items-center gap-1">
                            <div className="w-2 h-2 bg-emerald-500 rounded-full"></div>
                            <span className="text-xs text-emerald-700">PDF متوفر</span>
                          </div>
                          {resume.latest_cv_generation.metadata?.pdf_size && (
                            <span className="text-xs text-slate-500">
                              {(resume.latest_cv_generation.metadata.pdf_size / 1024).toFixed(1)} KB
                            </span>
                          )}
                        </div>
                      </div>
                    )}

                    {/* Contact Info */}
                    <div className="text-xs text-slate-500">
                      {resume.phone_number && <div>📞 {resume.phone_number}</div>}
                      {resume.city && resume.country && <div>📍 {resume.city}, {resume.country}</div>}
                    </div>

                    {/* Selection Indicator */}
                    {selectedResumeId === resume.id.toString() && (
                      <div className="mt-3 flex items-center justify-center">
                        <div className="flex items-center gap-2 text-emerald-600">
                          <i data-lucide="check-circle" className="w-4 h-4"></i>
                          <span className="text-sm font-medium">محدد</span>
                        </div>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>

            {/* Generate Button */}
            <div className="mb-8">
              <button
                type="button"
                onClick={handleSubmit}
                disabled={isGenerating || !selectedResumeId || !jobDescription.trim()}
                className="w-full bg-emerald-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-emerald-700 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {isGenerating ? 'جاري الإنشاء...' : 'إنشاء السيرة الذاتية'}
              </button>
            </div>

            {/* Results Section */}
            {showResults && (
              <div className="mt-8">
                {isGenerating && (
                  <div className="text-center py-8">
                    <div className="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-emerald-600"></div>
                    <p className="mt-4 text-slate-600">جاري إنشاء السيرة الذاتية...</p>
                    <p className="text-sm text-slate-500">يرجى الانتظار بينما نقوم بإنشاء سيرتك الذاتية...</p>
                  </div>
                )}

                {error && (
                  <div className="bg-red-50 border border-red-200 rounded-lg p-4">
                    <p className="text-red-800">{error}</p>
                  </div>
                )}

                {cvData && !isGenerating && (
                  <div className="bg-white border border-slate-200 rounded-lg p-6">
                    <div className="flex items-center justify-between mb-4">
                      <h3 className="text-lg font-semibold text-slate-900">تم إنشاء السيرة الذاتية بنجاح!</h3>
                      <div className="flex items-center gap-2 text-emerald-600">
                        <i data-lucide="file-text" className="w-5 h-5"></i>
                        <span className="text-sm font-medium">PDF جاهز</span>
                      </div>
                    </div>

                    <div className="mb-4">
                      <h4 className="font-medium text-slate-700 mb-2">الملخص المهني الجديد:</h4>
                      <p className="text-slate-600 leading-relaxed">{cvData.generated_content}</p>

                    </div>


                    {/* Show PDF buttons only if PDF was generated */}
                    {(cvData.metadata?.pdf_generated === true || cvData.metadata?.pdf_generated === 'true' || cvData.metadata?.pdf_generated === 1) ? (
                      <div className="flex gap-3">
                        <button
                          onClick={() => setShowPdfModal(true)}
                          className="bg-emerald-600 text-white px-4 py-2 rounded-lg hover:bg-emerald-700 flex items-center gap-2"
                        >
                          <i data-lucide="eye" className="w-4 h-4"></i>
                          معاينة PDF
                        </button>
                        <button
                          onClick={downloadPdf}
                          className="bg-slate-600 text-white px-4 py-2 rounded-lg hover:bg-slate-700 flex items-center gap-2"
                        >
                          <i data-lucide="download" className="w-4 h-4"></i>
                          تحميل PDF
                        </button>
                      </div>
                    ) : (
                      <div className="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                        <div className="flex items-center gap-2 text-yellow-800">
                          <i data-lucide="alert-circle" className="w-5 h-5"></i>
                          <span className="font-medium">PDF غير متوفر</span>
                        </div>
                        <p className="text-sm text-yellow-700 mt-1">
                          لم يتم إنشاء PDF لهذه السيرة الذاتية. يرجى المحاولة مرة أخرى.
                        </p>
                        {cvData.metadata?.pdf_error && (
                          <p className="text-xs text-yellow-600 mt-2">
                            خطأ: {cvData.metadata.pdf_error}
                          </p>
                        )}
                      </div>
                    )}
                  </div>
                )}
              </div>
            )}

            {/* PDF Modal */}
            {showPdfModal && cvData && (
              <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                <div className="bg-white rounded-lg max-w-4xl max-h-[90vh] w-full mx-4">
                  <div className="flex justify-between items-center p-4 border-b">
                    <h3 className="text-lg font-semibold">معاينة السيرة الذاتية</h3>
                    <button
                      onClick={() => setShowPdfModal(false)}
                      className="text-slate-500 hover:text-slate-700"
                    >
                      ✕
                    </button>
                  </div>
                  <div className="p-4">
                    <iframe
                      src={`/cv_generations/${cvData.id}/view_pdf`}
                      className="w-full h-[70vh] border-0"
                    />
                  </div>
                </div>
              </div>
            )}
          </div>
        );
      }

      // Render the component
      const root = ReactDOM.createRoot(document.getElementById('cv-generation-results'));
      root.render(<CvGeneratorApp />);
    </script>
    <script>
      // Initialize Lucide icons
      if (typeof lucide !== 'undefined') {
        lucide.createIcons({
          attrs: { 'stroke-width': 1.5 }
        });
      }
    </script>
  </body>
</html>

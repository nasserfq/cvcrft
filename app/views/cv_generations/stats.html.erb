<div class="container mx-auto px-4 py-8">
  <div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-900">CV Generation Statistics</h1>
      <%= link_to "Back to CV Generations", cv_generations_path, 
          class: "bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded-lg transition duration-200" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total Generations -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-blue-100 text-blue-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Total Generations</p>
            <p class="text-2xl font-semibold text-gray-900"><%= @stats[:total_generations] %></p>
          </div>
        </div>
      </div>

      <!-- Completed -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-green-100 text-green-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Completed</p>
            <p class="text-2xl font-semibold text-gray-900"><%= @stats[:completed] %></p>
          </div>
        </div>
      </div>

      <!-- Failed -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-red-100 text-red-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Failed</p>
            <p class="text-2xl font-semibold text-gray-900"><%= @stats[:failed] %></p>
          </div>
        </div>
      </div>

      <!-- Processing -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center">
          <div class="p-3 rounded-full bg-yellow-100 text-yellow-600">
            <svg class="w-6 h-6 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-600">Processing</p>
            <p class="text-2xl font-semibold text-gray-900"><%= @stats[:processing] %></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Tokens Usage -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-8">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Token Usage</h2>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-600">Total Tokens Used</p>
          <p class="text-3xl font-bold text-gray-900"><%= number_with_delimiter(@stats[:total_tokens_used]) %></p>
        </div>
        <div class="text-right">
          <p class="text-sm text-gray-600">Average per Generation</p>
          <p class="text-lg font-semibold text-gray-900">
            <%= @stats[:total_generations] > 0 ? number_with_delimiter(@stats[:total_tokens_used] / @stats[:total_generations]) : 0 %>
          </p>
        </div>
      </div>
    </div>

    <!-- Success Rate -->
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Success Rate</h2>
      <div class="flex items-center">
        <div class="flex-1">
          <div class="bg-gray-200 rounded-full h-4">
            <% success_rate = @stats[:total_generations] > 0 ? (@stats[:completed].to_f / @stats[:total_generations] * 100).round(1) : 0 %>
            <div class="bg-green-500 h-4 rounded-full" style="width: <%= success_rate %>%"></div>
          </div>
        </div>
        <div class="ml-4">
          <p class="text-2xl font-bold text-gray-900"><%= success_rate %>%</p>
          <p class="text-sm text-gray-600">Success Rate</p>
        </div>
      </div>
    </div>
  </div>
</div>

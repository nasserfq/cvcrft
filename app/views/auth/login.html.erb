<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= text_direction %>" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('auth.page_title') %> — <%= t('site.name') %></title>
    <meta name="description" content="<%= t('auth.page_description') %>" />
    <meta name="theme-color" content="#7B2FF7" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render 'shared/posthog' %>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>

    <style>
        body {
            font-feature-settings: "ss01", "ss02";
            -webkit-font-smoothing: antialiased;
        }
        .blob {
            position: absolute;
            filter: blur(90px);
            opacity: 0.5;
            z-index: -1;
            animation: pulse 10s infinite alternate;
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            100% { transform: scale(1.1); }
        }
        .gradient-text {
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            background-image: linear-gradient(135deg, #7B2FF7 0%, #2EF2A3 100%);
        }
        iconify-icon {
            display: inline-block;
            vertical-align: middle;
        }
    </style>
</head>
<body class="bg-canvas text-darkBase transition-colors duration-300 selection:bg-action selection:text-darkBase dark:bg-darkBase dark:text-canvas overflow-x-hidden">

    <!-- Background Blobs -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
        <div class="blob bg-primary/5 dark:bg-primary/20 w-64 h-64 md:w-96 md:h-96 rounded-full top-[-10%] left-[-10%]"></div>
        <div class="blob bg-action/5 dark:bg-action/10 w-64 h-64 md:w-[500px] md:h-[500px] rounded-full bottom-[-10%] right-[-10%] animation-delay-2000"></div>
    </div>

    <!-- Navigation -->
    <nav class="fixed top-0 w-full z-50 border-b border-borderLight bg-white/80 backdrop-blur-xl dark:bg-darkBase/80 dark:border-borderDark">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 md:h-20 flex items-center justify-between">
            <!-- Logo -->
            <div class="flex items-center gap-2 z-50">
                <a href="/" class="text-xl md:text-2xl font-medium tracking-tight text-darkBase dark:text-white flex items-center gap-2">
                    <span class="bg-primary text-white w-7 h-7 md:w-8 md:h-8 rounded-lg flex items-center justify-center text-sm font-semibold shadow-glow">س</span>
                    سيرة
                </a>
            </div>

            <!-- Desktop Menu -->
            <div class="hidden md:flex items-center gap-8 text-sm font-normal text-gray-500 dark:text-gray-400">
                <a href="/#features" class="hover:text-primary transition-colors"><%= t('nav.features') %></a>
                <a href="/#how-it-works" class="hover:text-primary transition-colors"><%= t('nav.how_it_works') %></a>
                <a href="/#templates" class="hover:text-primary transition-colors"><%= t('nav.templates') %></a>
            </div>

            <!-- Actions -->
            <div class="hidden md:flex items-center gap-4">
                <button id="themeToggle" onclick="var h=document.documentElement; if(h.classList.contains('dark')){h.classList.remove('dark');localStorage.theme='light';}else{h.classList.add('dark');localStorage.theme='dark';}" class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-gray-500 dark:text-gray-400">
                    <iconify-icon icon="solar:sun-2-linear" width="24" height="24" class="hidden dark:block pointer-events-none"></iconify-icon>
                    <iconify-icon icon="solar:moon-linear" width="24" height="24" class="block dark:hidden pointer-events-none"></iconify-icon>
                </button>
                
                <span class="flex items-center gap-2 text-sm text-primary dark:text-action">
                    <iconify-icon icon="solar:login-2-linear" width="20"></iconify-icon>
                    <span><%= t('nav.login') %></span>
                </span>
            </div>

            <!-- Mobile Actions -->
            <div class="flex md:hidden items-center gap-4 z-50">
                <button id="themeToggleMobile" onclick="var h=document.documentElement; if(h.classList.contains('dark')){h.classList.remove('dark');localStorage.theme='light';}else{h.classList.add('dark');localStorage.theme='dark';}" class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-gray-500 dark:text-gray-400">
                    <iconify-icon icon="solar:sun-2-linear" width="22" height="22" class="hidden dark:block pointer-events-none"></iconify-icon>
                    <iconify-icon icon="solar:moon-linear" width="22" height="22" class="block dark:hidden pointer-events-none"></iconify-icon>
                </button>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 pt-28">
      <div class="max-w-md w-full space-y-8">
        <!-- Header -->
        <div class="text-center">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-primary/20 bg-primary/5 dark:bg-primary/10 mb-4 backdrop-blur-md">
            <iconify-icon icon="solar:shield-check-linear" width="16" class="text-action"></iconify-icon>
            <span class="text-primary dark:text-action text-xs md:text-sm font-normal"><%= t('auth.secure_login') %></span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-medium tracking-tight text-darkBase dark:text-white">
            <%= t('auth.welcome') %> <span class="gradient-text"><%= t('site.name') %></span>
          </h1>
          <p class="mt-2 text-gray-600 dark:text-gray-400 leading-7">
            <%= t('auth.otp_instruction') %>
          </p>
        </div>

        <!-- Flash Messages -->
        <% if flash[:notice] && params[:otp_sent] != 'true' %>
          <div class="rounded-xl bg-action/10 border border-action/30 p-4 backdrop-blur-xl">
            <div class="flex items-center gap-3">
              <iconify-icon icon="solar:check-circle-linear" width="20" class="text-action"></iconify-icon>
              <p class="text-sm text-darkBase dark:text-white"><%= flash[:notice] %></p>
            </div>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="rounded-xl bg-red-500/10 border border-red-500/30 p-4 backdrop-blur-xl">
            <div class="flex items-center gap-3">
              <iconify-icon icon="solar:danger-circle-linear" width="20" class="text-red-500"></iconify-icon>
              <p class="text-sm text-darkBase dark:text-white"><%= flash[:alert] %></p>
            </div>
          </div>
        <% end %>

        <!-- Email Form -->
        <% unless params[:otp_sent] == 'true' %>
          <div class="bg-white/60 dark:bg-[#1C1C21]/60 backdrop-blur-xl rounded-2xl p-6 md:p-8 shadow-xl border border-borderLight dark:border-borderDark">
            <form class="space-y-6" action="/auth/send_otp" method="post">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :return_to, params[:return_to] %>
              <div>
                <label for="email" class="block text-sm font-medium text-darkBase dark:text-white mb-2"><%= t('auth.email') %></label>
                <input 
                  id="email" 
                  name="email" 
                  type="email" 
                  autocomplete="email" 
                  required 
                  class="w-full rounded-xl border border-borderLight dark:border-borderDark bg-white/70 dark:bg-white/5 px-4 py-3.5 text-sm text-darkBase dark:text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" 
                  placeholder="<%= t('auth.email_placeholder') %>"
                />
              </div>
              <button 
                type="submit" 
                class="btn-loading w-full inline-flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primaryHover text-white text-sm font-medium px-4 py-3.5 shadow-glow hover:shadow-lg transition-all"
              >
                <iconify-icon icon="solar:letter-linear" width="18" class="btn-icon"></iconify-icon>
                <svg class="btn-spinner hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <span class="btn-text"><%= t('auth.send_code') %></span>
              </button>
            </form>
          </div>
        <% end %>

        <!-- OTP Form -->
        <% if params[:otp_sent] == 'true' %>
          <div class="bg-white/60 dark:bg-[#1C1C21]/60 backdrop-blur-xl rounded-2xl p-6 md:p-8 shadow-xl border border-borderLight dark:border-borderDark">
            <form class="space-y-6" action="/auth/verify_otp" method="post">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :email, params[:email] %>
              <%= hidden_field_tag :return_to, params[:return_to] %>
              
              <!-- Success Message -->
              <div class="rounded-xl bg-action/10 border border-action/30 p-4">
                <div class="flex items-center gap-3">
                  <iconify-icon icon="solar:letter-linear" width="20" class="text-action"></iconify-icon>
                  <div>
                    <p class="text-sm font-medium text-darkBase dark:text-white"><%= t('auth.code_sent') %></p>
                    <p class="text-xs text-gray-500 dark:text-gray-400"><%= t('auth.code_sent_to', email: params[:email]) %></p>
                  </div>
                </div>
              </div>

              <div>
                <label for="otp_code" class="block text-sm font-medium text-darkBase dark:text-white mb-2"><%= t('auth.verification_code') %></label>
                <input 
                  id="otp_code" 
                  name="otp_code" 
                  type="text" 
                  maxlength="6" 
                  required 
                  class="w-full rounded-xl border border-borderLight dark:border-borderDark bg-white/70 dark:bg-white/5 px-4 py-3.5 text-center text-2xl tracking-widest text-darkBase dark:text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" 
                  placeholder="000000"
                />
              </div>
              
              <button 
                type="submit" 
                class="btn-loading w-full inline-flex items-center justify-center gap-2 rounded-xl bg-action hover:bg-actionHover text-darkBase text-sm font-medium px-4 py-3.5 shadow-glow-mint hover:shadow-lg transition-all"
              >
                <iconify-icon icon="solar:login-2-linear" width="18" class="btn-icon"></iconify-icon>
                <svg class="btn-spinner hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <span class="btn-text"><%= t('auth.login_title') %></span>
              </button>
            </form>
          </div>
        <% end %>

        <!-- Footer -->
        <div class="text-center">
          <p class="text-xs text-gray-500 dark:text-gray-400">
            <%= t('auth.terms_agreement') %>
            <a href="#" class="text-primary hover:text-primaryHover dark:text-action transition-colors"><%= t('auth.terms_of_service') %></a>
            <%= t('auth.and') %>
            <a href="<%= privacy_path %>" class="text-primary hover:text-primaryHover dark:text-action transition-colors"><%= t('auth.privacy_policy') %></a>
          </p>
        </div>
      </div>
    </div>

    <!-- Site Footer -->
    <footer class="border-t border-borderLight dark:border-borderDark bg-gray-50 dark:bg-darkBase pt-8 pb-6 px-4 sm:px-6">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4 md:gap-6">
        <div class="flex items-center gap-3">
          <span class="bg-primary text-white w-6 h-6 rounded flex items-center justify-center text-xs font-bold">س</span>
          <span class="font-medium text-lg text-darkBase dark:text-white">سيرة</span>
        </div>
        
        <div class="flex flex-wrap justify-center gap-4 md:gap-6 text-sm text-gray-500">
          <a href="<%= terms_path %>" class="hover:text-primary transition-colors"><%= t('footer.terms') %></a>
          <a href="<%= privacy_path %>" class="hover:text-primary transition-colors"><%= t('footer.privacy') %></a>
          <a href="mailto:support@cvcrft.com" class="hover:text-primary transition-colors"><%= t('footer.contact') %></a>
        </div>

        <div class="text-xs text-gray-500">
          © <%= Time.current.year %> سيرة. <%= t('footer.copyright') %>
        </div>
      </div>
    </footer>

    <script>
        // Theme Logic
        const html = document.documentElement;

        // Initialize Theme
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            html.classList.add('dark');
        } else {
            html.classList.remove('dark');
        }

        // Button loading animation
        document.addEventListener('DOMContentLoaded', () => {
            // Reset button loading state on page load
            document.querySelectorAll('.btn-loading').forEach(btn => {
                btn.disabled = false;
                const icon = btn.querySelector('.btn-icon');
                const spinner = btn.querySelector('.btn-spinner');
                if (icon) icon.style.display = '';
                if (spinner) spinner.classList.add('hidden');
            });

            // Handle form submission
            document.querySelectorAll('.btn-loading').forEach(btn => {
                const originalText = btn.querySelector('.btn-text')?.textContent;
                btn.dataset.originalText = originalText;
                
                const form = btn.closest('form');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        setTimeout(() => {
                            btn.classList.add('opacity-75');
                            
                            const icon = btn.querySelector('.btn-icon');
                            const spinner = btn.querySelector('.btn-spinner');
                            
                            if (icon) icon.style.display = 'none';
                            if (spinner) spinner.classList.remove('hidden');
                        }, 0);
                    });
                }
            });
        });

        // Reset on pageshow (back/forward navigation)
        window.addEventListener('pageshow', () => {
            document.querySelectorAll('.btn-loading').forEach(btn => {
                btn.disabled = false;
                btn.classList.remove('opacity-75');
                const icon = btn.querySelector('.btn-icon');
                const spinner = btn.querySelector('.btn-spinner');
                const text = btn.querySelector('.btn-text');
                if (icon) icon.style.display = '';
                if (spinner) spinner.classList.add('hidden');
                if (text && btn.dataset.originalText) text.textContent = btn.dataset.originalText;
            });
        });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>تسجيل الدخول — CV•AI</title>
    <meta name="description" content="سجل دخولك إلى منشئ السيرة الذاتية بالذكاء الاصطناعي" />
    <meta name="theme-color" content="#10b981" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="antialiased bg-gradient-to-b from-white via-emerald-50 to-white text-slate-900 font-sans" style="font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;">
    <!-- Background Accents -->
    <div class="pointer-events-none fixed inset-0 -z-10">
      <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-emerald-400/20 blur-3xl"></div>
      <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-emerald-300/20 blur-3xl"></div>
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[38rem] h-[38rem] bg-gradient-to-b from-emerald-200/30 to-transparent rounded-full blur-3xl"></div>
    </div>


    <!-- Main Content -->
    <div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-md w-full space-y-8">
        <!-- Header -->
        <div class="text-center">
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-100 text-emerald-700 px-3 py-1 text-xs ring-1 ring-emerald-500/20 mb-4">
            <i data-lucide="shield-check" class="w-4 h-4"></i>
            <span>تسجيل دخول آمن</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-slate-900">
            مرحباً بك في CV•AI
          </h1>
          <p class="mt-2 text-slate-600 leading-7">
            أدخل بريدك الإلكتروني للحصول على رمز التحقق
          </p>
        </div>

        <!-- Flash Messages -->
        <% if flash[:notice] %>
          <div class="rounded-lg bg-emerald-50 border border-emerald-200 p-4">
            <div class="flex items-center gap-3">
              <i data-lucide="check-circle" class="w-5 h-5 text-emerald-600"></i>
              <p class="text-sm text-emerald-800"><%= flash[:notice] %></p>
            </div>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="rounded-lg bg-red-50 border border-red-200 p-4">
            <div class="flex items-center gap-3">
              <i data-lucide="alert-circle" class="w-5 h-5 text-red-600"></i>
              <p class="text-sm text-red-800"><%= flash[:alert] %></p>
            </div>
          </div>
        <% end %>

        <!-- Email Form -->
        <% unless params[:otp_sent] == 'true' %>
          <div class="rounded-xl bg-white/80 backdrop-blur-xl ring-1 ring-slate-200/80 shadow-sm p-6">
            <form class="space-y-6" action="/auth/send_otp" method="post">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :return_to, params[:return_to] %>
              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-2">البريد الإلكتروني</label>
                <input 
                  id="email" 
                  name="email" 
                  type="email" 
                  autocomplete="email" 
                  required 
                  class="w-full rounded-lg border border-slate-300/70 bg-white/70 px-3 py-3 text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-400 ring-1 ring-black/5" 
                  placeholder="أدخل بريدك الإلكتروني"
                />
              </div>
              <button 
                type="submit" 
                class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 text-white text-sm font-medium px-4 py-3 ring-1 ring-black/5 hover:bg-emerald-700 transition-colors"
              >
                <i data-lucide="mail" class="w-4 h-4"></i>
                إرسال رمز التحقق
              </button>
            </form>
          </div>
        <% end %>

        <!-- OTP Form -->
        <% if params[:otp_sent] == 'true' %>
          <div class="rounded-xl bg-white/80 backdrop-blur-xl ring-1 ring-slate-200/80 shadow-sm p-6">
            <form class="space-y-6" action="/auth/verify_otp" method="post">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :email, params[:email] %>
              <%= hidden_field_tag :return_to, params[:return_to] %>
              
              <!-- Success Message -->
              <div class="rounded-lg bg-emerald-50 border border-emerald-200 p-4">
                <div class="flex items-center gap-3">
                  <i data-lucide="mail" class="w-5 h-5 text-emerald-600"></i>
                  <div>
                    <p class="text-sm font-medium text-emerald-800">تم إرسال رمز التحقق</p>
                    <p class="text-xs text-emerald-600">صالح لمدة 10 دقائق</p>
                  </div>
                </div>
              </div>

              <div>
                <label for="otp_code" class="block text-sm font-medium text-slate-700 mb-2">رمز التحقق</label>
                <input 
                  id="otp_code" 
                  name="otp_code" 
                  type="text" 
                  maxlength="6" 
                  required 
                  class="w-full rounded-lg border border-slate-300/70 bg-white/70 px-3 py-3 text-center text-2xl tracking-widest text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-400 ring-1 ring-black/5" 
                  placeholder="000000"
                />
              </div>
              
              <button 
                type="submit" 
                class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-600 text-white text-sm font-medium px-4 py-3 ring-1 ring-black/5 hover:bg-emerald-700 transition-colors"
              >
                <i data-lucide="log-in" class="w-4 h-4"></i>
                تسجيل الدخول
              </button>
            </form>
          </div>
        <% end %>

        <!-- Footer -->
        <div class="text-center">
          <p class="text-xs text-slate-500">
            بالضغط على "تسجيل الدخول" فإنك توافق على 
            <a href="#" class="text-emerald-600 hover:text-emerald-700">شروط الخدمة</a>
            و
            <a href="#" class="text-emerald-600 hover:text-emerald-700">سياسة الخصوصية</a>
          </p>
        </div>
      </div>
    </div>

    <!-- JavaScript for icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') {
          lucide.createIcons({
            attrs: { 'stroke-width': 1.5 }
          });
        }
      });
    </script>
  </body>
</html>

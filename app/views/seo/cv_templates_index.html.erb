<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= text_direction %>" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= I18n.locale == :ar ? 'قوالب السيرة الذاتية حسب المهنة | سيرة' : 'CV Templates by Profession | سيرة' %></title>
  <meta name="description" content="<%= I18n.locale == :ar ? 'اكتشف قوالب السيرة الذاتية المُحسّنة لأنظمة ATS لكل المهن. قوالب احترافية جاهزة للتحميل والتعديل.' : 'Discover ATS-optimized CV templates for all professions. Professional templates ready to download and customize.' %>">
  <meta name="theme-color" content="#7B2FF7">
  <link rel="canonical" href="https://cvcrft.com/cv-templates">
  <link rel="icon" href="/icon.png" type="image/png">
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://cvcrft.com/cv-templates">
  <meta property="og:title" content="<%= I18n.locale == :ar ? 'قوالب السيرة الذاتية حسب المهنة' : 'CV Templates by Profession' %>">
  <meta property="og:description" content="<%= I18n.locale == :ar ? 'قوالب سيرة ذاتية احترافية لكل المهن' : 'Professional CV templates for all professions' %>">
  <meta property="og:image" content="https://cvcrft.com/og-image.png">
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= render 'shared/posthog' %>
  
  <!-- JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "<%= I18n.locale == :ar ? 'قوالب السيرة الذاتية' : 'CV Templates' %>",
    "description": "<%= I18n.locale == :ar ? 'قوالب سيرة ذاتية احترافية لكل المهن' : 'Professional CV templates for all professions' %>",
    "url": "https://cvcrft.com/cv-templates",
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": <%= @job_titles.size %>,
      "itemListElement": [
        <% @job_titles.each_with_index do |job, index| %>
        {
          "@type": "ListItem",
          "position": <%= index + 1 %>,
          "url": "https://cvcrft.com/cv-templates/<%= job['slug'] %>",
          "name": "<%= I18n.locale == :ar ? job['title_ar'] : job['title_en'] %>"
        }<%= index < @job_titles.size - 1 ? ',' : '' %>
        <% end %>
      ]
    }
  }
  </script>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['IBM Plex Sans Arabic', 'sans-serif'] },
          colors: {
            primary: '#7B2FF7',
            primaryHover: '#5A1EDB',
            action: '#2EF2A3',
            actionHover: '#1BCB86',
            darkBase: '#121217',
            darkCard: '#1C1C21',
            canvas: '#FFFFFF',
            borderLight: 'rgba(0,0,0,0.08)',
            borderDark: 'rgba(255,255,255,0.08)',
          },
        }
      }
    }
  </script>
  <style>
    body { font-feature-settings: "ss01", "ss02"; -webkit-font-smoothing: antialiased; }
  </style>
</head>
<body class="antialiased bg-gray-50 dark:bg-darkBase text-gray-900 dark:text-white font-sans min-h-screen">
  <!-- Background -->
  <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-primary/20 blur-[100px]"></div>
    <div class="absolute top-1/3 -right-20 w-80 h-80 rounded-full bg-action/20 blur-[100px]"></div>
  </div>

  <%= render 'layouts/header' %>

  <main class="pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Hero -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 text-primary text-sm font-medium mb-6">
          <iconify-icon icon="solar:document-text-bold" width="16"></iconify-icon>
          <%= I18n.locale == :ar ? '+20 قالب احترافي' : '+20 Professional Templates' %>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <%= I18n.locale == :ar ? 'قوالب السيرة الذاتية' : 'CV Templates' %>
          <span class="bg-gradient-to-l from-primary to-action bg-clip-text text-transparent">
            <%= I18n.locale == :ar ? 'حسب المهنة' : 'by Profession' %>
          </span>
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          <%= I18n.locale == :ar ? 
            'اختر قالب السيرة الذاتية المناسب لمهنتك. جميع القوالب مُحسّنة لأنظمة ATS وجاهزة للاستخدام.' :
            'Choose the right CV template for your profession. All templates are ATS-optimized and ready to use.' %>
        </p>
      </div>

      <!-- Categories -->
      <% @categories.each do |category| %>
        <% category_jobs = @job_titles.select { |j| j['category'] == category['slug'] } %>
        <% next if category_jobs.empty? %>
        
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
            <span class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center">
              <iconify-icon icon="solar:briefcase-bold" class="text-primary" width="20"></iconify-icon>
            </span>
            <%= I18n.locale == :ar ? category['name_ar'] : category['name_en'] %>
          </h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            <% category_jobs.each do |job| %>
              <a href="/cv-templates/<%= job['slug'] %>" 
                 class="group p-5 bg-white dark:bg-white/5 rounded-2xl border border-gray-200 dark:border-white/10 hover:border-primary/50 hover:shadow-lg transition-all">
                <div class="flex items-start justify-between mb-3">
                  <div class="w-12 h-12 bg-gradient-to-br from-primary/20 to-action/20 rounded-xl flex items-center justify-center">
                    <iconify-icon icon="solar:user-id-bold" class="text-primary" width="24"></iconify-icon>
                  </div>
                  <iconify-icon icon="solar:arrow-left-bold" class="text-gray-400 group-hover:text-primary group-hover:-translate-x-1 transition-all" width="20"></iconify-icon>
                </div>
                <h3 class="font-semibold text-lg mb-1 group-hover:text-primary transition-colors">
                  <%= I18n.locale == :ar ? job['title_ar'] : job['title_en'] %>
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">
                  <%= I18n.locale == :ar ? job['description_ar'].truncate(80) : job['description_en'].truncate(80) %>
                </p>
                <div class="mt-3 flex flex-wrap gap-1">
                  <% job['skills'].first(3).each do |skill| %>
                    <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-white/10 rounded-full text-gray-600 dark:text-gray-400"><%= skill %></span>
                  <% end %>
                </div>
              </a>
            <% end %>
          </div>
        </section>
      <% end %>

      <!-- CTA -->
      <div class="mt-16 text-center p-8 bg-gradient-to-br from-primary/10 to-action/10 rounded-3xl border border-primary/20">
        <h2 class="text-2xl font-bold mb-4">
          <%= I18n.locale == :ar ? 'جاهز لإنشاء سيرتك الذاتية؟' : 'Ready to Build Your CV?' %>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-xl mx-auto">
          <%= I18n.locale == :ar ? 
            'استخدم أداة سيرة المدعومة بالذكاء الاصطناعي لإنشاء سيرة ذاتية احترافية في دقائق.' :
            'Use our AI-powered tool to create a professional CV in minutes.' %>
        </p>
        <a href="<%= new_resume_path %>" class="inline-flex items-center gap-2 px-8 py-3 bg-primary hover:bg-primaryHover text-white font-medium rounded-full transition-colors shadow-lg shadow-primary/25">
          <iconify-icon icon="solar:magic-stick-3-bold" width="20"></iconify-icon>
          <%= I18n.locale == :ar ? 'ابدأ الآن مجاناً' : 'Start Free Now' %>
        </a>
      </div>
    </div>
  </main>

  <%= render 'layouts/footer' %>

  <script>
    const html = document.documentElement;
    if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      html.classList.add('dark');
    } else {
      html.classList.remove('dark');
    }
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= text_direction %>" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page_title %></title>
  <meta name="description" content="<%= @meta_description %>">
  <meta name="keywords" content="<%= @keywords %>">
  <meta name="theme-color" content="#07120D">
  <link rel="canonical" href="https://cvcrft.com/cv-templates/<%= @job['slug'] %>">
  <link rel="icon" href="/icon.png?v=7" type="image/png">
  
  <!-- hreflang -->
  <link rel="alternate" hreflang="ar" href="https://cvcrft.com/ar/cv-templates/<%= @job['slug'] %>">
  <link rel="alternate" hreflang="en" href="https://cvcrft.com/en/cv-templates/<%= @job['slug'] %>">
  <link rel="alternate" hreflang="x-default" href="https://cvcrft.com/cv-templates/<%= @job['slug'] %>">
  
  <!-- Open Graph -->
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://cvcrft.com/cv-templates/<%= @job['slug'] %>">
  <meta property="og:title" content="<%= @page_title %>">
  <meta property="og:description" content="<%= @meta_description %>">
  <meta property="og:image" content="https://cvcrft.com/og-image.png?v=7">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @page_title %>">
  <meta name="twitter:description" content="<%= @meta_description %>">
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= render 'shared/posthog' %>
  
  <!-- JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "<%= @page_title %>",
    "description": "<%= @meta_description %>",
    "url": "https://cvcrft.com/cv-templates/<%= @job['slug'] %>",
    "mainEntity": {
      "@type": "HowTo",
      "name": "<%= I18n.locale == :ar ? "كيفية إنشاء سيرة ذاتية لـ #{@job['title_ar']}" : "How to Create a #{@job['title_en']} CV" %>",
      "description": "<%= @meta_description %>",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "<%= I18n.locale == :ar ? 'اختر القالب المناسب' : 'Choose the Right Template' %>",
          "text": "<%= I18n.locale == :ar ? 'اختر قالب سيرة ذاتية مُحسّن لمجال عملك' : 'Select a CV template optimized for your field' %>"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "<%= I18n.locale == :ar ? 'أضف معلوماتك' : 'Add Your Information' %>",
          "text": "<%= I18n.locale == :ar ? 'املأ بياناتك الشخصية وخبراتك' : 'Fill in your personal details and experience' %>"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "<%= I18n.locale == :ar ? 'راجع واطبع' : 'Review and Download' %>",
          "text": "<%= I18n.locale == :ar ? 'راجع سيرتك الذاتية وحملها بصيغة PDF' : 'Review your CV and download it as PDF' %>"
        }
      ],
      "tool": {
        "@type": "SoftwareApplication",
        "name": "سيرة",
        "applicationCategory": "BusinessApplication"
      }
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "<%= I18n.locale == :ar ? 'الرئيسية' : 'Home' %>",
          "item": "https://cvcrft.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "<%= I18n.locale == :ar ? 'قوالب السيرة الذاتية' : 'CV Templates' %>",
          "item": "https://cvcrft.com/cv-templates"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "<%= I18n.locale == :ar ? @job['title_ar'] : @job['title_en'] %>",
          "item": "https://cvcrft.com/cv-templates/<%= @job['slug'] %>"
        }
      ]
    }
  }
  </script>
  
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@300;400;500;600;700;800&family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@300;400;500;600;700;800&family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet"></noscript>
  
  <style>
    body { font-feature-settings: "ss01", "ss02"; -webkit-font-smoothing: antialiased; }
    .prose h2 { @apply text-xl font-bold mt-8 mb-4; }
    .prose h3 { @apply text-lg font-semibold mt-6 mb-3; }
    .prose p { @apply mb-4 leading-relaxed; }
    .prose ul { @apply list-disc list-inside mb-4 space-y-2; }
    .prose li { @apply text-gray-600 dark:text-gray-400; }
  </style>
</head>
<body class="sr-app antialiased bg-gray-50 dark:bg-darkBase text-gray-900 dark:text-white font-sans min-h-screen">
  <!-- Background -->
  <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-primary/20 blur-[100px]"></div>
    <div class="absolute top-1/3 -right-20 w-80 h-80 rounded-full bg-action/20 blur-[100px]"></div>
  </div>

  <%= render 'layouts/header' %>
<%= render 'shared/ambient', fixed: true %>

  <main class="pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
          <li><a href="/" class="hover:text-primary"><%= I18n.locale == :ar ? 'الرئيسية' : 'Home' %></a></li>
          <li><%= seera_icon "solar:alt-arrow-left-linear", width: 16 %></li>
          <li><a href="/cv-templates" class="hover:text-primary"><%= I18n.locale == :ar ? 'قوالب السيرة الذاتية' : 'CV Templates' %></a></li>
          <li><%= seera_icon "solar:alt-arrow-left-linear", width: 16 %></li>
          <li class="text-gray-900 dark:text-white font-medium"><%= I18n.locale == :ar ? @job['title_ar'] : @job['title_en'] %></li>
        </ol>
      </nav>

      <!-- Hero -->
      <header class="mb-12">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-primary to-action rounded-2xl flex items-center justify-center shadow-lg shadow-primary/25">
            <%= seera_icon "solar:user-id-bold", width: 32, class: "text-white" %>
          </div>
          <div>
            <p class="text-sm text-primary font-medium mb-1">
              <% category = @categories.find { |c| c['slug'] == @job['category'] } %>
              <%= I18n.locale == :ar ? category&.dig('name_ar') : category&.dig('name_en') %>
            </p>
            <h1 class="text-3xl md:text-4xl font-bold">
              <%= I18n.locale == :ar ? 
                "قالب سيرة ذاتية لـ #{@job['title_ar']}" : 
                "#{@job['title_en']} CV Template" %>
            </h1>
          </div>
        </div>
        
        <p class="text-lg text-gray-600 dark:text-gray-400">
          <%= I18n.locale == :ar ? @job['description_ar'] : @job['description_en'] %>
        </p>
      </header>

      <!-- Skills -->
      <section class="mb-12 p-6 bg-white dark:bg-white/5 rounded-2xl border border-gray-200 dark:border-white/10">
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <%= seera_icon "solar:star-bold", width: 24, class: "text-primary" %>
          <%= I18n.locale == :ar ? 'المهارات المطلوبة' : 'Required Skills' %>
        </h2>
        <div class="flex flex-wrap gap-2">
          <% @job['skills'].each do |skill| %>
            <span class="px-4 py-2 bg-primary/10 text-primary rounded-full text-sm font-medium"><%= skill %></span>
          <% end %>
        </div>
      </section>

      <!-- Content -->
      <article class="prose dark:prose-invert max-w-none mb-12">
        <h2><%= I18n.locale == :ar ? 
          "كيف تكتب سيرة ذاتية احترافية لـ #{@job['title_ar']}؟" : 
          "How to Write a Professional #{@job['title_en']} CV?" %></h2>
        
        <% if I18n.locale == :ar %>
          <p>
            إنشاء سيرة ذاتية متميزة لوظيفة <%= @job['title_ar'] %> يتطلب التركيز على المهارات والخبرات التي يبحث عنها أصحاب العمل.
            مع أداة سيرة، يمكنك إنشاء سيرة ذاتية احترافية مُحسّنة لأنظمة ATS في دقائق معدودة.
          </p>
          
          <h3>النقاط الأساسية لسيرتك الذاتية:</h3>
          <ul>
            <li><strong>الملخص المهني:</strong> ابدأ بملخص قوي يبرز خبراتك وإنجازاتك الرئيسية</li>
            <li><strong>المهارات التقنية:</strong> وضّح مهاراتك في <%= @job['skills'].first(3).join('، ') %> وغيرها</li>
            <li><strong>الخبرات العملية:</strong> اذكر إنجازاتك مع أرقام ونتائج ملموسة</li>
            <li><strong>التعليم والشهادات:</strong> أضف مؤهلاتك الأكاديمية والشهادات المهنية</li>
          </ul>
          
          <h3>نصائح لتحسين فرص القبول:</h3>
          <ul>
            <li>استخدم كلمات مفتاحية من الوصف الوظيفي</li>
            <li>حافظ على تنسيق واضح ومنظم</li>
            <li>تأكد من خلو السيرة من الأخطاء الإملائية</li>
            <li>استخدم صيغة PDF للحفاظ على التنسيق</li>
          </ul>
        <% else %>
          <p>
            Creating a standout CV for a <%= @job['title_en'] %> position requires focusing on the skills and experiences employers are looking for.
            With our tool, you can create a professional ATS-optimized CV in minutes.
          </p>
          
          <h3>Key Points for Your CV:</h3>
          <ul>
            <li><strong>Professional Summary:</strong> Start with a strong summary highlighting your key experiences and achievements</li>
            <li><strong>Technical Skills:</strong> Showcase your expertise in <%= @job['skills'].first(3).join(', ') %> and more</li>
            <li><strong>Work Experience:</strong> List your achievements with quantifiable results</li>
            <li><strong>Education & Certifications:</strong> Add your academic qualifications and professional certifications</li>
          </ul>
          
          <h3>Tips to Improve Your Chances:</h3>
          <ul>
            <li>Use keywords from the job description</li>
            <li>Keep a clean and organized format</li>
            <li>Ensure your CV is free of spelling errors</li>
            <li>Use PDF format to preserve formatting</li>
          </ul>
        <% end %>
      </article>

      <!-- CTA -->
      <div class="p-8 bg-gradient-to-br from-primary/10 to-action/10 rounded-3xl border border-primary/20 text-center mb-12">
        <h2 class="text-2xl font-bold mb-4">
          <%= I18n.locale == :ar ? 
            "أنشئ سيرتك الذاتية كـ #{@job['title_ar']} الآن" : 
            "Create Your #{@job['title_en']} CV Now" %>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-xl mx-auto">
          <%= I18n.locale == :ar ? 
            'استخدم أداة سيرة المدعومة بالذكاء الاصطناعي لإنشاء سيرة ذاتية احترافية في دقائق.' :
            'Use our AI-powered tool to create a professional CV in minutes.' %>
        </p>
        <a href="<%= new_resume_path %>" class="inline-flex items-center gap-2 px-8 py-4 bg-primary hover:bg-primaryHover text-white font-medium rounded-full transition-colors shadow-lg shadow-primary/25 text-lg">
          <%= seera_icon "solar:magic-stick-3-bold", width: 24 %>
          <%= I18n.locale == :ar ? 'ابدأ الآن مجاناً' : 'Start Free Now' %>
        </a>
      </div>

      <!-- Related Jobs -->
      <% if @related_jobs.any? %>
        <section>
          <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
            <%= seera_icon "solar:link-bold", width: 24, class: "text-primary" %>
            <%= I18n.locale == :ar ? 'قوالب مشابهة' : 'Related Templates' %>
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <% @related_jobs.each do |job| %>
              <a href="/cv-templates/<%= job['slug'] %>" 
                 class="group p-5 bg-white dark:bg-white/5 rounded-2xl border border-gray-200 dark:border-white/10 hover:border-primary/50 hover:shadow-lg transition-all">
                <div class="flex items-start justify-between mb-3">
                  <div class="w-10 h-10 bg-gradient-to-br from-primary/20 to-action/20 rounded-xl flex items-center justify-center">
                    <%= seera_icon "solar:user-id-bold", width: 20, class: "text-primary" %>
                  </div>
                  <%= seera_icon "solar:arrow-left-bold", width: 18, class: "text-gray-400 group-hover:text-primary group-hover:-translate-x-1 transition-all" %>
                </div>
                <h3 class="font-semibold group-hover:text-primary transition-colors">
                  <%= I18n.locale == :ar ? job['title_ar'] : job['title_en'] %>
                </h3>
              </a>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </main>

  <%= render 'layouts/footer' %>

  <script>
    const html = document.documentElement;
    html.classList.add('dark'); // the Seera design is dark only
  </script>
<%= render 'shared/site_scripts' %>
</body>
</html>

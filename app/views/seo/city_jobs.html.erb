<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= text_direction %>" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= @page_title %></title>
  <meta name="description" content="<%= @meta_description %>">
  <meta name="theme-color" content="#07120D">
  <%= render 'shared/seo_links' %>
  <link rel="icon" href="/icon.png?v=7" type="image/png">
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= seo_url %>">
  <meta property="og:title" content="<%= @page_title %>">
  <meta property="og:description" content="<%= @meta_description %>">
  <meta property="og:image" content="https://cvcrft.com/og-image.png?v=7">
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= render 'shared/posthog' %>
  
  <!-- JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "<%= @page_title %>",
    "description": "<%= @meta_description %>",
    "url": "https://cvcrft.com/jobs/<%= @city['slug'] %>",
    "about": {
      "@type": "City",
      "name": "<%= I18n.locale == :ar ? @city['name_ar'] : @city['name_en'] %>",
      "containedInPlace": {
        "@type": "Country",
        "name": "<%= I18n.locale == :ar ? @city['country_ar'] : @city['country_en'] %>"
      }
    },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": <%= @job_titles.size %>,
      "itemListElement": [
        <% @job_titles.each_with_index do |job, index| %>
        {
          "@type": "ListItem",
          "position": <%= index + 1 %>,
          "url": "https://cvcrft.com/cv-templates/<%= @city['slug'] %>/<%= job['slug'] %>",
          "name": "<%= I18n.locale == :ar ? job['title_ar'] : job['title_en'] %>"
        }<%= index < @job_titles.size - 1 ? ',' : '' %>
        <% end %>
      ]
    }
  }
  </script>
  
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@300;400;500;600;700;800&family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  
</head>
<body class="sr-app antialiased bg-gray-50 dark:bg-darkBase text-gray-900 dark:text-white font-sans min-h-dvh">
  <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-primary/20 blur-[100px]"></div>
    <div class="absolute top-1/3 -right-20 w-80 h-80 rounded-full bg-action/20 blur-[100px]"></div>
  </div>

  <%= render 'layouts/header' %>
<%= render 'shared/ambient', fixed: true %>

  <main class="pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Hero -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-action/10 text-action text-sm font-medium mb-6">
          <%= seera_icon "solar:map-point-bold", width: 16 %>
          <%= I18n.locale == :ar ? @city['country_ar'] : @city['country_en'] %>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          <%= I18n.locale == :ar ? 'قوالب السيرة الذاتية في' : 'CV Templates in' %>
          <span class="bg-gradient-to-l from-primary to-action bg-clip-text text-transparent">
            <%= I18n.locale == :ar ? @city['name_ar'] : @city['name_en'] %>
          </span>
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          <%= I18n.locale == :ar ? 
            "أكثر من #{@job_titles.size} قالب سيرة ذاتية مُحسّن لسوق العمل في #{@city['name_ar']}. اختر مهنتك وابدأ الآن." :
            "#{@job_titles.size}+ CV templates optimized for the #{@city['name_en']} job market. Choose your profession and start now." %>
        </p>
      </div>

      <!-- Categories -->
      <% @categories.each do |category| %>
        <% category_jobs = @job_titles.select { |j| j['category'] == category['slug'] } %>
        <% next if category_jobs.empty? %>
        
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
            <span class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center">
              <%= seera_icon "solar:case-bold", width: 20, class: "text-primary" %>
            </span>
            <%= I18n.locale == :ar ? category['name_ar'] : category['name_en'] %>
          </h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            <% category_jobs.each do |job| %>
              <a href="/cv-templates/<%= @city['slug'] %>/<%= job['slug'] %>" 
                 class="group p-5 bg-white dark:bg-white/5 rounded-2xl border border-gray-200 dark:border-white/10 hover:border-primary/50 hover:shadow-lg transition-all">
                <div class="flex items-start justify-between mb-3">
                  <div class="w-12 h-12 bg-gradient-to-br from-primary/20 to-action/20 rounded-xl flex items-center justify-center">
                    <%= seera_icon "solar:user-id-bold", width: 24, class: "text-primary" %>
                  </div>
                  <%= seera_icon "solar:arrow-left-bold", width: 20, class: "text-gray-400 group-hover:text-primary group-hover:-translate-x-1 transition-all" %>
                </div>
                <h3 class="font-semibold text-lg mb-1 group-hover:text-primary transition-colors">
                  <%= I18n.locale == :ar ? job['title_ar'] : job['title_en'] %>
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  <%= I18n.locale == :ar ? "في #{@city['name_ar']}" : "in #{@city['name_en']}" %>
                </p>
                <div class="mt-3 flex flex-wrap gap-1">
                  <% job['skills'].first(3).each do |skill| %>
                    <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-white/10 rounded-full text-gray-600 dark:text-gray-400"><%= skill %></span>
                  <% end %>
                </div>
              </a>
            <% end %>
          </div>
        </section>
      <% end %>

      <!-- CTA -->
      <div class="mt-16 text-center p-8 bg-gradient-to-br from-primary/10 to-action/10 rounded-3xl border border-primary/20">
        <h2 class="text-2xl font-bold mb-4">
          <%= I18n.locale == :ar ? 
            "جاهز للعمل في #{@city['name_ar']}؟" : 
            "Ready to Work in #{@city['name_en']}?" %>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-xl mx-auto">
          <%= I18n.locale == :ar ? 
            'استخدم أداة سيرة المدعومة بالذكاء الاصطناعي لإنشاء سيرة ذاتية احترافية في دقائق.' :
            'Use our AI-powered tool to create a professional CV in minutes.' %>
        </p>
        <a href="<%= build_cv_path %>" class="inline-flex items-center gap-2 px-8 py-3 bg-primary hover:bg-primaryHover text-white font-medium rounded-full transition-colors shadow-lg shadow-primary/25">
          <%= seera_icon "solar:magic-stick-3-bold", width: 20 %>
          <%= I18n.locale == :ar ? 'ابدأ الآن مجاناً' : 'Start Free Now' %>
        </a>
      </div>
    </div>
  </main>

  <%= render 'layouts/footer' %>

  <script>
    const html = document.documentElement;
    html.classList.add('dark'); // the Seera design is dark only
  </script>
<%= render 'shared/site_scripts' %>
</body>
</html>

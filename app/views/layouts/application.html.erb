<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= text_direction %>" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8">
    <title><%= content_for(:title) || t('site.name') + " | " + t('site.tagline') %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for(:description) || t('site.description') %>">
    <meta name="theme-color" content="#07120D">
    
    <!-- Canonical & Language Alternates -->
    <link rel="canonical" href="https://cvcrft.com<%= request.path == '/' ? '' : request.path %>">
    <link rel="alternate" hreflang="ar" href="https://cvcrft.com<%= request.path %>?locale=ar">
    <link rel="alternate" hreflang="en" href="https://cvcrft.com<%= request.path %>?locale=en">
    <link rel="alternate" hreflang="x-default" href="https://cvcrft.com<%= request.path %>">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url rescue 'https://cvcrft.com' %>">
    <meta property="og:title" content="<%= content_for(:title) || t('site.name') + ' - ' + t('site.tagline') %>">
    <meta property="og:description" content="<%= content_for(:description) || t('site.description') %>">
    <meta property="og:image" content="<%= content_for(:og_image) || "#{request.base_url rescue 'https://cvcrft.com'}/og-image.png?v=6" %>">
    <meta property="og:locale" content="<%= current_locale == 'ar' ? 'ar_SA' : 'en_US' %>">
    <meta property="og:locale:alternate" content="<%= current_locale == 'ar' ? 'en_US' : 'ar_SA' %>">
    <meta property="og:site_name" content="<%= t('site.name') %>">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="<%= request.original_url rescue 'https://cvcrft.com' %>">
    <meta name="twitter:title" content="<%= content_for(:title) || t('site.name') + ' - ' + t('site.tagline') %>">
    <meta name="twitter:description" content="<%= content_for(:description) || t('site.description') %>">
    <meta name="twitter:image" content="<%= content_for(:og_image) || "#{request.base_url rescue 'https://cvcrft.com'}/og-image.png?v=6" %>">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="locale" content="<%= current_locale %>">
    <%= yield :head %>
    
    <%= render 'shared/posthog' %>
    
    <%# Prevent Turbo from caching pages with user state - refresh on back navigation %>
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png?v=6" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png?v=6">
    
    <!-- Iconify -->
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js" defer></script>
    
    <!-- Google Fonts (async loading) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet"></noscript>

    
    <!-- Custom Styles -->
    <style>
        body {
            font-feature-settings: "ss01", "ss02";
            -webkit-font-smoothing: antialiased;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #333;
        }
        
        .gradient-text {
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            background-image: linear-gradient(135deg, #0B7F48 0%, #D6B877 100%);
        }

        .blob {
            position: absolute;
            filter: blur(90px);
            opacity: 0.5;
            z-index: -1;
            animation: pulse 10s infinite alternate;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            100% { transform: scale(1.1); }
        }
        
        @keyframes scan {
            0% { top: 0%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: 100%; opacity: 0; }
        }

        /* Mobile Menu Transition */
        #mobile-menu {
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
        }
        
        iconify-icon {
            display: inline-block;
            vertical-align: middle;
        }
    </style>
    
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <!--
      If using a TypeScript entrypoint file:
        vite_typescript_tag 'application'

      If using a .jsx or .tsx entrypoint, add the extension:
        vite_javascript_tag 'application.jsx'

      Visit the guide for more information: https://vite-ruby.netlify.app/guide/rails
    -->
  </head>
  <body class="bg-darkBase text-mist selection:bg-gold selection:text-darkBase overflow-x-hidden text-lg">
    <%= render 'shared/ambient', fixed: true %>
    <%= render 'layouts/header' %>
    <main id="main" class="sr-app relative">
      <%= yield %>
    </main>
    <%= render 'layouts/footer' %>
    
    <!-- Global hover/touch animation for native buttons and anchor-buttons -->
    <style>
      /* subtle lift and shadow when active (hover or touch) */
      .js-hover-active {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(2,6,23,0.08);
        transition: transform 160ms ease, box-shadow 160ms ease;
      }
      /* ensure smooth transition when class is removed */
      button, a[role="button"], a.button {
        transition: transform 160ms ease, box-shadow 160ms ease;
      }
    </style>

    <script>
      (function () {
        // Apply active class on hover/focus/touch for buttons and anchors that act like buttons.
        // This is intentionally non-invasive: it only adds/removes a class that triggers
        // an animation defined in the style above.
        const selector = 'button, a[role="button"], a.button, a.btn, a[class*="button"], a[class*="btn"]';

        function activate(el) {
          el.classList.add('js-hover-active');
        }

        function deactivate(el) {
          el.classList.remove('js-hover-active');
        }

        function addListeners(el) {
          if (el.__hoverable_bound) return;
          el.__hoverable_bound = true;
          el.addEventListener('mouseenter', () => activate(el), { passive: true });
          el.addEventListener('mouseleave', () => deactivate(el), { passive: true });
          el.addEventListener('focus', () => activate(el), { passive: true });
          el.addEventListener('blur', () => deactivate(el), { passive: true });

          // Touch behavior: activate on touchstart and remove shortly after touchend
          let touchTimer = null;
          el.addEventListener('touchstart', (ev) => {
            activate(el);
            if (touchTimer) clearTimeout(touchTimer);
          }, { passive: true });
          el.addEventListener('touchend', (ev) => {
            if (touchTimer) clearTimeout(touchTimer);
            touchTimer = setTimeout(() => deactivate(el), 300);
          }, { passive: true });
        }

        function scan() {
          document.querySelectorAll(selector).forEach(addListeners);
        }

        // Run on load and after DOM changes (simple mutation observer)
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', scan);
        } else {
          scan();
        }

        const observer = new MutationObserver((mutations) => {
          // quick scan when new nodes are added
          for (const m of mutations) {
            if (m.addedNodes && m.addedNodes.length) {
              scan();
              break;
            }
          }
        });

        observer.observe(document.documentElement || document.body, { childList: true, subtree: true });
      })();
    </script>

    <!-- Global button loading animation -->
    <script>
      // Global button loading animation
      (function() {
        // Reset buttons on page load
        function resetButtons() {
          document.querySelectorAll('.btn-loading').forEach(btn => {
            btn.disabled = false;
            btn.classList.remove('opacity-75', 'cursor-wait');
            const icon = btn.querySelector('.btn-icon');
            const spinner = btn.querySelector('.btn-spinner');
            const text = btn.querySelector('.btn-text');
            if (icon) icon.classList.remove('hidden');
            if (spinner) spinner.classList.add('hidden');
            if (text && btn.dataset.originalText) text.textContent = btn.dataset.originalText;
          });
        }

        // Store original text and reset on load
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('.btn-loading').forEach(btn => {
            const text = btn.querySelector('.btn-text');
            if (text) btn.dataset.originalText = text.textContent;
          });
          resetButtons();
        });

        // Reset on pageshow (back/forward)
        window.addEventListener('pageshow', resetButtons);

        document.addEventListener('click', (e) => {
          const btn = e.target.closest('.btn-loading');
          if (!btn) return;
          
          const form = btn.closest('form');
          if (form && !form.checkValidity()) return;
          
          // Show loading state after a tiny delay to let form submit
          setTimeout(() => {
            btn.classList.add('opacity-75', 'cursor-wait');
            
            const icon = btn.querySelector('.btn-icon');
            const spinner = btn.querySelector('.btn-spinner');
            const text = btn.querySelector('.btn-text');
            const loadingText = btn.dataset.loadingText;
            
            if (icon) icon.classList.add('hidden');
            if (spinner) spinner.classList.remove('hidden');
            if (text && loadingText) text.textContent = loadingText;
          }, 0);
        });
      })();

      // Loading animation for js-loading-btn links
      (function() {
        function resetLoadingBtns() {
          document.querySelectorAll('.js-loading-btn').forEach(btn => {
            const content = btn.querySelector('.js-btn-content');
            const spinner = btn.querySelector('.js-btn-spinner');
            if (content) {
              content.style.display = '';
              content.classList.remove('hidden');
            }
            if (spinner) {
              spinner.style.display = 'none';
              spinner.classList.add('hidden');
            }
            btn.classList.remove('pointer-events-none', 'opacity-80');
            btn.style.pointerEvents = '';
            btn.style.opacity = '';
          });
        }

        // Reset immediately when script runs
        resetLoadingBtns();
        
        // Also reset on page load, back/forward, and Turbo events
        window.addEventListener('pageshow', function(event) {
          // Always reset on pageshow, especially for bfcache
          resetLoadingBtns();
        });
        window.addEventListener('load', resetLoadingBtns);
        document.addEventListener('DOMContentLoaded', resetLoadingBtns);
        document.addEventListener('turbo:load', resetLoadingBtns);
        document.addEventListener('turbo:render', resetLoadingBtns);
        
        // Also reset after a short delay to catch any edge cases
        setTimeout(resetLoadingBtns, 100);
        setTimeout(resetLoadingBtns, 500);

        document.addEventListener('click', (e) => {
          const btn = e.target.closest('.js-loading-btn');
          if (!btn) return;

          const content = btn.querySelector('.js-btn-content');
          const spinner = btn.querySelector('.js-btn-spinner');
          
          if (content && spinner) {
            content.style.display = 'none';
            spinner.style.display = '';
            spinner.classList.remove('hidden');
            btn.style.pointerEvents = 'none';
            btn.style.opacity = '0.8';
          }
        });
      })();
    </script>
    
    <%= render 'shared/site_scripts' %>
  </body>
</html>

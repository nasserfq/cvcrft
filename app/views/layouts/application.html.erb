<!DOCTYPE html>
<html dir="rtl" lang="ar">
  <head>
    <title><%= content_for(:title) || "Cvcraft" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <!-- Using pre-built CSS directly -->
    <link rel="stylesheet" href="/assets/application.css" data-turbo-track="reload">
    <%= javascript_importmap_tags %>
    <!--
      If using a TypeScript entrypoint file:
        vite_typescript_tag 'application'

      If using a .jsx or .tsx entrypoint, add the extension:
        vite_javascript_tag 'application.jsx'

      Visit the guide for more information: https://vite-ruby.netlify.app/guide/rails
    -->
  </head>
  <body dir="rtl">
    <!-- Skeleton Loading Overlay -->
    <div id="page-loading-skeleton" class="fixed inset-0 z-50 bg-gradient-to-b from-white via-emerald-50 to-white hidden">
      <div class="animate-pulse">
        <!-- Header skeleton -->
        <div class="bg-white/70 border-b border-slate-200/60 px-4 py-3">
          <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 bg-slate-200 rounded-lg"></div>
              <div class="w-16 h-4 bg-slate-200 rounded"></div>
            </div>
            <div class="hidden md:flex items-center gap-6">
              <div class="w-20 h-3 bg-slate-200 rounded"></div>
              <div class="w-16 h-3 bg-slate-200 rounded"></div>
              <div class="w-24 h-3 bg-slate-200 rounded"></div>
            </div>
            <div class="w-28 h-9 bg-emerald-200 rounded-md"></div>
          </div>
        </div>
        <!-- Content skeleton -->
        <div class="max-w-4xl mx-auto px-4 py-12">
          <div class="bg-white/80 rounded-2xl border border-slate-200/80 p-8">
            <div class="text-center mb-8">
              <div class="w-64 h-8 bg-slate-200 rounded mx-auto mb-4"></div>
              <div class="w-96 h-4 bg-slate-100 rounded mx-auto"></div>
            </div>
            <div class="space-y-6">
              <div class="h-12 bg-slate-100 rounded-lg"></div>
              <div class="h-12 bg-slate-100 rounded-lg"></div>
              <div class="grid grid-cols-2 gap-4">
                <div class="h-12 bg-slate-100 rounded-lg"></div>
                <div class="h-12 bg-slate-100 rounded-lg"></div>
              </div>
              <div class="h-32 bg-slate-100 rounded-lg"></div>
              <div class="flex justify-between pt-4">
                <div class="w-24 h-10 bg-slate-200 rounded-lg"></div>
                <div class="w-24 h-10 bg-emerald-200 rounded-lg"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%= render 'layouts/header' %>
    <%= yield %>
    <%= render 'layouts/footer' %>
    <!-- Global hover/touch animation for native buttons and anchor-buttons -->
    <style>
      /* subtle lift and shadow when active (hover or touch) */
      .js-hover-active {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(2,6,23,0.08);
        transition: transform 160ms ease, box-shadow 160ms ease;
      }
      /* ensure smooth transition when class is removed */
      button, a[role="button"], a.button {
        transition: transform 160ms ease, box-shadow 160ms ease;
      }
    </style>

    <script>
      (function () {
        // Apply active class on hover/focus/touch for buttons and anchors that act like buttons.
        // This is intentionally non-invasive: it only adds/removes a class that triggers
        // an animation defined in the style above.
        const selector = 'button, a[role="button"], a.button, a.btn, a[class*="button"], a[class*="btn"]';

        function activate(el) {
          el.classList.add('js-hover-active');
        }

        function deactivate(el) {
          el.classList.remove('js-hover-active');
        }

        function addListeners(el) {
          if (el.__hoverable_bound) return;
          el.__hoverable_bound = true;
          el.addEventListener('mouseenter', () => activate(el), { passive: true });
          el.addEventListener('mouseleave', () => deactivate(el), { passive: true });
          el.addEventListener('focus', () => activate(el), { passive: true });
          el.addEventListener('blur', () => deactivate(el), { passive: true });

          // Touch behavior: activate on touchstart and remove shortly after touchend
          let touchTimer = null;
          el.addEventListener('touchstart', (ev) => {
            activate(el);
            if (touchTimer) clearTimeout(touchTimer);
          }, { passive: true });
          el.addEventListener('touchend', (ev) => {
            if (touchTimer) clearTimeout(touchTimer);
            touchTimer = setTimeout(() => deactivate(el), 300);
          }, { passive: true });
        }

        function scan() {
          document.querySelectorAll(selector).forEach(addListeners);
        }

        // Run on load and after DOM changes (simple mutation observer)
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', scan);
        } else {
          scan();
        }

        const observer = new MutationObserver((mutations) => {
          // quick scan when new nodes are added
          for (const m of mutations) {
            if (m.addedNodes && m.addedNodes.length) {
              scan();
              break;
            }
          }
        });

        observer.observe(document.documentElement || document.body, { childList: true, subtree: true });
      })();
    </script>

    <!-- Skeleton loading script -->
    <script>
      (function() {
        const skeleton = document.getElementById('page-loading-skeleton');
        if (!skeleton) return;

        // Show skeleton when navigating to internal links
        document.addEventListener('click', (e) => {
          const link = e.target.closest('a[href]');
          if (!link) return;
          
          const href = link.getAttribute('href');
          // Skip external links, anchors, and special links
          if (!href || 
              href.startsWith('#') || 
              href.startsWith('http') || 
              href.startsWith('mailto:') ||
              href.startsWith('tel:') ||
              link.hasAttribute('data-turbo-method') ||
              link.hasAttribute('data-method') ||
              link.target === '_blank') {
            return;
          }

          // Show skeleton with fade in
          skeleton.classList.remove('hidden');
          skeleton.style.opacity = '0';
          requestAnimationFrame(() => {
            skeleton.style.transition = 'opacity 150ms ease-out';
            skeleton.style.opacity = '1';
          });
        });

        // Hide skeleton when page loads (for back/forward navigation)
        window.addEventListener('pageshow', () => {
          skeleton.classList.add('hidden');
          skeleton.style.opacity = '0';
        });
      })();

      // Global button loading animation
      (function() {
        // Reset buttons on page load
        function resetButtons() {
          document.querySelectorAll('.btn-loading').forEach(btn => {
            btn.disabled = false;
            btn.classList.remove('opacity-75', 'cursor-wait');
            const icon = btn.querySelector('.btn-icon');
            const spinner = btn.querySelector('.btn-spinner');
            const text = btn.querySelector('.btn-text');
            if (icon) icon.classList.remove('hidden');
            if (spinner) spinner.classList.add('hidden');
            if (text && btn.dataset.originalText) text.textContent = btn.dataset.originalText;
          });
        }

        // Store original text and reset on load
        document.addEventListener('DOMContentLoaded', () => {
          document.querySelectorAll('.btn-loading').forEach(btn => {
            const text = btn.querySelector('.btn-text');
            if (text) btn.dataset.originalText = text.textContent;
          });
          resetButtons();
        });

        // Reset on pageshow (back/forward)
        window.addEventListener('pageshow', resetButtons);

        document.addEventListener('click', (e) => {
          const btn = e.target.closest('.btn-loading');
          if (!btn) return;
          
          const form = btn.closest('form');
          if (form && !form.checkValidity()) return;
          
          // Show loading state after a tiny delay to let form submit
          setTimeout(() => {
            btn.classList.add('opacity-75', 'cursor-wait');
            
            const icon = btn.querySelector('.btn-icon');
            const spinner = btn.querySelector('.btn-spinner');
            const text = btn.querySelector('.btn-text');
            const loadingText = btn.dataset.loadingText;
            
            if (icon) icon.classList.add('hidden');
            if (spinner) spinner.classList.remove('hidden');
            if (text && loadingText) text.textContent = loadingText;
          }, 0);
        });
      })();
    </script>
  </body>
</html>

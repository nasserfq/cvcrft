<!-- Background Accents -->
<div class="pointer-events-none fixed inset-0 -z-10">
  <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-emerald-400/20 blur-3xl"></div>
  <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-emerald-300/20 blur-3xl"></div>
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[38rem] h-[38rem] bg-gradient-to-b from-emerald-200/30 to-transparent rounded-full blur-3xl"></div>
</div>
<!-- Header -->
<header class="sticky top-0 z-30 backdrop-blur-xl bg-white/70 border-b border-slate-200/60">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-3">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 cursor-pointer" style="cursor: pointer;">
        <div class="grid place-items-center w-9 h-9 rounded-lg bg-emerald-500 text-white ring-1 ring-black/5 shadow-sm pointer-events-none">
          <span class="text-sm font-semibold tracking-tight">س</span>
        </div>
        <span class="text-slate-900 text-base font-semibold tracking-tight pointer-events-none">سيرة</span>
      </a>
      <!-- Nav -->
      <nav class="hidden md:flex items-center gap-8 text-sm text-slate-600">
        <% if user_signed_in? %>
          <%= link_to resumes_path, class: "hover:text-emerald-600 transition-colors js-hover-target", data: { hoverable: true } do %>
            <i data-lucide="file-text" class="w-4 h-4 inline mr-1"></i>
            سيرتي الذاتية
          <% end %>
        <% end %>
  <a href="#features" data-hoverable="true" class="hover:text-emerald-600 transition-colors js-hover-target">الميزات</a>
  <a href="#how" data-hoverable="true" class="hover:text-emerald-600 transition-colors js-hover-target">كيف يعمل</a>
  <a href="#pricing" data-hoverable="true" class="hover:text-emerald-600 transition-colors js-hover-target">الأسعار</a>
  <a href="#faq" data-hoverable="true" class="hover:text-emerald-600 transition-colors js-hover-target">الأسئلة الشائعة</a>
      </nav>
      <!-- Actions -->
      <div class="flex items-center gap-3">
        
        <% if user_signed_in? %>
          <%= link_to profile_path, class: "hidden sm:inline-flex items-center gap-2 text-sm text-gray-600 hover:text-emerald-600 transition-colors js-hover-target", data: { hoverable: true } do %>
            <i data-lucide="user" class="w-4 h-4"></i>
            <span>مرحباً، <%= current_user.email %></span>
          <% end %>
          <%= form_with url: "/auth/logout", method: :delete, class: "hidden sm:inline-flex" do |f| %>
            <button type="submit" data-hoverable="true" class="inline-flex items-center gap-2 text-sm text-gray-700 hover:text-red-700 transition-colors js-hover-target">
              <i data-lucide="log-out" class="w-4 h-4"></i>
              <span>تسجيل الخروج</span>
            </button>
          <% end %>
        <% else %>
          <a href="/login" data-hoverable="true" class="hidden sm:inline-flex items-center gap-2 text-sm text-gray-700 hover:text-emerald-700 transition-colors js-hover-target">
            <i data-lucide="log-in" class="w-4 h-4"></i>
            <span>تسجيل الدخول</span>
          </a>
        <% end %>
        <%= link_to (user_signed_in? ? new_resume_path : login_path(return_to: new_resume_path)), class: "inline-flex items-center gap-2 rounded-md bg-emerald-600 text-white text-sm font-medium px-4 py-2.5 shadow-sm ring-1 ring-black/5 hover:bg-emerald-700 hover:scale-105 hover:shadow active:bg-emerald-800 active:scale-110 transition-all duration-150 js-hover-target touch-manipulation js-loading-btn", data: { hoverable: true } do %>
          <span class="js-btn-content inline-flex items-center gap-2">
            <i data-lucide="wand-2" class="w-4 h-4"></i>
            <span>ابدأ الآن مجانًا</span>
          </span>
          <span class="js-btn-spinner inline-flex items-center gap-2" style="display: none;">
            <svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>جاري التحميل...</span>
          </span>
        <% end %>
        <!-- Mobile menu button -->
        <button id="mobile-menu-button" data-hoverable="true" class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 transition-colors js-hover-target">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
      </div>
    </div>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200/60" style="display: none;">
      <div class="py-4 space-y-3">
        <% if user_signed_in? %>
          <%= link_to resumes_path, class: "block px-3 py-2 text-sm text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-md transition-colors js-hover-target", data: { hoverable: true } do %>
            <i data-lucide="file-text" class="w-4 h-4 inline mr-2"></i>
            سيرتي الذاتية
          <% end %>
        <% end %>
  <a href="#features" data-hoverable="true" class="block px-3 py-2 text-sm text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-md transition-colors js-hover-target">الميزات</a>
  <a href="#how" data-hoverable="true" class="block px-3 py-2 text-sm text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-md transition-colors js-hover-target">كيف يعمل</a>
  <a href="#pricing" data-hoverable="true" class="block px-3 py-2 text-sm text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-md transition-colors js-hover-target">الأسعار</a>
  <a href="#faq" data-hoverable="true" class="block px-3 py-2 text-sm text-slate-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-md transition-colors js-hover-target">الأسئلة الشائعة</a>
        <div class="pt-3 border-t border-gray-200/60">
          <% if user_signed_in? %>
            <%= link_to profile_path, class: "block px-3 py-2 text-sm text-gray-600 hover:text-emerald-600 hover:bg-emerald-50 rounded-md transition-colors js-hover-target", data: { hoverable: true } do %>
              <i data-lucide="user" class="w-4 h-4 inline mr-2"></i>
              <span>مرحباً، <%= current_user.email %></span>
            <% end %>
            <%= form_with url: "/auth/logout", method: :delete, class: "block" do |f| %>
              <button type="submit" data-hoverable="true" class="w-full text-left px-3 py-2 text-sm text-gray-700 hover:text-red-700 hover:bg-red-50 rounded-md transition-colors js-hover-target">
                <i data-lucide="log-out" class="w-4 h-4 inline mr-2"></i>
                تسجيل الخروج
              </button>
            <% end %>
          <% else %>
            <a href="/login" data-hoverable="true" class="block px-3 py-2 text-sm text-gray-700 hover:text-emerald-700 hover:bg-emerald-50 rounded-md transition-colors js-hover-target">
              <i data-lucide="log-in" class="w-4 h-4 inline mr-2"></i>
              تسجيل الدخول
            </a>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
</header>

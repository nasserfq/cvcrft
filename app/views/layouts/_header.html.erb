<!-- Navigation -->
<nav class="fixed top-0 w-full z-50 border-b border-borderLight bg-white/80 backdrop-blur-xl dark:bg-darkBase/80 dark:border-borderDark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 md:h-20 flex items-center justify-between">
        <!-- Logo -->
        <div class="flex items-center gap-2 z-50">
            <a href="/" class="text-xl md:text-2xl font-medium tracking-tight text-darkBase dark:text-white flex items-center gap-2">
                <span class="bg-primary text-white w-7 h-7 md:w-8 md:h-8 rounded-lg flex items-center justify-center text-sm font-semibold shadow-glow">س</span>
                سيرة
            </a>
        </div>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center gap-8 text-sm font-normal text-gray-500 dark:text-gray-400">
            <% if user_signed_in? %>
                <%= link_to resumes_path, class: "hover:text-primary transition-colors" do %>
                    سيرتي الذاتية
                <% end %>
            <% end %>
            <a href="#features" class="hover:text-primary transition-colors">المميزات</a>
            <a href="#how-it-works" class="hover:text-primary transition-colors">كيف يعمل</a>
            <a href="#templates" class="hover:text-primary transition-colors">القوالب</a>
        </div>

        <!-- Actions -->
        <div class="hidden md:flex items-center gap-4">
            <button id="themeToggle" class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-gray-500 dark:text-gray-400">
                <iconify-icon icon="solar:sun-2-linear" width="24" height="24" class="hidden dark:block"></iconify-icon>
                <iconify-icon icon="solar:moon-linear" width="24" height="24" class="block dark:hidden"></iconify-icon>
            </button>
            
            <% if user_signed_in? %>
                <%= link_to profile_path, class: "flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition-colors" do %>
                    <iconify-icon icon="solar:user-linear" width="20"></iconify-icon>
                    <span><%= current_user.email %></span>
                <% end %>
                <%= form_with url: "/auth/logout", method: :delete, class: "inline-flex" do |f| %>
                    <button type="submit" class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-red-500 transition-colors">
                        <iconify-icon icon="solar:logout-2-linear" width="20"></iconify-icon>
                        <span>خروج</span>
                    </button>
                <% end %>
            <% else %>
                <a href="/login" class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition-colors">
                    <iconify-icon icon="solar:login-2-linear" width="20"></iconify-icon>
                    <span>تسجيل الدخول</span>
                </a>
            <% end %>
            
            <%= link_to (user_signed_in? ? new_resume_path : login_path(return_to: new_resume_path)), class: "flex items-center justify-center px-5 py-2 rounded-full bg-primary hover:bg-primaryHover text-white text-sm font-normal transition-all shadow-glow hover:shadow-lg" do %>
                ابنِ سيرتك الآن
            <% end %>
        </div>

        <!-- Mobile Menu Button -->
        <div class="flex md:hidden items-center gap-4 z-50">
            <button id="themeToggleMobile" class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-gray-500 dark:text-gray-400">
                <iconify-icon icon="solar:sun-2-linear" width="22" height="22" class="hidden dark:block"></iconify-icon>
                <iconify-icon icon="solar:moon-linear" width="22" height="22" class="block dark:hidden"></iconify-icon>
            </button>
            <button id="mobileMenuBtn" class="p-2 text-darkBase dark:text-white focus:outline-none">
                <iconify-icon icon="solar:hamburger-menu-linear" width="26" stroke-width="1.5"></iconify-icon>
            </button>
        </div>
    </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-[60] bg-white/95 dark:bg-darkBase/95 backdrop-blur-xl transform -translate-x-full md:hidden flex flex-col h-[100dvh]">
    <!-- Mobile Menu Header -->
    <div class="flex items-center justify-between px-4 sm:px-6 h-16 shrink-0 border-b border-borderLight dark:border-borderDark">
        <!-- Logo -->
        <div class="flex items-center gap-2">
            <span class="bg-primary text-white w-7 h-7 rounded-lg flex items-center justify-center text-sm font-semibold shadow-glow">س</span>
            <span class="text-xl font-medium tracking-tight text-darkBase dark:text-white">سيرة</span>
        </div>
        
        <!-- Actions -->
        <div class="flex items-center gap-3">
            <button id="themeToggleMobileInside" class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-gray-500 dark:text-gray-400">
                <iconify-icon icon="solar:sun-2-linear" width="24" height="24" class="hidden dark:block"></iconify-icon>
                <iconify-icon icon="solar:moon-linear" width="24" height="24" class="block dark:hidden"></iconify-icon>
            </button>
            <button id="closeMobileMenu" class="p-2 text-gray-500 hover:text-darkBase dark:hover:text-white transition-colors">
                <iconify-icon icon="solar:close-circle-linear" width="28" stroke-width="1.5"></iconify-icon>
            </button>
        </div>
    </div>

    <!-- Menu Items -->
    <div class="flex-1 flex flex-col items-center justify-center gap-8 p-6 overflow-y-auto">
        <% if user_signed_in? %>
            <%= link_to resumes_path, class: "mobile-link text-2xl font-normal text-darkBase dark:text-white hover:text-primary transition-colors tracking-tight" do %>
                سيرتي الذاتية
            <% end %>
        <% end %>
        <a href="#features" class="mobile-link text-2xl font-normal text-darkBase dark:text-white hover:text-primary transition-colors tracking-tight">المميزات</a>
        <a href="#how-it-works" class="mobile-link text-2xl font-normal text-darkBase dark:text-white hover:text-primary transition-colors tracking-tight">كيف يعمل</a>
        <a href="#templates" class="mobile-link text-2xl font-normal text-darkBase dark:text-white hover:text-primary transition-colors tracking-tight">القوالب</a>
        
        <div class="pt-6 border-t border-borderLight dark:border-borderDark w-full max-w-[280px] space-y-4">
            <% if user_signed_in? %>
                <%= link_to profile_path, class: "mobile-link flex items-center justify-center gap-2 text-lg text-gray-600 dark:text-gray-400 hover:text-primary transition-colors" do %>
                    <iconify-icon icon="solar:user-linear" width="24"></iconify-icon>
                    <span><%= current_user.email %></span>
                <% end %>
                <%= form_with url: "/auth/logout", method: :delete, class: "w-full" do |f| %>
                    <button type="submit" class="w-full flex items-center justify-center gap-2 text-lg text-gray-600 dark:text-gray-400 hover:text-red-500 transition-colors">
                        <iconify-icon icon="solar:logout-2-linear" width="24"></iconify-icon>
                        <span>تسجيل الخروج</span>
                    </button>
                <% end %>
            <% else %>
                <a href="/login" class="mobile-link flex items-center justify-center gap-2 text-lg text-gray-600 dark:text-gray-400 hover:text-primary transition-colors">
                    <iconify-icon icon="solar:login-2-linear" width="24"></iconify-icon>
                    <span>تسجيل الدخول</span>
                </a>
            <% end %>
        </div>
        
        <%= link_to (user_signed_in? ? new_resume_path : login_path(return_to: new_resume_path)), class: "w-full max-w-[280px] py-4 rounded-2xl bg-primary hover:bg-primaryHover text-white text-lg font-medium shadow-glow text-center transition-all mt-6" do %>
            ابنِ سيرتك الآن
        <% end %>
    </div>
</div>

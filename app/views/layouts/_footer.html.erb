<!-- Footer -->
<footer class="border-t border-borderLight dark:border-borderDark bg-gray-50 dark:bg-darkBase pt-12 md:pt-16 pb-8 md:pb-10 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6 md:gap-8">
        <div class="flex items-center gap-3">
            <span class="bg-primary text-white w-6 h-6 rounded flex items-center justify-center text-xs font-bold">س</span>
            <span class="font-medium text-lg md:text-xl text-darkBase dark:text-white">سيرة</span>
        </div>
        
        <div class="flex flex-wrap justify-center gap-6 md:gap-8 text-sm md:text-base text-gray-500">
            <a href="<%= terms_path %>" class="hover:text-primary transition-colors"><%= t('footer.terms') %></a>
            <a href="<%= privacy_path %>" class="hover:text-primary transition-colors"><%= t('footer.privacy') %></a>
            <a href="mailto:support@cvcrft.com" class="hover:text-primary transition-colors"><%= t('footer.contact') %></a>
        </div>

        <div class="text-xs md:text-sm text-gray-500 dir-ltr">
            © <%= Time.current.year %> سيرة. <%= t('footer.copyright') %>
        </div>
    </div>
</footer>
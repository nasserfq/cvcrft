<%# The Seera canvas backdrop: drifting green and gold orbs and slow sadu stars.
    fixed: true pins it to the viewport for app pages; the landing scrolls it.
    still: true keeps the same picture but stops the motion. Long reading pages
    use it: their glass card would otherwise be re-blurred on every frame. %>
<% spin = local_assigns[:still] ? nil : "sr-spin" %>
<div aria-hidden="true" class="<%= local_assigns[:fixed] ? 'fixed' : 'absolute' %> inset-0 pointer-events-none overflow-hidden">
  <svg class="<%= spin %>" width="560" height="560" viewBox="0 0 100 100" style="position: absolute; top: 110px; left: -80px; opacity: 0.14"><g fill="none" stroke="#d6b877" stroke-width="0.35"><rect x="20" y="20" width="60" height="60"></rect><rect x="20" y="20" width="60" height="60" transform="rotate(45 50 50)"></rect><rect x="32" y="32" width="36" height="36" transform="rotate(22.5 50 50)"></rect><rect x="32" y="32" width="36" height="36" transform="rotate(67.5 50 50)"></rect><circle cx="50" cy="50" r="12"></circle><circle cx="50" cy="50" r="42.5"></circle></g></svg>
  <svg class="<%= spin %>" width="440" height="440" viewBox="0 0 100 100" style="position: absolute; top: 2380px; right: -120px; opacity: 0.12"><g fill="none" stroke="#d6b877" stroke-width="0.4"><rect x="20" y="20" width="60" height="60"></rect><rect x="20" y="20" width="60" height="60" transform="rotate(45 50 50)"></rect><circle cx="50" cy="50" r="16"></circle></g></svg>
  <div class="<%= "sr-orb1" unless local_assigns[:still] %>" style="position: absolute; top: -180px; right: -120px; width: 720px; height: 720px; border-radius: 50%; background: radial-gradient(circle, rgba(0,140,78,0.55), rgba(0,140,78,0) 65%); filter: blur(40px)"></div>
  <div class="<%= "sr-orb2" unless local_assigns[:still] %>" style="position: absolute; top: 380px; left: -220px; width: 760px; height: 760px; border-radius: 50%; background: radial-gradient(circle, rgba(200,169,106,0.42), rgba(200,169,106,0) 65%); filter: blur(50px)"></div>
  <div class="<%= "sr-orb3" unless local_assigns[:still] %>" style="position: absolute; top: 1500px; right: 8%; width: 620px; height: 620px; border-radius: 50%; background: radial-gradient(circle, rgba(0,108,53,0.35), rgba(0,108,53,0) 65%); filter: blur(50px)"></div>
  <div class="<%= "sr-orb2" unless local_assigns[:still] %>" style="position: absolute; top: 2500px; left: 4%; width: 680px; height: 680px; border-radius: 50%; background: radial-gradient(circle, rgba(214,184,119,0.38), rgba(214,184,119,0) 65%); filter: blur(60px)"></div>
  <div class="<%= "sr-orb1" unless local_assigns[:still] %>" style="position: absolute; top: 3400px; right: 20%; width: 760px; height: 760px; border-radius: 50%; background: radial-gradient(circle, rgba(0,150,85,0.4), rgba(0,150,85,0) 65%); filter: blur(60px)"></div>
</div>

<%#
  The Seera glass header and its mobile menu, shared by every page.
  home: true links the section anchors in place; elsewhere they go to the landing.
  position: the header's positioning classes.
  locale_link: switch language with a plain link, for pages without a session (no CSRF token).
%>
<% build_href = user_signed_in? ? new_resume_path : login_path(return_to: new_resume_path) %>
<% target_locale = current_locale == 'ar' ? 'en' : 'ar' %>
<% anchor_base = local_assigns[:home] ? '' : root_path %>
<% header_position = local_assigns[:position] || 'sticky top-3 sm:top-4 z-50' %>
<%# nil unless the user is signed in and billing is on for them. %>
<% credit_balance = header_credit_balance %>
<header class="glass <%= header_position %> flex items-center justify-between gap-4 rounded-[22px] py-3 ps-4 pe-3 sm:ps-5">
  <a href="<%= local_assigns[:home] ? '#top' : root_path %>" class="flex items-center gap-3">
    <span class="glass flex items-center justify-center w-11 h-11 rounded-[13px] text-mist"><%= render "shared/logo_mark", size: 32, animate: true %></span>
    <span class="text-[22px] font-semibold tracking-[-0.01em]">سيرة</span>
  </a>
  <nav aria-label="<%= t('nav.features') %>" class="hidden lg:flex flex-wrap gap-1">
    <% if user_signed_in? %>
      <%= link_to t('nav.my_cv'), resumes_path, class: "sr-btn px-4 py-2.5 rounded-xl text-[15px]", style: "color: rgba(238,243,238,0.78)" %>
      <%# Only testers (or everyone once COACH_ENABLED) see the coach. %>
      <% if Coach.enabled_for?(current_user) %>
        <%= link_to t('nav.coach'), coach_root_path, class: "sr-btn px-4 py-2.5 rounded-xl text-[15px]", style: "color: rgba(238,243,238,0.78)" %>
      <% end %>
    <% end %>
    <a href="<%= anchor_base %>#features" class="sr-btn px-4 py-2.5 rounded-xl text-[15px]" style="color: rgba(238,243,238,0.78)"><%= t('nav.features') %></a>
    <a href="<%= anchor_base %>#how-it-works" class="sr-btn px-4 py-2.5 rounded-xl text-[15px]" style="color: rgba(238,243,238,0.78)"><%= t('nav.how_it_works') %></a>
    <a href="<%= anchor_base %>#templates" class="sr-btn px-4 py-2.5 rounded-xl text-[15px]" style="color: rgba(238,243,238,0.78)"><%= t('nav.templates') %></a>
  </nav>
  <div class="flex items-center gap-2">
    <% locale_classes = "sr-btn glass-soft h-11 min-w-11 px-3 rounded-xl text-mist sr-mono text-[13px] font-semibold cursor-pointer" %>
    <% if local_assigns[:locale_link] %>
      <%= link_to (target_locale == 'ar' ? 'ع' : 'EN'), root_path(locale: target_locale), class: "#{locale_classes} flex items-center justify-center", title: t('language.switch') %>
    <% else %>
      <%= button_to locale_path(target_locale), method: :patch, form_class: "contents", class: locale_classes, title: t('language.switch') do %><%= target_locale == 'ar' ? 'ع' : 'EN' %><% end %>
    <% end %>
    <% if credit_balance %>
      <%= link_to credits_path, class: "sr-btn glass-soft hidden sm:flex items-center gap-2 h-11 min-w-11 px-3 rounded-xl text-mist", title: t('ux_credits.credits'), "aria-label": t('ux_credits.chip_label', count: number_with_delimiter(credit_balance)), data: { testid: "header-credit-chip" } do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none shrink-0" style="color: #d6b877"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 9.5h4.5a2 2 0 010 4H10a2 2 0 000 4H15"/></svg><span class="sr-mono text-[14px] font-semibold" dir="ltr"><%= number_with_delimiter(credit_balance) %></span>
      <% end %>
    <% end %>
    <% if user_signed_in? %>
      <%= link_to profile_path, class: "sr-btn hidden md:flex items-center h-11 px-3 rounded-xl", title: current_user.email, "aria-label": current_user.email do %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      <% end %>
      <%= form_with url: "/auth/logout", method: :delete, class: "hidden md:flex" do %>
        <button type="submit" class="sr-btn flex items-center h-11 px-3 rounded-xl text-mist/80 hover:text-red-300 cursor-pointer" title="<%= t('nav.logout') %>" aria-label="<%= t('nav.logout') %>">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l-5-5 5-5M5 12h11"/></svg>
        </button>
      <% end %>
    <% else %>
      <a href="<%= login_path %>" class="sr-btn hidden md:flex items-center h-11 px-4 rounded-xl text-[15px]"><%= t('nav.login') %></a>
    <% end %>
    <a href="<%= build_href %>" class="sr-btn sr-primary hidden sm:flex items-center h-11 px-5 rounded-xl text-[15px] font-semibold" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.45)"><%= t('nav.build_cv') %></a>
    <button id="mobileMenuBtn" type="button" class="sr-btn glass-soft lg:hidden flex items-center justify-center h-11 w-11 rounded-xl text-mist" aria-label="Menu" aria-controls="mobile-menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>

<!-- Mobile menu -->
<div id="mobile-menu" class="fixed inset-0 z-[60] translate-x-full lg:hidden flex flex-col h-[100dvh]" style="background: rgba(7,18,13,0.92); -webkit-backdrop-filter: blur(28px); backdrop-filter: blur(28px)">
  <div class="flex items-center justify-between px-4 sm:px-6 h-20 shrink-0">
    <span class="flex items-center gap-3">
      <span class="glass flex items-center justify-center w-11 h-11 rounded-[13px] text-mist"><%= render "shared/logo_mark", size: 30 %></span>
      <span class="text-[22px] font-semibold">سيرة</span>
    </span>
    <button id="closeMobileMenu" type="button" class="sr-btn glass-soft flex items-center justify-center h-11 w-11 rounded-xl text-mist" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5l5 5M14.5 9.5l-5 5"/></svg>
    </button>
  </div>
  <div class="flex-1 flex flex-col gap-3 p-4 sm:p-6 overflow-y-auto">
    <% if user_signed_in? %>
      <%= link_to t('nav.my_cv'), resumes_path, class: "glass-soft sr-btn rounded-2xl px-5 py-4 text-xl" %>
      <% if Coach.enabled_for?(current_user) %>
        <%= link_to t('nav.coach'), coach_root_path, class: "glass-soft sr-btn rounded-2xl px-5 py-4 text-xl" %>
      <% end %>
    <% end %>
    <a href="<%= anchor_base %>#features" class="glass-soft sr-btn rounded-2xl px-5 py-4 text-xl"><%= t('nav.features') %></a>
    <a href="<%= anchor_base %>#how-it-works" class="glass-soft sr-btn rounded-2xl px-5 py-4 text-xl"><%= t('nav.how_it_works') %></a>
    <a href="<%= anchor_base %>#templates" class="glass-soft sr-btn rounded-2xl px-5 py-4 text-xl"><%= t('nav.templates') %></a>
    <div class="mt-4 flex flex-col gap-3">
      <% if credit_balance %>
        <%= link_to credits_path, class: "sr-btn glass-soft flex items-center justify-between gap-3 min-h-[52px] px-5 rounded-2xl text-lg", data: { testid: "mobile-credit-chip" } do %>
          <span class="flex items-center gap-2"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none shrink-0" style="color: #d6b877"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 9.5h4.5a2 2 0 010 4H10a2 2 0 000 4H15"/></svg><span><%= t('ux_credits.credits') %></span></span>
          <span class="sr-mono font-semibold" dir="ltr" style="color: #d6b877"><%= number_with_delimiter(credit_balance) %></span>
        <% end %>
      <% end %>
      <% if user_signed_in? %>
        <%= link_to profile_path, class: "sr-btn flex items-center gap-2 px-5 py-3 rounded-2xl", style: "color: rgba(238,243,238,0.75)" do %>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg><span class="truncate"><%= current_user.email %></span>
        <% end %>
        <%= form_with url: "/auth/logout", method: :delete do %>
          <button type="submit" class="sr-btn w-full flex items-center gap-2 px-5 py-3 rounded-2xl text-mist/75 hover:text-red-300 cursor-pointer">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l-5-5 5-5M5 12h11"/></svg><span><%= t('nav.logout_full') %></span>
          </button>
        <% end %>
      <% else %>
        <a href="<%= login_path %>" class="sr-btn glass-soft flex items-center justify-center min-h-[52px] rounded-2xl text-lg"><%= t('nav.login') %></a>
      <% end %>
      <a href="<%= build_href %>" class="sr-btn sr-primary flex items-center justify-center min-h-[56px] rounded-2xl text-lg font-semibold" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)"><%= t('nav.build_cv') %></a>
    </div>
  </div>
</div>

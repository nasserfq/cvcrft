<% size = local_assigns.fetch(:size, 32) %>
<% animate = local_assigns.fetch(:animate, false) %>
<svg width="<%= size %>" height="<%= size %>" viewBox="15 22 170 170" aria-hidden="true" class="<%= 'seera-mark' if animate %>">

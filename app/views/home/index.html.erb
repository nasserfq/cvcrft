<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= text_direction %>" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t('site.name') %> | <%= t('site.tagline') %></title>
    <meta name="description" content="<%= t('site.description') %>" />
    <meta name="theme-color" content="#07120D" />
    
    <!-- Canonical & Language Alternates -->
    <link rel="canonical" href="https://cvcrft.com<%= request.path == '/' ? '' : request.path %>" />
    <link rel="alternate" hreflang="ar" href="https://cvcrft.com/?locale=ar" />
    <link rel="alternate" hreflang="en" href="https://cvcrft.com/?locale=en" />
    <link rel="alternate" hreflang="x-default" href="https://cvcrft.com/" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cvcrft.com/" />
    <meta property="og:title" content="<%= t('site.name') %> - <%= t('site.tagline') %>" />
    <meta property="og:description" content="<%= t('site.description') %>" />
    <meta property="og:image" content="https://cvcrft.com/og-image.png" />
    <meta property="og:locale" content="<%= current_locale == 'ar' ? 'ar_SA' : 'en_US' %>" />
    <meta property="og:locale:alternate" content="<%= current_locale == 'ar' ? 'en_US' : 'ar_SA' %>" />
    <meta property="og:site_name" content="<%= t('site.name') %>" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://cvcrft.com/" />
    <meta name="twitter:title" content="<%= t('site.name') %> - <%= t('site.tagline') %>" />
    <meta name="twitter:description" content="<%= t('site.description') %>" />
    <meta name="twitter:image" content="https://cvcrft.com/og-image.png" />
    
    <!-- Favicon -->
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render 'shared/posthog' %>
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://cvcrft.com/#website",
          "url": "https://cvcrft.com/",
          "name": "<%= t('site.name') %>",
          "description": "<%= t('site.description') %>",
          "inLanguage": ["ar", "en"],
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://cvcrft.com/resumes?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Organization",
          "@id": "https://cvcrft.com/#organization",
          "name": "<%= t('site.name') %>",
          "url": "https://cvcrft.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://cvcrft.com/icon.png"
          },
          "sameAs": []
        },
        {
          "@type": "SoftwareApplication",
          "name": "<%= t('site.name') %>",
          "description": "<%= t('site.description') %>",
          "url": "https://cvcrft.com/",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.8",
            "ratingCount": "53"
          }
        }
      ]
    }
    </script>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" /></noscript>

    <style>

    <%# The landing page follows the Seera glass canvas design, which is dark only. %>
    <style>
      body { margin: 0; background: #07120d; font-feature-settings: "ss01", "ss02"; -webkit-font-smoothing: antialiased; }
      .sr-page a { color: #eef3ee; text-decoration: none; }
      .sr-page a:hover { color: #ffffff; }
      .sr-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
      iconify-icon { display: inline-block; vertical-align: middle; }

      .glass { background: linear-gradient(155deg, rgba(255,255,255,0.11), rgba(255,255,255,0.03)); -webkit-backdrop-filter: blur(28px) saturate(150%); backdrop-filter: blur(28px) saturate(150%); border: 1px solid rgba(255,255,255,0.13); box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), inset 0 -1px 0 rgba(255,255,255,0.03), 0 30px 60px -30px rgba(2,12,7,0.7); }
      .glass-soft { background: rgba(255,255,255,0.05); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); border: 1px solid rgba(255,255,255,0.09); box-shadow: inset 0 1px 0 rgba(255,255,255,0.1); }

      .sr-btn { position: relative; overflow: hidden; transition: transform .35s cubic-bezier(.16,1,.3,1), background .35s cubic-bezier(.16,1,.3,1), border-color .35s; }
      .sr-btn:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.28); }
      .sr-btn:active { transform: scale(.98); }
      .sr-btn:focus-visible { outline: 2px solid #d6b877; outline-offset: 3px; }
      .sr-btn::before { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 35%, rgba(255,255,255,0.22) 50%, transparent 65%); transform: translateX(110%); transition: transform .9s cubic-bezier(.16,1,.3,1); pointer-events: none; }
      .sr-btn:hover::before { transform: translateX(-110%); }
      .sr-btn .sr-ico { transition: transform .5s cubic-bezier(.16,1,.3,1); }
      .sr-btn:hover .sr-ico { transform: translateX(-4px); }
      [dir="ltr"] .sr-btn:hover .sr-ico { transform: translateX(4px); }
      [dir="ltr"] .sr-arrow { transform: scaleX(-1); }
      .sr-primary { background: #0b7f48; color: #ffffff !important; }
      .sr-primary:hover { background: #0d8c50; }

      .sr-lift { transition: transform .5s cubic-bezier(.16,1,.3,1), border-color .5s; }
      .sr-lift:hover { transform: translateY(-4px); border-color: rgba(255,255,255,0.22); }
      .sr-lift .sr-ico { transition: transform .6s cubic-bezier(.34,1.56,.64,1); }
      .sr-lift:hover .sr-ico { transform: rotate(-8deg) scale(1.08); }

      @keyframes sr-drift1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-60px,40px) scale(1.08); } }
      @keyframes sr-drift2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(50px,-50px) scale(.94); } }
      @keyframes sr-floaty { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
      @keyframes sr-pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .45; transform: scale(.8); } }
      @keyframes sr-shimmer { 0% { transform: translateX(120%); } 100% { transform: translateX(-120%); } }
      @keyframes sr-spin { to { transform: rotate(360deg); } }
      @keyframes sr-wordIn { from { opacity: 0; filter: blur(12px); transform: translateY(.4em); } to { opacity: 1; filter: blur(0); transform: none; } }
      @keyframes sr-fadeUp { from { opacity: 0; filter: blur(6px); transform: translateY(22px); } to { opacity: 1; filter: blur(0); transform: none; } }
      @keyframes sr-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
      @keyframes sr-ring { from { stroke-dashoffset: 314; } to { stroke-dashoffset: 16; } }
      @keyframes sr-reveal { from { opacity: 0; transform: translateY(48px) scale(.97); filter: blur(8px); } to { opacity: 1; transform: none; filter: blur(0); } }
      @keyframes sr-mask { from { clip-path: inset(0 0 100% 0); transform: translateY(40%); } to { clip-path: inset(0 0 -10% 0); transform: none; } }

      .sr-orb1 { animation: sr-drift1 18s ease-in-out infinite; }
      .sr-orb2 { animation: sr-drift2 22s ease-in-out infinite; }
      .sr-orb3 { animation: sr-drift1 26s ease-in-out infinite reverse; }
      .sr-float { animation: sr-floaty 7s ease-in-out infinite; }
      .sr-dot { animation: sr-pulse 2.4s ease-in-out infinite; }
      .sr-shim { position: relative; overflow: hidden; }
      .sr-shim::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,0.18) 50%, transparent 70%); animation: sr-shimmer 3.2s ease-in-out infinite; }
      .sr-spin { animation: sr-spin 140s linear infinite; }
      .sr-w { display: inline-block; animation: sr-wordIn 1.1s cubic-bezier(.16,1,.3,1) backwards; }
      .sr-up { animation: sr-fadeUp 1s cubic-bezier(.16,1,.3,1) backwards; }
      .sr-grow { display: block; transform-origin: right center; animation: sr-grow 1.1s cubic-bezier(.65,0,.35,1) backwards; }
      [dir="ltr"] .sr-grow { transform-origin: left center; }
      .sr-ring { animation: sr-ring 2.2s cubic-bezier(.65,0,.35,1) 1s backwards; }

      /* Scroll reveals: CSS scroll timelines where supported, otherwise
         the script at the bottom adds .is-in as each block comes into view. */
      @supports (animation-timeline: view()) {
        .sr-reveal { animation: sr-reveal linear backwards; animation-timeline: view(); animation-range: entry 0% entry 90%; }
        .sr-mask { animation: sr-mask linear backwards; animation-timeline: view(); animation-range: entry 10% entry 80%; }
      }
      @supports not (animation-timeline: view()) {
        .sr-io .sr-reveal { opacity: 0; transform: translateY(48px) scale(.97); filter: blur(8px); transition: opacity 1s cubic-bezier(.16,1,.3,1), transform 1s cubic-bezier(.16,1,.3,1), filter 1s cubic-bezier(.16,1,.3,1); }
        .sr-io .sr-reveal.is-in { opacity: 1; transform: none; filter: blur(0); }
        .sr-io .sr-mask { clip-path: inset(0 0 100% 0); transform: translateY(40%); transition: clip-path .9s cubic-bezier(.16,1,.3,1), transform .9s cubic-bezier(.16,1,.3,1); }
        .sr-io .sr-mask.is-in { clip-path: inset(0 0 -10% 0); transform: none; }
      }

      #mobile-menu { transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease; }

      @media (prefers-reduced-motion: reduce) {
        .sr-w, .sr-up, .sr-grow, .sr-ring, .sr-reveal, .sr-mask, .sr-orb1, .sr-orb2, .sr-orb3, .sr-float, .sr-dot, .sr-shim::after, .sr-spin { animation: none !important; }
        .sr-io .sr-reveal, .sr-io .sr-mask { opacity: 1; transform: none; filter: none; clip-path: none; transition: none; }
        .sr-btn::before { display: none; }
      }
    </style>
  </head>
  <body class="bg-darkBase text-mist overflow-x-hidden">
    <% build_href = user_signed_in? ? new_resume_path : login_path(return_to: new_resume_path) %>
    <% target_locale = current_locale == 'ar' ? 'en' : 'ar' %>
    <% arrow = '<svg class="sr-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>'.html_safe %>

    <div class="sr-page relative overflow-clip min-h-dvh leading-relaxed" style="background: #07120d; color: #eef3ee; line-height: 1.6">

      <!-- Ambient light -->
      <div aria-hidden="true" class="absolute inset-0 pointer-events-none">
        <svg class="sr-spin" width="560" height="560" viewBox="0 0 100 100" style="position: absolute; top: 110px; left: -80px; opacity: 0.14"><g fill="none" stroke="#d6b877" stroke-width="0.35"><rect x="20" y="20" width="60" height="60"></rect><rect x="20" y="20" width="60" height="60" transform="rotate(45 50 50)"></rect><rect x="32" y="32" width="36" height="36" transform="rotate(22.5 50 50)"></rect><rect x="32" y="32" width="36" height="36" transform="rotate(67.5 50 50)"></rect><circle cx="50" cy="50" r="12"></circle><circle cx="50" cy="50" r="42.5"></circle></g></svg>
        <svg class="sr-spin" width="440" height="440" viewBox="0 0 100 100" style="position: absolute; top: 2380px; right: -120px; opacity: 0.12"><g fill="none" stroke="#d6b877" stroke-width="0.4"><rect x="20" y="20" width="60" height="60"></rect><rect x="20" y="20" width="60" height="60" transform="rotate(45 50 50)"></rect><circle cx="50" cy="50" r="16"></circle></g></svg>
        <div class="sr-orb1" style="position: absolute; top: -180px; right: -120px; width: 720px; height: 720px; border-radius: 50%; background: radial-gradient(circle, rgba(0,140,78,0.55), rgba(0,140,78,0) 65%); filter: blur(40px)"></div>
        <div class="sr-orb2" style="position: absolute; top: 380px; left: -220px; width: 760px; height: 760px; border-radius: 50%; background: radial-gradient(circle, rgba(200,169,106,0.42), rgba(200,169,106,0) 65%); filter: blur(50px)"></div>
        <div class="sr-orb3" style="position: absolute; top: 1500px; right: 8%; width: 620px; height: 620px; border-radius: 50%; background: radial-gradient(circle, rgba(0,108,53,0.35), rgba(0,108,53,0) 65%); filter: blur(50px)"></div>
        <div class="sr-orb2" style="position: absolute; top: 2500px; left: 4%; width: 680px; height: 680px; border-radius: 50%; background: radial-gradient(circle, rgba(214,184,119,0.38), rgba(214,184,119,0) 65%); filter: blur(60px)"></div>
        <div class="sr-orb1" style="position: absolute; top: 3400px; right: 20%; width: 760px; height: 760px; border-radius: 50%; background: radial-gradient(circle, rgba(0,150,85,0.4), rgba(0,150,85,0) 65%); filter: blur(60px)"></div>
      </div>

      <div class="relative mx-auto max-w-[1240px] px-4 sm:px-6 pt-4 sm:pt-6 pb-10">

        <!-- Nav -->
        <header class="glass sticky top-3 sm:top-4 z-50 flex items-center justify-between gap-4 rounded-[22px] py-3 ps-4 pe-3 sm:ps-5">
          <a href="#top" class="flex items-center gap-3">
            <span class="glass flex items-center justify-center w-11 h-11 rounded-[13px] text-mist"><%= render "shared/logo_mark", size: 32, animate: true %></span>
            <span class="text-[22px] font-semibold tracking-[-0.01em]">سيرة</span>
          </a>
          <nav aria-label="<%= t('nav.features') %>" class="hidden lg:flex flex-wrap gap-1">
            <% if user_signed_in? %>
              <%= link_to t('nav.my_cv'), resumes_path, class: "sr-btn px-4 py-2.5 rounded-xl text-[15px]", style: "color: rgba(238,243,238,0.78)" %>
            <% end %>
            <a href="#features" class="sr-btn px-4 py-2.5 rounded-xl text-[15px]" style="color: rgba(238,243,238,0.78)"><%= t('nav.features') %></a>
            <a href="#how-it-works" class="sr-btn px-4 py-2.5 rounded-xl text-[15px]" style="color: rgba(238,243,238,0.78)"><%= t('nav.how_it_works') %></a>
            <a href="#templates" class="sr-btn px-4 py-2.5 rounded-xl text-[15px]" style="color: rgba(238,243,238,0.78)"><%= t('nav.templates') %></a>
          </nav>
          <div class="flex items-center gap-2">
            <%= button_to locale_path(target_locale), method: :patch, form_class: "contents", class: "sr-btn glass-soft h-11 min-w-11 px-3 rounded-xl text-mist sr-mono text-[13px] font-semibold cursor-pointer", title: t('language.switch') do %><%= target_locale == 'ar' ? 'ع' : 'EN' %><% end %>
            <% if user_signed_in? %>
              <%= link_to profile_path, class: "sr-btn hidden md:flex items-center h-11 px-3 rounded-xl", title: current_user.email, "aria-label": current_user.email do %>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              <% end %>
              <%= form_with url: "/auth/logout", method: :delete, class: "hidden md:flex" do %>
                <button type="submit" class="sr-btn flex items-center h-11 px-3 rounded-xl text-mist/80 hover:text-red-300 cursor-pointer" title="<%= t('nav.logout') %>" aria-label="<%= t('nav.logout') %>">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l-5-5 5-5M5 12h11"/></svg>
                </button>
              <% end %>
            <% else %>
              <a href="<%= login_path %>" class="sr-btn hidden md:flex items-center h-11 px-4 rounded-xl text-[15px]"><%= t('nav.login') %></a>
            <% end %>
            <a href="<%= build_href %>" class="sr-btn sr-primary hidden sm:flex items-center h-11 px-5 rounded-xl text-[15px] font-semibold" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.45)"><%= t('nav.build_cv') %></a>
            <button id="mobileMenuBtn" type="button" class="sr-btn glass-soft lg:hidden flex items-center justify-center h-11 w-11 rounded-xl text-mist" aria-label="Menu" aria-controls="mobile-menu">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
          </div>
        </header>

        <!-- Mobile menu -->
        <div id="mobile-menu" class="fixed inset-0 z-[60] translate-x-full lg:hidden flex flex-col h-[100dvh]" style="background: rgba(7,18,13,0.92); -webkit-backdrop-filter: blur(28px); backdrop-filter: blur(28px)">
          <div class="flex items-center justify-between px-4 sm:px-6 h-20 shrink-0">
            <span class="flex items-center gap-3">
              <span class="glass flex items-center justify-center w-11 h-11 rounded-[13px] text-mist"><%= render "shared/logo_mark", size: 30 %></span>
              <span class="text-[22px] font-semibold">سيرة</span>
            </span>
            <button id="closeMobileMenu" type="button" class="sr-btn glass-soft flex items-center justify-center h-11 w-11 rounded-xl text-mist" aria-label="Close">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5l5 5M14.5 9.5l-5 5"/></svg>
            </button>
          </div>
          <div class="flex-1 flex flex-col gap-3 p-4 sm:p-6 overflow-y-auto">
            <% if user_signed_in? %>
              <%= link_to t('nav.my_cv'), resumes_path, class: "glass-soft sr-btn rounded-2xl px-5 py-4 text-xl" %>
            <% end %>
            <a href="#features" class="glass-soft sr-btn rounded-2xl px-5 py-4 text-xl"><%= t('nav.features') %></a>
            <a href="#how-it-works" class="glass-soft sr-btn rounded-2xl px-5 py-4 text-xl"><%= t('nav.how_it_works') %></a>
            <a href="#templates" class="glass-soft sr-btn rounded-2xl px-5 py-4 text-xl"><%= t('nav.templates') %></a>
            <div class="mt-4 flex flex-col gap-3">
              <% if user_signed_in? %>
                <%= link_to profile_path, class: "sr-btn flex items-center gap-2 px-5 py-3 rounded-2xl", style: "color: rgba(238,243,238,0.75)" do %>
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg><span class="truncate"><%= current_user.email %></span>
                <% end %>
                <%= form_with url: "/auth/logout", method: :delete do %>
                  <button type="submit" class="sr-btn w-full flex items-center gap-2 px-5 py-3 rounded-2xl text-mist/75 hover:text-red-300 cursor-pointer">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="pointer-events-none"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l-5-5 5-5M5 12h11"/></svg><span><%= t('nav.logout_full') %></span>
                  </button>
                <% end %>
              <% else %>
                <a href="<%= login_path %>" class="sr-btn glass-soft flex items-center justify-center min-h-[52px] rounded-2xl text-lg"><%= t('nav.login') %></a>
              <% end %>
              <a href="<%= build_href %>" class="sr-btn sr-primary flex items-center justify-center min-h-[56px] rounded-2xl text-lg font-semibold" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)"><%= t('nav.build_cv') %></a>
            </div>
          </div>
        </div>

        <!-- Hero -->
        <section id="top" class="grid gap-14 items-center pt-16 pb-24 md:pt-24 md:pb-[120px]" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr))">
          <div class="flex flex-col gap-7">
            <span class="glass-soft sr-up self-start inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-sm" style="animation-delay: 0s; color: rgba(238,243,238,0.9)">
              <span class="sr-dot w-2 h-2 rounded-full bg-primary"></span>
              <%= t('home.hero_badge') %>
            </span>
            <h1 class="m-0 font-semibold" style="font-size: clamp(40px, 5.4vw, 68px); line-height: 1.15; letter-spacing: -0.02em">
              <% delay = 0.1 %>
              <% t('home.hero_title_1').split.each do |word| %><span class="sr-w" style="animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
              <% delay += 0.04 %>
              <% t('home.hero_title_2').split.each do |word| %><span class="sr-w" style="color: #d6b877; animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
            </h1>
            <p class="sr-up m-0 text-[17px] sm:text-[19px] font-light max-w-[56ch]" style="animation-delay: .7s; color: rgba(238,243,238,0.7)"><%= t('home.hero_description') %></p>
            <div class="sr-up grid grid-cols-1 min-[420px]:grid-cols-2 gap-2.5 max-w-[520px]" style="animation-delay: .85s">

<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= text_direction %>" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t('site.name') %> | <%= t('site.tagline') %></title>
    <meta name="description" content="<%= t('site.description') %>" />
    <meta name="theme-color" content="#7B2FF7" />
    
    <!-- Canonical & Language Alternates -->
    <link rel="canonical" href="https://cvcrft.com<%= request.path == '/' ? '' : request.path %>" />
    <link rel="alternate" hreflang="ar" href="https://cvcrft.com/?locale=ar" />
    <link rel="alternate" hreflang="en" href="https://cvcrft.com/?locale=en" />
    <link rel="alternate" hreflang="x-default" href="https://cvcrft.com/" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cvcrft.com/" />
    <meta property="og:title" content="<%= t('site.name') %> - <%= t('site.tagline') %>" />
    <meta property="og:description" content="<%= t('site.description') %>" />
    <meta property="og:image" content="https://cvcrft.com/og-image.png" />
    <meta property="og:locale" content="<%= current_locale == 'ar' ? 'ar_SA' : 'en_US' %>" />
    <meta property="og:locale:alternate" content="<%= current_locale == 'ar' ? 'en_US' : 'ar_SA' %>" />
    <meta property="og:site_name" content="<%= t('site.name') %>" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://cvcrft.com/" />
    <meta name="twitter:title" content="<%= t('site.name') %> - <%= t('site.tagline') %>" />
    <meta name="twitter:description" content="<%= t('site.description') %>" />
    <meta name="twitter:image" content="https://cvcrft.com/og-image.png" />
    
    <!-- Favicon -->
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render 'shared/posthog' %>
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://cvcrft.com/#website",
          "url": "https://cvcrft.com/",
          "name": "<%= t('site.name') %>",
          "description": "<%= t('site.description') %>",
          "inLanguage": ["ar", "en"],
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://cvcrft.com/resumes?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Organization",
          "@id": "https://cvcrft.com/#organization",
          "name": "<%= t('site.name') %>",
          "url": "https://cvcrft.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://cvcrft.com/icon.png"
          },
          "sameAs": []
        },
        {
          "@type": "SoftwareApplication",
          "name": "<%= t('site.name') %>",
          "description": "<%= t('site.description') %>",
          "url": "https://cvcrft.com/",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.8",
            "ratingCount": "53"
          }
        }
      ]
    }
    </script>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>

    <style>
      body {
          font-feature-settings: "ss01", "ss02";
          -webkit-font-smoothing: antialiased;
      }
      /* Custom Scrollbar */
      ::-webkit-scrollbar {
          width: 6px;
      }
      ::-webkit-scrollbar-track {
          background: transparent;
      }
      ::-webkit-scrollbar-thumb {
          background: #cbd5e1;
          border-radius: 3px;
      }
      .dark ::-webkit-scrollbar-thumb {
          background: #333;
      }

      .gradient-text {
          background-clip: text;
          -webkit-background-clip: text;
          color: transparent;
          background-image: linear-gradient(135deg, #7C6CF2 0%, #2ED3B7 100%);
      }

      .blob {
          position: absolute;
          filter: blur(90px);
          opacity: 0.5;
          z-index: -1;
          animation: pulse 10s infinite alternate;
      }

      @keyframes pulse {
          0% { transform: scale(1); }
          100% { transform: scale(1.1); }
      }

      @keyframes scan {
          0% { top: 0%; opacity: 0; }
          10% { opacity: 1; }
          90% { opacity: 1; }
          100% { top: 100%; opacity: 0; }
      }

      /* Mobile Menu Transition */
      #mobile-menu {
          transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
      }

      iconify-icon {
          display: inline-block;
          vertical-align: middle;
      }
    </style>
  </head>
  <body
    class="bg-canvas text-darkBase transition-colors duration-300 selection:bg-action selection:text-darkBase dark:bg-darkBase dark:text-canvas overflow-x-hidden text-lg"
  >
    <!-- Background Blobs -->
    <div
      class="fixed top-0 left-0 w-full h-full overflow-hidden pointer-events-none"
    >
      <div
        class="blob bg-primary/5 dark:bg-primary/20 w-64 h-64 md:w-96 md:h-96 rounded-full top-[-10%] left-[-10%]"
      ></div>
      <div
        class="blob bg-action/5 dark:bg-action/10 w-64 h-64 md:w-[500px] md:h-[500px] rounded-full bottom-[-10%] right-[-10%] animation-delay-2000"
      ></div>
    </div>

    <!-- Navigation -->
    <nav
      class="fixed top-0 w-full z-50 border-b border-borderLight bg-white/80 backdrop-blur-xl dark:bg-darkBase/80 dark:border-borderDark"
    >
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 h-16 md:h-20 flex items-center justify-between"
      >
        <!-- Logo -->
        <div class="flex items-center gap-2 z-50">
          <a
            href="#"
            class="text-xl md:text-2xl font-medium tracking-tight text-darkBase dark:text-white flex items-center gap-2"
          >
            <span
              class="bg-primary text-white w-7 h-7 md:w-8 md:h-8 rounded-lg flex items-center justify-center text-sm font-semibold shadow-glow"
            >
              س
            </span>
            سيرة
          </a>
        </div>

        <!-- Desktop Menu -->
        <div
          class="hidden md:flex items-center gap-8 text-sm font-normal text-gray-500 dark:text-gray-400"
        >
          <% if user_signed_in? %>
            <%= link_to resumes_path, class: "hover:text-primary transition-colors" do %>
              <%= t('nav.my_cv') %>
            <% end %>
          <% end %>
          <a href="#features" class="hover:text-primary transition-colors">
            <%= t('nav.features') %>
          </a>
          <a href="#how-it-works" class="hover:text-primary transition-colors">
            <%= t('nav.how_it_works') %>
          </a>
          <a href="#templates" class="hover:text-primary transition-colors">
            <%= t('nav.templates') %>
          </a>
        </div>

        <!-- Actions -->
        <div class="hidden md:flex items-center gap-4">
          <!-- Language Toggle -->
          <% target_locale = current_locale == 'ar' ? 'en' : 'ar' %>
          <%= button_to locale_path(target_locale), method: :patch, class: "p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-gray-500 dark:text-gray-400 flex items-center gap-1 text-sm", title: t('language.switch') do %>
            <iconify-icon icon="solar:global-linear" width="20" height="20" class="pointer-events-none"></iconify-icon>
            <span class="font-medium"><%= target_locale == 'ar' ? 'ع' : 'EN' %></span>
          <% end %>
          
          <button
            id="themeToggle"
            onclick="var h=document.documentElement; if(h.classList.contains('dark')){h.classList.remove('dark');localStorage.theme='light';}else{h.classList.add('dark');localStorage.theme='dark';}"
            class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-gray-500 dark:text-gray-400"
          >
            <iconify-icon
              icon="solar:sun-2-linear"
              width="24"
              height="24"
              class="hidden dark:block pointer-events-none"
            ></iconify-icon>
            <iconify-icon
              icon="solar:moon-linear"
              width="24"
              height="24"
              class="block dark:hidden pointer-events-none"
            ></iconify-icon>
          </button>
          
          <% if user_signed_in? %>
            <%= link_to profile_path, class: "flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition-colors" do %>
              <iconify-icon icon="solar:user-linear" width="20"></iconify-icon>
              <span><%= current_user.email %></span>
            <% end %>
            <%= form_with url: "/auth/logout", method: :delete, class: "inline-flex" do |f| %>
              <button type="submit" class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 hover:text-red-500 transition-colors">
                <iconify-icon icon="solar:logout-2-linear" width="20"></iconify-icon>
                <span><%= t('nav.logout') %></span>
              </button>
            <% end %>
          <% end %>
          
          <a
            href="<%= user_signed_in? ? new_resume_path : login_path(return_to: new_resume_path) %>"
            class="flex items-center justify-center px-5 py-2 rounded-full bg-primary hover:bg-primaryHover text-white text-sm font-normal transition-all shadow-glow hover:shadow-lg"
          >
            <%= t('nav.build_cv') %>
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <div class="flex md:hidden items-center gap-4 z-50">
          <button
            id="themeToggleMobile"
            onclick="var h=document.documentElement; if(h.classList.contains('dark')){h.classList.remove('dark');localStorage.theme='light';}else{h.classList.add('dark');localStorage.theme='dark';}"
            class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-gray-500 dark:text-gray-400"
          >
            <iconify-icon
              icon="solar:sun-2-linear"
              width="22"
              height="22"
              class="hidden dark:block pointer-events-none"
            ></iconify-icon>
            <iconify-icon
              icon="solar:moon-linear"
              width="22"
              height="22"
              class="block dark:hidden pointer-events-none"
            ></iconify-icon>
          </button>
          <button
            id="mobileMenuBtn"
            onclick="document.getElementById('mobile-menu').classList.remove('translate-x-full'); document.body.style.overflow='hidden';"
            class="p-2 text-darkBase dark:text-white focus:outline-none"
          >
            <iconify-icon
              icon="solar:hamburger-menu-linear"
              width="26"
              stroke-width="1.5"
              class="pointer-events-none"
            ></iconify-icon>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Menu Overlay -->
    <div
      id="mobile-menu"
      class="fixed inset-0 z-[60] bg-white/95 dark:bg-darkBase/95 backdrop-blur-xl translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col h-[100dvh]"
    >
      <!-- Mobile Menu Header -->
      <div
        class="flex items-center justify-between px-4 sm:px-6 h-16 shrink-0 border-b border-borderLight dark:border-borderDark"
      >
        <!-- Logo -->
        <div class="flex items-center gap-2">
          <span
            class="bg-primary text-white w-7 h-7 rounded-lg flex items-center justify-center text-sm font-semibold shadow-glow"
          >
            س
          </span>
          <span
            class="text-xl font-medium tracking-tight text-darkBase dark:text-white"
          >
            سيرة
          </span>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3">
          <!-- Language Toggle -->
          <% target_locale_mobile = current_locale == 'ar' ? 'en' : 'ar' %>
          <%= button_to locale_path(target_locale_mobile), method: :patch, class: "p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-gray-500 dark:text-gray-400 flex items-center gap-1 text-sm", title: t('language.switch') do %>
            <iconify-icon icon="solar:global-linear" width="20" height="20" class="pointer-events-none"></iconify-icon>
            <span class="font-medium"><%= target_locale_mobile == 'ar' ? 'ع' : 'EN' %></span>
          <% end %>
          
          <button
            id="themeToggleMobileInside"
            onclick="var h=document.documentElement; if(h.classList.contains('dark')){h.classList.remove('dark');localStorage.theme='light';}else{h.classList.add('dark');localStorage.theme='dark';}"
            class="p-2 rounded-full hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-gray-500 dark:text-gray-400"
          >
            <iconify-icon
              icon="solar:sun-2-linear"
              width="24"
              height="24"
              class="hidden dark:block pointer-events-none"
            ></iconify-icon>
            <iconify-icon
              icon="solar:moon-linear"
              width="24"
              height="24"
              class="block dark:hidden pointer-events-none"
            ></iconify-icon>
          </button>
          <button
            id="closeMobileMenu"
            onclick="document.getElementById('mobile-menu').classList.add('translate-x-full'); document.body.style.overflow='';"
            class="p-2 text-gray-500 hover:text-darkBase dark:hover:text-white transition-colors"
          >
            <iconify-icon
              icon="solar:close-circle-linear"
              width="28"
              stroke-width="1.5"
              class="pointer-events-none"
            ></iconify-icon>
          </button>
        </div>
      </div>

      <!-- Menu Items -->
      <div
        class="flex-1 flex flex-col items-center justify-center gap-8 p-6 overflow-y-auto"
      >
        <% if user_signed_in? %>
          <%= link_to resumes_path, class: "mobile-link text-2xl font-normal text-darkBase dark:text-white hover:text-primary transition-colors tracking-tight" do %>
            <%= t('nav.my_cv') %>
          <% end %>
        <% end %>
        <a
          href="#features"
          onclick="var menu=document.getElementById('mobile-menu'); menu.classList.add('translate-x-full'); document.body.style.overflow=''; setTimeout(function(){ window.location.hash='features'; }, 50); return false;"
          class="mobile-link text-2xl font-normal text-darkBase dark:text-white hover:text-primary transition-colors tracking-tight"
        >
          <%= t('nav.features') %>
        </a>
        <a
          href="#how-it-works"
          onclick="var menu=document.getElementById('mobile-menu'); menu.classList.add('translate-x-full'); document.body.style.overflow=''; setTimeout(function(){ window.location.hash='how-it-works'; }, 50); return false;"
          class="mobile-link text-2xl font-normal text-darkBase dark:text-white hover:text-primary transition-colors tracking-tight"
        >
          <%= t('nav.how_it_works') %>
        </a>
        <a
          href="#templates"
          onclick="var menu=document.getElementById('mobile-menu'); menu.classList.add('translate-x-full'); document.body.style.overflow=''; setTimeout(function(){ window.location.hash='templates'; }, 50); return false;"
          class="mobile-link text-2xl font-normal text-darkBase dark:text-white hover:text-primary transition-colors tracking-tight"
        >
          <%= t('nav.templates') %>
        </a>

        <div class="pt-6 border-t border-borderLight dark:border-borderDark w-full max-w-[280px] space-y-4">
          <% if user_signed_in? %>
            <%= link_to profile_path, class: "mobile-link flex items-center justify-center gap-2 text-lg text-gray-600 dark:text-gray-400 hover:text-primary transition-colors" do %>
              <iconify-icon icon="solar:user-linear" width="24"></iconify-icon>
              <span><%= current_user.email %></span>
            <% end %>
            <%= form_with url: "/auth/logout", method: :delete, class: "w-full" do |f| %>
              <button type="submit" class="w-full flex items-center justify-center gap-2 text-lg text-gray-600 dark:text-gray-400 hover:text-red-500 transition-colors">
                <iconify-icon icon="solar:logout-2-linear" width="24"></iconify-icon>
                <span><%= t('nav.logout_full') %></span>
              </button>
            <% end %>
          <% else %>
            <a href="/login" class="mobile-link flex items-center justify-center gap-2 text-lg text-gray-600 dark:text-gray-400 hover:text-primary transition-colors">
              <iconify-icon icon="solar:login-2-linear" width="24"></iconify-icon>
              <span><%= t('nav.login') %></span>
            </a>
          <% end %>
        </div>

        <a
          href="<%= user_signed_in? ? new_resume_path : login_path(return_to: new_resume_path) %>"
          class="w-full max-w-[280px] py-4 rounded-2xl bg-primary hover:bg-primaryHover text-white text-lg font-medium shadow-glow text-center transition-all mt-6"
        >
          <%= t('nav.build_cv') %>
        </a>
      </div>
    </div>

    <!-- Hero Section -->
    <header
      class="relative pt-32 pb-16 md:pt-40 md:pb-24 lg:pt-52 lg:pb-36 px-4 sm:px-6 overflow-hidden"
    >
      <div
        class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-20 items-center"
      >
        <!-- Content -->
        <div
          class="flex flex-col gap-6 md:gap-8 text-center lg:text-right order-1"
        >
          <div
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-primary/20 bg-primary/5 dark:bg-primary/10 w-fit mx-auto lg:mx-0 backdrop-blur-md"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-action opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-action"
              ></span>
            </span>
            <span
              class="text-primary dark:text-action text-xs md:text-sm font-normal tracking-wide"
            >
              <%= t('home.hero_badge') %>
            </span>
          </div>

          <h1
            class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-medium leading-[1.15] md:leading-[1.1] tracking-tight text-darkBase dark:text-white"
          >
            <%= t('home.hero_title_1') %>
            <br />
            <span class="gradient-text"><%= t('home.hero_title_2') %></span>
          </h1>

          <p
            class="text-base sm:text-lg md:text-xl text-gray-600 dark:text-gray-400 font-normal leading-relaxed max-w-xl mx-auto lg:mx-0"
          >
            <%= t('home.hero_description') %>
          </p>

          <!-- Buttons Grid -->
          <div
            class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full max-w-lg mx-auto lg:mx-0 mt-8"
          >
            <!-- Resume Builder (Purple) -->
            <a
              href="<%= user_signed_in? ? new_resume_path : login_path(return_to: new_resume_path) %>"
              class="flex items-center justify-between p-4 rounded-xl bg-primary text-white hover:bg-primaryHover hover:shadow-glow transition-all group"
            >
              <span class="font-medium text-base"><%= t('home.resume_builder') %></span>
              <iconify-icon
                icon="solar:document-add-linear"
                width="24"
                class="text-white/95"
              ></iconify-icon>
            </a>

            <!-- Generate CV (Dark / Green) -->
            <a
              href="<%= user_signed_in? ? new_cv_generation_path : login_path(return_to: new_cv_generation_path) %>"
              class="flex items-center justify-between p-4 rounded-xl bg-white dark:bg-white/5 border border-borderLight dark:border-borderDark hover:border-action dark:hover:bg-white/10 transition-all group text-darkBase dark:text-white hover:bg-lavender-50"
            >
              <span class="font-medium text-base"><%= t('home.generate_by_job') %></span>
              <iconify-icon
                icon="solar:magic-stick-3-linear"
                width="24"
                class="text-action-700 dark:text-action"
              ></iconify-icon>
            </a>

            <!-- Analyze CV (Dark / Orange) -->
            <a
              href="<%= user_signed_in? ? cv_analysis_path : login_path(return_to: cv_analysis_path) %>"
              class="flex items-center justify-between p-4 rounded-xl bg-white dark:bg-white/5 border border-borderLight dark:border-borderDark hover:border-orange-500 dark:hover:bg-white/10 transition-all group text-darkBase dark:text-white hover:bg-lavender-50"
            >
              <span class="font-medium text-base"><%= t('home.analyze_resume') %></span>
              <iconify-icon
                icon="solar:scanner-linear"
                width="24"
                class="text-orange-500"
              ></iconify-icon>
            </a>

            <!-- Import LinkedIn (Dark / Blue) -->
            <a
              href="<%= user_signed_in? ? linkedin_import_path : login_path(return_to: linkedin_import_path) %>"
              class="flex items-center justify-between p-4 rounded-xl bg-white dark:bg-white/5 border border-borderLight dark:border-borderDark hover:border-blue-500 dark:hover:bg-white/10 transition-all group text-darkBase dark:text-white hover:bg-lavender-50"
            >
              <span class="font-medium text-base"><%= t('home.import_from_linkedin') %></span>
              <iconify-icon
                icon="solar:upload-square-linear"
                width="24"
                class="text-blue-600 dark:text-blue-400"
              ></iconify-icon>
            </a>
          </div>

          <div
            class="flex items-center gap-4 justify-center lg:justify-start pt-2 md:pt-4 text-xs md:text-sm text-gray-500"
          >
            <div class="flex -space-x-3 space-x-reverse">
              <div
                class="w-8 h-8 rounded-full bg-gray-700 border-2 border-white dark:border-darkBase flex items-center justify-center text-[10px] text-white"
              >
                SA
              </div>
              <div
                class="w-8 h-8 rounded-full bg-gray-600 border-2 border-white dark:border-darkBase flex items-center justify-center text-[10px] text-white"
              >
                AE
              </div>
              <div
                class="w-8 h-8 rounded-full bg-gray-500 border-2 border-white dark:border-darkBase flex items-center justify-center text-[10px] text-white"
              >
                KW
              </div>
            </div>
            <p><%= t('home.trusted_by', count: number_with_delimiter(@users_count)) %></p>
          </div>
        </div>

        <!-- Visual Mockup -->
        <div
          class="relative order-2 perspective-1000 mt-8 lg:mt-0 w-full max-w-md lg:max-w-full mx-auto"
        >
          <div
            class="absolute inset-0 bg-primary/20 blur-[60px] md:blur-[100px] rounded-full"
          ></div>

          <!-- Glass Card -->
          <div
            class="relative bg-white/60 dark:bg-[#1C1C21]/60 backdrop-blur-xl rounded-2xl p-4 md:p-6 shadow-2xl transform lg:rotate-y-[-5deg] hover:rotate-y-0 transition-transform duration-500 border border-borderLight dark:border-borderDark"
          >
            <!-- Fake UI Header -->
            <div
              class="flex items-center justify-between mb-4 md:mb-6 border-b border-borderLight dark:border-borderDark pb-3 md:pb-4 dark:bg-darkCard/60"
            >
              <div class="flex gap-1.5 md:gap-2">
                <div

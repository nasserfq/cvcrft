                <span class="block rounded-md" style="height: 7px; width: 35%; background: #0b7f48; opacity: 0.8"></span>
                <span class="block my-2" style="height: 1px; background: rgba(255,255,255,0.14)"></span>
                <span class="block h-1.5 rounded-md" style="width: 92%; background: rgba(255,255,255,0.12)"></span>
                <span class="block h-1.5 rounded-md" style="width: 86%; background: rgba(255,255,255,0.12)"></span>
                <span class="block h-1.5 rounded-md" style="width: 74%; background: rgba(255,255,255,0.12)"></span>
                <span class="block rounded-md mt-2.5" style="height: 9px; width: 40%; background: rgba(255,255,255,0.22)"></span>
                <span class="block h-1.5 rounded-md" style="width: 90%; background: rgba(255,255,255,0.12)"></span>
                <span class="block h-1.5 rounded-md" style="width: 80%; background: rgba(255,255,255,0.12)"></span>

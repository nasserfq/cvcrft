            </div>
          </div>
        </section>

        </main>

        <%= render 'shared/site_footer' %>
      </div>
    </div>

    <%= render 'shared/site_scripts' %>
    <script>
      // Tagline reveal: each word lights up as it crosses a line 40% up from the bottom.
      (function () {
        var words = document.querySelectorAll('[data-lp-tagline] .lp-tw');
        if (!words.length) return;
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          words.forEach(function (w) { w.classList.add('is-on'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          var k = 0;
          entries.forEach(function (e) {
            var on = e.isIntersecting || e.boundingClientRect.top < 0;
            // Words that cross together still light up one by one, in reading order.
            e.target.style.transitionDelay = on ? (k++ * 70) + 'ms' : '0ms';
            e.target.classList.toggle('is-on', on);
          });
        }, { rootMargin: '0px 0px -40% 0px' });
        words.forEach(function (w) { io.observe(w); });
      })();
    </script>
  </body>
</html>

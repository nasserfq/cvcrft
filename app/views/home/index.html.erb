            <a href="<%= privacy_path %>" style="color: rgba(238,243,238,0.7)"><%= t('footer.privacy') %></a>
            <a href="mailto:support@cvcrft.com" style="color: rgba(238,243,238,0.7)"><%= t('footer.contact') %></a>
            <%= render 'shared/cookie_settings' %>

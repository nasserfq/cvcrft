                <%= t('home.cta_button') %>
                <span class="sr-ico flex"><%= arrow %></span>
              </a>
              <span class="text-[13px]" style="color: rgba(238,243,238,0.55)"><%= t('home.cta_no_card') %></span>
            </div>
          </div>

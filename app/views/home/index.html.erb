                <span class="flex flex-col gap-[9px]"><span class="block h-2.5 rounded-md" style="width: 70%; background: rgba(255,255,255,0.2)"></span><span class="block h-1.5 rounded-md" style="width: 95%; background: rgba(255,255,255,0.08)"></span></span>
              </div>
              <div class="glass sr-float absolute flex flex-col gap-2.5 p-6 box-border" style="top: 10px; left: 50%; margin-left: -28%; width: 56%; height: 90%; border-radius: 22px">

    <!-- Footer -->
    <!-- JavaScript for mobile menu and icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        // Initialize Lucide icons
        if (typeof lucide !== 'undefined') {
          lucide.createIcons({
            attrs: { 'stroke-width': 1.5 }
          });
        }

        // Mobile touch animation for buttons
        const buttons = document.querySelectorAll('a[class*="bg-"], button[class*="bg-"]');
        buttons.forEach(btn => {
          btn.addEventListener('touchstart', () => {
            btn.style.transform = 'scale(1.05)';
          }, { passive: true });
          btn.addEventListener('touchend', () => {
            setTimeout(() => {
              btn.style.transform = 'scale(1)';
            }, 150);
          }, { passive: true });
          btn.addEventListener('touchcancel', () => {
            btn.style.transform = 'scale(1)';
          }, { passive: true });
        });

              // Mobile menu functionality
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');

        console.log('Mobile menu button:', mobileMenuButton);
        console.log('Mobile menu:', mobileMenu);

        // Ensure mobile menu is hidden by default
        if (mobileMenu) {
          mobileMenu.classList.add('hidden');
          mobileMenu.style.display = 'none';
        }

        if (mobileMenuButton && mobileMenu) {
          mobileMenuButton.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            const isHidden = mobileMenu.classList.contains('hidden');
            console.log('Menu clicked, isHidden:', isHidden);

            if (isHidden) {
              mobileMenu.classList.remove('hidden');
              mobileMenu.style.display = 'block';
              // Change icon to close
              const icon = mobileMenuButton.querySelector('i');
              if (icon && typeof lucide !== 'undefined') {
                icon.setAttribute('data-lucide', 'x');
                lucide.createIcons();
              }
            } else {
              mobileMenu.classList.add('hidden');
              mobileMenu.style.display = 'none';
              // Change icon back to menu
              const icon = mobileMenuButton.querySelector('i');
              if (icon && typeof lucide !== 'undefined') {
                icon.setAttribute('data-lucide', 'menu');
                lucide.createIcons();
              }
            }
          });

          // Close mobile menu when clicking on a link
          const mobileMenuLinks = mobileMenu.querySelectorAll('a');
          mobileMenuLinks.forEach(link => {
            link.addEventListener('click', () => {
              mobileMenu.classList.add('hidden');
              mobileMenu.style.display = 'none';
              const icon = mobileMenuButton.querySelector('i');
              if (icon && typeof lucide !== 'undefined') {
                icon.setAttribute('data-lucide', 'menu');
                lucide.createIcons();
              }
            });
          });

          // Close mobile menu when clicking outside
          document.addEventListener('click', (e) => {
            if (!mobileMenuButton.contains(e.target) && !mobileMenu.contains(e.target)) {
              mobileMenu.classList.add('hidden');
              mobileMenu.style.display = 'none';
              const icon = mobileMenuButton.querySelector('i');
              if (icon && typeof lucide !== 'undefined') {
                icon.setAttribute('data-lucide', 'menu');
                lucide.createIcons();
              }
            }
          });
        } else {
          console.error('Mobile menu elements not found!');
        }

        // Loading animation for js-loading-btn links
        function resetLoadingBtns() {
          document.querySelectorAll('.js-loading-btn').forEach(btn => {
            const content = btn.querySelector('.js-btn-content');
            const spinner = btn.querySelector('.js-btn-spinner');
            if (content) {
              content.style.display = '';
            }
            if (spinner) {
              spinner.style.display = 'none';
            }
            btn.style.pointerEvents = '';
            btn.style.opacity = '';
          });
        }

        // Reset immediately
        resetLoadingBtns();

        // Reset on page events
        window.addEventListener('pageshow', resetLoadingBtns);
        window.addEventListener('load', resetLoadingBtns);

        document.addEventListener('click', (e) => {
          const btn = e.target.closest('.js-loading-btn');
          if (!btn) return;

          const content = btn.querySelector('.js-btn-content');
          const spinner = btn.querySelector('.js-btn-spinner');
          
          if (content && spinner) {
            content.style.display = 'none';
            spinner.style.display = '';
            btn.style.pointerEvents = 'none';
            btn.style.opacity = '0.8';
          }
        });
      });
    </script>

                  <span class="lp-plus flex-none flex" aria-hidden="true" style="color: #d6b877"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg></span>

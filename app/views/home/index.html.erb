            <div aria-hidden="true" class="relative h-[320px] sm:h-[380px]" dir="ltr">
              <div class="glass-soft absolute flex flex-col gap-[9px] p-5 box-border" style="top: 40px; left: 6%; width: 52%; height: 82%; border-radius: 20px; transform: rotate(-8deg)">
                <span class="block h-2.5 rounded-md" style="width: 50%; background: rgba(255,255,255,0.2)"></span>
                <span class="block h-1.5 rounded-md" style="width: 90%; background: rgba(255,255,255,0.08)"></span>
                <span class="block h-1.5 rounded-md" style="width: 80%; background: rgba(255,255,255,0.08)"></span>
              </div>
              <div class="glass-soft absolute grid gap-3 p-5 box-border" style="top: 30px; right: 6%; width: 52%; height: 82%; border-radius: 20px; transform: rotate(7deg); grid-template-columns: 1fr 2fr">
                <span class="rounded-[10px]" style="background: rgba(214,184,119,0.18)"></span>
                <span class="flex flex-col gap-[9px]"><span class="block h-2.5 rounded-md" style="width: 70%; background: rgba(255,255,255,0.2)"></span><span class="block h-1.5 rounded-md" style="width: 95%; background: rgba(255,255,255,0.08)"></span></span>
              </div>
              <div class="glass sr-float absolute flex flex-col gap-2.5 p-6 box-border" style="top: 10px; left: 50%; margin-left: -28%; width: 56%; height: 90%; border-radius: 22px">
                <span class="block rounded-md" style="height: 14px; width: 55%; background: rgba(255,255,255,0.32)"></span>
                <span class="block rounded-md" style="height: 7px; width: 35%; background: #0b7f48; opacity: 0.8"></span>
                <span class="block my-2" style="height: 1px; background: rgba(255,255,255,0.14)"></span>
                <span class="block h-1.5 rounded-md" style="width: 92%; background: rgba(255,255,255,0.12)"></span>
                <span class="block h-1.5 rounded-md" style="width: 86%; background: rgba(255,255,255,0.12)"></span>
                <span class="block h-1.5 rounded-md" style="width: 74%; background: rgba(255,255,255,0.12)"></span>
                <span class="block rounded-md mt-2.5" style="height: 9px; width: 40%; background: rgba(255,255,255,0.22)"></span>
                <span class="block h-1.5 rounded-md" style="width: 90%; background: rgba(255,255,255,0.12)"></span>
                <span class="block h-1.5 rounded-md" style="width: 80%; background: rgba(255,255,255,0.12)"></span>
              </div>
            </div>
          </div>
        </section>

        <!-- CTA -->
        <section id="start" class="pt-5 pb-20 md:pb-[100px]">
          <div class="glass sr-reveal relative overflow-hidden rounded-[40px] flex flex-wrap items-center justify-between gap-8" style="padding: clamp(36px, 6vw, 80px)">
            <div aria-hidden="true" class="absolute rounded-full" style="top: -140px; left: -80px; width: 420px; height: 420px; background: radial-gradient(circle, rgba(0,150,85,0.35), rgba(0,150,85,0) 65%); filter: blur(30px)"></div>
            <div aria-hidden="true" class="absolute top-0 inset-x-0" style="height: 10px; opacity: 0.8">
              <svg width="100%" height="10"><defs><pattern id="saduCta" width="20" height="10" patternUnits="userSpaceOnUse"><path d="M0 0L5 10L10 0Z" fill="rgba(0,140,78,0.8)"></path><path d="M10 10L15 0L20 10Z" fill="rgba(214,184,119,0.7)"></path></pattern></defs><rect width="100%" height="10" fill="url(#saduCta)"></rect></svg>
            </div>
            <div class="relative flex flex-col gap-3.5 max-w-[620px]">
              <h2 class="sr-mask m-0 font-semibold" style="font-size: clamp(30px, 3.8vw, 46px); letter-spacing: -0.02em; line-height: 1.2"><%= t('home.cta_title') %></h2>
              <p class="m-0 text-[17px] font-light" style="color: rgba(238,243,238,0.7)"><%= t('home.cta_description') %></p>

<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= text_direction %>" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t('site.name') %> | <%= t('site.tagline') %></title>
    <meta name="description" content="<%= t('site.description') %>" />
    <meta name="theme-color" content="#07120D" />
    
    <!-- Canonical & Language Alternates -->
    <link rel="canonical" href="https://cvcrft.com<%= request.path == '/' ? '' : request.path %>" />
    <link rel="alternate" hreflang="ar" href="https://cvcrft.com/?locale=ar" />
    <link rel="alternate" hreflang="en" href="https://cvcrft.com/?locale=en" />
    <link rel="alternate" hreflang="x-default" href="https://cvcrft.com/" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cvcrft.com/" />
    <meta property="og:title" content="<%= t('site.name') %> - <%= t('site.tagline') %>" />
    <meta property="og:description" content="<%= t('site.description') %>" />
    <meta property="og:image" content="https://cvcrft.com/og-image.png?v=7" />
    <meta property="og:locale" content="<%= current_locale == 'ar' ? 'ar_SA' : 'en_US' %>" />
    <meta property="og:locale:alternate" content="<%= current_locale == 'ar' ? 'en_US' : 'ar_SA' %>" />
    <meta property="og:site_name" content="<%= t('site.name') %>" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://cvcrft.com/" />
    <meta name="twitter:title" content="<%= t('site.name') %> - <%= t('site.tagline') %>" />
    <meta name="twitter:description" content="<%= t('site.description') %>" />
    <meta name="twitter:image" content="https://cvcrft.com/og-image.png?v=7" />
    
    <!-- Favicon -->
    <link rel="icon" href="/icon.png?v=7" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=7" />
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render 'shared/posthog' %>
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://cvcrft.com/#website",
          "url": "https://cvcrft.com/",
          "name": "<%= t('site.name') %>",
          "description": "<%= t('site.description') %>",
          "inLanguage": ["ar", "en"],
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://cvcrft.com/resumes?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "Organization",
          "@id": "https://cvcrft.com/#organization",
          "name": "<%= t('site.name') %>",
          "url": "https://cvcrft.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://cvcrft.com/icon.png?v=7"
          },
          "sameAs": []
        },
        {
          "@type": "SoftwareApplication",
          "name": "<%= t('site.name') %>",
          "description": "<%= t('site.description') %>",
          "url": "https://cvcrft.com/",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": <%= raw((1..6).map { |n| { "@type" => "Question", "name" => t("home_landing.faq.q#{n}"), "acceptedAnswer" => { "@type" => "Answer", "text" => t("home_landing.faq.a#{n}") } } }.to_json) %>
        }
      ]
    }
    </script>
    <style>
      /* Landing page design skill: hero type, tagline reveal, FAQ. Scoped to this page. */
      .lp-skip { position: absolute; inset-inline-start: 16px; top: -64px; z-index: 60; padding: 8px 12px; border-radius: 12px; background: #0b7f48; color: #fff; font-weight: 600; transition: top .7s cubic-bezier(0.32,0.72,0,1); }
      .lp-skip:focus { top: 16px; outline: 2px solid #d6b877; outline-offset: 2px; }
      .lp-balance { text-wrap: balance; }
      .lp-pretty { text-wrap: pretty; }
      .lp-tw { color: rgba(238,243,238,0.3); transition: color .7s cubic-bezier(0.32,0.72,0,1); }
      .lp-tw.is-on { color: #eef3ee; }
      .lp-tw.lp-gold.is-on { color: #d6b877; }
      .lp-faq summary { list-style: none; cursor: pointer; }
      .lp-faq summary::-webkit-details-marker { display: none; }
      .lp-faq summary:focus-visible { outline: 2px solid #d6b877; outline-offset: 4px; border-radius: 16px; }
      .lp-faq .lp-plus { transition: transform .7s cubic-bezier(0.32,0.72,0,1); }
      .lp-faq details[open] .lp-plus { transform: rotate(45deg); }
      .lp-faq details:hover { background: rgba(255,255,255,0.06); }
      .lp-faq details { transition: background-color .7s cubic-bezier(0.32,0.72,0,1); }
      @media (prefers-reduced-motion: reduce) { .lp-tw { color: #eef3ee; transition: none; } .lp-tw.lp-gold { color: #d6b877; } }
    </style>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" /></noscript>
  </head>
  <body class="bg-darkBase text-mist overflow-x-hidden">
    <a href="#main" class="lp-skip"><%= t('home_landing.skip_to_content') %></a>
    <% build_href = user_signed_in? ? new_resume_path : login_path(return_to: new_resume_path) %>
    <% arrow = '<svg class="sr-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>'.html_safe %>

    <div class="sr-page relative overflow-clip min-h-dvh leading-relaxed" style="background: #07120d; color: #eef3ee; line-height: 1.6">

      <%= render 'shared/ambient' %>

      <div class="relative mx-auto max-w-[1240px] px-4 sm:px-6 pt-4 sm:pt-6 pb-10">

        <%= render 'shared/site_header', home: true %>

        <main id="main" tabindex="-1" class="outline-none">

        <!-- Hero -->
        <section id="top" class="grid gap-14 items-center pt-16 pb-24 md:pt-24 md:pb-[120px]" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr))">
          <div class="flex flex-col gap-7">
            <span class="glass-soft sr-up self-start inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-sm" style="animation-delay: 0s; color: rgba(238,243,238,0.9)">
              <span class="sr-dot w-2 h-2 rounded-full bg-primary"></span>
              <%= t('home.hero_badge') %>
            </span>
            <h1 class="lp-balance m-0 font-semibold max-w-[680px]" style="font-size: clamp(40px, 5.4vw, 68px); line-height: 1.15; letter-spacing: -0.02em">
              <% delay = 0.1 %>
              <% line1 = t('home.hero_title_1').split %>
              <% line1.each_with_index do |word, i| %><% shade = (255 - (255 - 155) * i / [line1.size - 1, 1].max) %><span class="sr-w" style="color: rgb(<%= shade %>,<%= shade %>,<%= shade %>); animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
              <% delay += 0.04 %>
              <% t('home.hero_title_2').split.each do |word| %><span class="sr-w" style="color: #d6b877; animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
            </h1>
            <p class="lp-pretty sr-up m-0 text-lg font-light max-w-[680px]" style="animation-delay: .7s; color: rgba(238,243,238,0.7)"><%= t('home.hero_description') %></p>
            <div class="sr-up grid grid-cols-1 min-[420px]:grid-cols-2 gap-2.5 max-w-[520px]" style="animation-delay: .85s">
              <a href="<%= build_href %>" class="sr-btn sr-primary flex items-center justify-between gap-2.5 min-h-[52px] px-5 rounded-2xl font-semibold text-[15px]" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)">
                <%= t('home.resume_builder') %>
                <span class="sr-ico flex"><%= arrow %></span>
              </a>
              <a href="<%= user_signed_in? ? new_cv_generation_path : login_path(return_to: new_cv_generation_path) %>" class="sr-btn glass-soft flex items-center gap-2.5 min-h-[52px] px-[18px] rounded-2xl text-[15px]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg><%= t('home.generate_by_job') %>
              </a>
              <a href="<%= user_signed_in? ? cv_analysis_path : login_path(return_to: cv_analysis_path) %>" class="sr-btn glass-soft flex items-center gap-2.5 min-h-[52px] px-[18px] rounded-2xl text-[15px]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path></svg><%= t('home.analyze_resume') %>
              </a>
              <a href="<%= user_signed_in? ? linkedin_import_path : login_path(return_to: linkedin_import_path) %>" class="sr-btn glass-soft flex items-center gap-2.5 min-h-[52px] px-[18px] rounded-2xl text-[15px]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 21h16"></path></svg><%= t('home.import_from_linkedin') %>
              </a>
            </div>
            <div class="sr-up flex items-center gap-3.5" style="animation-delay: 1s">
              <div class="flex">
                <span class="glass sr-mono w-[38px] h-[38px] rounded-full flex items-center justify-center text-xs font-semibold" style="background: rgba(214,184,119,0.35)">SA</span>
                <span class="glass sr-mono w-[38px] h-[38px] rounded-full flex items-center justify-center text-xs font-semibold -ms-2.5" style="background: rgba(0,108,53,0.5)">AE</span>
                <span class="glass sr-mono w-[38px] h-[38px] rounded-full flex items-center justify-center text-xs font-semibold -ms-2.5" style="background: rgba(214,184,119,0.35)">KW</span>
              </div>
              <span class="text-sm" style="color: rgba(238,243,238,0.65)"><%= t('home.trusted_by', count: number_with_delimiter(@users_count)) %></span>
            </div>
          </div>

          <!-- Editor mockup -->
          <div class="sr-float relative py-5" aria-hidden="true">
            <div class="glass sr-up rounded-[28px] overflow-hidden" style="animation-delay: .4s; animation-duration: 1.4s">
              <div class="flex items-center justify-between px-[18px] py-3.5" style="border-bottom: 1px solid rgba(255,255,255,0.08)" dir="ltr">
                <div class="flex gap-[7px]">
                  <span class="w-[11px] h-[11px] rounded-full" style="background: #e0715f"></span>
                  <span class="w-[11px] h-[11px] rounded-full" style="background: #e8b25c"></span>
                  <span class="w-[11px] h-[11px] rounded-full" style="background: #7fbf86"></span>
                </div>
                <span class="sr-mono text-xs" style="color: rgba(238,243,238,0.55)">seera_editor_v1.0.exe</span>
                <span class="w-[45px]"></span>
              </div>
              <div class="grid gap-3 sm:gap-4 p-4 sm:p-[22px]" style="grid-template-columns: 1.3fr 1fr">
                <div class="glass-soft rounded-[18px] p-3.5 sm:p-[18px] flex flex-col gap-3 min-w-0">
                  <span class="text-[13px] font-semibold" style="color: rgba(238,243,238,0.85)"><%= t('home.job_analysis') %></span>
                  <span class="sr-grow h-2 rounded-md" style="animation-delay: .9s; background: rgba(255,255,255,0.14); width: 92%"></span>
                  <span class="sr-grow h-2 rounded-md" style="animation-delay: 1.02s; background: rgba(255,255,255,0.1); width: 78%"></span>
                  <span class="sr-grow h-2 rounded-md" style="animation-delay: 1.14s; background: rgba(255,255,255,0.1); width: 85%"></span>
                  <span class="sr-grow h-2 rounded-md" style="animation-delay: 1.26s; background: rgba(255,255,255,0.08); width: 60%"></span>
                  <span class="sr-shim mt-2 inline-flex items-center gap-2 self-start px-3 py-[7px] rounded-[10px] text-xs" style="background: rgba(214,184,119,0.16); border: 1px solid rgba(214,184,119,0.4); color: #d6b877">
                    <svg class="shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"></path></svg>
                    <%= t('home.enhanced_by_ai') %>
                  </span>
                </div>
                <div class="glass-soft rounded-[18px] p-3 sm:p-[18px] flex flex-col items-center justify-center gap-2 min-w-0">
                  <span class="text-[13px]" style="color: rgba(238,243,238,0.6)"><%= t('home.score') %></span>
                  <div class="relative w-[92px] h-[92px] sm:w-[120px] sm:h-[120px]">
                    <svg width="100%" height="100%" viewBox="0 0 120 120" style="transform: rotate(-90deg)">
                      <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="9"></circle>
                      <circle class="sr-ring" cx="60" cy="60" r="50" fill="none" stroke="#2fa36b" stroke-width="9" stroke-linecap="round" stroke-dasharray="314" stroke-dashoffset="16"></circle>
                    </svg>
                    <span dir="ltr" class="sr-mono absolute inset-0 flex flex-col items-center justify-center font-semibold text-xl sm:text-[26px]" style="line-height: 1.1">95%<span class="text-[11px] font-normal" style="color: rgba(238,243,238,0.6)">ATS</span></span>
                  </div>
                </div>
                <div class="glass-soft rounded-[18px] px-[18px] py-4 flex flex-col gap-2.5" style="grid-column: 1 / -1">
                  <span class="sr-grow rounded-md" style="animation-delay: 1.4s; height: 10px; background: rgba(255,255,255,0.16); width: 40%"></span>
                  <span class="sr-grow rounded-md" style="animation-delay: 1.52s; height: 7px; background: rgba(255,255,255,0.09); width: 96%"></span>
                  <span class="sr-grow rounded-md" style="animation-delay: 1.64s; height: 7px; background: rgba(255,255,255,0.09); width: 88%"></span>
                  <span class="sr-grow rounded-md" style="animation-delay: 1.76s; height: 7px; background: rgba(255,255,255,0.07); width: 70%"></span>
                </div>
              </div>
            </div>
            <span class="glass sr-mono absolute -bottom-1.5 end-0 sm:-end-[18px] px-4 py-3 rounded-2xl flex items-center gap-2.5 text-sm font-semibold" dir="ltr">
              <span class="sr-dot w-2 h-2 rounded-full" style="background: #7fbf86"></span>95% ATS</span>
          </div>
        </section>

        <!-- Features -->
        <section id="features" class="pt-10 pb-24 md:pb-[120px] flex flex-col gap-12 scroll-mt-28">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="sr-mask m-0 font-semibold" style="font-size: clamp(32px, 4vw, 48px); letter-spacing: -0.02em; line-height: 1.2"><%= t('home.features_title') %></h2>
            <p class="m-0 text-[17px] font-light max-w-[40ch]" style="color: rgba(238,243,238,0.62)"><%= t('home.features_subtitle') %></p>
          </div>
          <div class="grid gap-5" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr))">
            <article class="glass sr-lift sr-reveal rounded-[32px] p-7 sm:p-10 flex flex-col gap-5 min-h-[420px] justify-between">
              <span class="glass-soft sr-ico w-14 h-14 rounded-[18px] flex items-center justify-center" style="color: #2fa36b">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"></path></svg></span>
              <div class="glass-soft rounded-[18px] p-4 flex flex-col gap-2" aria-hidden="true">
                <span class="block h-[7px] rounded-md" style="background: rgba(255,255,255,0.14); width: 90%"></span>
                <span class="block h-[7px] rounded-md" style="background: rgba(255,255,255,0.1); width: 70%"></span>
                <span class="block h-[7px] rounded-md" style="background: rgba(214,184,119,0.45); width: 55%"></span>
              </div>
              <div class="flex flex-col gap-2.5">
                <h3 class="m-0 text-[26px] font-semibold"><%= t('home.feature_job_gen_title') %></h3>
                <p class="m-0 text-base font-light" style="color: rgba(238,243,238,0.68)"><%= t('home.feature_job_gen_desc') %></p>
              </div>
            </article>
            <div class="grid gap-5">
              <article class="glass sr-lift sr-reveal rounded-[32px] p-6 sm:p-8 flex gap-5 items-start">
                <span class="glass-soft sr-ico flex-none w-[52px] h-[52px] rounded-2xl flex items-center justify-center" style="color: #2fa36b">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h8M8 3v2M6 5c0 4 3 7 6 8M10 5c0 3-3 7-6 8M13 21l4-9 4 9M14.5 18h5"></path></svg></span>
                <div class="flex flex-col gap-2">
                  <h3 class="m-0 text-[22px] font-semibold"><%= t('home.feature_translate_title') %></h3>
                  <p class="m-0 text-[15px] font-light" style="color: rgba(238,243,238,0.68)"><%= t('home.feature_translate_desc') %></p>
                </div>
              </article>
              <article class="glass sr-lift sr-reveal rounded-[32px] p-6 sm:p-8 flex gap-5 items-start">
                <span class="glass-soft sr-ico flex-none w-[52px] h-[52px] rounded-2xl flex items-center justify-center" style="color: #2fa36b">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M12 18v-6M9 15l3 3 3-3"></path></svg></span>
                <div class="flex flex-col gap-2">
                  <h3 class="m-0 text-[22px] font-semibold"><%= t('home.feature_linkedin_title') %></h3>
                  <p class="m-0 text-[15px] font-light" style="color: rgba(238,243,238,0.68)"><%= t('home.feature_linkedin_desc') %></p>
                </div>
              </article>
            </div>
          </div>
        </section>

        <!-- Tagline reveal -->
        <section aria-label="<%= t('home_landing.tagline_1') %>" class="pt-10 pb-24 md:pb-[120px]">
          <p data-lp-tagline class="lp-balance m-0 mx-auto max-w-[680px] text-center text-4xl md:text-5xl font-semibold" style="letter-spacing: -0.02em; line-height: 1.2">
            <% t('home_landing.tagline_1').split.each do |word| %><span class="lp-tw"><%= word %></span> <% end %><br>
            <% t('home_landing.tagline_2').split.each do |word| %><span class="lp-tw lp-gold"><%= word %></span> <% end %>
          </p>
        </section>

        <!-- How it works -->
        <section id="how-it-works" class="pt-10 pb-24 md:pb-[120px] flex flex-wrap gap-10 items-start scroll-mt-28">
          <div class="flex flex-col gap-4" style="flex: 1 1 300px">
            <span class="sr-mono text-[13px] tracking-[0.08em]" style="color: #d6b877" dir="ltr">01 — 03</span>
            <h2 class="sr-mask m-0 font-semibold" style="font-size: clamp(32px, 4vw, 48px); letter-spacing: -0.02em; line-height: 1.2"><%= t('home.how_title') %></h2>
          </div>
          <ol class="glass list-none m-0 p-2 sm:p-3 rounded-[32px] flex flex-col gap-2 min-w-0" style="flex: 2 1 560px">
            <% [1, 2, 3].each do |n| %>
              <li class="glass-soft sr-lift sr-reveal rounded-3xl p-5 sm:p-7 flex gap-4 sm:gap-6 items-start">
                <% if n == 1 %>
                  <span class="sr-mono flex-none w-12 h-12 sm:w-14 sm:h-14 rounded-full flex items-center justify-center text-lg font-semibold" style="background: #0b7f48; color: #ffffff; box-shadow: inset 0 1px 0 rgba(255,255,255,0.5)">1</span>
                <% else %>
                  <span class="glass sr-mono flex-none w-12 h-12 sm:w-14 sm:h-14 rounded-full flex items-center justify-center text-lg font-semibold"><%= n %></span>
                <% end %>
                <div class="flex flex-col gap-1.5">
                  <h3 class="m-0 text-xl sm:text-[22px] font-semibold"><%= t("home.step#{n}_title") %></h3>
                  <p class="m-0 text-[15px] sm:text-base font-light" style="color: rgba(238,243,238,0.68)"><%= t("home.step#{n}_desc") %></p>
                </div>
              </li>
            <% end %>
          </ol>
        </section>

        <!-- Templates -->
        <section id="templates" class="pt-10 pb-24 md:pb-[120px] scroll-mt-28">
          <div class="glass sr-reveal rounded-[40px] grid gap-12 items-center" style="padding: clamp(28px, 5vw, 64px); grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr))">
            <div class="flex flex-col gap-5">
              <h2 class="sr-mask m-0 font-semibold" style="font-size: clamp(32px, 4vw, 48px); letter-spacing: -0.02em; line-height: 1.2"><%= t('home.templates_title') %></h2>

<div class="min-h-screen bg-gray-50 py-8" dir="<%= text_direction %>">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header with Actions -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
      <%= link_to resumes_path, class: 'inline-flex items-center gap-2 text-gray-500 hover:text-gray-700 transition-colors' do %>
        <svg class="w-5 h-5 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span><%= t('resume.back_to_list') %></span>
      <% end %>

      <div class="flex flex-wrap items-center gap-3">
        <% linkedin_import = @resume.linkedin_import_for_edit %>
        <% edit_link = linkedin_import.present? ? linkedin_import_show_path(linkedin_import) : edit_resume_path(@resume) %>
        <%= link_to edit_link, class: 'inline-flex items-center gap-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded-lg transition-colors' do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          <%= t('actions.edit') %>
        <% end %>

        <form action="<%= generate_pdf_resume_path(@resume) %>" method="get" class="flex flex-wrap items-center gap-2">
          <select name="template" class="bg-white border border-gray-300 text-gray-700 text-sm rounded-lg px-2 py-2">
            <% AtsTemplatePdfService.template_catalog.each do |template| %>
              <option value="<%= template[:key] %>"><%= template[:name] %></option>
            <% end %>
          </select>
          <button type="submit" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2 px-4 rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <%= t('resume.download_pdf') %>
          </button>
          <button type="submit" name="preview" value="true" class="inline-flex items-center gap-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 rounded-lg transition-colors">
            Preview
          </button>
        </form>
      </div>
    </div>

    <!-- Main Resume Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <!-- Header Section -->
      <div class="bg-white p-8 border-b border-gray-200">
        <h1 class="text-3xl font-bold mb-2 text-gray-900"><%= @resume.complete_name.presence || t('resume.no_name') %></h1>
        <% if @resume.target_position.present? %>
          <p class="text-gray-600 text-lg mb-4"><%= @resume.target_position %></p>
        <% end %>
        
        <div class="flex flex-wrap items-center gap-4 text-gray-600 text-sm">
          <% if @resume.email.present? %>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <span><%= @resume.email %></span>
            </div>
          <% end %>
          <% if @resume.phone_number.present? %>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <span dir="ltr"><%= @resume.phone_number %></span>
            </div>
          <% end %>
          <% if @resume.city.present? || @resume.country.present? %>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <span><%= [@resume.city, @resume.country].compact.join(t('resume.location_separator')) %></span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Content Sections -->
      <div class="p-6 sm:p-8 space-y-8">
        <!-- Professional Summary -->
        <% if @resume.professional_summary.present? %>
          <section>
            <h2 class="text-lg font-semibold text-gray-900 mb-3 flex items-center gap-2 border-b border-gray-200 pb-2">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              <%= t('resume.professional_summary_title') %>
            </h2>
            <p class="text-gray-600 leading-relaxed"><%= @resume.professional_summary %></p>
          </section>
        <% end %>

        <!-- Work Experience -->
        <% if @work_experiences.any? %>
          <section>
            <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-2">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              <%= t('resume.work_experience_title') %>
              <span class="bg-emerald-100 text-emerald-700 text-xs font-medium px-2 py-0.5 rounded-full mr-auto"><%= @work_experiences.size %></span>
            </h2>
            
            <div class="space-y-5">
              <% @work_experiences.each do |exp| %>
                <div class="border-r-4 border-emerald-500 pr-4 py-1">
                  <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                    <div>
                      <h3 class="font-semibold text-gray-900"><%= exp.job_title.presence || exp.position %></h3>
                      <p class="text-emerald-600 font-medium"><%= exp.company %></p>
                    </div>
                    <span class="text-sm text-gray-500 bg-gray-100 px-2 py-1 rounded">
                      <%= date_range(exp.start_date, exp.end_date, exp.is_current).presence || '—' %>
                    </span>
                  </div>
                  <% description = exp.arabic_description.presence || exp.english_description.presence || exp.responsibilities %>
                  <% if description.present? %>
                    <p class="text-gray-600 text-sm leading-relaxed whitespace-pre-line"><%= description %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>

        <!-- Education -->
        <% if @resume.educations.any? %>
          <section>
            <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-2">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
              </svg>
              <%= t('resume.education_title') %>
              <span class="bg-emerald-100 text-emerald-700 text-xs font-medium px-2 py-0.5 rounded-full mr-auto"><%= @resume.educations.size %></span>
            </h2>
            
            <div class="space-y-4">
              <% @resume.educations.each do |edu| %>
                <div class="border-r-4 border-gray-400 pr-4 py-1">
                  <div class="flex flex-wrap items-start justify-between gap-2">
                    <div>
                      <h3 class="font-semibold text-gray-900"><%= edu.degree %></h3>
                      <p class="text-gray-600"><%= edu.institution %></p>
                      <% if edu.respond_to?(:gpa) && edu.gpa.present? %>
                        <p class="text-gray-500 text-sm"><%= t('resume.gpa') %>: <%= edu.gpa %></p>
                      <% end %>
                    </div>
                    <span class="text-sm text-gray-500 bg-gray-100 px-2 py-1 rounded">
                      <%= date_range(edu.start_date, edu.end_date, edu.is_current, :year).presence || '—' %>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>

        <!-- Skills -->
        <% if @skills.any? %>
          <section>
            <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-2">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
              <%= t('resume.skills_title') %>
            </h2>
            
            <div class="space-y-4">
              <% @skills.each do |category, skills_list| %>
                <div>
                  <% if category.present? && category != t('resume.uncategorized') %>
                    <h4 class="text-sm font-medium text-gray-500 mb-2"><%= category %></h4>
                  <% end %>
                  <div class="flex flex-wrap gap-2">
                    <% skills_list.each do |skill| %>
                      <% skill_items = skill.skill_names.presence || [skill.name].compact %>
                      <% skill_items.each do |skill_name| %>
                        <span class="bg-gray-100 text-gray-700 px-3 py-1.5 rounded-lg text-sm">
                          <%= skill_name %>
                        </span>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>

        <!-- Certifications -->
        <% if @resume.respond_to?(:certifications) && @resume.certifications.any? %>
          <section>
            <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-2">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
              <%= t('resume.certifications_title') %>
              <span class="bg-emerald-100 text-emerald-700 text-xs font-medium px-2 py-0.5 rounded-full mr-auto"><%= @resume.certifications.size %></span>
            </h2>
            
            <div class="grid gap-3 sm:grid-cols-2">
              <% @resume.certifications.each do |cert| %>
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                  <h3 class="font-semibold text-gray-900"><%= cert.name %></h3>
                  <% if cert.organization.present? %>
                    <p class="text-gray-600 text-sm"><%= cert.organization %></p>
                  <% end %>
                  <% if cert.date.present? %>
                    <p class="text-gray-400 text-xs mt-1"><%= format_date(cert.date) %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>

        <!-- Languages -->
        <% if @resume.respond_to?(:languages) && @resume.languages.any? %>
          <section>
            <h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2 border-b border-gray-200 pb-2">
              <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
              </svg>
              <%= t('resume.languages_title') %>
            </h2>
            
            <div class="flex flex-wrap gap-3">
              <% @resume.languages.each do |lang| %>
                <div class="bg-gray-50 border border-gray-200 rounded-lg px-4 py-2">
                  <span class="font-medium text-gray-900"><%= lang.language %></span>
                  <% if lang.proficiency.present? %>
                    <span class="text-gray-500 text-sm"> — <%= lang.proficiency %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>

      <!-- Footer -->
      <div class="bg-gray-50 px-6 sm:px-8 py-4 border-t border-gray-200">
        <div class="flex flex-wrap items-center justify-between gap-4 text-xs text-gray-400">
          <span><%= t('resume.last_updated') %> <%= @resume.updated_at.strftime("%d/%m/%Y %H:%M") %></span>
          <span><%= t('resume.created') %> <%= @resume.created_at.strftime("%d/%m/%Y") %></span>
        </div>
      </div>
    </div>
  </div>
</div>

<% unless user_signed_in? %>
  <script>
    window.location.href = '/auth/login';
  </script>
<% else %>
<div class="bg-gradient-to-b from-white via-emerald-50 to-white min-h-screen">
  <!-- Background Accents -->
  <div class="pointer-events-none fixed inset-0 -z-10">
    <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-emerald-400/20 blur-3xl"></div>
    <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-emerald-300/20 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[38rem] h-[38rem] bg-gradient-to-b from-emerald-200/30 to-transparent rounded-full blur-3xl"></div>
  </div>
  <!-- Main Content -->
  <div class="relative">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
      <!-- Form Container -->
      <div class="bg-white/80 backdrop-blur-xl rounded-2xl border border-slate-200/80 shadow-sm p-8" dir="rtl">
        <div class="text-center mb-8">
          <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-slate-900 mb-3">
            إنشاء سيرة ذاتية جديدة
          </h1>
          <p class="text-slate-600 leading-7 max-w-2xl mx-auto">
            ابدأ ببناء سيرتك الذاتية الاحترافية بملء المعلومات الأساسية أدناه. سنقوم بتوجيهك خلال العملية خطوة بخطوة.
          </p>
        </div>
        <div id="resume-form-root" dir="rtl">
          <!-- React component will render here -->
        </div>
      </div>
    </div>
  </div>
</div>
<script type="module" src="<%= vite_asset_path('entrypoints/resume_form.jsx') %>?v=<%= Time.current.to_i %>"></script>
<script>
  // Pass resume data to JavaScript
  window.resumeData = <%= raw @resume.to_json(only: [:complete_name, :email, :phone_number, :city, :country, :professional_summary, :professional_summary_english, :education, :work_experience, :skills, :certifications, :languages]) %>;
  console.log('=== RAILS: Resume data set ===');
  console.log('Resume data:', window.resumeData);
  console.log('Resume skills:', window.resumeData.skills);
  console.log('Resume skills detailed:', window.resumeData.skills?.map(s => ({ 
    category: s.category, 
    skill_names: s.skill_names,
    skill_names_types: s.skill_names?.map(name => ({ value: name, type: typeof name }))
  })));
</script>
<% end %>

<% unless user_signed_in? %>
  <script>
    window.location.href = '/auth/login';
  </script>
<% else %>
<div class="bg-gradient-to-b from-white via-emerald-50 to-white min-h-screen">
  <!-- Background Accents -->
  <div class="pointer-events-none fixed inset-0 -z-10">
    <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-emerald-400/20 blur-3xl"></div>
    <div class="absolute top-1/3 -right-20 w-72 h-72 rounded-full bg-emerald-300/20 blur-3xl"></div>
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[38rem] h-[38rem] bg-gradient-to-b from-emerald-200/30 to-transparent rounded-full blur-3xl"></div>
  </div>
  <!-- Main Content -->
  <div class="relative">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
      <!-- Form Container -->
      <div class="bg-white/80 backdrop-blur-xl rounded-2xl border border-slate-200/80 shadow-sm p-8" dir="rtl">
        <div class="text-center mb-8">
          <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-slate-900 mb-3">
            تعديل السيرة الذاتية
          </h1>
          <p class="text-slate-600 leading-7 max-w-2xl mx-auto">
            قم بتحديث معلومات سيرتك الذاتية.
          </p>
        </div>
        <div id="resume-form-root" dir="rtl">
          <!-- React component will render here -->
        </div>
      </div>
    </div>
  </div>
</div>
<%= vite_javascript_tag 'entrypoints/resume_form.jsx' %>
<script>
  // Pass resume data to JavaScript
  <% if @resume.present? %>
    // For existing resumes (including drafts), pass the resume data
    window.resumeData = <%= raw @resume.to_json(only: [:id, :complete_name, :email, :phone_number, :city, :country, :professional_summary, :professional_summary_english, :is_draft, :draft_data]) %>;
    
    // Add association data if it exists
    <% if @resume.work_experiences.any? %>
      window.resumeData.work_experience = <%= raw @resume.work_experiences.to_json %>;
    <% end %>
    <% if @resume.skills.any? %>
      window.resumeData.skills = <%= raw @resume.skills.to_json %>;
    <% end %>
    <% if @resume.educations.any? %>
      window.resumeData.education = <%= raw @resume.educations.to_json %>;
    <% end %>
    <% if @resume.certifications.any? %>
      window.resumeData.certifications = <%= raw @resume.certifications.to_json %>;
    <% end %>
    <% if @resume.languages.any? %>
      window.resumeData.languages = <%= raw @resume.languages.to_json %>;
    <% end %>
  <% else %>
    // For new resumes, pass null
    window.resumeData = null;
  <% end %>
  
  console.log('=== RAILS: Resume data set (edit) ===');
  console.log('Resume data:', window.resumeData);
</script>
<% end %>

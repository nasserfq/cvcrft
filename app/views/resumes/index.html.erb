<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">سيرتي الذاتية</h1>
    <%# top CTAs annotated below - removed accidental per-resume action links that referenced undefined `resume` variable %>
  </div>
  <!-- Quick Action for Drafts -->
  <% if @drafts.any? %>
    <div class="mb-6 p-4 bg-gradient-to-r from-emerald-50 to-blue-50 rounded-lg border border-emerald-200">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-emerald-100 rounded-full flex items-center justify-center">
            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-900">لديك <%= @drafts.count %> مسودة محفوظة</h3>
            <p class="text-xs text-gray-600">استكمل بناء سيرتك الذاتية من حيث توقفت</p>
          </div>
        </div>
        <div class="text-xs text-emerald-700 font-medium">
          ↓ انظر أدناه
        </div>
      </div>
    </div>
  <% end %>
  <!-- Debug Section (remove this after testing) -->
  <% if Rails.env.development? %>
    <div class="mb-4 p-4 bg-yellow-50 border border-yellow-200 rounded">
      <h3 class="text-sm font-medium text-yellow-800 mb-2">Debug Info:</h3>
      <p class="text-xs text-yellow-700">Total resumes: <%= current_user.resumes.count %></p>
      <p class="text-xs text-yellow-700">Draft resumes: <%= current_user.resumes.drafts.count %></p>
      <p class="text-xs text-yellow-700">Non-draft resumes: <%= current_user.resumes.not_drafts.count %></p>
      <p class="text-xs text-yellow-700">@drafts variable: <%= @drafts&.count || 'nil' %></p>
    </div>
  <% end %>
  <!-- Drafts Section -->
  <% if @drafts.any? %>
    <div class="mb-8">
      <!-- Drafts Header with Call-to-Action -->
      <div class="bg-gradient-to-r from-blue-50 to-emerald-50 rounded-lg p-6 mb-6 border border-blue-200">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3-3m0 0l-3 3m3-3v12"></path>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-semibold text-gray-900">مسوداتي المحفوظة</h2>
              <p class="text-sm text-gray-600">استكمل بناء سيرتك الذاتية من حيث توقفت</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span class="bg-blue-100 text-blue-800 text-sm font-medium px-3 py-1 rounded-full">
              <%= @drafts.count %> مسودة
            </span>
          </div>
        </div>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <% @drafts.each do |resume| %>
          <div class="bg-white rounded-lg shadow-md p-6 border border-blue-200 hover:shadow-lg transition-shadow">
            <!-- Draft Status Header -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2">
                <span class="px-2 py-1 text-xs bg-blue-100 text-blue-700 rounded-full font-medium">
                  مسودة
                </span>
                <span class="px-2 py-1 text-xs bg-emerald-50 text-emerald-600 rounded-full font-medium border border-emerald-200">
                  💾 محفوظة
                </span>
              </div>
              <div class="text-xs text-gray-500">
                <%= resume.created_at.strftime("%d/%m/%Y") %>
              </div>
            </div>
            <!-- Resume Info -->
            <div class="mb-4">
              <h3 class="text-lg font-semibold text-gray-900 mb-1">
                <%= resume.complete_name.present? ? resume.complete_name : "مسودة جديدة" %>
              </h3>
              <p class="text-sm text-gray-600"><%= resume.email %></p>
            </div>
            <!-- Draft Progress Info -->
            <% if resume.draft_data.present? %>
              <div class="mb-4 p-3 bg-blue-50 rounded border border-blue-200">
                <div class="flex items-center justify-between mb-2">
                  <p class="text-sm text-blue-800 font-medium">
                    التقدم: الخطوة <%= resume.draft_data['current_step'] || 'غير محدد' %> من 8
                  </p>
                  <div class="w-16 bg-blue-200 rounded-full h-2">
                    <div class="bg-blue-600 h-2 rounded-full" style="width: <%= ((resume.draft_data['current_step'] || 1).to_f / 8 * 100).round %>%"></div>
                  </div>
                </div>
                <p class="text-xs text-blue-700">
                  آخر تحديث: <%= Time.parse(resume.draft_data['saved_at']).strftime("%d/%m/%Y في %I:%M %p") rescue 'غير محدد' %>
                </p>
              </div>
            <% end %>
            <div class="flex gap-2">
              <%= link_to "استكمال البناء", edit_resume_path(resume, step: resume.draft_data&.dig('current_step') || 1),
                  class: "w-full bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-2 rounded text-sm transition duration-200 text-center font-medium js-hover-target", data: { hoverable: true } %>
            </div>
            <!-- Additional Info -->
            <div class="mt-3 pt-3 border-t border-blue-100">
              <p class="text-xs text-blue-600 text-center">
                <svg class="w-3 h-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                انقر على "استكمال البناء" للعودة إلى منشئ السيرة الذاتية
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @resumes.any? || @cv_generations.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- CV Builder Resumes -->
      <% @resumes.each do |resume| %>
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow border border-blue-200">
          <!-- CV Builder Badge -->
          <div class="flex justify-between items-start mb-4">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200">
                <i data-lucide="edit-3" class="w-3 h-3"></i>
                CV Builder
              </span>
            </div>
            <div class="flex space-x-2">
              <%= link_to 'عرض', resume_path(resume), class: 'text-blue-600 hover:text-blue-800 text-sm js-hover-target', data: { hoverable: true } %>
              <%= link_to 'تعديل', edit_resume_path(resume), class: 'text-green-600 hover:text-green-800 text-sm js-hover-target', data: { hoverable: true } %>
            </div>
          </div>
          <h2 class="text-xl font-semibold text-gray-900 mb-2"><%= resume.complete_name || "سيرة ذاتية بدون اسم" %></h2>
          <p class="text-gray-600 mb-3"><%= resume.email %></p>
          <% summary_to_show = resume.professional_summary_english.presence || resume.professional_summary.presence %>
          <% if summary_to_show.present? %>
            <div class="mb-4">
              <p class="text-sm text-gray-500 mb-1">الملخص المهني</p>
              <p class="text-sm text-gray-700 bg-gray-50 p-2 rounded text-right">
                <%= truncate(summary_to_show, length: 100) %>
              </p>
            </div>
          <% end %>
          <div class="flex justify-between text-sm text-gray-500 mb-4">
            <span><%= pluralize(resume.work_experiences.count, 'خبرة') %></span>
            <span><%= pluralize(resume.skills.count, 'مهارة') %></span>
          </div>
          <%# export/optimize annotated below %>
            <div class="flex space-x-2">
              <%= link_to 'تصدير PDF', generate_pdf_resume_path(resume), class: 'bg-green-600 hover:bg-green-700 text-white text-sm py-1 px-3 rounded js-hover-target', data: { hoverable: true } %>
              <%= link_to 'تحسين ATS', optimize_ats_resume_path(resume), method: :post, class: 'bg-purple-600 hover:bg-purple-700 text-white text-sm py-1 px-3 rounded js-hover-target', data: { hoverable: true } %>
            </div>
          <div class="mt-3 text-xs text-gray-500">
            تم الإنشاء: <%= resume.created_at.strftime("%d/%m/%Y") %>
          </div>
        </div>
      <% end %>
      <!-- AI Generated CVs -->
      <% @cv_generations.each do |generation| %>
        <div class="bg-gradient-to-br from-emerald-50 to-blue-50 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow border border-emerald-200">
          <!-- AI Generated Badge -->
          <div class="flex justify-between items-start mb-4">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 border border-emerald-200">
                <i data-lucide="sparkles" class="w-3 h-3"></i>
                مبنية بالذكاء الاصطناعي
              </span>
            </div>
            <div class="flex space-x-2">
              <%# annotated links below; original unannotated links removed %>
                <%= link_to 'عرض', cv_generation_path(generation), class: 'text-blue-600 hover:text-blue-800 text-sm js-hover-target', data: { hoverable: true } %>
                <% if generation.metadata&.dig("pdf_generated") %>
                  <%= link_to 'PDF', view_pdf_cv_generation_path(generation), target: "_blank", class: 'text-green-600 hover:text-green-800 text-sm js-hover-target', data: { hoverable: true } %>
                <% end %>
            </div>
          </div>
          <h2 class="text-xl font-semibold text-gray-900 mb-2">
            <span class="inline-flex items-center gap-2">
              <i data-lucide="wand-2" class="w-4 h-4 text-emerald-600"></i>
              سيرة ذاتية مبنية #<%= generation.id %>
            </span>
          </h2>
          <% if generation.job_description.present? %>
            <div class="mb-3">
              <p class="text-sm text-gray-500 mb-1">وصف الوظيفة</p>
              <p class="text-sm text-gray-700 bg-white p-2 rounded text-right">
                <%= truncate(generation.job_description, length: 80) %>
              </p>
            </div>
          <% end %>
          <% if generation.generated_content.present? %>
            <div class="mb-4">
              <p class="text-sm text-gray-500 mb-1">المحتوى المولد</p>
              <p class="text-sm text-gray-700 bg-white p-2 rounded text-right">
                <%= truncate(generation.generated_content, length: 100) %>
              </p>
            </div>
          <% end %>
          <% if generation.metadata&.dig("pdf_generated") %>
            <div class="mb-4 p-2 bg-green-50 border border-green-200 rounded">
              <div class="flex items-center justify-between">
                <span class="text-green-600 text-sm">📄 PDF جاهز</span>
                <div class="flex space-x-1">
                  <%# annotated download/view links below; originals removed %>
                    <%= link_to 'عرض', view_pdf_cv_generation_path(generation), target: "_blank", class: 'text-xs bg-green-500 hover:bg-green-600 text-white px-2 py-1 rounded js-hover-target', data: { hoverable: true } %>
                    <%= link_to 'تحميل', download_pdf_cv_generation_path(generation), class: 'text-xs bg-purple-500 hover:bg-purple-600 text-white px-2 py-1 rounded js-hover-target', data: { hoverable: true } %>
                </div>
              </div>
            </div>
          <% end %>
          <div class="mt-3 text-xs text-gray-500">
            تم التوليد: <%= generation.created_at.strftime("%d/%m/%Y") %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <div class="text-gray-400 mb-4">
        <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-2">لا توجد سير ذاتية بعد</h3>
      <p class="text-gray-500 mb-6">ابدأ بإنشاء سيرتك الذاتية الأولى أو استخدم الذكاء الاصطناعي لتوليدها.</p>
      <div class="flex gap-3 justify-center">
        <%= link_to 'إنشاء سيرة ذاتية', new_resume_path, class: 'bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded js-hover-target', data: { hoverable: true } %>
        <%= link_to 'توليد بالذكاء الاصطناعي', new_cv_generation_path, class: 'bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded js-hover-target', data: { hoverable: true } %>
      </div>
    </div>
  <% end %>
</div>

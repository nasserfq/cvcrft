<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">سيرتي الذاتية</h1>
    <div class="flex gap-3">
      <%= link_to 'إنشاء سيرة ذاتية جديدة', new_resume_path, class: 'bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded' %>
      <%= link_to 'توليد بالذكاء الاصطناعي', new_cv_generation_path, class: 'bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded' %>
    </div>
  </div>

  <% if @resumes.any? || @cv_generations.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- CV Builder Resumes -->
      <% @resumes.each do |resume| %>
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow border border-blue-200">
          <!-- CV Builder Badge -->
          <div class="flex justify-between items-start mb-4">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-700 border border-blue-200">
                <i data-lucide="edit-3" class="w-3 h-3"></i>
                CV Builder
              </span>
            </div>
            <div class="flex space-x-2">
              <%= link_to 'عرض', resume_path(resume), class: 'text-blue-600 hover:text-blue-800 text-sm' %>
              <%= link_to 'تعديل', edit_resume_path(resume), class: 'text-green-600 hover:text-green-800 text-sm' %>
            </div>
          </div>
          
          <h2 class="text-xl font-semibold text-gray-900 mb-2"><%= resume.complete_name || "سيرة ذاتية بدون اسم" %></h2>
          <p class="text-gray-600 mb-3"><%= resume.email %></p>
          
          <% if resume.professional_summary.present? %>
            <div class="mb-4">
              <p class="text-sm text-gray-500 mb-1">الملخص المهني</p>
              <p class="text-sm text-gray-700 bg-gray-50 p-2 rounded text-right">
                <%= truncate(resume.professional_summary, length: 100) %>
              </p>
            </div>
          <% end %>
          
          <div class="flex justify-between text-sm text-gray-500 mb-4">
            <span><%= pluralize(resume.work_experiences.count, 'خبرة') %></span>
            <span><%= pluralize(resume.skills.count, 'مهارة') %></span>
          </div>
          
          <div class="flex space-x-2">
            <%= link_to 'تصدير PDF', generate_pdf_resume_path(resume), class: 'bg-green-600 hover:bg-green-700 text-white text-sm py-1 px-3 rounded' %>
            <%= link_to 'تحسين ATS', optimize_ats_resume_path(resume), method: :post, class: 'bg-purple-600 hover:bg-purple-700 text-white text-sm py-1 px-3 rounded' %>
          </div>
          
          <div class="mt-3 text-xs text-gray-500">
            تم الإنشاء: <%= resume.created_at.strftime("%d/%m/%Y") %>
          </div>
        </div>
      <% end %>

      <!-- AI Generated CVs -->
      <% @cv_generations.each do |generation| %>
        <div class="bg-gradient-to-br from-emerald-50 to-blue-50 rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow border border-emerald-200">
          <!-- AI Generated Badge -->
          <div class="flex justify-between items-start mb-4">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 border border-emerald-200">
                <i data-lucide="sparkles" class="w-3 h-3"></i>
                مبنية بالذكاء الاصطناعي
              </span>
            </div>
            <div class="flex space-x-2">
              <%= link_to 'عرض', cv_generation_path(generation), class: 'text-blue-600 hover:text-blue-800 text-sm' %>
              <% if generation.metadata&.dig("pdf_generated") %>
                <%= link_to 'PDF', view_pdf_cv_generation_path(generation), target: "_blank", class: 'text-green-600 hover:text-green-800 text-sm' %>
              <% end %>
            </div>
          </div>
          
          <h2 class="text-xl font-semibold text-gray-900 mb-2">
            <span class="inline-flex items-center gap-2">
              <i data-lucide="wand-2" class="w-4 h-4 text-emerald-600"></i>
              سيرة ذاتية مبن #<%= generation.id %>
            </span>
          </h2>
          
          <% if generation.job_description.present? %>
            <div class="mb-3">
              <p class="text-sm text-gray-500 mb-1">وصف الوظيفة</p>
              <p class="text-sm text-gray-700 bg-white p-2 rounded text-right">
                <%= truncate(generation.job_description, length: 80) %>
              </p>
            </div>
          <% end %>
          
          <% if generation.generated_content.present? %>
            <div class="mb-4">
              <p class="text-sm text-gray-500 mb-1">المحتوى المولد</p>
              <p class="text-sm text-gray-700 bg-white p-2 rounded text-right">
                <%= truncate(generation.generated_content, length: 100) %>
              </p>
            </div>
          <% end %>
          
          <% if generation.metadata&.dig("pdf_generated") %>
            <div class="mb-4 p-2 bg-green-50 border border-green-200 rounded">
              <div class="flex items-center justify-between">
                <span class="text-green-600 text-sm">📄 PDF جاهز</span>
                <div class="flex space-x-1">
                  <%= link_to 'عرض', view_pdf_cv_generation_path(generation), target: "_blank", class: 'text-xs bg-green-500 hover:bg-green-600 text-white px-2 py-1 rounded' %>
                  <%= link_to 'تحميل', download_pdf_cv_generation_path(generation), class: 'text-xs bg-purple-500 hover:bg-purple-600 text-white px-2 py-1 rounded' %>
                </div>
              </div>
            </div>
          <% end %>
          
          <div class="mt-3 text-xs text-gray-500">
            تم التوليد: <%= generation.created_at.strftime("%d/%m/%Y") %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-12">
      <div class="text-gray-400 mb-4">
        <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-2">لا توجد سير ذاتية بعد</h3>
      <p class="text-gray-500 mb-6">ابدأ بإنشاء سيرتك الذاتية الأولى أو استخدم الذكاء الاصطناعي لتوليدها.</p>
      <div class="flex gap-3 justify-center">
        <%= link_to 'إنشاء سيرة ذاتية', new_resume_path, class: 'bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded' %>
        <%= link_to 'توليد بالذكاء الاصطناعي', new_cv_generation_path, class: 'bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded' %>
      </div>
    </div>
  <% end %>
</div>

<div class="container mx-auto px-4 py-8">
  <!-- Header with Actions -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">سيرتي الذاتية</h1>
      <p class="text-gray-600 mt-1">إدارة وتحرير سيرك الذاتية</p>
    </div>
    <div class="flex gap-3">
      <%= link_to new_resume_path, class: 'inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 px-4 rounded-lg transition-colors js-hover-target', data: { hoverable: true } do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        إنشاء سيرة جديدة
      <% end %>
    </div>
  </div>

  <% total_count = @resumes.size + @drafts.size + @cv_generations.size %>

  <% if total_count > 0 %>
    <!-- Stats Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
      <div class="bg-white rounded-lg p-4 border border-gray-200 shadow-sm">
        <div class="text-2xl font-bold text-gray-900"><%= total_count %></div>
        <div class="text-sm text-gray-600">إجمالي السير</div>
      </div>
      <div class="bg-white rounded-lg p-4 border border-amber-200 shadow-sm">
        <div class="text-2xl font-bold text-amber-600"><%= @drafts.size %></div>
        <div class="text-sm text-gray-600">مسودات</div>
      </div>
      <div class="bg-white rounded-lg p-4 border border-green-200 shadow-sm">
        <div class="text-2xl font-bold text-green-600"><%= @resumes.size %></div>
        <div class="text-sm text-gray-600">مكتملة</div>
      </div>
      <div class="bg-white rounded-lg p-4 border border-purple-200 shadow-sm">
        <div class="text-2xl font-bold text-purple-600"><%= @cv_generations.size %></div>
        <div class="text-sm text-gray-600">مولدة بالذكاء</div>
      </div>
    </div>
  <% end %>

  <!-- Drafts Section (if any) -->
  <% if @drafts.any? %>
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-8 h-8 bg-amber-100 rounded-full flex items-center justify-center">
          <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-gray-900">مسودات قيد العمل</h2>
        <span class="bg-amber-100 text-amber-700 text-xs font-medium px-2.5 py-0.5 rounded-full"><%= @drafts.size %></span>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <% @drafts.each do |resume| %>
          <% step = resume.draft_data&.dig('current_step') || 1 %>
          <div id="resume_<%= resume.id %>" class="bg-white rounded-xl border-2 border-amber-200 hover:border-amber-400 p-5 transition-all hover:shadow-lg hover:-translate-y-1 group relative">
            <!-- Delete Button -->
            <%= button_to resume_path(resume), method: :delete, form: { data: { turbo_confirm: 'هل أنت متأكد من حذف هذه المسودة؟' } }, class: 'absolute top-3 left-3 p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all opacity-0 group-hover:opacity-100 z-10', title: 'حذف' do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            <% end %>

            <%= link_to edit_resume_path(resume, step: step), class: 'block cursor-pointer' do %>
              <!-- Header -->
              <div class="flex items-start justify-between mb-3">
                <div class="flex items-center gap-2">
                  <span class="px-2.5 py-1 text-xs bg-amber-100 text-amber-700 rounded-full font-medium">مسودة</span>
                  <span class="px-2 py-1 text-xs bg-gray-100 text-gray-600 rounded-full">الخطوة <%= step %>/4</span>
                </div>
                <div class="flex items-center gap-1">
                  <span class="w-2 h-2 bg-amber-400 rounded-full animate-pulse"></span>
                  <span class="text-xs text-amber-600 font-medium">قيد العمل</span>
                </div>
              </div>

              <!-- Name -->
              <h3 class="text-lg font-bold text-gray-900 mb-1 truncate">
                <%= resume.complete_name.present? ? resume.complete_name : "سيرة بدون اسم" %>
              </h3>
              
              <!-- Email -->
              <div class="flex items-center gap-2 text-sm text-gray-500 mb-3">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                <span class="truncate"><%= resume.email.presence || "لم يتم إدخال البريد" %></span>
              </div>

              <!-- Professional Summary Preview -->
              <% draft_summary = resume.professional_summary_english.presence || resume.professional_summary.presence %>
              <% if draft_summary.present? %>
                <div class="p-3 bg-gray-50 rounded-lg mb-4">
                  <p class="text-xs text-gray-600 line-clamp-2 leading-relaxed"><%= truncate(draft_summary, length: 100) %></p>
                </div>
              <% end %>

              <!-- Progress Bar -->
              <div class="mb-4 p-3 bg-amber-50 rounded-lg">
                <div class="flex justify-between text-xs mb-2">
                  <span class="text-amber-700 font-medium">التقدم في الإنشاء</span>
                  <span class="text-amber-800 font-bold"><%= ((step.to_f / 4) * 100).round %>%</span>
                </div>
                <div class="w-full bg-amber-200 rounded-full h-2.5">
                  <div class="bg-amber-500 h-2.5 rounded-full transition-all" style="width: <%= ((step.to_f / 4) * 100).round %>%"></div>
                </div>
              </div>

              <!-- Stats Row -->
              <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500 mb-4 pb-3 border-b border-gray-100">
                <span class="flex items-center gap-1 bg-blue-50 text-blue-700 px-2 py-1 rounded-full">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  <%= resume.work_experiences.size %> خبرات
                </span>
                <span class="flex items-center gap-1 bg-purple-50 text-purple-700 px-2 py-1 rounded-full">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                  <%= resume.educations.size rescue 0 %> تعليم
                </span>
                <span class="flex items-center gap-1 bg-emerald-50 text-emerald-700 px-2 py-1 rounded-full">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                  </svg>
                  <%= resume.skills.size %> مهارات
                </span>
              </div>

              <!-- Last Updated -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs text-gray-400">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <% if resume.draft_data&.dig('saved_at') %>
                    آخر تحديث: <%= Time.parse(resume.draft_data['saved_at']).strftime("%d/%m/%Y %H:%M") rescue resume.updated_at.strftime("%d/%m/%Y %H:%M") %>
                  <% else %>
                    تم الإنشاء: <%= resume.created_at.strftime("%d/%m/%Y") %>
                  <% end %>
                </div>
                <div class="flex items-center gap-1 text-amber-600 group-hover:text-amber-700 transition-colors">
                  <span class="text-sm font-medium">استكمال</span>
                  <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @resumes.any? || @cv_generations.any? || total_count == 0 %>
    <!-- Completed Resumes Section -->
    <% if @resumes.any? %>
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-gray-900">سير ذاتية مكتملة</h2>
          <span class="bg-green-100 text-green-700 text-xs font-medium px-2.5 py-0.5 rounded-full"><%= @resumes.size %></span>
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          <% @resumes.each do |resume| %>
            <div id="resume_<%= resume.id %>" class="bg-white rounded-xl border border-gray-200 hover:border-emerald-400 p-5 transition-all hover:shadow-lg hover:-translate-y-1 group relative">
              <!-- Delete Button -->
              <%= button_to resume_path(resume), method: :delete, form: { data: { turbo_confirm: 'هل أنت متأكد من حذف هذه السيرة الذاتية؟' } }, class: 'absolute top-3 left-3 p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all opacity-0 group-hover:opacity-100 z-10', title: 'حذف' do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              <% end %>

              <%= link_to resume_path(resume), class: 'block cursor-pointer' do %>
                <!-- Header -->
                <div class="flex items-start justify-between mb-3">
                  <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 text-xs bg-green-100 text-green-700 rounded-full font-medium flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      مكتملة
                    </span>
                  </div>
                  <div class="flex items-center gap-2 text-xs text-gray-400">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <%= resume.updated_at.strftime("%d/%m/%Y") %>
                  </div>
                </div>

                <!-- Name -->
                <h3 class="text-lg font-bold text-gray-900 mb-1 truncate">
                  <%= resume.complete_name.presence || "سيرة بدون اسم" %>
                </h3>
                
                <!-- Email -->
                <div class="flex items-center gap-2 text-sm text-gray-500 mb-3">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  <span class="truncate"><%= resume.email %></span>
                </div>

                <!-- Summary Preview -->
                <% summary = resume.professional_summary_english.presence || resume.professional_summary.presence %>
                <% if summary.present? %>
                  <div class="p-3 bg-gray-50 rounded-lg mb-4">
                    <p class="text-xs text-gray-600 line-clamp-2 leading-relaxed"><%= truncate(summary, length: 120) %></p>
                  </div>
                <% end %>

              <!-- Stats Row -->
              <div class="flex flex-wrap items-center gap-3 text-xs text-gray-500 mb-4 pb-4 border-b border-gray-100">
                <span class="flex items-center gap-1 bg-blue-50 text-blue-700 px-2 py-1 rounded-full">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  <%= resume.work_experiences.size %> خبرات
                </span>
                <span class="flex items-center gap-1 bg-purple-50 text-purple-700 px-2 py-1 rounded-full">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                  <%= resume.educations.size rescue 0 %> تعليم
                </span>
                <span class="flex items-center gap-1 bg-emerald-50 text-emerald-700 px-2 py-1 rounded-full">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                  </svg>
                  <%= resume.skills.size %> مهارات
                </span>
                <% if resume.respond_to?(:certificates) && resume.certificates.any? %>
                  <span class="flex items-center gap-1 bg-amber-50 text-amber-700 px-2 py-1 rounded-full">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                    </svg>
                    <%= resume.certificates.size %> شهادات
                  </span>
                <% end %>
              </div>

              <!-- Footer with CTA -->
              <div class="flex items-center justify-between">
                <div class="text-xs text-gray-400">
                  تم الإنشاء: <%= resume.created_at.strftime("%d/%m/%Y") %>
                </div>
                <div class="flex items-center gap-1 text-emerald-600 group-hover:text-emerald-700 transition-colors">
                  <span class="text-sm font-medium">عرض التفاصيل</span>
                  <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </div>
              </div>
            <% end %>
          </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- AI Generated CVs Section -->
    <% if @cv_generations.any? %>
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
            <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-gray-900">مولدة بالذكاء الاصطناعي</h2>
          <span class="bg-purple-100 text-purple-700 text-xs font-medium px-2.5 py-0.5 rounded-full"><%= @cv_generations.size %></span>
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          <% @cv_generations.each do |generation| %>
            <div id="cv_generation_<%= generation.id %>" class="bg-gradient-to-br from-purple-50 to-blue-50 rounded-xl border border-purple-200 hover:border-purple-400 p-5 transition-all hover:shadow-lg hover:-translate-y-1 group relative">
              <!-- Delete Button -->
              <%= button_to cv_generation_path(generation), method: :delete, form: { data: { turbo_confirm: 'هل أنت متأكد من حذف هذه السيرة المولدة؟' } }, class: 'absolute top-3 left-3 p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all opacity-0 group-hover:opacity-100 z-10', title: 'حذف' do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
              <% end %>

              <%= link_to cv_generation_path(generation), class: 'block cursor-pointer' do %>
                <!-- Header -->
                <div class="flex items-start justify-between mb-3">
                  <span class="px-2.5 py-1 text-xs bg-purple-100 text-purple-700 rounded-full font-medium flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    ذكاء اصطناعي
                  </span>
                  <div class="flex items-center gap-2 text-xs text-gray-400">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <%= generation.created_at.strftime("%d/%m/%Y") %>
                  </div>
                </div>

                <!-- Title -->
                <h3 class="text-lg font-bold text-gray-900 mb-2">سيرة ذاتية #<%= generation.id %></h3>

                <!-- Job Description Preview -->
                <% if generation.job_description.present? %>
                  <div class="p-3 bg-white/70 rounded-lg mb-4">
                    <p class="text-xs text-gray-500 mb-1 font-medium">الوظيفة المستهدفة:</p>
                    <p class="text-sm text-gray-700 line-clamp-2"><%= truncate(generation.job_description, length: 100) %></p>
                  </div>
                <% end %>

                <!-- Generated Content Preview -->
                <% if generation.generated_content.present? %>
                  <div class="p-3 bg-purple-50/50 rounded-lg mb-4">
                    <p class="text-xs text-purple-600 mb-1 font-medium">المحتوى المولد:</p>
                    <p class="text-xs text-gray-600 line-clamp-2"><%= truncate(generation.generated_content, length: 100) %></p>
                  </div>
                <% end %>

                <!-- PDF Status -->
                <% if generation.metadata&.dig("pdf_generated") %>
                  <div class="flex items-center gap-2 mb-4 p-2 bg-green-50 border border-green-200 rounded-lg">
                    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="text-xs text-green-700 font-medium">PDF جاهز للتحميل</span>
                  </div>
              <% end %>

              <!-- Footer with CTA -->
              <div class="flex items-center justify-between pt-3 border-t border-purple-100">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-400 rounded-full"></span>
                  <span class="text-xs text-purple-600">تم التوليد تلقائياً</span>
                </div>
                <div class="flex items-center gap-1 text-purple-600 group-hover:text-purple-700 transition-colors">
                  <span class="text-sm font-medium">عرض التفاصيل</span>
                  <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </div>
              </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if total_count == 0 %>
    <!-- Empty State -->
    <div class="text-center py-16 bg-gradient-to-br from-gray-50 to-emerald-50 rounded-2xl border-2 border-dashed border-gray-200">
      <div class="w-20 h-20 mx-auto mb-6 bg-emerald-100 rounded-full flex items-center justify-center">
        <svg class="w-10 h-10 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-gray-900 mb-2">لا توجد سير ذاتية بعد</h3>
      <p class="text-gray-600 mb-8 max-w-md mx-auto">ابدأ رحلتك المهنية بإنشاء سيرة ذاتية احترافية تساعدك في الحصول على وظيفة أحلامك</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <%= link_to new_resume_path, class: 'inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-3 px-6 rounded-xl transition-colors' do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          إنشاء سيرة ذاتية جديدة
        <% end %>
        <%= link_to new_cv_generation_path, class: 'inline-flex items-center justify-center gap-2 bg-purple-600 hover:bg-purple-700 text-white font-medium py-3 px-6 rounded-xl transition-colors' do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
          </svg>
          توليد بالذكاء الاصطناعي
        <% end %>
      </div>
    </div>
  <% end %>
</div>

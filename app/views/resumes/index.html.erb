<div class="container mx-auto px-4 pt-24 pb-8">
  <% if flash[:alert].present? %>
    <div role="alert" class="mb-6 flex items-start gap-3 rounded-2xl border border-gold/40 bg-gold/10 px-4 py-3 text-ink dark:text-mist">
      <iconify-icon icon="solar:info-circle-linear" width="22" class="shrink-0 text-gold-deep dark:text-gold"></iconify-icon>
      <p class="text-sm leading-relaxed"><%= flash[:alert] %></p>
    </div>
  <% end %>
  <!-- Header with Actions -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div class="text-center sm:text-right w-full sm:w-auto">
      <h1 class="text-3xl md:text-4xl font-bold text-primary mb-2"><%= t('resume.my_resume') %></h1>
      <p class="text-gray-600 dark:text-gray-300"><%= t('resume.manage_resumes') %></p>
    </div>
    <div class="flex gap-3 w-full sm:w-auto justify-center sm:justify-end">
      <%= link_to new_resume_path, class: 'inline-flex items-center gap-2 bg-action hover:bg-actionHover text-darkBase font-medium py-2.5 px-4 rounded-lg transition-colors', data: { hoverable: true } do %>
        <iconify-icon icon="solar:add-circle-bold" width="20"></iconify-icon>
        <%= t('resume.create_new') %>
      <% end %>
    </div>
  </div>

  <% total_count = @resumes.size + @drafts.size + @cv_generations.size %>

  <% if total_count > 0 %>
    <!-- Stats Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="bg-white/80 dark:bg-white/5 backdrop-blur-sm rounded-xl p-4 border border-gray-200 dark:border-white/10 shadow-sm">
        <div class="text-2xl font-bold text-darkBase dark:text-white"><%= total_count %></div>
        <div class="text-sm text-gray-600 dark:text-gray-400"><%= t('resume.total_resumes') %></div>
      </div>
      <div class="bg-white/80 dark:bg-white/5 backdrop-blur-sm rounded-xl p-4 border border-primary/20 shadow-sm">
        <div class="text-2xl font-bold text-primary"><%= @drafts.size %></div>
        <div class="text-sm text-gray-600 dark:text-gray-400"><%= t('resume.drafts') %></div>
      </div>
      <div class="bg-white/80 dark:bg-white/5 backdrop-blur-sm rounded-xl p-4 border border-action/30 shadow-sm">
        <div class="text-2xl font-bold text-action"><%= @resumes.size %></div>
        <div class="text-sm text-gray-600 dark:text-gray-400"><%= t('resume.completed') %></div>
      </div>
      <div class="bg-white/80 dark:bg-white/5 backdrop-blur-sm rounded-xl p-4 border border-primary/20 shadow-sm">
        <div class="text-2xl font-bold text-primary"><%= @cv_generations.size %></div>
        <div class="text-sm text-gray-600 dark:text-gray-400"><%= t('resume.ai_generated') %></div>
      </div>
    </div>
  <% end %>

  <!-- Tabs for filtering -->
  <% if total_count > 0 %>
    <div class="flex items-center gap-2 mb-6 flex-wrap">
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 dark:bg-primary/20 text-primary text-sm font-medium ring-1 ring-primary/30">
        <iconify-icon icon="solar:folder-bold" width="16"></iconify-icon>
        <%= t('resume.all') %>
        <span class="bg-primary/20 px-2 py-0.5 rounded-full text-xs"><%= total_count %></span>
      </span>
      <% if @drafts.any? %>
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 dark:bg-white/5 text-gray-600 dark:text-gray-300 text-sm font-medium border border-gray-200 dark:border-white/10">
          <iconify-icon icon="solar:document-text-bold" width="16"></iconify-icon>
          <%= t('resume.drafts') %>
          <span class="bg-gray-100 dark:bg-white/10 px-2 py-0.5 rounded-full text-xs"><%= @drafts.size %></span>
        </span>
      <% end %>
    </div>
  <% end %>

  <!-- Drafts Section (if any) -->
  <% if @drafts.any? %>
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-10 h-10 bg-primary/10 dark:bg-primary/20 rounded-xl flex items-center justify-center">
          <iconify-icon icon="solar:document-text-bold" class="text-primary" width="20"></iconify-icon>
        </div>
        <h2 class="text-xl font-bold text-darkBase dark:text-white"><%= t('resume.drafts_in_progress') %></h2>
        <span class="bg-primary/10 dark:bg-primary/20 text-primary text-xs font-semibold px-3 py-1 rounded-full"><%= @drafts.size %></span>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <% @drafts.each do |resume| %>
          <% step = resume.draft_data&.dig('current_step') || 1 %>
          <div id="resume_<%= resume.id %>" class="bg-white/80 dark:bg-white/5 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-white/10 hover:border-primary/50 dark:hover:border-primary/50 p-5 transition-all hover:shadow-lg hover:shadow-primary/5 hover:-translate-y-1 group relative">
            <!-- Delete Button -->
            <%= button_to resume_path(resume), method: :delete, form: { data: { turbo_confirm: t('resume.delete_draft_confirm') } }, class: 'absolute top-3 left-3 p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/20 rounded-lg transition-all opacity-0 group-hover:opacity-100 z-10', title: t('actions.delete') do %>
              <iconify-icon icon="solar:trash-bin-trash-bold" width="16"></iconify-icon>
            <% end %>

            <%= link_to edit_resume_path(resume, step: step), class: 'block cursor-pointer' do %>
              <!-- Header -->
              <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="px-2.5 py-1 text-xs bg-primary/10 dark:bg-primary/20 text-primary rounded-full font-medium"><%= t('resume.draft') %></span>
                  <span class="px-2 py-1 text-xs bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 rounded-full"><%= t('resume.step_of', step: step) %></span>
                  <% if resume.source == "linkedin" %>
                    <span class="px-2.5 py-1 text-xs bg-[#0077B5] text-white rounded-full font-medium flex items-center gap-1">
                      <iconify-icon icon="mdi:linkedin" width="12"></iconify-icon>
                      LinkedIn
                    </span>
                  <% end %>
                </div>
                <div class="flex items-center gap-1">
                  <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
                  <span class="text-xs text-primary font-medium"><%= t('resume.in_progress') %></span>
                </div>
              </div>

              <!-- Name -->
              <h3 class="text-lg font-bold text-darkBase dark:text-white mb-1 truncate">
                <%= resume.complete_name.present? ? resume.complete_name : t('resume.no_name_draft') %>
              </h3>
              
              <!-- Email -->
              <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-4">
                <iconify-icon icon="solar:letter-bold" width="16"></iconify-icon>
                <span class="truncate"><%= resume.email.presence || t('resume.email_not_entered') %></span>
              </div>

              <!-- Professional Summary Preview -->
              <% draft_summary = resume.professional_summary_english.presence || resume.professional_summary.presence %>
              <% if draft_summary.present? %>
                <div class="p-3 bg-gray-50 dark:bg-white/5 rounded-xl mb-4">
                  <p class="text-xs text-gray-600 dark:text-gray-400 line-clamp-2 leading-relaxed"><%= truncate(draft_summary, length: 100) %></p>
                </div>
              <% end %>

              <!-- Progress Bar -->
              <div class="mb-4 p-3 bg-primary/5 dark:bg-primary/10 rounded-xl">
                <div class="flex justify-between text-xs mb-2">
                  <span class="text-primary font-medium"><%= t('resume.creation_progress') %></span>
                  <span class="text-primary font-bold"><%= ((step.to_f / 4) * 100).round %>%</span>
                </div>
                <div class="w-full bg-primary/20 rounded-full h-2">
                  <div class="bg-gradient-to-l from-primary to-action h-2 rounded-full transition-all" style="width: <%= ((step.to_f / 4) * 100).round %>%"></div>
                </div>
              </div>

              <!-- Stats Row -->
              <div class="flex flex-wrap items-center gap-2 text-xs mb-4 pb-4 border-b border-gray-100 dark:border-white/10">
                <span class="flex items-center gap-1 bg-primary/10 dark:bg-primary/20 text-primary px-2 py-1 rounded-full">
                  <iconify-icon icon="solar:case-bold" width="14"></iconify-icon>
                  <%= t('resume.experiences_count', count: resume.work_experiences.size) %>
                </span>
                <span class="flex items-center gap-1 bg-action/10 dark:bg-action/20 text-action px-2 py-1 rounded-full">
                  <iconify-icon icon="solar:square-academic-cap-bold" width="14"></iconify-icon>
                  <%= t('resume.education_count', count: (resume.educations.size rescue 0)) %>
                </span>
                <span class="flex items-center gap-1 bg-primary/10 dark:bg-primary/20 text-primary px-2 py-1 rounded-full">
                  <iconify-icon icon="solar:star-bold" width="14"></iconify-icon>
                  <%= t('resume.skills_count', count: resume.skills.size) %>
                </span>
              </div>

              <!-- Last Updated -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
                  <iconify-icon icon="solar:clock-circle-bold" width="14"></iconify-icon>
                  <% if resume.draft_data&.dig('saved_at') %>
                    <%= t('resume.last_updated') %> <%= (Time.parse(resume.draft_data['saved_at']).strftime("%d/%m/%Y %H:%M") rescue resume.updated_at.strftime("%d/%m/%Y %H:%M")) %>
                  <% else %>
                    <%= t('resume.created') %> <%= resume.created_at.strftime("%d/%m/%Y") %>
                  <% end %>
                </div>
                <div class="flex items-center gap-1 text-primary group-hover:text-primaryHover transition-colors">
                  <span class="text-sm font-medium"><%= t('resume.continue') %></span>
                  <iconify-icon icon="solar:arrow-left-bold" class="transform group-hover:-translate-x-1 transition-transform" width="16"></iconify-icon>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @resumes.any? || @cv_generations.any? || total_count == 0 %>
    <!-- Completed Resumes Section -->
    <% if @resumes.any? %>
      <div class="mb-10">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 bg-action/10 dark:bg-action/20 rounded-xl flex items-center justify-center">
            <iconify-icon icon="solar:verified-check-bold" class="text-action" width="20"></iconify-icon>
          </div>
          <h2 class="text-xl font-bold text-darkBase dark:text-white"><%= t('resume.completed_resumes') %></h2>
          <span class="bg-action/10 dark:bg-action/20 text-action text-xs font-semibold px-3 py-1 rounded-full"><%= @resumes.size %></span>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          <% @resumes.each do |resume| %>
            <div id="resume_<%= resume.id %>" class="bg-white/80 dark:bg-white/5 backdrop-blur-sm rounded-2xl border border-gray-200 dark:border-white/10 hover:border-action/50 dark:hover:border-action/50 p-5 transition-all hover:shadow-lg hover:shadow-action/5 hover:-translate-y-1 group relative">
              <!-- Delete Button -->
              <%= button_to resume_path(resume), method: :delete, form: { data: { turbo_confirm: t('resume.delete_resume_confirm') } }, class: 'absolute top-3 left-3 p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/20 rounded-lg transition-all opacity-0 group-hover:opacity-100 z-10', title: t('actions.delete') do %>
                <iconify-icon icon="solar:trash-bin-trash-bold" width="16"></iconify-icon>
              <% end %>

              <% linkedin_import = resume.linkedin_import_for_edit %>
              <% resume_link = linkedin_import.present? ? linkedin_import_show_path(linkedin_import) : resume_path(resume) %>
              <%= link_to resume_link, class: 'block cursor-pointer' do %>
                <!-- Header -->
                <div class="flex items-start justify-between mb-4">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="px-2.5 py-1 text-xs bg-action/10 dark:bg-action/20 text-action rounded-full font-medium flex items-center gap-1">
                      <iconify-icon icon="solar:check-circle-bold" width="12"></iconify-icon>
                      <%= t('resume.completed') %>
                    </span>
                    <% if resume.source == "linkedin" %>
                      <span class="px-2.5 py-1 text-xs bg-[#0077B5] text-white rounded-full font-medium flex items-center gap-1">
                        <iconify-icon icon="mdi:linkedin" width="12"></iconify-icon>
                        LinkedIn
                      </span>
                    <% end %>
                  </div>
                  <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
                    <iconify-icon icon="solar:clock-circle-bold" width="14"></iconify-icon>
                    <%= resume.updated_at.strftime("%d/%m/%Y") %>
                  </div>
                </div>

                <!-- Name -->
                <h3 class="text-lg font-bold text-darkBase dark:text-white mb-1 truncate">
                  <%= resume.complete_name.presence || t('resume.no_name_draft') %>
                </h3>
                
                <!-- Email -->
                <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-4">
                  <iconify-icon icon="solar:letter-bold" width="16"></iconify-icon>
                  <span class="truncate"><%= resume.email %></span>
                </div>

                <!-- Summary Preview -->
                <% summary = resume.professional_summary_english.presence || resume.professional_summary.presence %>
                <% if summary.present? %>
                  <div class="p-3 bg-gray-50 dark:bg-white/5 rounded-xl mb-4">
                    <p class="text-xs text-gray-600 dark:text-gray-400 line-clamp-2 leading-relaxed"><%= truncate(summary, length: 120) %></p>
                  </div>
                <% end %>

                <!-- Stats Row -->
                <div class="flex flex-wrap items-center gap-2 text-xs mb-4 pb-4 border-b border-gray-100 dark:border-white/10">
                  <span class="flex items-center gap-1 bg-primary/10 dark:bg-primary/20 text-primary px-2 py-1 rounded-full">
                    <iconify-icon icon="solar:case-bold" width="14"></iconify-icon>
                    <%= t('resume.experiences_count', count: resume.work_experiences.size) %>
                  </span>
                  <span class="flex items-center gap-1 bg-action/10 dark:bg-action/20 text-action px-2 py-1 rounded-full">
                    <iconify-icon icon="solar:square-academic-cap-bold" width="14"></iconify-icon>
                    <%= t('resume.education_count', count: (resume.educations.size rescue 0)) %>
                  </span>
                  <span class="flex items-center gap-1 bg-primary/10 dark:bg-primary/20 text-primary px-2 py-1 rounded-full">
                    <iconify-icon icon="solar:star-bold" width="14"></iconify-icon>
                    <%= t('resume.skills_count', count: resume.skills.size) %>
                  </span>
                  <% if resume.respond_to?(:certificates) && resume.certificates.any? %>
                    <span class="flex items-center gap-1 bg-action/10 dark:bg-action/20 text-action px-2 py-1 rounded-full">
                      <iconify-icon icon="solar:medal-ribbons-star-bold" width="14"></iconify-icon>
                      <%= t('resume.certificates_count', count: resume.certificates.size) %>
                    </span>
                  <% end %>
                </div>

                <!-- Footer with CTA -->
                <div class="flex items-center justify-between">
                  <div class="text-xs text-gray-400 dark:text-gray-500">
                    <%= t('resume.created') %> <%= resume.created_at.strftime("%d/%m/%Y") %>
                  </div>
                  <div class="flex items-center gap-1 text-action group-hover:text-actionHover transition-colors">
                    <span class="text-sm font-medium"><%= t('resume.view_details') %></span>
                    <iconify-icon icon="solar:arrow-left-bold" class="transform group-hover:-translate-x-1 transition-transform" width="16"></iconify-icon>
                  </div>
                </div>
              <% end %>
              
              <!-- Edit Button for completed resumes -->
              <div class="mt-3 pt-3 border-t border-gray-100 dark:border-white/10">
                <% edit_link = linkedin_import.present? ? linkedin_import_show_path(linkedin_import) : edit_resume_path(resume) %>
                <%= link_to edit_link, class: 'w-full inline-flex items-center justify-center gap-2 px-4 py-2 bg-primary/10 dark:bg-primary/20 hover:bg-primary/20 dark:hover:bg-primary/30 text-primary rounded-lg transition-colors text-sm font-medium' do %>
                  <iconify-icon icon="solar:pen-bold" width="16"></iconify-icon>
                  <%= t('resume.edit_resume') %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- AI Generated CVs Section -->
    <% if @cv_generations.any? %>
      <div class="mb-10">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-10 h-10 bg-gradient-to-br from-primary/20 to-action/20 rounded-xl flex items-center justify-center">
            <iconify-icon icon="solar:magic-stick-3-bold" class="text-primary" width="20"></iconify-icon>
          </div>
          <h2 class="text-xl font-bold text-darkBase dark:text-white"><%= t('resume.ai_generated_title') %></h2>
          <span class="bg-gradient-to-r from-primary/10 to-action/10 dark:from-primary/20 dark:to-action/20 text-primary text-xs font-semibold px-3 py-1 rounded-full"><%= @cv_generations.size %></span>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          <% @cv_generations.each do |generation| %>
            <div id="cv_generation_<%= generation.id %>" class="bg-gradient-to-br from-white/80 to-primary/5 dark:from-white/5 dark:to-primary/10 backdrop-blur-sm rounded-2xl border border-primary/20 hover:border-primary/50 p-5 transition-all hover:shadow-lg hover:shadow-primary/10 hover:-translate-y-1 group relative">
              <!-- Delete Button -->
              <%= button_to cv_generation_path(generation), method: :delete, form: { data: { turbo_confirm: t('resume.delete_generated_confirm') } }, class: 'absolute top-3 left-3 p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-500/20 rounded-lg transition-all opacity-0 group-hover:opacity-100 z-10', title: t('actions.delete') do %>
                <iconify-icon icon="solar:trash-bin-trash-bold" width="16"></iconify-icon>
              <% end %>

              <%= link_to cv_generation_path(generation), class: 'block cursor-pointer' do %>
                <!-- Header -->
                <div class="flex items-start justify-between mb-4">
                  <span class="px-2.5 py-1 text-xs bg-gradient-to-r from-primary/10 to-action/10 dark:from-primary/20 dark:to-action/20 text-primary rounded-full font-medium flex items-center gap-1">
                    <iconify-icon icon="solar:magic-stick-3-bold" width="12"></iconify-icon>
                    <%= t('resume.artificial_intelligence') %>
                  </span>
                  <div class="flex items-center gap-2 text-xs text-gray-400 dark:text-gray-500">
                    <iconify-icon icon="solar:clock-circle-bold" width="14"></iconify-icon>
                    <%= generation.created_at.strftime("%d/%m/%Y") %>
                  </div>
                </div>

                <!-- Title -->
                <h3 class="text-lg font-bold text-darkBase dark:text-white mb-3"><%= t('resume.cv_number', id: generation.id) %></h3>

                <!-- Job Description Preview -->
                <% if generation.job_description.present? %>
                  <div class="p-3 bg-white/70 dark:bg-white/5 rounded-xl mb-4">
                    <p class="text-xs text-gray-500 dark:text-gray-400 mb-1 font-medium"><%= t('resume.target_job') %></p>
                    <p class="text-sm text-gray-700 dark:text-gray-300 line-clamp-2"><%= truncate(generation.job_description, length: 100) %></p>
                  </div>
                <% end %>

                <!-- Generated Content Preview -->
                <% if generation.generated_content.present? %>
                  <div class="p-3 bg-primary/5 dark:bg-primary/10 rounded-xl mb-4">
                    <p class="text-xs text-primary mb-1 font-medium"><%= t('resume.generated_content') %></p>
                    <p class="text-xs text-gray-600 dark:text-gray-400 line-clamp-2"><%= truncate(generation.generated_content, length: 100) %></p>
                  </div>
                <% end %>

                <!-- PDF Status -->
                <% if generation.metadata&.dig("pdf_generated") %>
                  <div class="flex items-center gap-2 mb-4 p-2 bg-action/10 dark:bg-action/20 border border-action/30 rounded-xl">
                    <iconify-icon icon="solar:verified-check-bold" class="text-action" width="16"></iconify-icon>
                    <span class="text-xs text-action font-medium"><%= t('resume.pdf_ready') %></span>
                  </div>
                <% end %>

                <!-- Footer with CTA -->
                <div class="flex items-center justify-between pt-4 border-t border-primary/10 dark:border-primary/20">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-gradient-to-r from-primary to-action rounded-full"></span>
                    <span class="text-xs text-primary"><%= t('resume.auto_generated') %></span>
                  </div>
                  <div class="flex items-center gap-1 text-primary group-hover:text-primaryHover transition-colors">
                    <span class="text-sm font-medium"><%= t('resume.view_details') %></span>
                    <iconify-icon icon="solar:arrow-left-bold" class="transform group-hover:-translate-x-1 transition-transform" width="16"></iconify-icon>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <% if total_count == 0 %>
    <!-- Empty State -->
    <div class="text-center py-16 bg-gradient-to-br from-white/80 to-primary/5 dark:from-white/5 dark:to-primary/10 backdrop-blur-sm rounded-2xl border-2 border-dashed border-primary/30">
      <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-primary/10 to-action/10 dark:from-primary/20 dark:to-action/20 rounded-2xl flex items-center justify-center">
        <iconify-icon icon="solar:document-add-bold" class="text-primary" width="40"></iconify-icon>
      </div>
      <h3 class="text-xl font-bold text-darkBase dark:text-white mb-2"><%= t('resume.no_resumes_yet') %></h3>
      <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-md mx-auto"><%= t('resume.start_journey') %></p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <%= link_to new_resume_path, class: 'inline-flex items-center justify-center gap-2 bg-action hover:bg-actionHover text-darkBase font-medium py-3 px-6 rounded-xl transition-colors' do %>
          <iconify-icon icon="solar:add-circle-bold" width="20"></iconify-icon>
          <%= t('resume.create_new_resume') %>
        <% end %>
        <%= link_to new_cv_generation_path, class: 'inline-flex items-center justify-center gap-2 bg-primary hover:bg-primaryHover text-white font-medium py-3 px-6 rounded-xl transition-colors' do %>
          <iconify-icon icon="solar:magic-stick-3-bold" width="20"></iconify-icon>
          <%= t('resume.generate_with_ai') %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

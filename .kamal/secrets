# Secrets are referenced from config/deploy.yml under registry/password, env/secret,
# builder/secrets and accessories/*/env/secret. Never enter raw credentials here —
# this file is in git.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$(cat config/master.key)

# Postgres: same value on both sides — the app's connection string and the
# container's superuser password.
CVCRAFT_DATABASE_PASSWORD=$CVCRAFT_DATABASE_PASSWORD
POSTGRES_PASSWORD=$CVCRAFT_DATABASE_PASSWORD

# Amazon Bedrock (IAM user BedrockAPIKey-4vaj). RubyLLM signs with SigV4, so
# this is an access key pair, not the ABSK-style Bedrock API key.
AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY

# Admin panel basic auth
ADMIN_PASSWORD=$ADMIN_PASSWORD

# Moyasar payments (packs/billing). Secret key only; the hosted checkout
# needs no publishable key.
MOYASAR_SECRET_KEY=$MOYASAR_SECRET_KEY

# TypeSafe Jev (packs/coach judge). Optional: when empty, the coach falls back to Haiku.
JEV_API_KEY=$JEV_API_KEY

# Social sign-in (packs/accounts). Optional: a provider's button is hidden
# while any of its values is empty.
# Google: OAuth client (web application).
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
# Apple: APPLE_CLIENT_ID is the Services ID; APPLE_PRIVATE_KEY is the .p8 file
# base64-encoded on one line (`base64 -w0 AuthKey_XXXX.p8`), because
# multi-line repo secrets are dropped.
APPLE_CLIENT_ID=$APPLE_CLIENT_ID
APPLE_TEAM_ID=$APPLE_TEAM_ID
APPLE_KEY_ID=$APPLE_KEY_ID
APPLE_PRIVATE_KEY=$APPLE_PRIVATE_KEY
# LinkedIn: app with "Sign In with LinkedIn using OpenID Connect".
LINKEDIN_CLIENT_ID=$LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=$LINKEDIN_CLIENT_SECRET

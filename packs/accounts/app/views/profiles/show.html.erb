<% content_for :title, t('profile.title') %>

<div dir="<%= text_direction %>" class="min-h-screen bg-gradient-to-br from-gray-50 via-white to-gray-100 dark:from-darkBase dark:via-darkBase dark:to-darkBase transition-colors duration-300">
  <!-- Top Navigation Bar -->
  <div class="bg-white dark:bg-white/5 border-b border-gray-200 dark:border-white/10 backdrop-blur-sm">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-4">
          <%= link_to root_path, class: "flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-primary transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span class="font-medium"><%= t('profile.home') %></span>
          <% end %>
          <span class="text-gray-300 dark:text-gray-600">|</span>
          <%= link_to resumes_path, class: "flex items-center gap-2 text-gray-600 dark:text-gray-300 hover:text-primary transition-colors" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span class="font-medium"><%= t('profile.my_cv') %></span>
          <% end %>
        </div>
        <div class="flex items-center gap-3">
          <% if Billing.enabled_for?(current_user) %>
            <%= link_to credits_path, class: "inline-flex items-center gap-2 px-4 py-3 text-sm font-semibold rounded-xl border border-gray-200 dark:border-white/10 text-gray-700 dark:text-gray-200 hover:text-primary transition-colors" do %>
              <%= t('billing.title') %>
              <span class="font-mono" dir="ltr"><%= Billing::Credits.balance(current_user) %></span>
            <% end %>
          <% end %>
          <%= link_to new_resume_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-primary hover:bg-primaryHover text-white text-sm font-bold rounded-xl shadow-lg transition-all duration-200 hover:shadow-xl active:scale-[0.98]" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <%= t('profile.new_resume') %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Profile Header Card -->
    <div class="bg-white dark:bg-white/5 rounded-2xl shadow-xl border border-gray-100 dark:border-white/10 overflow-hidden mb-8 backdrop-blur-sm">
      <!-- Gradient Header -->
      <div class="relative bg-gradient-to-br from-primary via-primary to-action px-6 sm:px-10 py-10 sm:py-12">
        <!-- Decorative circles -->
        <div class="absolute top-0 left-0 w-40 h-40 bg-white/5 rounded-full -translate-x-1/2 -translate-y-1/2"></div>
        <div class="absolute bottom-0 right-0 w-60 h-60 bg-white/5 rounded-full translate-x-1/3 translate-y-1/3"></div>
        
        <div class="relative flex flex-col sm:flex-row items-center sm:items-start gap-6">
          <!-- Avatar -->
          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-white text-4xl sm:text-5xl font-bold shadow-lg ring-4 ring-white/30">
            <%= @user.name&.first&.upcase || @user.email&.first&.upcase || "U" %>
          </div>
          
          <!-- User Info -->
          <div class="text-center sm:text-right flex-1">
            <h1 class="text-2xl sm:text-3xl font-bold text-white mb-1">
              <%= @user.name.presence || @user.email.split('@').first %>
            </h1>
            <p class="text-white/80 text-lg mb-3"><%= @user.email %></p>
            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 text-white/60 text-sm">
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <%= t('profile.member_since', date: @user.created_at.strftime("%B %Y")) %>
              </span>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Stats Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4">
        <div class="p-6 text-center border-b lg:border-b-0 border-l border-gray-100 dark:border-white/10 hover:bg-primary/5 dark:hover:bg-primary/10 transition-colors">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 text-primary mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= @stats[:total_resumes] %></p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t('profile.completed_resumes') %></p>
        </div>
        <div class="p-6 text-center border-b lg:border-b-0 border-gray-100 dark:border-white/10 hover:bg-amber-50/50 dark:hover:bg-amber-500/10 transition-colors">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
          <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= @stats[:total_drafts] %></p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t('profile.drafts_in_progress') %></p>
        </div>
        <div class="p-6 text-center border-l border-gray-100 dark:border-white/10 hover:bg-action/5 dark:hover:bg-action/10 transition-colors">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-action/10 text-action mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </div>
          <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= @stats[:total_cv_generations] %></p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t('profile.pdf_files') %></p>
        </div>
        <div class="p-6 text-center hover:bg-primary/5 dark:hover:bg-primary/10 transition-colors">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-primary/10 text-primary mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
            </svg>
          </div>
          <p class="text-3xl font-bold text-gray-900 dark:text-white"><%= @stats[:total_translations] %></p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t('profile.ai_translations') %></p>
        </div>
      </div>
    </div>

    <!-- Two Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content (2/3) -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Resumes Section -->
        <div class="bg-white dark:bg-white/5 rounded-2xl shadow-lg border border-gray-100 dark:border-white/10 overflow-hidden backdrop-blur-sm">
          <div class="px-6 py-5 border-b border-gray-100 dark:border-white/10 flex items-center justify-between">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
              <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-primary/10 text-primary">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </span>
              <%= t('profile.resumes') %>
              <span class="text-sm font-normal text-gray-400 dark:text-gray-500">(<%= @resumes.count %>)</span>
            </h2>
            <%= link_to new_resume_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-primary hover:bg-primaryHover text-white text-sm font-bold rounded-xl shadow-lg transition-all duration-200 hover:shadow-xl active:scale-[0.98]" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              <%= t('profile.create_new_resume') %>
            <% end %>
          </div>
          
          <div class="p-6">
            <% if @resumes.any? %>
              <div class="space-y-4">
                <% @resumes.each do |resume| %>
                  <div class="group flex items-center justify-between p-5 bg-gradient-to-l from-gray-50 to-white dark:from-white/5 dark:to-transparent rounded-xl border border-gray-200 dark:border-white/10 hover:border-primary/50 dark:hover:border-primary/30 hover:shadow-md transition-all">
                    <div class="flex-1 min-w-0">
                      <h3 class="font-semibold text-gray-900 dark:text-white text-lg truncate"><%= resume.complete_name.presence || t('profile.no_name') %></h3>
                      <p class="text-gray-500 dark:text-gray-400 text-sm truncate"><%= resume.email %></p>
                      <div class="flex items-center gap-3 mt-2 text-xs text-gray-400 dark:text-gray-500">
                        <span class="flex items-center gap-1">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                          </svg>
                          <%= resume.updated_at.strftime("%Y-%m-%d") %>
                        </span>
                      </div>
                    </div>
                    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <%= link_to resume_path(resume), class: "p-2.5 text-gray-500 dark:text-gray-400 hover:text-primary hover:bg-primary/10 rounded-lg transition-colors", title: t('profile.view') do %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                      <% end %>
                      <%= link_to edit_resume_path(resume), class: "p-2.5 text-gray-500 dark:text-gray-400 hover:text-action hover:bg-action/10 rounded-lg transition-colors", title: t('profile.edit') do %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                      <% end %>
                      <%= link_to "/api/export_pdf?resume_id=#{resume.id}", class: "p-2.5 text-gray-500 dark:text-gray-400 hover:text-primary hover:bg-primary/10 rounded-lg transition-colors", title: t('profile.download_pdf') do %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                      <% end %>
                      <%= button_to resume_path(resume), method: :delete, class: "p-2.5 text-gray-500 dark:text-gray-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-lg transition-colors", title: t('profile.delete'), data: { turbo_confirm: t('profile.delete_resume_confirm') } do %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-12">
                <div class="w-20 h-20 mx-auto mb-4 rounded-2xl bg-gray-100 dark:bg-white/10 flex items-center justify-center">
                  <svg class="w-10 h-10 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                </div>
                <p class="text-gray-500 dark:text-gray-400 text-lg mb-2"><%= t('profile.no_resumes_yet') %></p>
                <p class="text-gray-400 dark:text-gray-500 text-sm mb-6"><%= t('profile.start_creating') %></p>
                <%= link_to new_resume_path, class: "inline-flex items-center gap-3 px-8 py-4 bg-action hover:bg-action/90 text-white text-base font-bold rounded-xl shadow-lg transition-all duration-200 hover:shadow-xl active:scale-[0.98]" do %>
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                  <%= t('profile.create_first_resume') %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Drafts Section -->
        <% if @drafts.any? %>
          <div class="bg-white dark:bg-white/5 rounded-2xl shadow-lg border border-gray-100 dark:border-white/10 overflow-hidden backdrop-blur-sm">
            <div class="px-6 py-5 border-b border-gray-100 dark:border-white/10">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
                <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-amber-100 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                </span>
                <%= t('profile.drafts') %>
                <span class="text-sm font-normal text-gray-400 dark:text-gray-500">(<%= @drafts.count %>)</span>
              </h2>
            </div>
            <div class="p-6 space-y-4">
              <% @drafts.each do |draft| %>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 bg-gradient-to-l from-amber-50 to-white dark:from-amber-500/10 dark:to-transparent rounded-xl border border-amber-200 dark:border-amber-500/20 hover:border-amber-300 dark:hover:border-amber-500/30 hover:shadow-md transition-all">
                  <div class="flex-1 min-w-0">
                    <p class="font-semibold text-gray-900 dark:text-white truncate text-base"><%= draft.complete_name.presence || t('profile.draft_no_name') %></p>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t('profile.last_edited', date: draft.updated_at.strftime("%Y-%m-%d %H:%M")) %></p>
                  </div>
                  <div class="flex items-center gap-3">
                    <%= link_to edit_resume_path(draft), class: "inline-flex items-center justify-center gap-2 px-6 py-3 bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold rounded-xl shadow-lg transition-all duration-200 hover:shadow-xl active:scale-[0.98]" do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                      </svg>
                      <%= t('profile.continue_editing') %>
                    <% end %>
                    <%= button_to resume_path(draft), method: :delete, class: "p-3 text-gray-400 dark:text-gray-500 hover:text-red-600 bg-white dark:bg-white/5 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-xl border border-gray-200 dark:border-white/10 hover:border-red-200 dark:hover:border-red-500/30 transition-all shadow-sm", data: { turbo_confirm: t('profile.delete_draft_confirm') } do %>
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Sidebar (1/3) -->
      <div class="space-y-8">
        <!-- Coupon Redemption Card -->
        <div class="bg-white dark:bg-white/5 rounded-2xl shadow-lg border border-gray-100 dark:border-white/10 overflow-hidden backdrop-blur-sm">
          <div class="px-6 py-5 border-b border-gray-100 dark:border-white/10">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/>
              </svg>
              <%= t('profile.coupon_code') %>
            </h2>
          </div>
          <div class="p-6">
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4"><%= t('profile.coupon_hint') %></p>
            <%= form_with url: redeem_coupon_profile_path, method: :post, local: true, class: "flex flex-col gap-3" do |f| %>
              <%= f.text_field :code, placeholder: random_coupon_code_placeholder, class: "w-full rounded-xl border border-gray-200 dark:border-white/10 bg-white/70 dark:bg-darkCard/70 px-4 py-3 text-gray-900 dark:text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary uppercase", autocomplete: "off" %>
              <%= f.submit t('profile.apply_coupon'), class: "w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary hover:bg-primaryHover text-white text-sm font-bold rounded-xl shadow-lg transition-all duration-200 hover:shadow-xl active:scale-[0.98] cursor-pointer" %>
            <% end %>
          </div>
        </div>

        <!-- Generation Credits Card -->
        <div class="bg-white dark:bg-white/5 rounded-2xl shadow-lg border border-gray-100 dark:border-white/10 overflow-hidden backdrop-blur-sm">
          <div class="px-6 py-5 border-b border-gray-100 dark:border-white/10">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-action" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <%= t('profile.generation_credits') %>
            </h2>
          </div>
          <div class="p-6 space-y-5">
            <!-- CV Builder Credits -->
            <div class="p-4 bg-gradient-to-l from-action/10 to-white dark:from-action/20 dark:to-transparent rounded-xl border border-action/20">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= t('profile.cv_builder_generation') %></span>
                <span class="text-sm font-bold text-action">
                  <% if @stats[:unlimited] %>
                    <%= t('profile.unlimited') %>
                  <% else %>
                    <%= @stats[:cv_builder_remaining] %>/<%= @stats[:cv_builder_max] %>
                  <% end %>
                </span>
              </div>
              <div class="w-full bg-action/20 rounded-full h-2.5">
                <div class="bg-action h-2.5 rounded-full transition-all" style="width: <%= @stats[:unlimited] ? 100 : (@stats[:cv_builder_remaining].to_f / @stats[:cv_builder_max] * 100).to_i %>%"></div>
              </div>
            </div>
            
            <!-- Job-Based CV Credits -->
            <div class="p-4 bg-gradient-to-l from-amber-50 to-white dark:from-amber-500/10 dark:to-transparent rounded-xl border border-amber-100 dark:border-amber-500/20">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= t('profile.job_based_generation') %></span>
                <span class="text-sm font-bold text-amber-600 dark:text-amber-400">
                  <% if @stats[:unlimited] %>
                    <%= t('profile.unlimited') %>
                  <% else %>
                    <%= @stats[:job_based_remaining] %>/<%= @stats[:job_based_max] %>
                  <% end %>
                </span>
              </div>
              <div class="w-full bg-amber-100 dark:bg-amber-500/20 rounded-full h-2.5">
                <div class="bg-amber-500 h-2.5 rounded-full transition-all" style="width: <%= @stats[:unlimited] ? 100 : (@stats[:job_based_remaining].to_f / @stats[:job_based_max] * 100).to_i %>%"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Translation Credits Card -->
        <div class="bg-white dark:bg-white/5 rounded-2xl shadow-lg border border-gray-100 dark:border-white/10 overflow-hidden backdrop-blur-sm">
          <div class="px-6 py-5 border-b border-gray-100 dark:border-white/10">
            <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
              </svg>
              <%= t('profile.translation_credits') %>
            </h2>
          </div>
          <div class="p-6 space-y-5">
            <!-- Summary Translations -->
            <div class="p-4 bg-gradient-to-l from-primary/10 to-white dark:from-primary/20 dark:to-transparent rounded-xl border border-primary/20">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= t('profile.professional_summary') %></span>
                <span class="text-sm font-bold text-primary">
                  <% if @stats[:unlimited] %>
                    <%= t('profile.unlimited') %>
                  <% else %>
                    <%= @stats[:remaining_summary_translations] %>/<%= @stats[:summary_translations_max] %>
                  <% end %>
                </span>
              </div>
              <div class="w-full bg-primary/20 rounded-full h-2.5">
                <div class="bg-primary h-2.5 rounded-full transition-all" style="width: <%= @stats[:unlimited] ? 100 : (@stats[:remaining_summary_translations].to_f / @stats[:summary_translations_max] * 100).to_i %>%"></div>
              </div>
            </div>
            
            <!-- Jobs Translations -->
            <div class="p-4 bg-gradient-to-l from-primary/10 to-white dark:from-primary/20 dark:to-transparent rounded-xl border border-primary/20">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= t('profile.job_descriptions') %></span>
                <span class="text-sm font-bold text-primary">
                  <% if @stats[:unlimited] %>
                    <%= t('profile.unlimited') %>
                  <% else %>
                    <%= @stats[:remaining_jobs_translations] %>/<%= @stats[:jobs_translations_max] %>
                  <% end %>
                </span>
              </div>
              <div class="w-full bg-primary/20 rounded-full h-2.5">
                <div class="bg-primary h-2.5 rounded-full transition-all" style="width: <%= @stats[:unlimited] ? 100 : (@stats[:remaining_jobs_translations].to_f / @stats[:jobs_translations_max] * 100).to_i %>%"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- PDF History Card -->
        <% if @cv_generations.any? %>
          <div class="bg-white dark:bg-white/5 rounded-2xl shadow-lg border border-gray-100 dark:border-white/10 overflow-hidden backdrop-blur-sm">
            <div class="px-6 py-5 border-b border-gray-100 dark:border-white/10">
              <h2 class="text-lg font-bold text-gray-900 dark:text-white flex items-center gap-2">
                <svg class="w-5 h-5 text-action" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
                <%= t('profile.pdf_history') %>
              </h2>
            </div>
            <div class="divide-y divide-gray-100 dark:divide-white/10">
              <% @cv_generations.limit(5).each do |gen| %>
                <div class="px-6 py-4 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-white/5 transition-colors">
                  <div>
                    <p class="text-sm text-gray-700 dark:text-gray-300"><%= gen.created_at.strftime("%Y-%m-%d") %></p>
                    <p class="text-xs text-gray-400 dark:text-gray-500"><%= gen.created_at.strftime("%H:%M") %></p>
                  </div>
                  <div class="flex items-center gap-2">
                    <% if gen.status == "completed" %>
                      <span class="px-2.5 py-1 bg-action/10 text-action text-xs font-medium rounded-full"><%= t('profile.status_completed') %></span>
                    <% elsif gen.status == "failed" %>
                      <span class="px-2.5 py-1 bg-red-100 dark:bg-red-500/20 text-red-700 dark:text-red-400 text-xs font-medium rounded-full"><%= t('profile.status_failed') %></span>
                    <% else %>
                      <span class="px-2.5 py-1 bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-400 text-xs font-medium rounded-full"><%= gen.status %></span>
                    <% end %>
                    <% if gen.status == "completed" && gen.resume_id %>
                      <%= link_to "/api/export_pdf?resume_id=#{gen.resume_id}", class: "p-1.5 text-primary hover:text-primaryHover hover:bg-primary/10 rounded-lg transition-colors" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                        </svg>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Danger Zone Card -->
        <div class="bg-white dark:bg-white/5 rounded-2xl shadow-lg border-2 border-red-200 dark:border-red-500/30 overflow-hidden backdrop-blur-sm">
          <div class="px-6 py-5 border-b border-red-200 dark:border-red-500/30 bg-gradient-to-l from-red-50 to-rose-50 dark:from-red-500/10 dark:to-transparent">
            <h2 class="text-lg font-bold text-red-700 dark:text-red-400 flex items-center gap-3">
              <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-red-100 dark:bg-red-500/20">
                <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
              </span>
              <%= t('profile.danger_zone') %>
            </h2>
          </div>
          <div class="p-6">
            <p class="text-gray-600 dark:text-gray-300 text-base mb-5 leading-relaxed">
              <%= t('profile.danger_warning') %>
            </p>
            <%= button_to profile_path, 
                method: :delete, 
                class: "w-full inline-flex items-center justify-center gap-3 px-6 py-4 bg-red-600 hover:bg-red-700 text-white text-base font-bold rounded-xl shadow-lg transition-all duration-200 hover:shadow-xl active:scale-[0.98]",
                form: { 
                  data: { 
                    turbo_confirm: t('profile.delete_account_warning'),
                    controller: "confirm-delete"
                  }
                } do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
              <%= t('profile.delete_my_account') %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

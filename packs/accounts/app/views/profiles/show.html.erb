<% content_for :title, t('profile.title') %>
<%# Long page: rise without the blur, and let the ambient orbs scroll with it (layout hooks; harmless if absent). %>
<% content_for :body_class, "sr-app-long" %>
<% content_for :ambient_scrolls, true %>
<% icons = {
     add: '<path d="M12 5v14M5 12h14"></path>',
     doc: '<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h4"></path>',
     pen: '<path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"></path>',
     eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle>',
     download: '<path d="M12 4v11M7 10l5 5 5-5"></path><path d="M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"></path>',
     trash: '<path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path>',
     clock: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>',
     calendar: '<rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path>',
     tag: '<path d="M3 12V5a2 2 0 012-2h7l9 9-9 9z"></path><circle cx="8" cy="8" r="1.5"></circle>',
     check: '<circle cx="12" cy="12" r="9"></circle><path d="M8 12l3 3 5-6"></path>',
     translate: '<path d="M4 5h9M8.5 3v2M6 5c.6 3.2 2.6 6 5.5 7.5M11 5c-.6 3.6-3 6.8-6.5 8.5"></path><path d="M13 21l4-9 4 9M14.5 18h5"></path>',
     warning: '<path d="M12 3l10 18H2z"></path><path d="M12 10v4M12 17.5v.01"></path>',
     folder: '<path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>',
     coin: '<circle cx="12" cy="12" r="9"></circle><path d="M9 9.5c0-1 1.3-1.8 3-1.8s3 .8 3 1.8-1.3 1.6-3 2-3 1-3 2 1.3 1.8 3 1.8 3-.8 3-1.8M12 6v1.7M12 16.3V18"></path>'
   } %>
<% svg = ->(name, size = 18) { "<svg class=\"shrink-0\" width=\"#{size}\" height=\"#{size}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">#{icons[name]}</svg>".html_safe } %>
<% arrow = '<svg class="sr-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>'.html_safe %>
<% muted = "color: rgba(238,243,238,0.6)" %>
<% soft = "color: rgba(238,243,238,0.72)" %>
<% primary_class = "sr-btn sr-primary inline-flex items-center justify-center gap-2.5 min-h-[52px] px-5 rounded-2xl font-semibold text-[15px] border-0 cursor-pointer" %>
<% primary_style = "box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)" %>
<% secondary_class = "sr-btn glass-soft inline-flex items-center justify-center gap-2.5 min-h-[52px] px-[18px] rounded-2xl text-[15px]" %>
<% card_class = "glass sr-reveal rounded-[28px] p-5 sm:p-7 flex flex-col gap-5" %>
<% card_title = "m-0 text-[19px] font-semibold flex items-center gap-3" %>
<% title_icon = "glass-soft sr-ico flex-none w-11 h-11 rounded-[14px] flex items-center justify-center" %>
<% icon_btn = "glass-soft flex-none w-11 h-11 rounded-xl flex items-center justify-center transition-colors duration-300" %>
<% pct = ->(left, max) { max.to_f.positive? ? ((left.to_f / max) * 100).clamp(0, 100).to_i : 0 } %>
<% display_name = @user.name.presence || @user.email.split('@').first %>
<% initial = @user.name&.first&.upcase || @user.email&.first&.upcase || "U" %>

<%# A long page: the wrapper rises without sr-fadeUp's blur so it paints fast on phones. %>
<div dir="<%= text_direction %>" data-controller="confirm-delete" class="sr-page relative overflow-clip leading-relaxed" style="color: #eef3ee; animation-name: sr-riseUp">
  <div class="relative mx-auto max-w-[1240px] px-4 sm:px-6 pt-10 pb-20 flex flex-col gap-10">

    <!-- Profile header -->
    <header class="flex flex-col lg:flex-row lg:items-end justify-between gap-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 min-w-0">
        <span class="glass sr-up sr-mono flex-none w-24 h-24 sm:w-28 sm:h-28 rounded-[28px] flex items-center justify-center text-4xl sm:text-5xl font-semibold" style="animation-delay: 0s; color: #d6b877; background: linear-gradient(155deg, rgba(214,184,119,0.22), rgba(0,108,53,0.18))" aria-hidden="true"><%= initial %></span>
        <div class="flex flex-col items-start gap-3 min-w-0">
          <span class="glass-soft sr-up inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-sm" style="animation-delay: .05s; color: rgba(238,243,238,0.9)">
            <span class="sr-dot w-2 h-2 rounded-full bg-primary"></span>
            <%= t('profile.title') %>
          </span>
          <h1 class="m-0 font-semibold break-words max-w-full" style="font-size: clamp(30px, 4.4vw, 52px); line-height: 1.15; letter-spacing: -0.02em">
            <% words = display_name.split %>
            <% delay = 0.1 %>
            <% words.each_with_index do |word, i| %><span class="sr-w" style="<%= 'color: #d6b877; ' if i == words.size - 1 && words.size > 1 %>animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
          </h1>
          <div class="sr-up flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[15px] min-w-0" style="animation-delay: .4s; <%= muted %>">
            <span class="sr-mono truncate max-w-full" dir="ltr"><%= @user.email %></span>
            <span class="inline-flex items-center gap-1.5"><%= svg.call(:calendar, 16) %><%= t('profile.member_since', date: @user.created_at.strftime("%B %Y")) %></span>
          </div>
        </div>
      </div>
      <div class="sr-up flex flex-wrap items-center gap-2.5" style="animation-delay: .5s">
        <% if Billing.enabled_for?(current_user) %>
          <%= link_to credits_path, class: secondary_class do %>
            <span style="color: #d6b877"><%= svg.call(:coin) %></span>
            <%= t('billing.title') %>
            <span class="sr-mono font-semibold" dir="ltr" style="color: #d6b877"><%= Billing::Credits.balance(current_user) %></span>
          <% end %>
        <% end %>
        <%= link_to resumes_path, class: secondary_class do %>
          <%= svg.call(:folder) %>
          <%= t('profile.my_cv') %>
        <% end %>
        <%= link_to new_resume_path, class: primary_class, style: primary_style do %>
          <%= svg.call(:add) %>
          <%= t('profile.new_resume') %>
          <span class="sr-ico flex"><%= arrow %></span>
        <% end %>
      </div>
    </header>

    <% if flash[:notice].present? || flash[:alert].present? %>
      <div class="flex flex-col gap-3">
        <% if flash[:notice].present? %>
          <div role="status" class="glass-soft sr-up flex items-start gap-3 rounded-2xl px-4 py-3.5" style="animation-delay: .55s; border-color: rgba(47,163,107,0.4); background: rgba(47,163,107,0.1)">
            <span style="color: #2fa36b"><%= svg.call(:check, 20) %></span>
            <p class="m-0 text-[15px]"><%= flash[:notice] %></p>
          </div>
        <% end %>
        <% if flash[:alert].present? %>
          <div role="alert" class="glass-soft sr-up flex items-start gap-3 rounded-2xl px-4 py-3.5" style="animation-delay: .55s; border-color: rgba(214,184,119,0.45); background: rgba(214,184,119,0.1)">
            <span style="color: #d6b877"><%= svg.call(:warning, 20) %></span>
            <p class="m-0 text-[15px]"><%= flash[:alert] %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Stats -->
    <div class="sr-up grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4" style="animation-delay: .6s">
      <% [
           [ @stats[:total_resumes], t('profile.completed_resumes'), "#eef3ee", :doc ],
           [ @stats[:total_drafts], t('profile.drafts_in_progress'), "#d6b877", :pen ],
           [ @stats[:total_cv_generations], t('profile.pdf_files'), "#2fa36b", :download ],
           [ @stats[:total_translations], t('profile.ai_translations'), "#2fa36b", :translate ]
         ].each do |value, label, color, icon| %>
        <div class="glass sr-lift rounded-[24px] p-5 flex flex-col gap-3">
          <span class="glass-soft sr-ico w-10 h-10 rounded-xl flex items-center justify-center" style="color: <%= color %>"><%= svg.call(icon) %></span>
          <span class="sr-mono font-semibold" style="font-size: clamp(26px, 3vw, 34px); line-height: 1.1; color: <%= color %>"><%= value %></span>
          <span class="text-sm" style="<%= muted %>"><%= label %></span>
        </div>
      <% end %>
    </div>

    <!-- Two columns -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-start">
      <!-- Main (2/3) -->
      <div class="lg:col-span-2 flex flex-col gap-5 min-w-0">
        <!-- Resumes -->
        <section class="<%= card_class %>">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <h2 class="<%= card_title %>">
              <span class="<%= title_icon %>" style="color: #2fa36b"><%= svg.call(:doc, 20) %></span>
              <%= t('profile.resumes') %>
              <span class="sr-mono text-sm font-normal" style="<%= muted %>">(<%= @resumes.count %>)</span>
            </h2>
            <%= link_to new_resume_path, class: primary_class, style: primary_style do %>
              <%= svg.call(:add) %>
              <%= t('profile.create_new_resume') %>
            <% end %>
          </div>

          <% if @resumes.any? %>
            <ul class="list-none m-0 p-0 flex flex-col gap-2.5">
              <% @resumes.each do |resume| %>
                <% resume_name = resume.complete_name.presence || t('profile.no_name') %>
                <li class="glass-soft sr-lift rounded-[20px] p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div class="flex-1 min-w-0 flex flex-col gap-1">
                    <h3 class="m-0 text-[17px] font-semibold truncate"><%= resume_name %></h3>
                    <p class="m-0 text-sm truncate" style="<%= muted %>" dir="ltr"><%= resume.email %></p>
                    <span class="inline-flex items-center gap-1.5 text-xs" style="color: rgba(238,243,238,0.5)">
                      <%= svg.call(:clock, 14) %>
                      <span class="sr-mono" dir="ltr"><%= resume.updated_at.strftime("%Y-%m-%d") %></span>
                    </span>
                  </div>
                  <div class="flex items-center gap-2">
                    <%= link_to resume_path(resume), class: "#{icon_btn} hover:text-[#2fa36b]", style: soft, title: t('profile.view'), aria: { label: t('ux_confirm.aria.view_resume', name: resume_name) } do %>
                      <%= svg.call(:eye) %>
                    <% end %>
                    <%= link_to edit_resume_path(resume), class: "#{icon_btn} hover:text-[#d6b877]", style: soft, title: t('profile.edit'), aria: { label: t('ux_confirm.aria.edit_resume', name: resume_name) } do %>
                      <%= svg.call(:pen) %>
                    <% end %>
                    <%= link_to "/api/export_pdf?resume_id=#{resume.id}", class: "#{icon_btn} hover:text-[#2fa36b]", style: soft, title: t('profile.download_pdf'), aria: { label: t('ux_confirm.aria.download_pdf', name: resume_name) } do %>
                      <%= svg.call(:download) %>
                    <% end %>
                    <%= button_to resume_path(resume), method: :delete, class: "#{icon_btn} cursor-pointer hover:text-red-300", style: soft, title: t('profile.delete'),
                        aria: { label: t('ux_confirm.aria.delete_resume', name: resume_name) },
                        form: {
                          data: {
                            action: "submit->confirm-delete#intercept",
                            confirm_delete_title_param: t('ux_confirm.resume_title'),
                            confirm_delete_body_param: t('ux_confirm.resume_body', name: resume_name),
                            confirm_delete_confirm_label_param: t('ux_confirm.resume_confirm')
                          }
                        } do %>
                      <%= svg.call(:trash) %>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="glass-soft rounded-[24px] px-6 py-12 flex flex-col items-center text-center gap-3">
              <span class="glass sr-float w-16 h-16 rounded-[20px] flex items-center justify-center" style="color: #2fa36b"><%= svg.call(:doc, 28) %></span>
              <p class="m-0 text-[18px] font-semibold"><%= t('profile.no_resumes_yet') %></p>
              <p class="m-0 text-sm mb-3" style="<%= muted %>"><%= t('profile.start_creating') %></p>
              <%= link_to new_resume_path, class: primary_class, style: primary_style do %>
                <%= svg.call(:add) %>
                <%= t('profile.create_first_resume') %>
                <span class="sr-ico flex"><%= arrow %></span>
              <% end %>
            </div>
          <% end %>
        </section>

        <!-- Drafts -->
        <% if @drafts.any? %>
          <section class="<%= card_class %>">
            <h2 class="<%= card_title %>">
              <span class="<%= title_icon %>" style="color: #d6b877"><%= svg.call(:pen, 20) %></span>
              <%= t('profile.drafts') %>
              <span class="sr-mono text-sm font-normal" style="<%= muted %>">(<%= @drafts.count %>)</span>
            </h2>
            <ul class="list-none m-0 p-0 flex flex-col gap-2.5">
              <% @drafts.each do |draft| %>
                <% draft_name = draft.complete_name.presence || t('profile.draft_no_name') %>
                <li class="glass-soft sr-lift rounded-[20px] p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4" style="border-color: rgba(214,184,119,0.28)">
                  <div class="flex-1 min-w-0 flex flex-col gap-1">
                    <p class="m-0 text-[17px] font-semibold truncate"><%= draft_name %></p>
                    <p class="m-0 text-sm" style="<%= muted %>"><%= t('profile.last_edited', date: draft.updated_at.strftime("%Y-%m-%d %H:%M")) %></p>
                  </div>
                  <div class="flex items-center gap-2">
                    <%= link_to edit_resume_path(draft), class: "sr-btn glass-soft inline-flex items-center justify-center gap-2 min-h-[44px] px-4 rounded-xl text-[15px] font-medium", style: "color: #d6b877; border-color: rgba(214,184,119,0.4); background: rgba(214,184,119,0.1)" do %>
                      <%= svg.call(:pen) %>
                      <%= t('profile.continue_editing') %>
                    <% end %>
                    <%= button_to resume_path(draft), method: :delete, class: "#{icon_btn} cursor-pointer hover:text-red-300", style: soft,
                        title: t('profile.delete'),
                        aria: { label: t('ux_confirm.aria.delete_draft', name: draft_name) },
                        form: {
                          data: {
                            action: "submit->confirm-delete#intercept",
                            confirm_delete_title_param: t('ux_confirm.draft_title'),
                            confirm_delete_body_param: t('ux_confirm.draft_body', name: draft_name),
                            confirm_delete_confirm_label_param: t('ux_confirm.draft_confirm')
                          }
                        } do %>
                      <%= svg.call(:trash) %>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>

      <!-- Sidebar (1/3) -->
      <div class="flex flex-col gap-5 min-w-0">
        <!-- Coupon -->
        <section class="<%= card_class %>">
          <h2 class="<%= card_title %>">
            <span class="<%= title_icon %>" style="color: #2fa36b"><%= svg.call(:tag, 20) %></span>
            <%= t('profile.coupon_code') %>
          </h2>
          <p class="m-0 text-sm" style="<%= soft %>"><%= t('profile.coupon_hint') %></p>
          <%= form_with url: redeem_coupon_profile_path, method: :post, local: true, class: "flex flex-col gap-3" do |f| %>
            <%= f.text_field :code, placeholder: random_coupon_code_placeholder, autocomplete: "off", "aria-label": t('profile.coupon_code'),
                  class: "sr-mono glass-soft w-full min-h-[52px] rounded-2xl px-4 py-3 text-base uppercase focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d6b877]", style: "color: #eef3ee" %>
            <button type="submit" class="<%= primary_class %> w-full" style="<%= primary_style %>">
              <%= t('profile.apply_coupon') %>
            </button>
          <% end %>
        </section>

        <!-- Generation credits -->
        <% [
             [ t('profile.generation_credits'), :check, "#d6b877", [
                 [ t('profile.job_based_generation'), @stats[:job_based_remaining], @stats[:job_based_max], "#2fa36b" ]
               ] ],
             [ t('profile.translation_credits'), :translate, "#2fa36b", [
                 [ t('profile.professional_summary'), @stats[:remaining_summary_translations], @stats[:summary_translations_max], "#2fa36b" ],
                 [ t('profile.job_descriptions'), @stats[:remaining_jobs_translations], @stats[:jobs_translations_max], "#2fa36b" ]
               ] ]
           ].each do |title, icon, color, rows| %>
          <section class="<%= card_class %>">
            <h2 class="<%= card_title %>">
              <span class="<%= title_icon %>" style="color: <%= color %>"><%= svg.call(icon, 20) %></span>
              <%= title %>
            </h2>
            <div class="flex flex-col gap-2.5">
              <% rows.each_with_index do |(label, left, max, bar), i| %>
                <% width = @stats[:unlimited] ? 100 : pct.call(left, max) %>
                <div class="glass-soft rounded-[18px] p-4 flex flex-col gap-2.5">
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-sm font-medium"><%= label %></span>
                    <span class="sr-mono text-sm font-semibold" style="color: <%= bar %>" dir="ltr">
                      <% if @stats[:unlimited] %><%= t('profile.unlimited') %><% else %><%= left %>/<%= max %><% end %>
                    </span>
                  </div>
                  <div class="w-full h-2 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.08)" role="presentation">
                    <span class="sr-grow h-2 rounded-full" style="width: <%= width %>%; background: <%= bar %>; animation-delay: <%= (0.7 + i * 0.12).round(2) %>s"></span>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
        <% if @stats[:credits_enabled] && !@stats[:unlimited] %>
          <p class="text-xs px-1" style="color: rgba(238,243,238,0.7)"><%= t("ux_overage.profile.then_credit_each", count: @stats[:credit_balance], **credit_costs) %></p>
        <% end %>

        <!-- PDF history -->
        <% if @cv_generations.any? %>
          <section class="<%= card_class %>">
            <h2 class="<%= card_title %>">
              <span class="<%= title_icon %>" style="color: #d6b877"><%= svg.call(:download, 20) %></span>
              <%= t('profile.pdf_history') %>
            </h2>
            <ul class="list-none m-0 p-0 flex flex-col gap-2">
              <% @cv_generations.limit(5).each do |gen| %>
                <li class="glass-soft rounded-2xl ps-4 pe-2 py-2 flex items-center justify-between gap-3 min-h-[60px]">
                  <div class="sr-mono flex flex-col" dir="ltr">
                    <span class="text-sm"><%= gen.created_at.strftime("%Y-%m-%d") %></span>
                    <span class="text-xs" style="color: rgba(238,243,238,0.5)"><%= gen.created_at.strftime("%H:%M") %></span>
                  </div>
                  <div class="flex items-center gap-2">
                    <% if gen.status == "completed" %>
                      <span class="glass-soft px-2.5 py-1 rounded-full text-xs font-medium" style="background: rgba(47,163,107,0.12); border-color: rgba(47,163,107,0.35); color: #2fa36b"><%= t('profile.status_completed') %></span>
                    <% elsif gen.status == "failed" %>
                      <span class="glass-soft px-2.5 py-1 rounded-full text-xs font-medium" style="background: rgba(248,113,113,0.12); border-color: rgba(248,113,113,0.35); color: #fca5a5"><%= t('profile.status_failed') %></span>
                    <% else %>
                      <span class="glass-soft px-2.5 py-1 rounded-full text-xs font-medium" style="<%= soft %>"><%= gen.status %></span>
                    <% end %>
                    <% if gen.status == "completed" && gen.resume_id %>
                      <%= link_to "/api/export_pdf?resume_id=#{gen.resume_id}", class: "#{icon_btn} hover:text-[#d6b877]", style: "color: #2fa36b", title: t('profile.download_pdf'), aria: { label: t('profile.download_pdf') } do %>
                        <%= svg.call(:download) %>
                      <% end %>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>

        <!-- Danger zone -->
        <section class="<%= card_class %>" style="border-color: rgba(248,113,113,0.32)">
          <h2 class="<%= card_title %>" style="color: #fca5a5">
            <span class="<%= title_icon %>" style="color: #fca5a5; background: rgba(248,113,113,0.1); border-color: rgba(248,113,113,0.3)"><%= svg.call(:warning, 20) %></span>
            <%= t('profile.danger_zone') %>
          </h2>
          <p class="m-0 text-[15px] leading-relaxed" style="<%= soft %>"><%= t('pdpl_profile.export_hint') %></p>
          <%= link_to export_profile_path, data: { turbo: false }, class: "#{secondary_class} w-full font-medium" do %>
            <%= svg.call(:download) %>
            <%= t('pdpl_profile.export_button') %>
          <% end %>
          <p class="m-0 text-[15px] leading-relaxed" style="<%= soft %>"><%= t('profile.danger_warning') %></p>
          <%= button_to profile_path,
              method: :delete,
              class: "sr-btn w-full inline-flex items-center justify-center gap-2.5 min-h-[52px] px-5 rounded-2xl font-semibold text-[15px] text-white bg-red-600 hover:bg-red-500 border-0 cursor-pointer",
              style: "box-shadow: inset 0 1px 0 rgba(255,255,255,0.35), 0 18px 40px -18px rgba(220,38,38,0.6)",
              form: {
                data: {
                  action: "submit->confirm-delete#intercept",
                  confirm_delete_title_param: t('ux_confirm.account_title'),
                  confirm_delete_body_param: t('ux_confirm.account_body'),
                  confirm_delete_confirm_label_param: t('ux_confirm.account_confirm'),
                  confirm_delete_phrase_param: t('ux_confirm.account_phrase')
                }
              } do %>
            <%= svg.call(:trash) %>
            <%= t('profile.delete_my_account') %>
          <% end %>
        </section>
      </div>
    </div>
  </div>
  <%= render "shared/confirm_dialog" %>
</div>

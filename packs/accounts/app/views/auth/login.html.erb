<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= text_direction %>" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('auth.page_title') %> — <%= t('site.name') %></title>
    <meta name="description" content="<%= t('auth.page_description') %>" />
    <meta name="theme-color" content="#07120D" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/icon.png?v=7" type="image/png" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render 'shared/posthog' %>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet"></noscript>

    <style>
        body {
            font-feature-settings: "ss01", "ss02";
            -webkit-font-smoothing: antialiased;
        }
        .blob {
            position: absolute;
            filter: blur(90px);
            opacity: 0.5;
            z-index: -1;
            animation: pulse 10s infinite alternate;
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            100% { transform: scale(1.1); }
        }
        .gradient-text {
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            background-image: linear-gradient(135deg, #0B7F48 0%, #D6B877 100%);
        }
        iconify-icon {
            display: inline-block;
            vertical-align: middle;
        }
    </style>
</head>
<body class="sr-app bg-canvas text-darkBase transition-colors duration-300 selection:bg-action selection:text-darkBase dark:bg-darkBase dark:text-canvas overflow-x-hidden">
<%= render 'shared/ambient', fixed: true %>

    <%= render 'layouts/header' %>

    <!-- Main Content -->
    <div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 pt-28">
      <div class="max-w-md w-full space-y-8">
        <!-- Header -->
        <div class="text-center">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-primary/20 bg-primary/5 dark:bg-primary/10 mb-4 backdrop-blur-md">
            <iconify-icon icon="solar:shield-check-linear" width="16" class="text-action"></iconify-icon>
            <span class="text-primary dark:text-action text-xs md:text-sm font-normal"><%= t('auth.secure_login') %></span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-medium tracking-tight text-darkBase dark:text-white">
            <%= t('auth.welcome') %> <span class="gradient-text"><%= t('site.name') %></span>
          </h1>
          <p class="mt-2 text-gray-600 dark:text-gray-400 leading-7">
            <%= t('auth.otp_instruction') %>
          </p>
        </div>

        <!-- Flash Messages -->
        <% if flash[:notice] && params[:otp_sent] != 'true' %>
          <div class="rounded-xl bg-action/10 border border-action/30 p-4 backdrop-blur-xl">
            <div class="flex items-center gap-3">
              <iconify-icon icon="solar:check-circle-linear" width="20" class="text-action"></iconify-icon>
              <p class="text-sm text-darkBase dark:text-white"><%= flash[:notice] %></p>
            </div>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="rounded-xl bg-red-500/10 border border-red-500/30 p-4 backdrop-blur-xl">
            <div class="flex items-center gap-3">
              <iconify-icon icon="solar:danger-circle-linear" width="20" class="text-red-500"></iconify-icon>
              <p class="text-sm text-darkBase dark:text-white"><%= flash[:alert] %></p>
            </div>
          </div>
        <% end %>

        <!-- Email Form -->
        <% unless params[:otp_sent] == 'true' %>
          <div class="bg-white/60 dark:bg-darkCard/60 backdrop-blur-xl rounded-2xl p-6 md:p-8 shadow-xl border border-borderLight dark:border-borderDark">
            <form class="space-y-6" action="/auth/send_otp" method="post">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :return_to, params[:return_to] %>
              <div>
                <label for="email" class="block text-sm font-medium text-darkBase dark:text-white mb-2"><%= t('auth.email') %></label>
                <input 
                  id="email" 
                  name="email" 
                  type="email" 
                  autocomplete="email" 
                  required 
                  class="w-full rounded-xl border border-borderLight dark:border-borderDark bg-white/70 dark:bg-white/5 px-4 py-3.5 text-sm text-darkBase dark:text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" 
                  placeholder="<%= t('auth.email_placeholder') %>"
                />
              </div>
              <button 
                type="submit" 
                class="btn-loading w-full inline-flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primaryHover text-white text-sm font-medium px-4 py-3.5 shadow-glow hover:shadow-lg transition-all"
              >
                <iconify-icon icon="solar:letter-linear" width="18" class="btn-icon"></iconify-icon>
                <svg class="btn-spinner hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <span class="btn-text"><%= t('auth.send_code') %></span>
              </button>
            </form>
          </div>
        <% end %>

        <!-- OTP Form -->
        <% if params[:otp_sent] == 'true' %>
          <div class="bg-white/60 dark:bg-darkCard/60 backdrop-blur-xl rounded-2xl p-6 md:p-8 shadow-xl border border-borderLight dark:border-borderDark">
            <form class="space-y-6" action="/auth/verify_otp" method="post">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <%= hidden_field_tag :email, params[:email] %>
              <%= hidden_field_tag :return_to, params[:return_to] %>
              
              <!-- Success Message -->
              <div class="rounded-xl bg-action/10 border border-action/30 p-4">
                <div class="flex items-center gap-3">
                  <iconify-icon icon="solar:letter-linear" width="20" class="text-action"></iconify-icon>
                  <div>
                    <p class="text-sm font-medium text-darkBase dark:text-white"><%= t('auth.code_sent') %></p>
                    <p class="text-xs text-gray-500 dark:text-gray-400"><%= t('auth.code_sent_to', email: params[:email]) %></p>
                  </div>
                </div>
              </div>

              <div>
                <label for="otp_code" class="block text-sm font-medium text-darkBase dark:text-white mb-2"><%= t('auth.verification_code') %></label>
                <input 
                  id="otp_code" 
                  name="otp_code" 
                  type="text" 
                  maxlength="6" 
                  required 
                  class="w-full rounded-xl border border-borderLight dark:border-borderDark bg-white/70 dark:bg-white/5 px-4 py-3.5 text-center text-2xl tracking-widest text-darkBase dark:text-white placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" 
                  placeholder="000000"
                />
              </div>
              
              <button 
                type="submit" 
                class="btn-loading w-full inline-flex items-center justify-center gap-2 rounded-xl bg-action hover:bg-actionHover text-darkBase text-sm font-medium px-4 py-3.5 shadow-glow-mint hover:shadow-lg transition-all"
              >
                <iconify-icon icon="solar:login-2-linear" width="18" class="btn-icon"></iconify-icon>
                <svg class="btn-spinner hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <span class="btn-text"><%= t('auth.login_title') %></span>
              </button>
            </form>
          </div>
        <% end %>

        <!-- Footer -->
        <div class="text-center">
          <p class="text-xs text-gray-500 dark:text-gray-400">
            <%= t('auth.terms_agreement') %>
            <a href="#" class="text-primary hover:text-primaryHover dark:text-action transition-colors"><%= t('auth.terms_of_service') %></a>
            <%= t('auth.and') %>
            <a href="<%= privacy_path %>" class="text-primary hover:text-primaryHover dark:text-action transition-colors"><%= t('auth.privacy_policy') %></a>
          </p>
        </div>
      </div>
    </div>

    <!-- Site Footer -->
    <%= render 'layouts/footer' %>

    <script>
        // Theme Logic
        const html = document.documentElement;

        // Initialize Theme
        html.classList.add('dark'); // the Seera design is dark only

        // Button loading animation
        document.addEventListener('DOMContentLoaded', () => {
            // Reset button loading state on page load
            document.querySelectorAll('.btn-loading').forEach(btn => {
                btn.disabled = false;
                const icon = btn.querySelector('.btn-icon');
                const spinner = btn.querySelector('.btn-spinner');
                if (icon) icon.style.display = '';
                if (spinner) spinner.classList.add('hidden');
            });

            // Handle form submission
            document.querySelectorAll('.btn-loading').forEach(btn => {
                const originalText = btn.querySelector('.btn-text')?.textContent;
                btn.dataset.originalText = originalText;
                
                const form = btn.closest('form');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        setTimeout(() => {
                            btn.classList.add('opacity-75');
                            
                            const icon = btn.querySelector('.btn-icon');
                            const spinner = btn.querySelector('.btn-spinner');
                            
                            if (icon) icon.style.display = 'none';
                            if (spinner) spinner.classList.remove('hidden');
                        }, 0);
                    });
                }
            });
        });

        // Reset on pageshow (back/forward navigation)
        window.addEventListener('pageshow', () => {
            document.querySelectorAll('.btn-loading').forEach(btn => {
                btn.disabled = false;
                btn.classList.remove('opacity-75');
                const icon = btn.querySelector('.btn-icon');
                const spinner = btn.querySelector('.btn-spinner');
                const text = btn.querySelector('.btn-text');
                if (icon) icon.style.display = '';
                if (spinner) spinner.classList.add('hidden');
                if (text && btn.dataset.originalText) text.textContent = btn.dataset.originalText;
            });
        });
    </script>
<%= render 'shared/site_scripts' %>
</body>
</html>

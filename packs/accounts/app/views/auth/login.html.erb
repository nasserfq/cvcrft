<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= text_direction %>" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('auth.page_title') %> — <%= t('site.name') %></title>
    <meta name="description" content="<%= t('auth.page_description') %>" />
    <meta name="theme-color" content="#07120D" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/icon.png?v=7" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=7" />
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render 'shared/posthog' %>

    <%# Same stylesheet, icons and fonts as the landing page (home/index). %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/iconify-icon@1.0.7/dist/iconify-icon.min.js" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" /></noscript>

    <style>
        /* The six-digit code: spaced mono digits, centred in either direction. */
        #otp_code { letter-spacing: 0.5em; text-indent: 0.5em; }
        #privacy_consent { accent-color: #0b7f48; }
        .sr-field:focus { outline: none; border-color: rgba(214,184,119,0.6); box-shadow: inset 0 1px 0 rgba(255,255,255,0.1), 0 0 0 3px rgba(214,184,119,0.18); }
        .sr-field { transition: border-color .35s cubic-bezier(.16,1,.3,1), box-shadow .35s cubic-bezier(.16,1,.3,1); }
    </style>
</head>
<body class="bg-darkBase text-mist overflow-x-hidden">
    <% otp_step = params[:otp_sent] == 'true' %>
    <% primary_class = "btn-loading sr-btn sr-primary w-full flex items-center justify-center gap-2.5 min-h-[56px] px-6 rounded-2xl font-semibold text-[16px] border-0 cursor-pointer disabled:opacity-45 disabled:cursor-not-allowed" %>
    <% primary_style = "box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)" %>
    <% spinner = '<svg class="btn-spinner hidden animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>'.html_safe %>
    <% field_class = "sr-field glass-soft w-full min-h-[56px] rounded-2xl px-4 py-3.5 text-base" %>

    <div class="sr-page relative overflow-clip min-h-dvh leading-relaxed" style="background: #07120d; color: #eef3ee; line-height: 1.6">

      <%= render 'shared/ambient' %>

      <div class="relative mx-auto max-w-[1240px] px-4 sm:px-6 pt-4 sm:pt-6 pb-10">

        <%= render 'shared/site_header' %>

        <main id="main" class="flex justify-center pt-14 pb-20 md:pt-20 md:pb-[100px]">
          <div class="w-full max-w-[480px] flex flex-col gap-7">
            <!-- Header -->
            <header class="flex flex-col items-center text-center gap-5">
              <span class="glass-soft sr-up inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-sm" style="animation-delay: 0s; color: rgba(238,243,238,0.9)">
                <span class="sr-dot w-2 h-2 rounded-full bg-primary"></span>
                <%= t('auth.secure_login') %>
              </span>
              <h1 class="m-0 font-semibold" style="font-size: clamp(34px, 5vw, 52px); line-height: 1.15; letter-spacing: -0.02em">
                <% delay = 0.1 %>
                <% t('auth.welcome').split.each do |word| %><span class="sr-w" style="animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
                <span class="sr-w" style="color: #d6b877; animation-delay: <%= delay.round(2) %>s"><%= t('site.name') %></span>
              </h1>
              <p class="sr-up m-0 text-[17px] font-light max-w-[42ch]" style="animation-delay: .45s; color: rgba(238,243,238,0.7)">
                <%= t('auth.otp_instruction') %>
              </p>
            </header>

            <!-- Flash Messages -->
            <% if flash[:notice] && !otp_step %>
              <div role="status" class="glass-soft sr-up flex items-center gap-3 rounded-2xl px-4 py-3.5" style="animation-delay: .5s; border-color: rgba(47,163,107,0.4); background: rgba(47,163,107,0.1)">
                <iconify-icon icon="solar:check-circle-linear" width="20" style="color: #2fa36b"></iconify-icon>
                <p class="m-0 text-[15px]"><%= flash[:notice] %></p>
              </div>
            <% end %>
            <% if flash[:alert] %>
              <div role="alert" class="glass-soft sr-up flex items-center gap-3 rounded-2xl px-4 py-3.5" style="animation-delay: .5s; border-color: rgba(248,113,113,0.4); background: rgba(248,113,113,0.1)">
                <iconify-icon icon="solar:danger-circle-linear" width="20" style="color: #fca5a5"></iconify-icon>
                <p class="m-0 text-[15px]"><%= flash[:alert] %></p>
              </div>
            <% end %>

            <!-- One glass card holds both steps -->
            <div class="glass sr-up relative overflow-hidden rounded-[32px]" style="animation-delay: .55s">
              <%= render 'shared/sadu_band' %>
              <div class="p-6 sm:p-8">
                <!-- Email step: kept in the page on the OTP step (hidden) so "Change email" needs no reload -->
                <%# On the OTP step it starts hidden; "Change email" reveals it with the landing's rise. %>
                <%# The PDPL consent box covers both the email code and social sign-in. With social
                    buttons it sits above them; without, it stays in the email form as before. The
                    form="email-form" attribute keeps it part of that form wherever it is. %>
                <% social = SocialAuth.providers.any? %>
                <% consent_block = capture do %>
                    <div class="flex items-start gap-1">
                      <%# 44px tap target around the 20px box. %>
                      <label for="privacy_consent" class="flex-none flex items-center justify-center w-11 h-11 -ms-3 -mt-2.5 cursor-pointer">
                        <input
                          id="privacy_consent"
                          name="privacy_consent"
                          type="checkbox"
                          value="1"
                          required
                          form="email-form"
                          class="w-5 h-5 rounded cursor-pointer"
                        />
                      </label>
                      <label for="privacy_consent" class="text-sm leading-6 cursor-pointer" style="color: rgba(238,243,238,0.72)">
                        <%= t('pdpl_consent.checkbox_html',
                              privacy_link: link_to(t('pdpl_consent.privacy_link'), privacy_path, target: "_blank", rel: "noopener", class: "underline underline-offset-4", style: "color: #d6b877"),
                              terms_link: link_to(t('pdpl_consent.terms_link'), terms_path, target: "_blank", rel: "noopener", class: "underline underline-offset-4", style: "color: #d6b877")) %>
                      </label>
                    </div>
                <% end %>
                <div id="email-step" class="<%= 'hidden sr-up' if otp_step %>" style="animation-duration: .8s">
                  <div class="flex flex-col gap-6">
                    <% if social %>
                      <%= consent_block %>

                      <!-- Social sign-in: POST forms (OmniAuth); the script below adds the consent -->
                      <div class="flex flex-col gap-3">
                        <% SocialAuth::PROVIDERS.each_key do |provider| %>
                          <% next unless SocialAuth.enabled?(provider) %>
                          <%= button_to omniauth_authorize_path(:user, provider), method: :post,
                                form: { class: "w-full", "data-social-form": "", "data-turbo": "false" },
                                params: { return_to: params[:return_to], privacy_consent: "0" },
                                class: "sr-btn glass-soft w-full min-h-[48px] rounded-xl px-4 flex items-center justify-center gap-3 text-[15px] font-medium cursor-pointer",
                                style: "color: #eef3ee" do %>
                            <%= render "auth/social_logo", provider: provider %>
                            <span><%= t("social_auth.continue_with.#{SocialAuth.short_name(provider)}") %></span>
                          <% end %>
                        <% end %>
                      </div>

                      <div class="flex items-center gap-3" role="separator">
                        <span class="flex-1 h-px" style="background: rgba(238,243,238,0.12)"></span>
                        <span class="text-sm" style="color: rgba(238,243,238,0.55)"><%= t("social_auth.or_email") %></span>
                        <span class="flex-1 h-px" style="background: rgba(238,243,238,0.12)"></span>
                      </div>
                    <% end %>

                    <form id="email-form" class="flex flex-col gap-6" action="/auth/send_otp" method="post">
                      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                      <%= hidden_field_tag :return_to, params[:return_to] %>
                      <div class="flex flex-col gap-2">
                        <label for="email" class="text-[15px] font-medium" style="color: rgba(238,243,238,0.85)"><%= t('auth.email') %></label>
                        <input
                          id="email"
                          name="email"
                          type="email"
                          autocomplete="email"
                          required
                          value="<%= params[:email] %>"
                          class="<%= field_class %>"
                          style="color: #eef3ee"
                          placeholder="<%= t('auth.email_placeholder') %>"
                        />
                      </div>
                      <%= consent_block unless social %>
                      <button type="submit" class="<%= primary_class %>" style="<%= primary_style %>">
                        <iconify-icon icon="solar:letter-linear" width="20" class="btn-icon"></iconify-icon>
                        <%= spinner %>
                        <span class="btn-text"><%= t('auth.send_code') %></span>
                      </button>
                    </form>
                  </div>
                </div>

                <!-- OTP step -->
                <% if otp_step %>
                  <div id="otp-step" class="flex flex-col gap-6">
                    <form class="flex flex-col gap-6" action="/auth/verify_otp" method="post">
                      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                      <%= hidden_field_tag :email, params[:email], id: nil %>
                      <%= hidden_field_tag :return_to, params[:return_to], id: nil %>
                      <%= hidden_field_tag :privacy_consent, "1", id: nil %>

                      <!-- Code sent -->
                      <div role="status" class="glass-soft flex items-center gap-3.5 rounded-[20px] p-4" style="border-color: rgba(47,163,107,0.35); background: rgba(47,163,107,0.08)">
                        <span class="glass sr-float flex-none w-11 h-11 rounded-[14px] flex items-center justify-center" style="color: #2fa36b">
                          <iconify-icon icon="solar:letter-linear" width="22"></iconify-icon>
                        </span>
                        <div class="min-w-0">
                          <p class="m-0 text-[15px] font-semibold"><%= t('auth.code_sent') %></p>
                          <p class="m-0 text-sm break-all" style="color: rgba(238,243,238,0.6)"><%= t('auth.code_sent_to', email: params[:email]) %></p>
                        </div>
                      </div>

                      <div class="flex flex-col gap-2">
                        <label for="otp_code" class="text-[15px] font-medium" style="color: rgba(238,243,238,0.85)"><%= t('auth.verification_code') %></label>
                        <input
                          id="otp_code"
                          name="otp_code"
                          type="text"
                          inputmode="numeric"
                          autocomplete="one-time-code"
                          pattern="[0-9]{6}"
                          maxlength="6"
                          required
                          dir="ltr"
                          class="sr-field sr-mono glass-soft w-full min-h-[64px] rounded-2xl px-4 py-3.5 text-center text-2xl font-semibold"
                          style="color: #eef3ee"
                          placeholder="000000"
                        />
                      </div>

                      <button type="submit" class="<%= primary_class %>" style="<%= primary_style %>">
                        <iconify-icon icon="solar:login-2-linear" width="20" class="btn-icon"></iconify-icon>
                        <%= spinner %>
                        <span class="btn-text"><%= t('auth.login_title') %></span>
                      </button>
                    </form>

                    <!-- Resend / change email. Resend re-POSTs send_otp like the email form; the controller's rate limits still apply. -->
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <form id="resend-otp-form" action="/auth/send_otp" method="post">
                        <%= hidden_field_tag :authenticity_token, form_authenticity_token, id: nil %>
                        <%= hidden_field_tag :email, params[:email], id: nil %>
                        <%= hidden_field_tag :return_to, params[:return_to], id: nil %>
                        <%= hidden_field_tag :privacy_consent, "1", id: nil %>
                        <button
                          id="resend-otp"
                          type="submit"
                          data-label="<%= t('ux_next.login.resend_code') %>"
                          data-countdown-label="<%= t('ux_next.login.resend_in', seconds: '%{seconds}') %>"
                          class="sr-btn glass-soft inline-flex items-center gap-2 min-h-[44px] rounded-xl px-4 text-sm font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                          style="color: #d6b877"
                        >
                          <iconify-icon icon="solar:refresh-linear" width="18"></iconify-icon>
                          <span class="resend-text" aria-live="polite"><%= t('ux_next.login.resend_code') %></span>
                        </button>
                      </form>
                      <button
                        id="change-email"
                        type="button"
                        class="sr-btn glass-soft inline-flex items-center gap-2 min-h-[44px] rounded-xl px-4 text-sm cursor-pointer"
                        style="color: rgba(238,243,238,0.75)"
                      >
                        <iconify-icon icon="solar:pen-linear" width="18"></iconify-icon>
                        <span><%= t('ux_next.login.change_email') %></span>
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Terms -->
            <p class="sr-up m-0 text-center text-[13px] leading-6" style="animation-delay: .7s; color: rgba(238,243,238,0.55)">
              <%= t('auth.terms_agreement') %>
              <a href="<%= terms_path %>" class="underline underline-offset-4" style="color: #d6b877"><%= t('auth.terms_of_service') %></a>
              <%= t('auth.and') %>
              <a href="<%= privacy_path %>" class="underline underline-offset-4" style="color: #d6b877"><%= t('auth.privacy_policy') %></a>
            </p>
          </div>
        </main>

        <%= render 'shared/site_footer' %>
      </div>
    </div>

    <script>
        // Button loading animation
        document.addEventListener('DOMContentLoaded', () => {
            // Reset button loading state on page load
            document.querySelectorAll('.btn-loading').forEach(btn => {
                btn.disabled = false;
                const icon = btn.querySelector('.btn-icon');
                const spinner = btn.querySelector('.btn-spinner');
                if (icon) icon.style.display = '';
                if (spinner) spinner.classList.add('hidden');
            });

            // Handle form submission
            document.querySelectorAll('.btn-loading').forEach(btn => {
                const originalText = btn.querySelector('.btn-text')?.textContent;
                btn.dataset.originalText = originalText;

                const form = btn.closest('form');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        setTimeout(() => {
                            btn.classList.add('opacity-75');

                            const icon = btn.querySelector('.btn-icon');
                            const spinner = btn.querySelector('.btn-spinner');

                            if (icon) icon.style.display = 'none';
                            if (spinner) spinner.classList.remove('hidden');
                        }, 0);
                    });
                }
            });
        });

        // OTP step: 30s cooldown on "Resend code", and "Change email" without a reload.
        (() => {
            const RESEND_COOLDOWN = 30;
            const KEY = 'otpSentAt';
            const store = {
                get() { try { return Number(sessionStorage.getItem(KEY)) || 0; } catch (e) { return 0; } },
                set(v) { try { sessionStorage.setItem(KEY, String(v)); } catch (e) {} }
            };

            // A code goes out on either form's submit; start the clock then.
            document.querySelectorAll('form[action="/auth/send_otp"]').forEach(form => {
                form.addEventListener('submit', () => store.set(Date.now()));
            });

            const resend = document.getElementById('resend-otp');
            if (resend) {
                const text = resend.querySelector('.resend-text');
                // Arriving here straight after a send (e.g. no sessionStorage) still gets the cooldown.
                if (<%= flash[:notice].present? ? 'true' : 'false' %> && Date.now() - store.get() > RESEND_COOLDOWN * 1000) store.set(Date.now());
                let timer;
                const tick = () => {
                    const left = Math.ceil(RESEND_COOLDOWN - (Date.now() - store.get()) / 1000);
                    if (left > 0) {
                        resend.disabled = true;
                        text.textContent = resend.dataset.countdownLabel.replace('%{seconds}', left);
                    } else {
                        resend.disabled = false;
                        text.textContent = resend.dataset.label;
                        clearInterval(timer);
                    }
                };
                tick();
                timer = setInterval(tick, 1000);
                resend.closest('form').addEventListener('submit', () => { resend.disabled = true; });
            }

            const change = document.getElementById('change-email');
            if (change) {
                change.addEventListener('click', () => {
                    document.getElementById('otp-step')?.classList.add('hidden');
                    document.getElementById('email-step')?.classList.remove('hidden');
                    const email = document.getElementById('email');
                    if (email) { email.focus(); email.select(); }
                });
            }
        })();

        // Social sign-in: the same consent box as the email form. The server checks it too.
        document.querySelectorAll('form[data-social-form]').forEach(form => {
            form.addEventListener('submit', e => {
                const consent = document.getElementById('privacy_consent');
                if (consent && !consent.checked) { e.preventDefault(); consent.reportValidity(); consent.focus(); return; }
                form.querySelector('input[name="privacy_consent"]').value = '1';
            });
        });

        // Reset on pageshow (back/forward navigation)
        window.addEventListener('pageshow', () => {
            document.querySelectorAll('.btn-loading').forEach(btn => {
                btn.disabled = false;
                btn.classList.remove('opacity-75');
                const icon = btn.querySelector('.btn-icon');
                const spinner = btn.querySelector('.btn-spinner');
                const text = btn.querySelector('.btn-text');
                if (icon) icon.style.display = '';
                if (spinner) spinner.classList.add('hidden');
                if (text && btn.dataset.originalText) text.textContent = btn.dataset.originalText;
            });
        });
    </script>
<%= render 'shared/site_scripts' %>
</body>
</html>

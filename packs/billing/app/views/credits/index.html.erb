<% content_for :title, t('billing.title') %>
<% arrow = '<svg class="sr-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>'.html_safe %>

<div dir="<%= text_direction %>" class="sr-page relative leading-relaxed" style="color: #eef3ee">
  <div class="relative mx-auto max-w-[1040px] px-4 sm:px-6 pt-10 pb-20 flex flex-col gap-8">

    <% [ [ :notice, '#2fa36b' ], [ :alert, '#d6b877' ] ].each do |kind, color| %>
      <% if flash[kind].present? %>
        <p class="glass-soft sr-up m-0 rounded-2xl px-5 py-4 text-[15px]" style="color: <%= color %>"><%= flash[kind] %></p>
      <% end %>
    <% end %>

    <!-- Balance -->
    <section class="glass sr-up rounded-[32px] p-7 sm:p-10 flex flex-wrap items-center justify-between gap-8">
      <div class="flex flex-col gap-3 max-w-[52ch]">
        <span class="glass-soft self-start inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-sm" style="color: rgba(238,243,238,0.9)">
          <span class="sr-dot w-2 h-2 rounded-full bg-primary"></span>
          <%= t('billing.title') %>
        </span>
        <h1 class="m-0 font-semibold" style="font-size: clamp(30px, 4vw, 44px); line-height: 1.2; letter-spacing: -0.02em"><%= t('billing.balance') %></h1>
        <p class="m-0 font-light text-[16px]" style="color: rgba(238,243,238,0.7)"><%= t('billing.subtitle') %></p>
      </div>
      <div class="glass-soft sr-float rounded-[24px] px-8 py-6 flex flex-col items-center gap-1 min-w-[180px]">
        <span class="sr-mono font-semibold" style="font-size: clamp(44px, 6vw, 64px); line-height: 1; color: #d6b877" dir="ltr" data-testid="credit-balance"><%= number_with_delimiter(@balance) %></span>
        <span class="text-sm" style="color: rgba(238,243,238,0.7)"><%= t('billing.credits') %></span>
      </div>
    </section>

    <!-- Packs -->
    <section class="flex flex-col gap-5">
      <h2 class="sr-up m-0 text-[22px] font-semibold" style="animation-delay: .15s"><%= t('billing.buy_title') %></h2>
      <div class="grid gap-5" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr))">
        <% @packs.each_with_index do |(id, pack), i| %>
          <% price = pack[:amount_halalas] / 100.0 %>
          <article class="glass sr-lift sr-up rounded-[28px] p-7 flex flex-col gap-5 justify-between" style="animation-delay: <%= (0.25 + i * 0.1).round(2) %>s">
            <div class="flex items-start justify-between gap-4">
              <div class="flex flex-col gap-1">
                <span class="text-[22px] font-semibold"><%= t('billing.pack_credits', credits: number_with_delimiter(pack[:credits])) %></span>
                <span class="text-sm" style="color: rgba(238,243,238,0.6)"><%= t('billing.per_credit', price: number_with_precision(price / pack[:credits], precision: 2)) %></span>
              </div>
              <span class="glass-soft sr-ico flex-none w-[52px] h-[52px] rounded-2xl flex items-center justify-center" style="color: #2fa36b">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v10M9 9.5h4.5a2 2 0 010 4H10a2 2 0 000 4H15"></path></svg>
              </span>
            </div>
            <%= button_to purchase_credits_path, params: { pack: id }, method: :post, data: { turbo: false },
                  class: "sr-btn sr-primary w-full flex items-center justify-between gap-2.5 min-h-[52px] px-5 rounded-2xl font-semibold text-[15px] border-0 cursor-pointer",
                  style: "box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)" do %>
              <span><%= t('billing.buy') %> · <%= t('billing.price_sar', price: number_with_precision(price, precision: 0)) %></span>
              <span class="sr-ico flex"><%= arrow %></span>
            <% end %>
          </article>
        <% end %>
      </div>
      <p class="m-0 text-sm" style="color: rgba(238,243,238,0.6)"><%= t('billing.payment_methods') %> <%= t('billing.free_note', count: Billing::SIGNUP_BONUS) %></p>
    </section>

    <!-- History -->
    <section class="glass sr-reveal rounded-[32px] p-6 sm:p-8 flex flex-col gap-4">
      <h2 class="m-0 text-[20px] font-semibold"><%= t('billing.history_title') %></h2>
      <% if @entries.any? %>
        <ul class="list-none m-0 p-0 flex flex-col gap-2">
          <% @entries.each do |entry| %>
            <li class="glass-soft rounded-2xl px-5 py-3.5 flex items-center justify-between gap-4">
              <div class="flex flex-col">
                <span class="text-[15px]"><%= t("billing.reasons.#{entry.reason}", default: entry.reason.humanize) %></span>
                <span class="sr-mono text-xs" style="color: rgba(238,243,238,0.5)" dir="ltr"><%= entry.created_at.strftime("%Y-%m-%d %H:%M") %></span>
              </div>
              <span class="sr-mono font-semibold" dir="ltr" style="color: <%= entry.amount.positive? ? '#2fa36b' : 'rgba(238,243,238,0.75)' %>"><%= entry.amount.positive? ? "+#{entry.amount}" : entry.amount %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="m-0 text-[15px]" style="color: rgba(238,243,238,0.6)"><%= t('billing.history_empty') %></p>
      <% end %>
    </section>
  </div>
</div>

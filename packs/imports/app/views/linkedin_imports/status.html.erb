<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>جاري المعالجة... — سيرة</title>
    <meta name="theme-color" content="#07120D" />
    <%= render 'shared/posthog' %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@300;400;500;600;700;800&family=Readex+Pro:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= csrf_meta_tags %>
  </head>
  <body class="sr-app antialiased bg-darkBase text-mist min-h-dvh flex items-center justify-center">
<%= render 'shared/ambient', fixed: true %>

    <main class="relative w-full max-w-[820px] px-4 sm:px-6 py-16" dir="rtl">
      <%= render "shared/ai_progress",
            id: "linkedin-progress",
            dir: "rtl",
            badge: "استيراد من LinkedIn",
            title: "جاري تحليل سيرتك الذاتية",
            subtitle: "نستخدم الذكاء الاصطناعي لاستخراج البيانات من ملفك. قد تستغرق العملية حتى دقيقة واحدة.",
            steps: [
              { label: "تم رفع الملف", at: 0 },
              { label: "استخراج النص", at: 10 },
              { label: "تحليل الذكاء الاصطناعي", at: 30 },
              { label: "تجهيز المحرر", at: 85 }
            ],
            error_title: "حدث خطأ",
            error_text: @linkedin_import.error_message.presence || "عذراً، لم نتمكن من معالجة الملف. يرجى المحاولة مرة أخرى.",
            retry_label: "حاول مرة أخرى",
            retry_href: linkedin_import_path %>
    </main>

    <script>
      const statusUrl = '<%= linkedin_import_status_path(@linkedin_import, format: :json) %>';
      const editUrl = '<%= linkedin_import_edit_path(@linkedin_import) %>';
      const progressEl = document.getElementById('linkedin-progress');

      <% if @linkedin_import.failed? %>
        window.SeeraProgress.fail(progressEl);
      <% else %>
        window.SeeraProgress.start(progressEl, { expectedSeconds: 20 });
        // Stops after 3 minutes and shows the timeout state.
        window.SeeraProgress.poll(progressEl, {
          url: statusUrl,
          interval: 2000,
          onComplete: function () { window.location.href = editUrl; },
          onFail: function (data) {
            if (!data.error_message) window.SeeraProgress.fail(progressEl, 'حدث خطأ غير متوقع');
          }
        });
      <% end %>
    </script>
  <%= render 'shared/site_scripts' %>
</body>
</html>

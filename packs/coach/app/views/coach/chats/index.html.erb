<% content_for :title, t('coach.title') %>
<% arrow = '<svg class="sr-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>'.html_safe %>
<% icons = {
     "scratch" => '<path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"></path>'.html_safe,
     "import" => '<path d="M14 3H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V9z"></path><path d="M14 3v6h6M9 14l2 2 4-4"></path>'
   } %>

<div dir="<%= text_direction %>" class="sr-page relative leading-relaxed" style="color: #eef3ee">
  <div class="relative mx-auto max-w-[1040px] px-4 sm:px-6 pt-10 pb-20 flex flex-col gap-8">
    <% if flash[:alert].present? %>
      <p class="glass-soft sr-up m-0 rounded-2xl px-5 py-4 text-[15px]" style="color: #d6b877" role="alert"><%= flash[:alert] %></p>
    <% end %>

    <section class="glass sr-up rounded-[32px] p-7 sm:p-10 flex flex-col gap-3">
      <h1 class="m-0 font-semibold" style="font-size: clamp(30px, 4vw, 44px); line-height: 1.2; letter-spacing: -0.02em"><%= t('coach.title') %></h1>
      <p class="m-0 font-light text-[16px] max-w-[52ch]" style="color: rgba(238,243,238,0.7)"><%= t('coach.subtitle') %></p>
    </section>

    <div class="grid gap-5" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr))">
      <% Coach::Chat::PATHS.each_with_index do |path, i| %>
        <article class="glass sr-lift sr-up rounded-[28px] p-7 flex flex-col gap-5 justify-between" style="animation-delay: <%= (0.15 + i * 0.1).round(2) %>s">
          <div class="flex items-start justify-between gap-4">
            <div class="flex flex-col gap-2">
              <h2 class="m-0 text-[22px] font-semibold"><%= t("coach.paths.#{path}.title") %></h2>
              <p class="m-0 text-[15px]" style="color: rgba(238,243,238,0.7)"><%= t("coach.paths.#{path}.body") %></p>
            </div>
            <span class="glass-soft sr-ico flex-none w-[52px] h-[52px] rounded-2xl flex items-center justify-center" style="color: #2fa36b">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= icons[path] %></svg>
            </span>
          </div>
          <% button = { class: "sr-btn sr-primary w-full flex items-center justify-between gap-2.5 min-h-[52px] px-5 rounded-2xl font-semibold text-[15px] border-0 cursor-pointer",
                        style: "box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)" } %>
          <% if path == "import" %>
            <%# PDF only: there is no Word parser, so the note asks for a PDF export. %>
            <%= form_with url: coach_chats_path, multipart: true, data: { turbo: false }, class: "flex flex-col gap-4" do |f| %>
              <%= f.hidden_field :path, value: "import" %>
              <label class="flex flex-col gap-1.5 text-[14px]">
                <span class="font-semibold"><%= t('coach.import.pdf') %></span>
                <%= f.file_field :pdf_file, accept: "application/pdf", class: "glass-soft rounded-2xl px-4 py-3 text-[14px] w-full" %>
                <span class="text-[13px]" style="color: rgba(238,243,238,0.6)"><%= t('coach.import.word_note') %></span>
              </label>
              <% if @resumes.any? %>
                <label class="flex flex-col gap-1.5 text-[14px]">
                  <span class="font-semibold"><%= t('coach.import.pick_seera') %></span>
                  <%= f.select :resume_id,
                        @resumes.map { |r| [ "#{r['title'].presence || '—'} · #{r['updated_at'].to_date.iso8601}", r["id"], { style: "color: #0b1a12" } ] },
                        { include_blank: true },
                        class: "glass-soft rounded-2xl px-4 py-3 text-[14px] w-full", style: "color: #eef3ee" %>
                </label>
              <% end %>
              <%= f.button type: "submit", **button do %>
                <span><%= t('coach.start') %></span>
                <span class="sr-ico flex"><%= arrow %></span>
              <% end %>
            <% end %>
          <% else %>
            <%= button_to coach_chats_path, params: { path: path }, method: :post, data: { turbo: false }, **button do %>
              <span><%= t('coach.start') %></span>
              <span class="sr-ico flex"><%= arrow %></span>
            <% end %>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</div>

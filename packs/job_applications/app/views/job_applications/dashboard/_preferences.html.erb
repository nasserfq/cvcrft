<%= form_with url: my_jobs_preferences_path, method: :patch, scope: :preference, data: { turbo: false }, class: "flex flex-col gap-5" do |f| %>
  <label class="flex flex-col gap-2 text-[14px]">
    <span class="font-semibold"><%= t('seera_apply.titles') %></span>
    <%= f.text_field :titles, value: preference.titles.join(", "), maxlength: 900, required: true,
          class: "glass-soft rounded-2xl px-4 min-h-[52px] text-[16px] w-full", style: "color: #eef3ee" %>
  </label>

  <fieldset class="m-0 p-0 border-0">
    <legend class="sr-only"><%= t('seera_apply.cities').values.join(" · ") %></legend>
    <%= hidden_field_tag "preference[cities][]", "", id: nil %>
    <div class="flex flex-wrap gap-2">
      <% JobApplications::CITIES.each do |city| %>
        <label class="glass-soft sr-btn rounded-full min-h-[44px] px-4 flex items-center gap-2 cursor-pointer text-[15px] has-[:checked]:border-[#2fa36b] has-[:checked]:bg-[rgba(47,163,107,0.18)]">
          <%= check_box_tag "preference[cities][]", city, preference.cities.include?(city), id: "preference_cities_#{city}", class: "accent-[#2fa36b] w-4 h-4" %>
          <%= seera_icon(city == "remote" ? "solar:case-bold" : "solar:map-point-bold", width: 16, style: "color: #7fd3a6") %>
          <span><%= t("seera_apply.cities.#{city}") %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div>
    <%= f.button t('seera_apply.save'), type: "submit",
          class: "sr-btn sr-primary inline-flex items-center justify-center min-h-[52px] px-8 rounded-2xl font-semibold text-[15px] border-0 cursor-pointer",
          style: "box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)" %>
  </div>
<% end %>

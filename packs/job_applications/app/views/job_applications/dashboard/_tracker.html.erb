<% primary = "sr-btn sr-primary inline-flex items-center justify-center gap-2 min-h-[52px] px-6 rounded-2xl font-semibold text-[15px] border-0 cursor-pointer" %>
<% primary_shadow = "box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)" %>
<% chip = "glass-soft sr-btn rounded-full min-h-[44px] px-4 inline-flex items-center gap-2 text-[15px] cursor-pointer" %>
<% chip_on = "background: rgba(47,163,107,0.24); border-color: #2fa36b; box-shadow: inset 0 0 0 1px #2fa36b" %>

<% if profile.nil? %>
  <section class="glass sr-up rounded-[28px] p-6 sm:p-8 flex flex-wrap items-center justify-between gap-5" data-testid="apply-setup">
    <h2 class="m-0 text-[22px] sm:text-[26px] font-semibold leading-snug"><%= t('seera_apply.apply.title') %></h2>
    <%= link_to my_jobs_setup_path, class: primary, style: primary_shadow do %>
      <%= seera_icon("solar:magic-stick-3-bold", width: 18) %>
      <span><%= t('seera_apply.setup.turn_on') %></span>
    <% end %>
  </section>
<% else %>
  <section class="glass sr-up rounded-[28px] p-6 sm:p-8 flex flex-col gap-5" data-testid="apply-switch">
    <div class="flex items-center justify-between gap-4">
      <h2 class="m-0 text-[22px] sm:text-[26px] font-semibold leading-snug"><%= t('seera_apply.apply.title') %></h2>
      <%= link_to my_jobs_setup_path, class: "sr-btn inline-flex items-center gap-1.5 min-h-[44px] px-2 rounded-xl text-[14px]", style: "color: rgba(238,243,238,0.75)" do %>
        <%= seera_icon("solar:pen-bold", width: 16) %>
        <span><%= t('seera_apply.apply.edit') %></span>
      <% end %>
    </div>
    <% current = profile.consented? ? profile.state : "off" %>
    <div class="flex flex-wrap gap-2" role="group" aria-label="<%= t('seera_apply.apply.title') %>">
      <% %w[on paused off].each do |state| %>
        <% active = current == state %>
        <%= button_to my_jobs_sending_path, method: :patch, params: { state: }, form: { data: { turbo: false } },
              class: chip, style: (chip_on if active), aria: { pressed: active }, data: { testid: "state-#{state}" } do %>
          <span class="w-2 h-2 rounded-full" style="background: <%= { 'on' => '#7fd3a6', 'paused' => '#d6b877', 'off' => 'rgba(238,243,238,0.4)' }[state] %>" aria-hidden="true"></span>
          <span><%= t("seera_apply.apply.states.#{state}") %></span>
        <% end %>
      <% end %>
    </div>
  </section>

  <nav class="flex flex-wrap gap-2" aria-label="<%= t('seera_apply.apply.title') %>" data-testid="apply-tabs">
    <% tab_counts.each do |name, count| %>
      <% active = name == tab %>
      <%= link_to my_jobs_root_path(tab: name), class: chip, style: (chip_on if active), aria: { current: (active ? "page" : nil) }, data: { testid: "tab-#{name}" } do %>
        <span><%= t("seera_apply.apply.tabs.#{name}") %></span>
        <span class="sr-mono text-[14px] font-semibold" dir="ltr" style="color: <%= count.positive? ? '#7fd3a6' : 'rgba(238,243,238,0.5)' %>"><%= count %></span>
      <% end %>
    <% end %>
  </nav>

  <% if applications.any? %>
    <ul class="m-0 p-0 list-none flex flex-col gap-4" data-testid="applications">
      <% applications.each_with_index do |application, i| %>
        <%= render "job_applications/dashboard/application_card", application:, kinds: document_kinds.fetch(application.id, []), index: i %>
      <% end %>
    </ul>
  <% end %>
<% end %>

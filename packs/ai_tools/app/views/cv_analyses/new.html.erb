<% content_for :title, t('cv_analysis.page_title') %>
<% en = I18n.locale.to_s == "en" %>
<% arrow = '<svg class="sr-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>'.html_safe %>
<% gets = [
     { title: t('cv_analysis.overall_score'), desc: t('cv_analysis.score_desc'), color: "#2fa36b", icon: '<path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path>' },
     { title: t('cv_analysis.strengths_title'), desc: t('cv_analysis.strengths_desc'), color: "#2fa36b", icon: '<path d="M5 13l4 4L19 7"></path>' },
     { title: t('cv_analysis.improvements'), desc: t('cv_analysis.improvements_desc'), color: "#d6b877", icon: '<circle cx="12" cy="12" r="9"></circle><path d="M12 8v4M12 16h.01"></path>' },
     { title: t('cv_analysis.ats_tips'), desc: t('cv_analysis.ats_tips_desc'), color: "#d6b877", icon: '<path d="M9 18h6M10 21h4M12 3a6 6 0 00-3.5 10.9c.6.4 1 1.1 1 1.8V16h5v-.3c0-.7.4-1.4 1-1.8A6 6 0 0012 3z"></path>' }
   ] %>
<% features = [
     { title: t('cv_analysis.feature_smart'), desc: t('cv_analysis.feature_smart_desc'), icon: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"></path>' },
     { title: t('cv_analysis.feature_secure'), desc: t('cv_analysis.feature_secure_desc'), icon: '<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"></path><path d="M9 12l2 2 4-4"></path>' },
     { title: t('cv_analysis.feature_fast'), desc: t('cv_analysis.feature_fast_desc'), icon: '<path d="M13 3L4 14h7l-1 7 9-11h-7z"></path>' }
   ] %>

<div dir="<%= text_direction %>" class="sr-page relative overflow-clip leading-relaxed" style="color: #eef3ee">
  <%# Lower glows: the layout's ambient layer is fixed to one viewport, so orbs further down the page live here, as on the landing. %>
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="sr-orb3" style="position: absolute; top: 900px; right: 4%; width: 620px; height: 620px; border-radius: 50%; background: radial-gradient(circle, rgba(0,108,53,0.35), rgba(0,108,53,0) 65%); filter: blur(50px)"></div>
    <div class="sr-orb2" style="position: absolute; top: 1600px; left: -160px; width: 680px; height: 680px; border-radius: 50%; background: radial-gradient(circle, rgba(214,184,119,0.38), rgba(214,184,119,0) 65%); filter: blur(60px)"></div>
    <div class="sr-orb1" style="position: absolute; top: 2400px; right: 12%; width: 720px; height: 720px; border-radius: 50%; background: radial-gradient(circle, rgba(0,150,85,0.4), rgba(0,150,85,0) 65%); filter: blur(60px)"></div>
    <div class="sr-orb2" style="position: absolute; top: 3200px; left: 6%; width: 640px; height: 640px; border-radius: 50%; background: radial-gradient(circle, rgba(200,169,106,0.36), rgba(200,169,106,0) 65%); filter: blur(60px)"></div>
  </div>
  <div class="relative mx-auto max-w-[1040px] px-4 sm:px-6 pt-10 pb-20 flex flex-col gap-10">

    <!-- Upload Section (shown initially) -->
    <div id="upload-section" class="flex flex-col gap-10">
      <!-- Hero -->
      <header class="flex flex-col items-start gap-6">
        <span class="glass-soft sr-up inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-sm" style="animation-delay: 0s; color: rgba(238,243,238,0.9)">
          <span class="sr-dot w-2 h-2 rounded-full bg-primary"></span>
          <%= t('cv_analysis.badge') %>
        </span>
        <h1 class="m-0 font-semibold" style="font-size: clamp(36px, 5vw, 60px); line-height: 1.15; letter-spacing: -0.02em">
          <% words = t('cv_analysis.page_title').split %>
          <% delay = 0.1 %>
          <% words.each_with_index do |word, i| %><span class="sr-w" style="<%= 'color: #d6b877; ' if i == words.size - 1 && words.size > 1 %>animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
        </h1>
        <p class="sr-up m-0 text-[17px] sm:text-[19px] font-light max-w-[60ch]" style="animation-delay: .5s; color: rgba(238,243,238,0.7)"><%= t('cv_analysis.description') %></p>
      </header>

      <div class="grid gap-5 items-start" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr))">
        <!-- Upload Form -->
        <%= form_tag cv_analysis_path, method: :post, multipart: true, id: "upload-form", data: { turbo: false },
              class: "glass sr-up rounded-[32px] p-6 sm:p-8 flex flex-col gap-6", style: "animation-delay: .6s" do %>

          <!-- Drop Zone -->
          <div id="drop-zone" class="sr-lift relative rounded-[24px] px-6 py-12 text-center cursor-pointer" style="background: rgba(255,255,255,0.04); border: 1.5px dashed rgba(255,255,255,0.22); transition: border-color .4s, background-color .4s, transform .5s cubic-bezier(.16,1,.3,1)">
            <input type="file" name="pdf_file" id="pdf-file-input" accept=".pdf,application/pdf" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" aria-label="<%= t('cv_analysis.drop_title') %>" />
            <div id="upload-placeholder" class="flex flex-col items-center gap-3 pointer-events-none">
              <span class="glass-soft sr-ico w-16 h-16 rounded-[20px] flex items-center justify-center" style="color: #2fa36b">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3M7 8l5-5 5 5"></path><path d="M4 15v4a2 2 0 002 2h12a2 2 0 002-2v-4"></path></svg>
              </span>
              <p class="m-0 text-[18px] font-semibold"><%= t('cv_analysis.drop_title') %></p>
              <p class="m-0 text-sm" style="color: rgba(238,243,238,0.6)"><%= t('cv_analysis.drop_subtitle') %></p>
            </div>
            <div id="file-selected" class="hidden flex-col items-center gap-3 pointer-events-none">
              <span class="glass-soft w-16 h-16 rounded-[20px] flex items-center justify-center" style="color: #d6b877">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"></path><path d="M14 3v5h5M9 14l2 2 4-4"></path></svg>
              </span>
              <p class="sr-mono m-0 text-[15px] font-semibold break-all" style="color: #d6b877" id="selected-filename" dir="ltr"></p>
              <p class="m-0 text-sm" style="color: rgba(238,243,238,0.6)"><%= t('cv_analysis.click_select_another') %></p>
            </div>
          </div>

          <!-- Optional Fields -->
          <fieldset class="glass-soft rounded-[24px] p-5 sm:p-6 flex flex-col gap-4 m-0 border-0">
            <legend class="sr-only"><%= t('cv_analysis.optional_title') %></legend>
            <h2 class="m-0 text-[17px] font-semibold flex items-center gap-2.5">
              <span style="color: #d6b877"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"></path><circle cx="16" cy="6" r="2"></circle><circle cx="10" cy="12" r="2"></circle><circle cx="18" cy="18" r="2"></circle></svg></span>
              <%= t('cv_analysis.optional_title') %>
            </h2>
            <div class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr))">
              <label class="flex flex-col gap-1.5 text-sm">
                <span style="color: rgba(238,243,238,0.8)"><%= t('cv_analysis.target_job') %></span>
                <input type="text" name="target_job" id="target_job" placeholder="<%= t('cv_analysis.target_job_placeholder') %>" class="glass-soft w-full rounded-2xl px-4 py-3 text-[15px] focus:outline-none" style="color: #eef3ee" />
              </label>
              <label class="flex flex-col gap-1.5 text-sm">
                <span style="color: rgba(238,243,238,0.8)"><%= t('cv_analysis.industry') %></span>
                <input type="text" name="target_industry" id="target_industry" placeholder="<%= t('cv_analysis.industry_placeholder') %>" class="glass-soft w-full rounded-2xl px-4 py-3 text-[15px] focus:outline-none" style="color: #eef3ee" />
              </label>
            </div>
            <div class="flex flex-col gap-2">
              <span class="text-sm" style="color: rgba(238,243,238,0.8)"><%= t('cv_analysis.analysis_language') %></span>
              <div class="flex flex-wrap gap-2.5" role="radiogroup">
                <% [ [ "ar", t('cv_analysis.arabic') ], [ "en", "English" ] ].each do |value, label| %>
                  <label class="sr-lang glass-soft inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl cursor-pointer text-[15px] has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-[#d6b877]" style="transition: border-color .4s, background-color .4s">
                    <input type="radio" name="language" value="<%= value %>" <%= 'checked' if value == 'ar' %> class="sr-only">
                    <span class="sr-radio flex-none w-[18px] h-[18px] rounded-full flex items-center justify-center" aria-hidden="true" style="border: 1.5px solid rgba(255,255,255,0.35); background: rgba(255,255,255,0.04); transition: border-color .3s, background-color .3s, box-shadow .3s">
                      <span class="sr-radio-dot w-2 h-2 rounded-full" style="background: #2fa36b; transform: scale(0); transition: transform .35s cubic-bezier(.34,1.56,.64,1)"></span>
                    </span>
                    <span><%= label %></span>
                  </label>
                <% end %>
              </div>
            </div>
          </fieldset>

          <button type="submit" id="submit-btn" disabled
                  class="sr-btn sr-primary w-full flex items-center justify-between gap-2.5 min-h-[56px] px-6 rounded-2xl font-semibold text-[16px] border-0 cursor-pointer disabled:opacity-45 disabled:cursor-not-allowed"
                  style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)">
            <span><%= t('cv_analysis.start_analysis') %></span>
            <span class="sr-ico flex"><%= arrow %></span>
          </button>
        <% end %>

        <!-- What You'll Get -->
        <section class="glass sr-up rounded-[32px] p-6 sm:p-8 flex flex-col gap-5" style="animation-delay: .75s">
          <h2 class="m-0 text-[22px] font-semibold"><%= t('cv_analysis.what_you_get') %></h2>
          <ul class="list-none m-0 p-0 flex flex-col gap-2.5">
            <% gets.each do |item| %>
              <li class="glass-soft sr-lift rounded-2xl p-4 flex gap-4 items-start">
                <span class="glass sr-ico flex-none w-11 h-11 rounded-[14px] flex items-center justify-center" style="color: <%= item[:color] %>">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= item[:icon].html_safe %></svg>
                </span>
                <div class="flex flex-col gap-0.5">
                  <span class="text-[16px] font-semibold"><%= item[:title] %></span>
                  <span class="text-[14px] font-light" style="color: rgba(238,243,238,0.65)"><%= item[:desc] %></span>
                </div>
              </li>
            <% end %>
          </ul>
        </section>
      </div>

      <!-- Features -->
      <div class="grid gap-5" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr))">
        <% features.each do |feature| %>
          <article class="glass sr-lift sr-reveal rounded-[28px] p-6 sm:p-7 flex flex-col gap-4">
            <span class="glass-soft sr-ico w-[52px] h-[52px] rounded-2xl flex items-center justify-center" style="color: #2fa36b">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= feature[:icon].html_safe %></svg>
            </span>
            <h3 class="m-0 text-[20px] font-semibold"><%= feature[:title] %></h3>
            <p class="m-0 text-[15px] font-light" style="color: rgba(238,243,238,0.68)"><%= feature[:desc] %></p>
          </article>
        <% end %>
      </div>

      <!-- Back Link -->
      <div class="text-center">
        <a href="<%= root_path %>" class="text-sm" style="color: rgba(238,243,238,0.6)"><%= t('cv_analysis.back_to_home') %></a>
      </div>
    </div>

    <!-- Processing Section (hidden until upload) -->
    <div id="processing-section" class="max-w-[820px] w-full mx-auto" hidden>
      <%= render "shared/ai_progress",
            id: "cv-analysis-progress",
            badge: t('cv_analysis.badge'),
            title: t('cv_analysis.analyzing_title'),
            subtitle: t('cv_analysis.analyzing_desc'),
            steps: [
              { label: t('cv_analysis.step_file_uploaded'), at: 0 },
              { label: en ? "Reading your CV" : "قراءة السيرة الذاتية", at: 6 },
              { label: en ? "Scoring sections" : "تقييم الأقسام", at: 25 },
              { label: en ? "Writing the report" : "كتابة التقرير", at: 70 }
            ],
            error_title: t('cv_analysis.error_occurred'),
            error_text: t('cv_analysis.error_message'),
            retry_label: t('cv_analysis.try_again'),
            retry_href: cv_analysis_path %>
    </div>
  </div>
</div>

<!-- Translations for JavaScript -->
<script>
  const CV_ANALYSIS_TRANSLATIONS = {
    upload_error: "<%= j t('cv_analysis.upload_error') %>",
    analysis_error: "<%= j t('cv_analysis.analysis_error') %>",
    text_extracted: "<%= j t('cv_analysis.text_extracted') %>"
  };
</script>

<script>
(function () {
  function init() {
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('pdf-file-input');
    const submitBtn = document.getElementById('submit-btn');
    const uploadPlaceholder = document.getElementById('upload-placeholder');
    const fileSelected = document.getElementById('file-selected');
    const selectedFilename = document.getElementById('selected-filename');
    const uploadForm = document.getElementById('upload-form');
    const uploadSection = document.getElementById('upload-section');
    const processingSection = document.getElementById('processing-section');
    const progressEl = document.getElementById('cv-analysis-progress');
    if (!uploadForm || uploadForm.dataset.bound) return;
    uploadForm.dataset.bound = 'true';

    function highlight(on) {
      dropZone.style.borderColor = on ? 'rgba(47,163,107,0.75)' : 'rgba(255,255,255,0.22)';
      dropZone.style.backgroundColor = on ? 'rgba(47,163,107,0.08)' : 'rgba(255,255,255,0.04)';
    }

    function selectFile(file) {
      if (!file || file.type !== 'application/pdf') return false;
      uploadPlaceholder.classList.add('hidden');
      fileSelected.classList.remove('hidden');
      fileSelected.classList.add('flex');
      selectedFilename.textContent = file.name;
      submitBtn.disabled = false;
      highlight(true);
      return true;
    }

    // Language chips: outline the checked one.
    const langLabels = document.querySelectorAll('.sr-lang');
    function paintLanguages() {
      langLabels.forEach(function (label) {
        const checked = label.querySelector('input').checked;
        const ring = label.querySelector('.sr-radio');
        const dot = label.querySelector('.sr-radio-dot');
        label.style.borderColor = checked ? 'rgba(47,163,107,0.6)' : '';
        label.style.backgroundColor = checked ? 'rgba(47,163,107,0.12)' : '';
        label.style.color = checked ? '#eef3ee' : 'rgba(238,243,238,0.7)';
        if (ring) {
          ring.style.borderColor = checked ? '#2fa36b' : 'rgba(255,255,255,0.35)';
          ring.style.boxShadow = checked ? '0 0 12px rgba(47,163,107,0.55)' : 'none';
        }
        if (dot) dot.style.transform = checked ? 'scale(1)' : 'scale(0)';
      });
    }
    langLabels.forEach(function (label) { label.querySelector('input').addEventListener('change', paintLanguages); });
    paintLanguages();

    fileInput.addEventListener('change', function (e) { selectFile(e.target.files[0]); });

    dropZone.addEventListener('dragover', function (e) {
      e.preventDefault();
      highlight(true);
    });

    dropZone.addEventListener('dragleave', function (e) {
      e.preventDefault();
      if (!fileInput.files.length) highlight(false);
    });

    dropZone.addEventListener('drop', function (e) {
      e.preventDefault();
      const file = e.dataTransfer.files[0];
      if (selectFile(file)) fileInput.files = e.dataTransfer.files;
    });

    function showProcessing() {
      uploadSection.hidden = true;
      processingSection.hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function showError(message) {
      showProcessing();
      if (window.SeeraProgress) window.SeeraProgress.fail(progressEl, message);
    }

    uploadForm.addEventListener('submit', function (e) {
      e.preventDefault();
      showProcessing();
      if (window.SeeraProgress) window.SeeraProgress.start(progressEl, { expectedSeconds: 30, cap: 90 });

      const formData = new FormData(uploadForm);

      fetch('<%= cv_analysis_path(format: :json) %>', {
        method: 'POST',
        body: formData,
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Accept': 'application/json'
        }
      })
      .then(function (response) {
        if (!response.ok) {
          return response.json().catch(function () { return {}; }).then(function (data) {
            throw new Error(data.error || CV_ANALYSIS_TRANSLATIONS.upload_error);
          });
        }
        return response.json();
      })
      .then(function (data) {
        if (data.success) {
          pollStatus(data.analysis_id);
        } else {
          showError(data.error || CV_ANALYSIS_TRANSLATIONS.upload_error);
        }
      })
      .catch(function (error) {
        console.error('Error:', error);
        showError(error.message || CV_ANALYSIS_TRANSLATIONS.upload_error);
      });
    });

    function pollStatus(analysisId) {
      const statusUrl = '<%= cv_analysis_status_path(":id", format: :json) %>'.replace(':id', analysisId);
      const showUrl = '<%= cv_analysis_show_path(":id") %>'.replace(':id', analysisId);
      window.SeeraProgress.poll(progressEl, {
        url: statusUrl,
        interval: 1000,
        onComplete: function () { window.location.href = showUrl; },
        onFail: function (data) {
          if (!data.error_message) window.SeeraProgress.fail(progressEl, CV_ANALYSIS_TRANSLATIONS.analysis_error);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<% en = @cv_analysis.language == "en" %>
<% dir = en ? "ltr" : "rtl" %>
<% content_for :title, en ? "Analyzing your CV" : "جاري تحليل سيرتك الذاتية" %>

<div dir="<%= dir %>" lang="<%= en ? 'en' : 'ar' %>" class="sr-page relative overflow-clip leading-relaxed" style="color: #eef3ee">
  <%# Lower glows: the layout's ambient layer is fixed to one viewport, so orbs further down the page live here, as on the landing. %>
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="sr-orb3" style="position: absolute; top: 900px; right: 4%; width: 620px; height: 620px; border-radius: 50%; background: radial-gradient(circle, rgba(0,108,53,0.35), rgba(0,108,53,0) 65%); filter: blur(50px)"></div>
    <div class="sr-orb2" style="position: absolute; top: 1600px; left: -160px; width: 680px; height: 680px; border-radius: 50%; background: radial-gradient(circle, rgba(214,184,119,0.38), rgba(214,184,119,0) 65%); filter: blur(60px)"></div>
    <div class="sr-orb1" style="position: absolute; top: 2400px; right: 12%; width: 720px; height: 720px; border-radius: 50%; background: radial-gradient(circle, rgba(0,150,85,0.4), rgba(0,150,85,0) 65%); filter: blur(60px)"></div>
    <div class="sr-orb2" style="position: absolute; top: 3200px; left: 6%; width: 640px; height: 640px; border-radius: 50%; background: radial-gradient(circle, rgba(200,169,106,0.36), rgba(200,169,106,0) 65%); filter: blur(60px)"></div>
  </div>
  <div class="relative mx-auto max-w-[820px] px-4 sm:px-6 pt-10 pb-20 flex flex-col gap-8">
    <%= render "shared/ai_progress",
          id: "cv-analysis-progress",
          dir: dir,
          badge: en ? "AI CV analysis" : "تحليل السيرة بالذكاء الاصطناعي",
          title: en ? "Analyzing your CV..." : "جاري تحليل سيرتك الذاتية...",
          subtitle: en ? "The AI is reading your CV and scoring every section." : "يقرأ الذكاء الاصطناعي سيرتك ويقيّم كل قسم فيها.",
          filename: @cv_analysis.original_filename,
          steps: [
            { label: en ? "File uploaded" : "تم رفع الملف", at: 0 },
            { label: en ? "Reading your CV" : "قراءة السيرة الذاتية", at: 6 },
            { label: en ? "Scoring sections" : "تقييم الأقسام", at: 25 },
            { label: en ? "Writing the report" : "كتابة التقرير", at: 70 }
          ],
          error_title: en ? "Something went wrong" : "حدث خطأ",
          error_text: @cv_analysis.error_message.presence || (en ? "We could not finish the analysis. Please try again." : "حدث خطأ أثناء التحليل، يرجى المحاولة مرة أخرى."),
          retry_label: en ? "Try again" : "حاول مرة أخرى",
          retry_href: cv_analysis_path %>
  </div>
</div>

<script>
  (function () {
    var el = document.getElementById('cv-analysis-progress');
    var SP = window.SeeraProgress;
    if (!el || !SP) return;
    var showUrl = <%= raw json_escape(cv_analysis_show_path(@cv_analysis).to_json) %>;

    <% if @cv_analysis.failed? %>
      SP.fail(el);
    <% else %>
      SP.start(el, { expectedSeconds: 30, cap: 90 });
      SP.set(el, <%= @cv_analysis.try(:progress).to_i %>);
      SP.poll(el, {
        url: <%= raw json_escape(cv_analysis_status_path(@cv_analysis, format: :json).to_json) %>,
        interval: 1000,
        onComplete: function (data) { window.location.href = data.redirect_url || showUrl; }
      });
    <% end %>
  })();
</script>

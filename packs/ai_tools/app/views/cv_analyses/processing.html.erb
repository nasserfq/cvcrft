<div class="min-h-screen bg-gradient-to-b from-white via-primary/5 to-white py-12" dir="rtl">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="text-center py-16">
      <!-- Animated Spinner -->
      <div class="relative w-24 h-24 mx-auto mb-8">
        <div class="absolute inset-0 border-4 border-primary/20 rounded-full"></div>
        <div class="absolute inset-0 border-4 border-transparent border-t-primary rounded-full animate-spin"></div>
        <div class="absolute inset-3 border-4 border-transparent border-t-primary-soft rounded-full animate-spin" style="animation-direction: reverse; animation-duration: 1.5s;"></div>
      </div>
      
      <h2 class="text-2xl font-semibold text-slate-900 mb-4">جاري تحليل سيرتك الذاتية...</h2>
      <p class="text-slate-600 mb-8">يقوم الذكاء الاصطناعي بتحليل المحتوى وتقييم كل قسم</p>
      
      <!-- File info -->
      <div class="bg-white rounded-xl border border-slate-200 p-4 inline-block mb-8">
        <p class="text-sm text-slate-600">
          <span class="font-medium text-slate-800"><%= @cv_analysis.original_filename %></span>
        </p>
      </div>
      
      <!-- Progress Steps -->
      <div class="max-w-md mx-auto space-y-3" id="progress-steps">
        <div class="flex items-center gap-3 text-right">
          <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <span class="text-sm text-slate-700">تم رفع الملف</span>
        </div>
        <% if @cv_analysis.processing? %>
        <div class="flex items-center gap-3 text-right">
          <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <span class="text-sm text-slate-700">تم استخراج النص</span>
        </div>
        <div class="flex items-center gap-3 text-right">
          <div class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center flex-shrink-0 animate-pulse">
            <div class="w-3 h-3 bg-primary rounded-full"></div>
          </div>
          <span class="text-sm text-slate-500">تحليل المحتوى...</span>
        </div>
        <% else %>
        <div class="flex items-center gap-3 text-right">
          <div class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center flex-shrink-0 animate-pulse">
            <div class="w-3 h-3 bg-primary rounded-full"></div>
          </div>
          <span class="text-sm text-slate-500">استخراج النص...</span>
        </div>
        <div class="flex items-center gap-3 text-right">
          <div class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center flex-shrink-0">
            <div class="w-3 h-3 bg-slate-300 rounded-full"></div>
          </div>
          <span class="text-sm text-slate-400">تحليل المحتوى...</span>
        </div>
        <% end %>
        <div class="flex items-center gap-3 text-right">
          <div class="w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center flex-shrink-0">
            <div class="w-3 h-3 bg-slate-300 rounded-full"></div>
          </div>
          <span class="text-sm text-slate-400">إنشاء التقرير...</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Poll for status and redirect when complete
(function() {
  const analysisId = '<%= @cv_analysis.id %>';
  const statusUrl = '<%= cv_analysis_status_path(@cv_analysis, format: :json) %>';
  const showUrl = '<%= cv_analysis_show_path(@cv_analysis) %>';
  
  function pollStatus() {
    fetch(statusUrl)
      .then(response => response.json())
      .then(data => {
        if (data.status === 'completed') {
          window.location.href = showUrl;
        } else if (data.status === 'failed') {
          // Show error and redirect
          alert(data.error_message || 'حدث خطأ أثناء التحليل');
          window.location.href = '<%= cv_analysis_path %>';
        } else {
          // Continue polling
          setTimeout(pollStatus, 2000);
        }
      })
      .catch(error => {
        console.error('Poll error:', error);
        setTimeout(pollStatus, 3000);
      });
  }
  
  // Start polling after a short delay
  setTimeout(pollStatus, 2000);
})();
</script>

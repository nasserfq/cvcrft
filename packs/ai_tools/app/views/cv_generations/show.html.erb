<% tk = "ux_i18n2.cv_generations.show" %>
<% content_for :title, t("#{tk}.title", id: @cv_generation.id) %>
<% content_for :body_class, "sr-app-long" %>
<%# Long page: the layout lets the ambient scroll with it, so its orbs run the full page height. %>
<% content_for :ambient_scrolls, true %>
<% icons = {
     back: '<path d="M5 12h14M13 6l6 6-6 6"></path>',
     eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle>',
     download: '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>',
     retry: '<path d="M4 12a8 8 0 0114-5.3L20 9"></path><path d="M20 4v5h-5"></path><path d="M20 12a8 8 0 01-14 5.3L4 15"></path><path d="M4 20v-5h5"></path>',
     stop: '<circle cx="12" cy="12" r="9"></circle><path d="M9 9l6 6M15 9l-6 6"></path>',
     doc: '<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h4"></path>',
     check: '<circle cx="12" cy="12" r="9"></circle><path d="M8 12l3 3 5-6"></path>',
     alert: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v6M12 16.5v.01"></path>',
     spark: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"></path>'
   } %>
<% svg = ->(name, size = 16) { "<svg class=\"shrink-0\" width=\"#{size}\" height=\"#{size}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">#{icons[name]}</svg>".html_safe } %>
<% muted = "color: rgba(238,243,238,0.6)" %>
<% primary_class = "sr-btn sr-primary inline-flex items-center justify-center gap-2.5 min-h-[48px] px-5 rounded-2xl font-semibold text-[15px] border-0 cursor-pointer" %>
<% primary_style = "box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)" %>
<% secondary_class = "sr-btn glass-soft inline-flex items-center justify-center gap-2.5 min-h-[48px] px-[18px] rounded-2xl text-[15px] cursor-pointer" %>
<% stamp = ->(time) { time.strftime("%Y-%m-%d %H:%M") } %>
<% metadata = @cv_generation.metadata || {} %>
<% pdf_ready = metadata["pdf_generated"].present? && metadata["pdf_generated"].to_s != "false" %>
<% draft = @cv_generation.draft? && @cv_generation.draft_data.present? %>

<div dir="<%= text_direction %>" data-controller="confirm-delete" class="sr-page relative overflow-clip leading-relaxed" style="color: #eef3ee; animation-name: sr-riseUp">
  <div class="relative mx-auto max-w-[1240px] px-4 sm:px-6 pt-10 pb-20 flex flex-col gap-8">
    <%= render 'shared/flash_alert' %>

    <!-- Header -->
    <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-6">
      <div class="flex flex-col items-start gap-5 min-w-0">
        <span class="glass-soft sr-up inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-sm" style="animation-delay: 0s; color: rgba(238,243,238,0.9)">
          <span class="sr-dot w-2 h-2 rounded-full bg-primary"></span>
          <%= t("ux_i18n2.cv_generations.index.ai_generated") %>
        </span>
        <h1 class="m-0 font-semibold" style="font-size: clamp(30px, 4.2vw, 50px); line-height: 1.15; letter-spacing: -0.02em">
          <% words = t("#{tk}.title", id: @cv_generation.id).split %>
          <% delay = 0.1 %>
          <% words.each_with_index do |word, i| %><span class="sr-w" style="<%= 'color: #d6b877; ' if i == words.size - 1 && words.size > 1 %>animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
        </h1>
      </div>
      <div class="sr-up flex items-center gap-2.5 flex-wrap" style="animation-delay: .45s">
        <%= link_to cv_generations_path, class: secondary_class do %>
          <span class="sr-ico flex"><span class="flex" style="<%= 'transform: scaleX(-1)' if text_direction == 'ltr' %>"><%= svg.call(:back) %></span></span>
          <%= t("#{tk}.back") %>
        <% end %>
        <% if @cv_generation.status == "failed" %>
          <%= button_to retry_cv_generation_path(@cv_generation), method: :post, class: primary_class, style: primary_style do %>
            <%= svg.call(:retry) %><%= t("#{tk}.retry") %>
          <% end %>
        <% end %>
        <% if @cv_generation.status == "processing" %>
          <%= button_to cancel_cv_generation_path(@cv_generation), method: :post, class: "#{secondary_class} hover:text-red-300" do %>
            <%= svg.call(:stop) %><%= t("#{tk}.cancel") %>
          <% end %>
        <% end %>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      <!-- Status and details -->
      <aside class="glass sr-up rounded-[28px] p-6 flex flex-col gap-5 lg:sticky lg:top-28" style="animation-delay: .55s">
        <h2 class="m-0 text-[18px] font-semibold"><%= t("#{tk}.info_title") %></h2>
        <dl class="m-0 flex flex-col gap-4 text-[14px]">
          <div class="flex items-center justify-between gap-3">
            <dt style="<%= muted %>"><%= t("#{tk}.status") %></dt>
            <dd class="m-0"><%= render "cv_generations/status_chip", generation: @cv_generation %></dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt style="<%= muted %>"><%= t("#{tk}.created") %></dt>
            <dd class="m-0 sr-mono text-xs" dir="ltr"><%= stamp.call(@cv_generation.created_at) %></dd>
          </div>
          <div class="flex items-center justify-between gap-3">
            <dt style="<%= muted %>"><%= t("#{tk}.updated") %></dt>
            <dd class="m-0 sr-mono text-xs" dir="ltr"><%= stamp.call(@cv_generation.updated_at) %></dd>
          </div>
          <% if @cv_generation.tokens_used %>
            <div class="flex items-center justify-between gap-3">
              <dt style="<%= muted %>"><%= t("#{tk}.tokens_used") %></dt>
              <dd class="m-0 sr-mono text-xs" dir="ltr"><%= number_with_delimiter(@cv_generation.tokens_used) %></dd>
            </div>
          <% end %>
          <% if @cv_generation.ai_model.present? %>
            <div class="flex items-center justify-between gap-3">
              <dt style="<%= muted %>"><%= t("#{tk}.ai_model") %></dt>
              <dd class="m-0 sr-mono text-xs truncate" dir="ltr"><%= @cv_generation.ai_model %></dd>
            </div>
          <% end %>
          <% if @cv_generation.resume_id %>
            <div class="flex items-center justify-between gap-3">
              <dt style="<%= muted %>"><%= t("#{tk}.resume") %></dt>
              <dd class="m-0"><%= link_to t("#{tk}.view_resume"), resume_path(@cv_generation.resume_id), class: "underline underline-offset-4", style: "color: #2fa36b" %></dd>
            </div>
          <% end %>
        </dl>
      </aside>

      <!-- Main content -->
      <div class="lg:col-span-2 flex flex-col gap-6">
        <% if @cv_generation.status == "processing" %>
          <section id="cvgen-show-processing" class="glass sr-up rounded-[28px] p-6 flex items-center gap-4" style="animation-delay: .6s; border-color: rgba(214,184,119,0.35)" role="status">
            <span class="glass-soft flex-none w-12 h-12 rounded-2xl flex items-center justify-center" style="color: #d6b877">
              <span class="sr-spin inline-flex"><%= svg.call(:spark, 22) %></span>
            </span>
            <div class="flex flex-col gap-1">
              <h2 class="m-0 text-[17px] font-semibold" style="color: #d6b877"><%= t("#{tk}.processing_title") %></h2>
              <p class="m-0 text-[14px]" style="color: rgba(238,243,238,0.7)"><%= t("#{tk}.processing_text") %></p>
            </div>
          </section>
          <script>
            (function () {
              var url = <%= raw json_escape(cv_generation_path(@cv_generation, format: :json).to_json) %>;
              var timer = setInterval(function () {
                if (!document.getElementById('cvgen-show-processing')) { clearInterval(timer); return; }
                fetch(url, { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
                  .then(function (r) { return r.ok ? r.json() : null; })
                  .then(function (data) {
                    if (!data || data.status === 'processing') return;
                    clearInterval(timer);
                    if (window.Turbo && window.Turbo.visit) { window.Turbo.visit(window.location.href, { action: 'replace' }); }
                    else { window.location.reload(); }
                  })
                  .catch(function () {});
              }, 4000);
            })();
          </script>
        <% end %>

        <% if @cv_generation.status == "failed" %>
          <section class="glass sr-up rounded-[28px] p-6 flex items-start gap-4" style="animation-delay: .6s; border-color: rgba(248,113,113,0.35)" role="alert">
            <span class="glass-soft flex-none w-12 h-12 rounded-2xl flex items-center justify-center" style="color: #fca5a5"><%= svg.call(:alert, 22) %></span>
            <div class="flex flex-col gap-1">
              <h2 class="m-0 text-[17px] font-semibold" style="color: #fca5a5"><%= t("#{tk}.failed_title") %></h2>
              <p class="m-0 text-[14px]" style="color: rgba(238,243,238,0.7)"><%= t("#{tk}.failed_text") %></p>
            </div>
          </section>
        <% end %>

        <!-- Job description -->
        <% if @cv_generation.job_description.present? %>
          <section class="glass sr-up rounded-[28px] p-6 flex flex-col gap-3" style="animation-delay: .65s">
            <h2 class="m-0 text-[18px] font-semibold"><%= t("#{tk}.job_description") %></h2>
            <div class="glass-soft rounded-[18px] p-4 max-h-[320px] overflow-y-auto">
              <p class="m-0 text-[14px] whitespace-pre-wrap leading-relaxed" style="color: rgba(238,243,238,0.8)"><%= @cv_generation.job_description %></p>
            </div>
          </section>
        <% end %>

        <% if draft %>
          <!-- Saved draft -->
          <section class="glass sr-reveal rounded-[28px] p-6 flex flex-col gap-4" style="border-color: rgba(214,184,119,0.3)">
            <h2 class="m-0 text-[18px] font-semibold" style="color: #d6b877"><%= t("#{tk}.saved_draft") %></h2>
            <p class="m-0 text-[14px]" style="color: rgba(238,243,238,0.75)"><%= t("#{tk}.saved_at") %>:
              <span class="sr-mono text-xs" dir="ltr"><%= (stamp.call(Time.zone.parse(@cv_generation.draft_data["saved_at"].to_s)) rescue nil) || t("#{tk}.not_specified") %></span>
            </p>
            <% if @cv_generation.draft_data["job_description"].present? %>
              <div class="glass-soft rounded-[18px] p-4">
                <p class="m-0 text-[14px] whitespace-pre-wrap leading-relaxed" style="color: rgba(238,243,238,0.8)"><%= @cv_generation.draft_data["job_description"] %></p>
              </div>
            <% end %>
            <% if @cv_generation.draft_data["resume_id"] %>
              <p class="m-0 text-[14px]" style="color: rgba(238,243,238,0.75)"><%= t("#{tk}.selected_resume") %>:
                <%= link_to t("#{tk}.view_resume"), resume_path(@cv_generation.draft_data["resume_id"]), class: "underline underline-offset-4", style: "color: #2fa36b" %>
              </p>
            <% end %>
            <div class="flex items-center gap-2.5 flex-wrap">
              <%= button_to resume_draft_cv_generation_path(@cv_generation), method: :post, form: { data: { action: "submit->confirm-delete#intercept", confirm_delete_title_param: t("#{tk}.resume_draft"), confirm_delete_body_param: t("#{tk}.resume_draft_confirm"), confirm_delete_confirm_label_param: t("#{tk}.resume_draft") } }, class: primary_class, style: primary_style do %>
                <%= svg.call(:retry) %><%= t("#{tk}.resume_draft") %>
              <% end %>
              <%= link_to t("#{tk}.back"), cv_generations_path, class: secondary_class %>
            </div>
          </section>
        <% elsif @cv_generation.generated_content.present? %>
          <!-- Generated summary -->
          <section class="glass sr-reveal rounded-[28px] p-6 flex flex-col gap-4">
            <h2 class="m-0 text-[18px] font-semibold"><%= t("#{tk}.generated_summary") %></h2>
            <div class="glass-soft rounded-[18px] p-4">
              <p class="m-0 text-[15px] whitespace-pre-wrap leading-relaxed" style="color: rgba(238,243,238,0.85)"><%= @cv_generation.generated_content %></p>
            </div>
            <% if pdf_ready %>
              <div class="glass-soft rounded-[18px] px-4 py-3 flex items-center gap-2 flex-wrap text-[13px]" style="background: rgba(47,163,107,0.08); border-color: rgba(47,163,107,0.3)">
                <span style="color: #2fa36b"><%= svg.call(:check) %></span>
                <span class="font-medium" style="color: #2fa36b"><%= t("#{tk}.pdf_ready") %></span>
                <span class="sr-mono text-xs truncate" style="<%= muted %>" dir="ltr"><%= number_to_human_size(metadata["pdf_size"]) %> · <%= metadata["pdf_filename"] %></span>
              </div>
              <div class="flex items-center gap-2.5 flex-wrap">
                <%= link_to download_pdf_cv_generation_path(@cv_generation), class: primary_class, style: primary_style, data: { turbo: false } do %>
                  <%= svg.call(:download) %><%= t("#{tk}.download_pdf") %>
                <% end %>
                <%= link_to view_pdf_cv_generation_path(@cv_generation), target: "_blank", rel: "noopener", class: secondary_class do %>
                  <%= svg.call(:eye) %><%= t("#{tk}.view_pdf") %>
                <% end %>
                <%= link_to download_pdf_cv_generation_path(@cv_generation, regenerate: true), class: secondary_class, title: t("#{tk}.regenerate_note"), data: { turbo: false } do %>
                  <%= svg.call(:retry) %><%= t("#{tk}.regenerate_pdf") %>
                <% end %>
              </div>
              <p class="m-0 text-xs" style="<%= muted %>"><%= t("#{tk}.regenerate_note") %></p>
            <% elsif metadata["pdf_error"].present? %>
              <p class="glass-soft m-0 rounded-[18px] px-4 py-3 text-[13px]" style="color: #fca5a5; border-color: rgba(248,113,113,0.35)"><%= t("#{tk}.pdf_error", error: metadata["pdf_error"]) %></p>
            <% end %>
          </section>
        <% end %>

        <% if pdf_ready && metadata["pdf_data"].present? %>
          <!-- PDF preview -->
          <section class="glass sr-reveal rounded-[28px] p-4 sm:p-5 flex flex-col gap-4">
            <div class="flex items-center justify-between gap-3 px-1">
              <h2 class="m-0 text-[18px] font-semibold inline-flex items-center gap-2"><span style="color: #2fa36b"><%= svg.call(:doc, 18) %></span><%= t("#{tk}.pdf_title") %></h2>
              <span class="sr-mono text-xs truncate" style="<%= muted %>" dir="ltr"><%= metadata["pdf_filename"] %></span>
            </div>
            <div class="rounded-[20px] overflow-hidden border border-white/10 bg-white keep-light">
              <iframe src="<%= view_pdf_cv_generation_path(@cv_generation) %>" class="block w-full border-0" style="height: min(80vh, 900px)" title="<%= t("#{tk}.pdf_title") %>">
                <p><%= t("#{tk}.pdf_fallback") %> <%= link_to t("#{tk}.pdf_fallback_link"), download_pdf_cv_generation_path(@cv_generation) %></p>
              </iframe>
            </div>
          </section>
        <% end %>
      </div>
    </div>
  </div>
  <%= render "shared/confirm_dialog" %>
</div>

            );

            container.dataset.mounted = 'true';
            console.log('✅ React app mounted successfully');
          } catch (error) {
            console.error('🔴 Error starting React app:', error);
            const container = document.getElementById('cv-generation-results');
            if (container) {
              container.innerHTML = '<div className="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800 dark:border-red-500/30 dark:bg-red-500/20 dark:text-red-300"><p className="font-medium">' + (t.render_error || 'Render error') + '</p><p className="mt-2 text-sm">' + error.message + '</p></div>';
            }
          }
        };

        window.addEventListener('error', function(event) {
          const container = document.getElementById('cv-generation-results');
          if (!container || container.dataset.mounted === 'true') return;
          container.innerHTML = '<div className="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800 dark:border-red-500/30 dark:bg-red-500/20 dark:text-red-300"><p className="font-medium">' + (t.render_error || 'Render error') + '</p><p className="mt-2 text-sm">' + (event.error?.message || event.message || 'Unknown error') + '</p></div>';
        });

        // Initialize the app when the document is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', startApp);
        } else {
          startApp();
        }
      </script>
      <script>
        // Initialize Lucide icons
        document.addEventListener('DOMContentLoaded', () => {
          if (typeof lucide !== 'undefined') {
            lucide.createIcons({
              attrs: { 'stroke-width': 1.5 }
            });
          }
        });
      </script>
      <script>
        // Theme Logic
        const html = document.documentElement;

        // Initialize Theme
        html.classList.add('dark'); // the Seera design is dark only

        // Mobile Menu Logic
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const closeMobileMenu = document.getElementById('closeMobileMenu');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        function openMenu() {
            if (mobileMenu) {
                mobileMenu.classList.remove('translate-x-full');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeMenu() {
            if (mobileMenu) {
                mobileMenu.classList.add('translate-x-full');
                document.body.style.overflow = '';
            }
        }

        if (mobileMenuBtn) mobileMenuBtn.addEventListener('click', openMenu);
        if (closeMobileMenu) closeMobileMenu.addEventListener('click', closeMenu);

        mobileLinks.forEach(link => {
            link.addEventListener('click', closeMenu);
        });
      </script>
      </main>
      
      <!-- Footer -->
      <%= render 'layouts/footer' %>
    <%= render 'shared/site_scripts' %>
</body>
  </html>
<% end %>

<% content_for :title, t('cv_generation.page_title', default: 'AI Resume Builder — CV•AI') %>
<% content_for :body_class, "sr-app-long" %>
<%# Long page: the layout lets the ambient scroll with it, so its orbs run the full page height. %>
<% content_for :ambient_scrolls, true %>
<% content_for :description, t('cv_generation.page_description', default: 'Create a professional resume in minutes using AI. Modern templates, automatic bullet point optimization, and high-quality PDF export.') %>
<% content_for :head do %>
  <%# The generator below is compiled by in-browser Babel on DOMContentLoaded, which a
      Turbo Drive visit never fires, so arriving here always loads the page in full. %>
  <meta name="turbo-visit-control" content="reload">
  <style>
    .line-clamp-3 {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .pdf-viewer {
      width: 100%;
      height: 100%;
      border: none;
      background: #ffffff;
    }
    @media (max-width: 768px) {
      .pdf-modal iframe {
        min-height: 60vh;
      }
    }
    .pdf-preview-frame {
      width: 100%;
      height: 100%;
      border: none;
      margin: 0;
      padding: 0;
    }
  </style>
<% end %>
<% muted = "color: rgba(238,243,238,0.7)" %>

<div dir="<%= text_direction %>" class="sr-page relative overflow-clip leading-relaxed" style="color: #eef3ee; animation-name: sr-riseUp">
  <div class="relative mx-auto max-w-[1240px] px-4 sm:px-6 pt-10 pb-20 flex flex-col gap-8">
    <%= render 'shared/flash_alert' %>

    <!-- Header -->
    <header class="flex flex-col items-center text-center gap-5">
      <span class="glass-soft sr-up inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-sm" style="animation-delay: 0s; color: rgba(238,243,238,0.9)">
        <span class="sr-dot w-2 h-2 rounded-full bg-primary"></span>
        <%= t('cv_generation.badge') %>
      </span>
      <h1 class="m-0 font-semibold" style="font-size: clamp(34px, 4.6vw, 56px); line-height: 1.15; letter-spacing: -0.02em">
        <% words = t('cv_generation.title').split %>
        <% delay = 0.1 %>
        <% words.each_with_index do |word, i| %><span class="sr-w" style="<%= 'color: #d6b877; ' if i == words.size - 1 && words.size > 1 %>animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
      </h1>
      <p class="sr-up m-0 font-light text-[17px] max-w-[56ch]" style="animation-delay: .35s; <%= muted %>"><%= t('cv_generation.description') %></p>
    </header>

        <div id="cv-generation-results">
          <div id="cv-generation-bootstrapping" class="glass sr-up rounded-[32px] py-14 px-6 flex flex-col items-center gap-4 text-center" style="animation-delay: .45s" role="status">
            <span class="glass-soft sr-float w-14 h-14 rounded-2xl flex items-center justify-center" style="color: #d6b877">
              <svg class="sr-spin" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 3a9 9 0 019 9"></path><circle cx="12" cy="12" r="9" stroke-opacity="0.2"></circle></svg>
            </span>
            <p class="m-0 text-[15px]" style="color: rgba(238,243,238,0.7)"><%= t('cv_generation.loading_data') %></p>
          </div>
        </div>
        <%# Live percentage for the generation wait; React moves it into place while generating. %>
        <% cvgen_en = I18n.locale.to_s == "en" %>
        <div id="cvgen-progress-home" hidden>
          <%= render "shared/ai_progress",
                id: "cvgen-progress",
                dir: (cvgen_en ? "ltr" : "rtl"),
                badge: t('cv_generation.badge'),
                title: t('cv_generation.generating_cv'),
                subtitle: t('cv_generation.please_wait'),
                steps: [
                  { label: cvgen_en ? "Reading your resume" : "قراءة سيرتك الذاتية", at: 0 },
                  { label: cvgen_en ? "Matching the job description" : "مطابقة الوصف الوظيفي", at: 15 },
                  { label: cvgen_en ? "Writing your tailored CV" : "كتابة السيرة المخصصة", at: 40 },
                  { label: cvgen_en ? "Building the PDF" : "تجهيز ملف PDF", at: 85 }
                ],
                error_title: t('cv_generation.error_occurred'),
                error_text: t('cv_generation.unknown_error'),
                retry_label: t('cv_generation.create_resume'),
                retry_href: new_cv_generation_path %>
        </div>
      </div>
      <!-- Pass translations to JavaScript -->
      <script>
        window.CV_TRANSLATIONS = {
          job_description_label: "<%= j t('cv_generation.job_description_label') %>",
          job_description_placeholder: "<%= j t('cv_generation.job_description_placeholder') %>",
          select_resume_label: "<%= j t('cv_generation.select_resume_label') %>",
          no_resumes: "<%= j t('cv_generation.no_resumes') %>",
          create_resume: "<%= j t('cv_generation.create_resume') %>",
          error_occurred: "<%= j t('cv_generation.error_occurred') %>",
          unknown_error: "<%= j t('cv_generation.unknown_error') %>",
          render_error: "<%= j t('cv_generation.render_error') %>",
          generating: "<%= j t('cv_generation.generating') %>",
          max_reached: "<%= j t('cv_generation.max_reached', max: '{max}') %>",
          generating_cv: "<%= j t('cv_generation.generating_cv') %>",
          please_wait: "<%= j t('cv_generation.please_wait') %>",
          selected: "<%= j t('cv_generation.selected') %>",
          job_description_prefix: "<%= j t('cv_generation.job_description_prefix') %>",
          cv_created_success: "<%= j t('cv_generation.cv_created_success') %>",
          delete: "<%= j t('cv_generation.delete') %>",
          pdf_ready: "<%= j t('cv_generation.pdf_ready') %>",
          new_professional_summary: "<%= j t('cv_generation.new_professional_summary') %>",
          preview_pdf: "<%= j t('cv_generation.preview_pdf') %>",
          download_pdf: "<%= j t('cv_generation.download_pdf') %>",
          pdf_not_available: "<%= j t('cv_generation.pdf_not_available') %>",
          pdf_not_generated: "<%= j t('cv_generation.pdf_not_generated') %>",
          error_prefix: "<%= j t('cv_generation.error_prefix') %>",
          cv_preview: "<%= j t('cv_generation.cv_preview') %>",
          close: "<%= j t('cv_generation.close') %>",
          loading_pdf: "<%= j t('cv_generation.loading_pdf') %>",
          open_in_new_window: "<%= j t('cv_generation.open_in_new_window') %>",
          download_failed: "<%= j t('cv_generation.download_failed') %>",
          generated_cv_name: "<%= j t('cv_generation.generated_cv_name', id: '{id}') %>",
          not_specified: "<%= j t('cv_generation.not_specified') %>",
          ai_generated_content: "<%= j t('cv_generation.ai_generated_content') %>",
          delete_confirm: "<%= j t('cv_generation.delete_confirm') %>",
          delete_failed: "<%= j t('cv_generation.delete_failed') %>",
          delete_error: "<%= j t('cv_generation.delete_error') %>",
          delete_generated_confirm: "<%= j t('cv_generation.delete_generated_confirm') %>",
          delete_generated_failed: "<%= j t('cv_generation.delete_generated_failed') %>",
          delete_generated_error: "<%= j t('cv_generation.delete_generated_error') %>",
          max_limit_reached: "<%= j t('cv_generation.max_limit_reached', max: '{max}') %>",
          loading_data: "<%= j t('cv_generation.loading_data') %>",
          ai_generated: "<%= j t('cv_generation.ai_generated') %>",
          last_generated: "<%= j t('cv_generation.last_generated') %>",
          pdf_available: "<%= j t('cv_generation.pdf_available') %>",
          processing: "<%= j t('cv_generation.processing') %>",
          generation_failed: "<%= j t('cv_generation.generation_failed') %>",
          professional_summary: "<%= j t('cv_generation.professional_summary') %>",
          cv_builder_resume: "<%= j t('cv_generation.cv_builder_resume') %>",
          ready_to_enhance: "<%= j t('cv_generation.ready_to_enhance') %>",
          created_on: "<%= j t('cv_generation.created_on') %>",
          basic_resume: "<%= j t('cv_generation.basic_resume') %>",
          preview: "<%= j t('cv_generation.preview') %>",
          download: "<%= j t('cv_generation.download') %>",
          ats_template_label: "<%= j t('cv_generation.ats_template_label') %>",
          preview_template: "<%= j t('cv_generation.preview_template') %>",
          use_template: "<%= j t('cv_generation.use_template') %>",
          select_resume_and_job: "<%= j t('cv_generation.select_resume_and_job') %>",
          toast_close: "<%= j t('cv_generation_toast.close') %>",
          get_more_credits: "<%= j t('cv_generation_toast.get_more_credits') %>"
        };
        window.CV_ATS_TEMPLATES = <%= raw ats_template_options_for_cv_generation.to_json %>;
        window.CV_DEFAULT_ATS_TEMPLATE = <%= raw @default_ats_template.to_json %>;
      </script>
      <!-- Glass toast: replaces window.alert() on this standalone page -->
      <div id="cv-toast-region" class="fixed inset-x-0 bottom-4 z-[60] flex flex-col items-center gap-2 px-4 pointer-events-none"></div>
      <script>
        window.cvSafeUrl = function (url) {
          // Only same-origin paths or http(s) URLs; never javascript: or data:.
          if (typeof url !== 'string' || !url.trim()) return null;
          try {
            const parsed = new URL(url, window.location.origin);
            return (parsed.protocol === 'https:' || parsed.protocol === 'http:') ? parsed.href : null;
          } catch (_) {
            return null;
          }
        };

        window.cvToast = function (message, options) {
          const opts = options || {};
          const region = document.getElementById('cv-toast-region');
          if (!region) { console.warn(message); return; }

          const toast = document.createElement('div');
          toast.setAttribute('role', opts.type === 'info' ? 'status' : 'alert');
          toast.className = 'glass pointer-events-auto w-full max-w-md rounded-2xl px-4 py-3 text-sm text-white shadow-2xl flex items-start gap-3 border ' +
            (opts.type === 'info' ? 'border-white/15' : 'border-red-400/40');
          toast.style.transition = 'opacity .2s ease, transform .2s ease';
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(8px)';

          const dot = document.createElement('span');
          dot.className = 'mt-1.5 h-2 w-2 shrink-0 rounded-full ' + (opts.type === 'info' ? 'bg-primary' : 'bg-red-400');
          dot.setAttribute('aria-hidden', 'true');

          const body = document.createElement('div');
          body.className = 'min-w-0 flex-1 leading-relaxed';
          const text = document.createElement('p');
          text.textContent = String(message || '');
          body.appendChild(text);

          const href = window.cvSafeUrl(opts.linkUrl);
          if (href) {
            const link = document.createElement('a');
            link.href = href;
            link.textContent = opts.linkLabel || href;
            link.className = 'mt-1 inline-block font-semibold text-action underline underline-offset-2';
            body.appendChild(link);
          }

          const close = document.createElement('button');
          close.type = 'button';
          close.className = 'shrink-0 -m-1 h-8 w-8 inline-flex items-center justify-center rounded-full text-white/70 hover:text-white hover:bg-white/10';
          close.setAttribute('aria-label', (window.CV_TRANSLATIONS && window.CV_TRANSLATIONS.toast_close) || 'Dismiss');
          close.textContent = '\u00D7';

          let timer = null;
          const dismiss = function () {
            clearTimeout(timer);
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(8px)';
            setTimeout(function () { toast.remove(); }, 200);
          };
          close.addEventListener('click', dismiss);

          toast.appendChild(dot);
          toast.appendChild(body);
          toast.appendChild(close);
          region.appendChild(toast);
          while (region.children.length > 3) region.firstElementChild.remove();

          requestAnimationFrame(function () {
            toast.style.opacity = '1';
            toast.style.transform = 'none';
          });
          timer = setTimeout(dismiss, href ? 10000 : 5000);
          toast.addEventListener('mouseenter', function () { clearTimeout(timer); });
          toast.addEventListener('mouseleave', function () { timer = setTimeout(dismiss, 3000); });
        };

        window.cvEscapeHtml = function (value) {
          return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
          });
        };
      </script>
      <!-- React Libraries -->
      <script crossorigin src="https://unpkg.com/react@18.3.1/umd/react.production.min.js"></script>
      <script crossorigin src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.production.min.js"></script>
      <script src="https://unpkg.com/@babel/standalone@7.26.9/babel.min.js"></script>
      <script type="text/babel" data-presets="env,react">
        const { useState, useEffect } = React;
        const t = window.CV_TRANSLATIONS;

        // Live percentage while a CV is generating (shared/_ai_progress + window.SeeraProgress).
        const progressNode = () => document.getElementById('cvgen-progress');
        const progressHome = () => document.getElementById('cvgen-progress-home');

        const GenerationProgress = () => {
          const holderRef = React.useRef(null);
          const el = progressNode();

          useEffect(() => {
            const node = progressNode();
            const holder = holderRef.current;
            if (!node || !holder || !window.SeeraProgress) return undefined;
            holder.appendChild(node);
            window.SeeraProgress.start(node, { expectedSeconds: 30 });
            return () => {
              window.SeeraProgress.stop(node);
              const home = progressHome();
              if (home) home.appendChild(node);
            };
          }, []);

          if (!el || !window.SeeraProgress) {
            return (
              <GlassLoader label={t.generating_cv} hint={t.please_wait} />
            );
          }
          return <div ref={holderRef} />;
        };

        // Count the live percentage up to 100% before showing the result.
        const finishProgress = (callback) => {
          const node = progressNode();
          const home = progressHome();
          if (window.SeeraProgress && node && home && !home.contains(node)) {
            window.SeeraProgress.done(node, callback);
          } else {
            callback();
          }
        };

          // NOTE: Inline Babel cannot import local modules. Avoid imports here.

        // Error Boundary Component
        class ErrorBoundary extends React.Component {
          constructor(props) {
            super(props);
            this.state = { hasError: false, error: null };
          }

          static getDerivedStateFromError(error) {
            return { hasError: true, error };
          }

          componentDidCatch(error, errorInfo) {
            console.error('🔴 React Error:', error);
            console.error('Error Info:', errorInfo);
          }

          render() {
            if (this.state.hasError) {
              return (
                <div role="alert" className="glass-soft rounded-2xl p-4" style={{ borderColor: 'rgba(248,113,113,0.4)' }}>
                  <h2 className="m-0 text-red-200 font-medium">{t.error_occurred}</h2>
                  <p className="m-0 text-red-300/80 text-sm mt-2">{this.state.error?.message || t.unknown_error}</p>
                </div>
              );
            }
            return this.props.children;
          }
        }

        const DebugWrapper = ({ children }) => {
          try {
            return children;
          } catch (error) {
            console.error('🔴 Render Error:', error);
            return (
              <div role="alert" className="glass-soft rounded-2xl p-4" style={{ borderColor: 'rgba(248,113,113,0.4)' }}>
                <h2 className="m-0 text-red-200 font-medium">{t.render_error}</h2>
                <p className="m-0 text-red-300/80 text-sm mt-2">{error.message}</p>
              </div>
            );
          }
        };

        // ATS template previews: static page-1 WebP images in public/ats_previews.
        // Cards load the small thumbnail (1x/2x); the full image loads only in the lightbox.
        const atsThumbSrc = (template) =>
          template.thumb_url || '/ats_previews/' + template.key + '-thumb.webp';
        const atsThumb2xSrc = (template) =>
          template.thumb_2x_url || '/ats_previews/' + template.key + '-thumb@2x.webp';
        const atsFullSrc = (template) =>
          template.full_url || '/ats_previews/' + template.key + '.webp';

        const MagnifierIcon = ({ className }) => (
          <svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7" />
            <path d="M20 20l-3.5-3.5" />
            <path d="M11 8v6M8 11h6" />
          </svg>
        );

        // Line icons drawn inline, matching the landing's 24px stroke set.
        const ICON_PATHS = {
          eye: <><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></>,
          download: <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />,
          trash: <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3" />,
          check: <><circle cx="12" cy="12" r="9" /><path d="M8 12l3 3 5-6" /></>,
          alert: <><circle cx="12" cy="12" r="9" /><path d="M12 7v6M12 16.5v.01" /></>,
          doc: <><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></>,
          spark: <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" />,
          close: <path d="M6 6l12 12M18 6L6 18" />,
          external: <><path d="M14 4h6v6" /><path d="M20 4l-9 9" /><path d="M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5" /></>
        };

        const Icon = ({ name, className }) => (
          <svg className={'shrink-0 ' + (className || 'w-4 h-4')} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true" focusable="false">
            {ICON_PATHS[name]}
          </svg>
        );

        // Numbered section heading for the three steps of the form.
        const StepTitle = ({ number, label }) => (
          <div className="flex items-center gap-3">
            <span className="glass-soft sr-mono flex-none w-9 h-9 rounded-xl inline-flex items-center justify-center text-sm font-semibold" style={{ color: '#d6b877' }}>{number}</span>
            <h2 className="m-0 text-[18px] sm:text-[20px] font-semibold text-mist">{label}</h2>
          </div>
        );

        // Glass loading card with the landing's slow spinner.
        const GlassLoader = ({ label, hint }) => (
          <div className="glass rounded-[32px] py-14 px-6 flex flex-col items-center gap-4 text-center" role="status">
            <span className="glass-soft sr-float w-14 h-14 rounded-2xl flex items-center justify-center" style={{ color: '#d6b877' }}>
              <svg className="sr-spin" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" aria-hidden="true">
                <path d="M12 3a9 9 0 019 9" />
                <circle cx="12" cy="12" r="9" strokeOpacity="0.2" />
              </svg>
            </span>
            <p className="m-0 text-[15px] text-mist/70">{label}</p>
            {hint && <p className="m-0 text-sm text-mist/50">{hint}</p>}
          </div>
        );

        // Full-size glass lightbox for one template preview.
        const AtsTemplateLightbox = ({ template, onClose, onUse }) => {
          const closeRef = React.useRef(null);
          const panelRef = React.useRef(null);
          const onCloseRef = React.useRef(onClose);
          const [imageFailed, setImageFailed] = useState(false);
          onCloseRef.current = onClose;

          useEffect(() => {
            const trigger = document.activeElement;
            const previousOverflow = document.body.style.overflow;
            document.body.style.overflow = 'hidden';
            if (closeRef.current) closeRef.current.focus();

            const handleKeyDown = (event) => {
              if (event.key === 'Escape') {
                event.preventDefault();
                onCloseRef.current();
                return;
              }
              if (event.key !== 'Tab' || !panelRef.current) return;
              const focusable = panelRef.current.querySelectorAll('button:not([disabled])');
              if (focusable.length === 0) return;
              const first = focusable[0];
              const last = focusable[focusable.length - 1];
              if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
              } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
              }
            };
            document.addEventListener('keydown', handleKeyDown);

            return () => {
              document.removeEventListener('keydown', handleKeyDown);
              document.body.style.overflow = previousOverflow;
              if (trigger && typeof trigger.focus === 'function') trigger.focus();
            };
          }, []);

          const titleId = 'ats-preview-title-' + template.key;

          // Portal to <body> so a blurred or transformed ancestor cannot trap the fixed overlay.
          return ReactDOM.createPortal(
            <div
              className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-3 sm:p-6"
              onClick={(event) => { if (event.target === event.currentTarget) onClose(); }}
              data-testid="ats-preview-backdrop"
            >
              <div
                ref={panelRef}
                role="dialog"
                aria-modal="true"
                aria-labelledby={titleId}
                className="glass rounded-2xl p-3 sm:p-4 w-full max-w-xl max-h-full flex flex-col text-white"
              >
                <div className="flex items-start justify-between gap-3 mb-3">
                  <div className="min-w-0">
                    <h2 id={titleId} className="text-base sm:text-lg font-semibold leading-snug">
                      {template.name}
                    </h2>
                    {template.description && (
                      <p className="text-xs sm:text-sm text-white/60 mt-0.5 line-clamp-2">{template.description}</p>
                    )}
                  </div>
                </div>
                <div className="flex-1 min-h-0 overflow-auto overscroll-contain rounded-xl border border-white/10 bg-white/5 flex items-center justify-center">
                  {imageFailed ? (
                    <p className="p-6 text-sm text-white/70 text-center">{template.description || template.name}</p>
                  ) : (
                    <img
                      src={atsFullSrc(template)}
                      alt={template.name}
                      decoding="async"
                      className="block max-h-[calc(100dvh-11rem)] sm:max-h-[85vh] w-auto max-w-full bg-white keep-light"
                      onError={() => setImageFailed(true)}
                    />
                  )}
                </div>
                <div className="flex flex-wrap items-center justify-end gap-2 mt-3">
                  <button
                    ref={closeRef}
                    type="button"
                    onClick={onClose}
                    className="glass-soft sr-btn min-h-[44px] px-4 rounded-xl text-sm font-medium text-white hover:bg-white/10 touch-manipulation"
                  >
                    {t.close}
                  </button>
                  <button
                    type="button"
                    onClick={onUse}
                    className="sr-btn sr-primary min-h-[44px] px-4 rounded-xl text-sm font-semibold touch-manipulation"
                  >
                    {t.use_template}
                  </button>
                </div>
              </div>
            </div>,
            document.body
          );
        };

        const CvGeneratorApp = () => {
          console.log('🔄 CvGeneratorApp component rendering...');

          // Form state
          const [jobDescription, setJobDescription] = useState('');
          const [selectedResumeId, setSelectedResumeId] = useState('');
          const [selectedAtsTemplate, setSelectedAtsTemplate] = useState(
            window.CV_DEFAULT_ATS_TEMPLATE || 'harvard_classic'
          );
          const atsTemplates = window.CV_ATS_TEMPLATES || [];
          const [previewTemplate, setPreviewTemplate] = useState(null);
          const [failedPreviews, setFailedPreviews] = useState({});
          const markPreviewFailed = (key) =>
            setFailedPreviews((prev) => (prev[key] ? prev : { ...prev, [key]: true }));
          const [isGenerating, setIsGenerating] = useState(false);
          const [isLoading, setIsLoading] = useState(true);

          // Results state
          const [cvData, setCvData] = useState(null);
          const [error, setError] = useState(null);
          const [upgradeUrl, setUpgradeUrl] = useState(null);
          const [showPdfModal, setShowPdfModal] = useState(false);
          const [showResults, setShowResults] = useState(false);
          const [resumes, setResumes] = useState([]);

          // Preview Modal state
          const [showPreviewModal, setShowPreviewModal] = useState(false);
          const [previewPdfUrl, setPreviewPdfUrl] = useState('');
          const [previewTitle, setPreviewTitle] = useState('');

          // Safe access helper
          const safeGet = (obj, path, fallback = '') => {
            try {
              return path.split('.').reduce((acc, key) => acc[key], obj) || fallback;
            } catch (e) {
              return fallback;
            }
          };
            // Helper to get unique id for resume or CV
            const getResumeId = (resume) => resume.id || resume.cv_gen_id || resume.cv_generation_id || resume._id || '';

          // CV Generation limit state
          const [userCvCount, setUserCvCount] = useState(0);
          const [maxCvGenerations, setMaxCvGenerations] = useState(150);

          // Download handler function
          const handleDownload = async (url, filename) => {
            try {
              const response = await fetch(url);
              if (!response.ok) {
                throw new Error('Download failed');
              }

              const blob = await response.blob();
              const downloadUrl = window.URL.createObjectURL(blob);
              const link = document.createElement('a');
              link.href = downloadUrl;
              link.download = filename || 'cv.pdf';
              document.body.appendChild(link);
              link.click();
              document.body.removeChild(link);
              window.URL.revokeObjectURL(downloadUrl);
            } catch (error) {
              console.error('Download error:', error);
              window.cvToast(t.download_failed);
            }
          };

          // Fetch user CV count
          const fetchUserCvCount = async () => {
            try {
              const response = await fetch('/cv_generations/count.json');
              if (response.ok) {
                const data = await response.json();
                setUserCvCount(data.count || 0);
                setMaxCvGenerations(data.limit || 150);
              }
            } catch (error) {
              console.error('Error fetching CV count:', error);
              setUserCvCount(0);
            }
          };

          // Load resumes and CV generations (moved outside useEffect so it can be called by delete handlers)
          const loadResumesWithGenerations = async () => {
            setIsLoading(true);
            try {
              console.log('📊 Fetching CV count...');
              await fetchUserCvCount();

              // Fetch CV Builder resumes only
              console.log('📝 Loading CV Builder resumes...');
              let builderResumes = [];
              try {
                const rawResumesResponse = await fetch('/resumes.json');
                if (rawResumesResponse.ok) {
                  const rawResumesData = await rawResumesResponse.json();
                  builderResumes = rawResumesData.map(resume => ({
                    ...resume,
                    is_cv_builder: true
                  }));
                }
              } catch (e) {
                console.error('Error loading CV Builder resumes:', e);
              }

              // Fetch generated CVs only
              console.log('📝 Loading generated CVs...');
              let generatedCVs = [];
              try {
                const cvGenerationsResponse = await fetch('/cv_generations.json');
                if (cvGenerationsResponse.ok) {
                  const cvGenerationsData = await cvGenerationsResponse.json();
                  generatedCVs = cvGenerationsData
                    .filter(cv => cv.status === 'completed')
                    .map(cv => ({
                      id: `cv_gen_${cv.id}`,
                      complete_name: cv.metadata?.complete_name || t.generated_cv_name.replace('{id}', cv.id),
                      email: cv.metadata?.email || t.not_specified,
                      professional_summary: cv.generated_content || t.ai_generated_content,
                      professional_summary_english: cv.generated_content || 'AI Generated Content',
                      latest_cv_generation: cv,
                      last_generated: new Date(cv.created_at),
                      pdf_url: cv.metadata?.pdf_generated ? `/cv_generations/${cv.id}/view_pdf` : null,
                      pdf_metadata: cv.metadata,
                      is_cv_builder: false,
                      is_ai_generated: true,
                      job_description: cv.job_description,
                      created_at: cv.created_at
                    }));
                }
              } catch (e) {
                console.error('Error loading generated CVs:', e);
              }

              // Combine both lists, but do NOT merge or overwrite
              const allResumes = [...builderResumes, ...generatedCVs];
              // Sort by creation date (newest first)
              allResumes.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
              setResumes(allResumes || []);
            } catch (err) {
              setResumes([]);
              setError('Failed to load CVs: ' + err.message);
            } finally {
              setIsLoading(false);
              console.log('✅ Initial data loading complete');
            }
          };

          // Load resumes and CV generations on component mount
          useEffect(() => {
            console.log('🔄 Initial data loading effect running...');
            loadResumesWithGenerations();
          }, []); // Empty dependency array means this effect runs once on mount

          // Check for CV generation ID in URL on page load (for direct links)
          useEffect(() => {
            const urlParams = new URLSearchParams(window.location.search);
            const cvGenerationId = urlParams.get('cv_generation_id');

            if (cvGenerationId) {
              console.log('🔍 Found CV Generation ID in URL:', cvGenerationId);
              setShowResults(true);
              setIsGenerating(true);

              // Load existing CV data if it's already completed
              const loadExistingCv = async () => {
                try {
                  const response = await fetch(`/cv_generations/${cvGenerationId}.json`);
                  const data = await response.json();

                  if (data && data.status === 'completed') {
                    console.log('✅ CV already completed, loading data');
                    console.log('📄 CV Data:', data);
                    console.log('📄 PDF Metadata:', data.metadata);
                    console.log('📄 PDF Path:', data.metadata?.pdf_path);
                    setCvData(data);
                    setIsGenerating(false);

                    if (data.metadata?.pdf_generated === true || data.metadata?.pdf_generated === 'true') {
                      setShowPdfModal(true);
                    }
                  } else if (data && data.status === 'processing') {
                    // Start polling for completion
                    let pollAttempts = 0;
                    const maxPollAttempts = 30;

                    const pollForResults = async () => {
                      try {
                        const pollResponse = await fetch(`/cv_generations/${cvGenerationId}.json`);
                        const pollData = await pollResponse.json();

                        if (pollData && pollData.status === 'completed') {
                          console.log('✅ CV generation completed!');
                          finishProgress(() => {
                            setCvData(pollData);
                            setIsGenerating(false);

                            if (pollData.metadata?.pdf_generated === true || pollData.metadata?.pdf_generated === 'true') {
                              setShowPdfModal(true);
                            }
                          });
                        } else if (pollData && pollData.status === 'failed') {
                          setError('CV generation failed');
                          setIsGenerating(false);
                        } else {
                          pollAttempts++;
                          if (pollAttempts < maxPollAttempts) {
                            setTimeout(pollForResults, 2000);
                          } else {
                            setError('CV generation is taking too long');
                            setIsGenerating(false);
                          }
                        }
                      } catch (err) {
                        console.error('❌ Error polling for results:', err);
                        setError('Error checking generation status');
                        setIsGenerating(false);
                      }
                    };

                    pollForResults();
                  }
                } catch (err) {
                  console.error('❌ Error loading CV data:', err);
                  setError('Error loading CV data');
                  setIsGenerating(false);
                }
              };

              loadExistingCv();
            }
          }, []); // Empty dependency array means this effect runs once on mount

          // PDF download handler
          const downloadPdf = async () => {
            if (!cvData || !cvData.id) {
              console.error('No CV data available for download');
              return;
            }

            try {
              await handleDownload(
                `/cv_generations/${cvData.id}/download_pdf`,
                `cv_generated_${cvData.id}.pdf`
              );
            } catch (error) {
              console.error('Error downloading PDF:', error);
              window.cvToast(t.download_failed);
            }
          };

          // Delete handlers
          const getCsrfToken = () => document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

          const deleteResume = async (resumeId) => {
            if (!resumeId) return;
            if (!confirm(t.delete_confirm)) return;
            try {
              const res = await fetch(`/resumes/${resumeId}`, {
                method: 'DELETE',
                headers: {
                  'X-CSRF-Token': getCsrfToken() || '',
                  'Accept': 'application/json'
                }
              });
              if (res.ok || res.status === 204 || res.status === 404) {
                // Remove the deleted resume from state without reloading
                setResumes(prevResumes => prevResumes.filter(r => r.id !== resumeId));
              } else {
                const txt = await res.text();
                console.error('Failed to delete resume:', res.status, txt);
                window.cvToast(t.delete_failed);
              }
            } catch (e) {
              console.error('Error deleting resume:', e);
              window.cvToast(t.delete_error);
            }
          };

          const deleteCvGeneration = async (cvGenId) => {
            if (!cvGenId) return;
            if (!confirm(t.delete_generated_confirm)) return;
            try {
              const res = await fetch(`/cv_generations/${cvGenId}`, {
                method: 'DELETE',
                headers: {
                  'X-CSRF-Token': getCsrfToken() || '',
                  'Accept': 'application/json'
                }
              });
              if (res.ok || res.status === 204 || res.status === 404) {
                // Remove the deleted CV generation from state without reloading
                // CV generations have IDs like 'cv_gen_123'
                setResumes(prevResumes => prevResumes.filter(r => r.id !== `cv_gen_${cvGenId}`));
              } else {
                const txt = await res.text();
                console.error('Failed to delete CV generation:', res.status, txt);
                window.cvToast(t.delete_generated_failed);
              }
            } catch (e) {
              console.error('Error deleting CV generation:', e);
              window.cvToast(t.delete_generated_error);
            }
          };


          // Form submission handler
          const handleSubmit = async (e) => {
            e.preventDefault();

            if (!selectedResumeId || !jobDescription.trim() || !selectedAtsTemplate) {
              window.cvToast(t.select_resume_and_job, { type: 'info' });
              return;
            }

            // Check CV generation limit
            if (userCvCount >= maxCvGenerations) {
              window.cvToast(t.max_limit_reached.replace('{max}', maxCvGenerations));
              return;
            }

            setIsGenerating(true);
            setError(null);
            setUpgradeUrl(null);
            setShowResults(true);

            try {
              // Use fetch to submit the form data
              const formData = new URLSearchParams();
              formData.append('cv_generation[job_description]', jobDescription.trim());
              formData.append('cv_generation[resume_id]', selectedResumeId);
              formData.append('cv_generation[ats_template]', selectedAtsTemplate);
              formData.append('cv_generation[temperature]', '0.7');
              formData.append('cv_generation[max_tokens]', '15000');
              formData.append('cv_generation[complete_name]', '');
              formData.append('cv_generation[email]', '');

              const response = await fetch('/cv_generations', {
                method: 'POST',
                body: formData,
                headers: {
                  'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
                  'Accept': 'application/json',
                  'Content-Type': 'application/x-www-form-urlencoded'
                }
              });

              if (response.ok) {
                const result = await response.json();
                console.log('✅ Form submitted successfully:', result);

                if (result.cv_generation_id) {
                  // Start polling for this specific CV generation
                  const cvGenerationId = result.cv_generation_id;
                  console.log('🔍 Starting to poll for CV ID:', cvGenerationId);

                  // Poll for results
                  let pollAttempts = 0;
                  const maxPollAttempts = 30;

                  const pollForResults = async () => {
                    try {
                      const pollResponse = await fetch(`/cv_generations/${cvGenerationId}.json`);
                      const data = await pollResponse.json();

                      if (data && data.status === 'completed') {
                        console.log('✅ CV generation completed!');
                        console.log('📊 CV Data:', data);
                        console.log('📄 PDF Generated:', data.metadata?.pdf_generated);
                        console.log('📄 PDF Generated Type:', typeof data.metadata?.pdf_generated);
                        console.log('📄 Has PDF Data:', !!data.metadata?.pdf_data);
                        finishProgress(() => {
                          setCvData(data);
                          setIsGenerating(false);

                          // Show PDF modal immediately if PDF is generated
                          const pdfGenerated = data.metadata?.pdf_generated;
                          console.log('📄 PDF Generated Value:', pdfGenerated);
                          console.log('📄 PDF Generated Type:', typeof pdfGenerated);

                          if (pdfGenerated === true || pdfGenerated === 'true' || pdfGenerated === 1) {
                            console.log('📄 PDF generated, showing modal immediately');
                            setShowPdfModal(true);
                          } else {
                            console.log('❌ PDF not generated for this CV');
                            console.log('📄 PDF Error:', data.metadata?.pdf_error);
                          }
                        });
                      } else if (data && data.status === 'failed') {
                        console.log('❌ CV generation failed');
                        setError('CV generation failed');
                        setIsGenerating(false);
                      } else {
                        pollAttempts++;
                        if (pollAttempts < maxPollAttempts) {
                          setTimeout(pollForResults, 2000);
                        } else {
                          setError('CV generation is taking too long');
                          setIsGenerating(false);
                        }
                      }
                    } catch (err) {
                      console.error('❌ Error polling for results:', err);
                      setError('Error checking generation status');
                      setIsGenerating(false);
                    }
                  };

                  // Start polling immediately
                  pollForResults();
                }
              } else {
                const errorText = await response.text();
                console.error('❌ Form submission failed:', response.status, errorText);
                let errorPayload = null;
                try { errorPayload = JSON.parse(errorText); } catch (_) { errorPayload = null; }
                const serverMessage = errorPayload && typeof errorPayload === 'object'
                  ? [errorPayload.error, errorPayload.message].find((m) => typeof m === 'string' && m.trim())
                  : null;
                setError(serverMessage || `Failed to submit CV generation request (Status: ${response.status})`);
                setUpgradeUrl(window.cvSafeUrl(errorPayload && errorPayload.upgrade_url));
                setIsGenerating(false);
              }
            } catch (err) {
              console.error('❌ Error submitting form:', err);
              setError('Error submitting form: ' + err.message);
              setIsGenerating(false);
            }
          };


          if (isLoading) {
            return <GlassLoader label={t.loading_data} />;
          }

          const pdfIsReady = (meta) => meta?.pdf_generated === true || meta?.pdf_generated === 'true' || meta?.pdf_generated === 1;
          const formDisabled = isGenerating || !selectedResumeId || !jobDescription.trim() || !selectedAtsTemplate || userCvCount >= maxCvGenerations;
          const chipBase = 'glass-soft inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium';
          const smallBtn = 'sr-btn glass-soft flex-1 inline-flex items-center justify-center gap-1.5 min-h-[40px] px-3 rounded-xl text-xs font-medium text-mist touch-manipulation';
          const smallDangerBtn = smallBtn + ' hover:text-red-300';

          return (
            <div className="cv-generator-app flex flex-col gap-6">
              {error && (
                <div role="alert" className="glass-soft sr-up rounded-2xl p-4 flex items-start gap-3" style={{ borderColor: 'rgba(248,113,113,0.4)' }}>
                  <span className="mt-0.5 text-red-300"><Icon name="alert" className="w-5 h-5" /></span>
                  <div className="min-w-0 flex-1">
                    <p className="m-0 text-[15px] text-red-200">{error}</p>
                    {upgradeUrl && (
                      <a
                        href={upgradeUrl}
                        className="sr-btn sr-primary mt-3 inline-flex min-h-[44px] items-center px-4 rounded-xl text-sm font-semibold touch-manipulation"
                      >
                        {t.get_more_credits}
                      </a>
                    )}
                  </div>
                </div>
              )}

              {/* Step 1: Job description */}
              <section className="glass sr-up rounded-[32px] p-5 sm:p-8 flex flex-col gap-4" style={{ animationDelay: '.45s' }}>
                <StepTitle number="1" label={t.job_description_label} />
                <textarea
                  value={jobDescription}
                  onChange={(e) => setJobDescription(e.target.value)}
                  placeholder={t.job_description_placeholder}
                  className="glass-soft w-full px-4 py-3.5 rounded-2xl text-[15px] leading-relaxed text-mist placeholder:text-mist/40 focus:outline-none focus:ring-2 focus:ring-primary/60 focus:border-primary/60 resize-none"
                  rows="5"
                />
              </section>

              {/* Step 2: ATS template */}
              <section className="glass sr-up rounded-[32px] p-5 sm:p-8 flex flex-col gap-4" style={{ animationDelay: '.55s' }}>
                <StepTitle number="2" label={t.ats_template_label} />
                <div
                  className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3 max-h-[70vh] sm:max-h-none overflow-y-auto sm:overflow-visible overscroll-contain p-0.5"
                  role="group"
                  aria-label={t.ats_template_label}
                  data-testid="ats-template-picker"
                >
                  {atsTemplates.map((template) => {
                    const isSelected = selectedAtsTemplate === template.key;
                    const hasImage = !failedPreviews[template.key];
                    return (
                      <div key={template.key} className="relative" data-template-key={template.key}>
                        <button
                          type="button"
                          aria-pressed={isSelected}
                          onClick={() => setSelectedAtsTemplate(template.key)}
                          className={`sr-lift flex flex-col w-full h-full text-start p-2 sm:p-2.5 rounded-[20px] border transition-all touch-manipulation min-h-[44px] ${
                            isSelected
                              ? 'border-primary bg-primary/15 ring-2 ring-primary/30'
                              : 'glass-soft hover:border-white/25 active:scale-[0.99]'
                          }`}
                        >
                          {hasImage && (
                            <span className="block w-full aspect-[1/1.294] rounded-[14px] overflow-hidden border border-white/10 bg-white keep-light mb-2 shadow-sm">
                              <img
                                src={atsThumbSrc(template)}
                                srcSet={atsThumbSrc(template) + ' 1x, ' + atsThumb2xSrc(template) + ' 2x'}
                                width="320"
                                height="414"
                                alt={template.name}
                                loading="lazy"
                                decoding="async"
                                className="block w-full h-full object-cover object-top"
                                onError={() => markPreviewFailed(template.key)}
                              />
                            </span>
                          )}
                          <span className="flex items-center gap-1.5 text-sm font-medium text-mist leading-snug px-0.5">
                            {isSelected && <span className="text-[#2fa36b]"><Icon name="check" className="w-4 h-4" /></span>}
                            {template.name}
                          </span>
                          <span className="block text-xs text-mist/60 mt-1 line-clamp-2 px-0.5">
                            {template.description}
                          </span>
                        </button>
                        {hasImage && (
                          <button
                            type="button"
                            onClick={() => setPreviewTemplate(template)}
                            aria-label={t.preview_template + ': ' + template.name}
                            title={t.preview_template}
                            data-testid="ats-preview-button"
                            className="absolute top-2 end-2 h-11 w-11 inline-flex items-center justify-center rounded-full touch-manipulation group focus-visible:outline-none"
                          >
                            <span className="inline-flex h-8 w-8 items-center justify-center rounded-full border border-white/25 bg-[#07120D]/70 backdrop-blur-md text-white shadow-md transition-transform group-hover:scale-110 group-focus-visible:ring-2 group-focus-visible:ring-primary">
                              <MagnifierIcon className="h-4 w-4" />
                            </span>
                          </button>
                        )}
                      </div>
                    );
                  })}
                </div>
              </section>

              {/* Step 3: Resume selection */}
              <section className="glass sr-up rounded-[32px] p-5 sm:p-8 flex flex-col gap-5" style={{ animationDelay: '.65s' }}>
                <StepTitle number="3" label={t.select_resume_label} />
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  {resumes && resumes.length > 0 ? resumes.map(resume => {
                    const resumeId = resume.id || resume.cv_gen_id;
                    const isSelected = selectedResumeId === resumeId.toString();
                    const gen = resume.latest_cv_generation;
                    const genSummary = gen && (gen.professional_summary_english || gen.professional_summary);
                    const builderSummary = resume.professional_summary_english || resume.professional_summary;
                    const statusTone = !gen ? null :
                      gen.status === 'completed' ? { color: '#2fa36b', label: t.pdf_available } :
                      gen.status === 'processing' ? { color: '#d6b877', label: t.processing } :
                      gen.status === 'failed' ? { color: '#fca5a5', label: t.generation_failed } :
                      { color: 'rgba(238,243,238,0.6)', label: t.not_specified };
                    return (
                      <div
                        key={resumeId}
                        role="button"
                        tabIndex={0}
                        aria-pressed={isSelected}
                        className={`sr-lift rounded-[24px] p-4 sm:p-5 cursor-pointer flex flex-col gap-3 border transition-all ${
                          isSelected
                            ? 'border-primary bg-primary/10 ring-2 ring-primary/30'
                            : 'glass-soft hover:border-white/25'
                        }`}
                        onClick={() => setSelectedResumeId(resumeId.toString())}
                        onKeyDown={(e) => {
                          if (e.target === e.currentTarget && (e.key === 'Enter' || e.key === ' ')) {
                            e.preventDefault();
                            setSelectedResumeId(resumeId.toString());
                          }
                        }}
                      >
                        {/* Header */}
                        <div className="flex flex-col gap-1.5 min-w-0">
                          <div className="flex items-center justify-between gap-2">
                            <h3 className="m-0 text-[16px] font-semibold text-mist truncate">{resume.complete_name}</h3>
                            {resume.is_cv_builder && (
                              <span className={chipBase} style={{ background: 'rgba(47,163,107,0.12)', borderColor: 'rgba(47,163,107,0.35)', color: '#2fa36b' }}>
                                CV Builder
                              </span>
                            )}
                            {resume.is_ai_generated && (
                              <span className={chipBase} style={{ background: 'rgba(214,184,119,0.12)', borderColor: 'rgba(214,184,119,0.4)', color: '#d6b877' }}>
                                <Icon name="spark" className="w-3 h-3" />
                                {t.ai_generated}
                              </span>
                            )}
                          </div>
                          <p className="m-0 text-sm text-mist/60 truncate" dir="ltr" style={{ textAlign: 'start' }}>{resume.email}</p>
                        </div>

                        {/* Job description for AI generated CVs */}
                        {resume.is_ai_generated && resume.job_description && (
                          <div>
                            <p className="m-0 text-xs text-mist/60 font-medium mb-1">{t.job_description_prefix}</p>
                            <p className="m-0 text-xs text-mist/75 line-clamp-2 leading-relaxed">
                              {resume.job_description.substring(0, 80)}
                              {resume.job_description.length > 80 ? '...' : ''}
                            </p>
                          </div>
                        )}

                        {/* CV generation info */}
                        {gen ? (
                          <div className="glass-soft rounded-[16px] p-3 flex flex-col gap-1.5">
                            <div className="flex items-center justify-between gap-2">
                              <span className="text-xs font-medium text-mist/75">{t.last_generated}</span>
                              <span className="sr-mono text-xs text-mist/60" dir="ltr">
                                {resume.last_generated ? new Date(resume.last_generated).toLocaleDateString('en-GB') : t.not_specified}
                              </span>
                            </div>
                            <div className="flex items-center justify-between gap-2">
                              <span className="inline-flex items-center gap-1.5 text-xs" style={{ color: statusTone.color }}>
                                <span className="w-1.5 h-1.5 rounded-full" style={{ background: 'currentColor' }}></span>
                                {statusTone.label}
                              </span>
                              {gen.metadata?.pdf_size && (
                                <span className="sr-mono text-xs text-mist/50" dir="ltr">
                                  {(gen.metadata.pdf_size / 1024).toFixed(1)} KB
                                </span>
                              )}
                            </div>
                            {genSummary && (
                              <p className="m-0 text-xs leading-relaxed" style={{ color: '#d6b877' }}>
                                <span className="font-semibold">{t.professional_summary}</span>
                                <span> {genSummary.substring(0, 120)}{genSummary.length > 120 ? '...' : ''}</span>
                              </p>
                            )}
                          </div>
                        ) : resume.is_cv_builder ? (
                          <div className="glass-soft rounded-[16px] p-3 flex flex-col gap-1.5" style={{ background: 'rgba(47,163,107,0.08)', borderColor: 'rgba(47,163,107,0.25)' }}>
                            <div className="flex items-center gap-2 flex-wrap">
                              <span className="inline-flex items-center gap-1.5 text-xs font-medium" style={{ color: '#2fa36b' }}>
                                <span className="w-1.5 h-1.5 rounded-full" style={{ background: 'currentColor' }}></span>
                                {t.cv_builder_resume}
                              </span>
                              <span className="text-xs text-mist/60">{t.ready_to_enhance}</span>
                            </div>
                            <div className="text-xs text-mist/60">
                              {t.created_on} <span className="sr-mono" dir="ltr">{resume.created_at ? new Date(resume.created_at).toLocaleDateString('en-GB') : t.not_specified}</span>
                            </div>
                            {builderSummary && (
                              <p className="m-0 text-xs leading-relaxed text-mist/75">
                                <span className="font-semibold" style={{ color: '#2fa36b' }}>{t.professional_summary}</span>
                                <span> {builderSummary.substring(0, 120)}{builderSummary.length > 120 ? '...' : ''}</span>
                              </p>
                            )}
                          </div>
                        ) : (
                          <div className="glass-soft rounded-[16px] p-3">
                            <span className="inline-flex items-center gap-1.5 text-xs text-mist/60">
                              <span className="w-1.5 h-1.5 rounded-full" style={{ background: 'currentColor' }}></span>
                              {t.basic_resume}
                            </span>
                          </div>
                        )}

                        {/* Contact info */}
                        {(resume.phone_number || (resume.city && resume.country)) && (
                          <div className="text-xs text-mist/55 flex flex-col gap-0.5">
                            {resume.phone_number && <div dir="ltr" style={{ textAlign: 'start' }}>{resume.phone_number}</div>}
                            {resume.city && resume.country && <div>{resume.city}, {resume.country}</div>}
                          </div>
                        )}

                        {/* Actions for AI generated CVs */}
                        {resume.is_ai_generated && pdfIsReady(gen?.metadata) && (
                          <div className="mt-auto flex gap-2" onClick={(e) => e.stopPropagation()}>
                            <button
                              type="button"
                              onClick={() => {
                                setPreviewPdfUrl(`/cv_generations/${gen.id}/view_pdf`);
                                setPreviewTitle(resume.complete_name);
                                setShowPreviewModal(true);
                              }}
                              className={smallBtn}
                            >
                              <Icon name="eye" className="w-3.5 h-3.5" />
                              {t.preview}
                            </button>
                            <button
                              type="button"
                              onClick={() => handleDownload(`/cv_generations/${gen.id}/download_pdf`, `cv_generated_${gen.id}.pdf`)}
                              className={smallBtn}
                            >
                              <Icon name="download" className="w-3.5 h-3.5" />
                              {t.download}
                            </button>
                            <button
                              type="button"
                              onClick={() => deleteCvGeneration(gen.id)}
                              className={smallDangerBtn}
                            >
                              <Icon name="trash" className="w-3.5 h-3.5" />
                              {t.delete}
                            </button>
                          </div>
                        )}
                        {/* Actions for CV Builder resumes */}
                        {resume.is_cv_builder && (
                          <div className="mt-auto flex gap-2" onClick={(e) => e.stopPropagation()}>
                            <button
                              type="button"
                              onClick={() => {
                                const pdfUrl = resume.pdf_url ? `${resume.pdf_url}?preview=true` : `/resumes/${resume.id}/generate_pdf?preview=true`;
                                setPreviewPdfUrl(pdfUrl);
                                setPreviewTitle(resume.complete_name);
                                setShowPreviewModal(true);
                              }}
                              className={smallBtn}
                            >
                              <Icon name="eye" className="w-3.5 h-3.5" />
                              {t.preview}
                            </button>
                            <button
                              type="button"
                              onClick={() => handleDownload(`/resumes/${resume.id}/generate_pdf`, `${resume.complete_name || 'resume'}_${resume.id}.pdf`)}
                              className={smallBtn}
                            >
                              <Icon name="download" className="w-3.5 h-3.5" />
                              {t.download}
                            </button>
                            <button
                              type="button"
                              onClick={() => deleteResume(resume.id)}
                              className={smallDangerBtn}
                            >
                              <Icon name="trash" className="w-3.5 h-3.5" />
                              {t.delete}
                            </button>
                          </div>
                        )}

                        {/* Selection indicator */}
                        {isSelected && (
                          <div className="flex items-center justify-center gap-2 text-sm font-medium" style={{ color: '#2fa36b' }}>
                            <Icon name="check" className="w-4 h-4" />
                            <span>{t.selected}</span>
                          </div>
                        )}
                      </div>
                    );
                  }) : (
                    <div className="col-span-full glass-soft rounded-[24px] text-center py-10 px-4">
                      <p className="m-0 text-mist/70">{t.no_resumes}</p>
                    </div>
                  )}
                </div>
                <button
                  type="button"
                  onClick={handleSubmit}
                  disabled={formDisabled}
                  className="sr-btn sr-primary w-full inline-flex items-center justify-center gap-2.5 min-h-[56px] px-6 rounded-2xl font-semibold text-[16px] border-0 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed touch-manipulation"
                  style={{ boxShadow: 'inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)' }}
                >
                  <Icon name="spark" className="w-5 h-5" />
                  {isGenerating ? t.generating :
                   userCvCount >= maxCvGenerations ? t.max_reached.replace('{max}', maxCvGenerations) :
                   t.create_resume}
                </button>
              </section>

              {/* Results */}
              {showResults && (
                <div className="flex flex-col gap-4">
                  {isGenerating && <GenerationProgress />}

                  {error && (
                    <div className="glass-soft rounded-2xl p-4 flex items-start gap-3" style={{ borderColor: 'rgba(248,113,113,0.4)' }}>
                      <span className="mt-0.5 text-red-300"><Icon name="alert" className="w-5 h-5" /></span>
                      <p className="m-0 text-[15px] text-red-200">{error}</p>
                    </div>
                  )}

                  {cvData && !isGenerating && (
                    <section className="glass sr-up relative overflow-hidden rounded-[32px] p-6 sm:p-8 flex flex-col gap-5">
                      <div aria-hidden="true" className="absolute rounded-full pointer-events-none" style={{ top: '-140px', insetInlineEnd: '-80px', width: '380px', height: '380px', background: 'radial-gradient(circle, rgba(0,150,85,0.32), rgba(0,150,85,0) 65%)', filter: 'blur(30px)' }}></div>
                      <div className="relative flex items-center justify-between gap-3 flex-wrap">
                        <h3 className="m-0 text-[22px] font-semibold text-mist">{t.cv_created_success}</h3>
                        <span className={chipBase} style={{ background: 'rgba(47,163,107,0.12)', borderColor: 'rgba(47,163,107,0.35)', color: '#2fa36b' }}>
                          <Icon name="doc" className="w-3.5 h-3.5" />
                          {t.pdf_ready}
                        </span>
                      </div>

                      <div className="relative flex flex-col gap-2">
                        <h4 className="m-0 text-sm font-medium" style={{ color: '#d6b877' }}>{t.new_professional_summary}</h4>
                        <div className="glass-soft rounded-[20px] p-4">
                          <p className="m-0 text-[15px] text-mist/85 leading-relaxed whitespace-pre-wrap">{cvData.generated_content}</p>
                        </div>
                      </div>

                      {pdfIsReady(cvData.metadata) ? (
                        <div className="relative flex flex-col sm:flex-row gap-3">
                          <button
                            type="button"
                            onClick={() => setShowPdfModal(true)}
                            className="sr-btn sr-primary flex-1 inline-flex items-center justify-center gap-2.5 min-h-[52px] px-5 rounded-2xl font-semibold text-[15px] border-0 cursor-pointer"
                            style={{ boxShadow: 'inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)' }}
                          >
                            <Icon name="eye" className="w-4 h-4" />
                            {t.preview_pdf}
                          </button>
                          <button
                            type="button"
                            onClick={downloadPdf}
                            className="sr-btn glass-soft flex-1 inline-flex items-center justify-center gap-2.5 min-h-[52px] px-5 rounded-2xl text-[15px] text-mist cursor-pointer"
                          >
                            <Icon name="download" className="w-4 h-4" />
                            {t.download_pdf}
                          </button>
                        </div>
                      ) : (
                        <div className="relative glass-soft rounded-[20px] p-4 flex flex-col gap-1" style={{ borderColor: 'rgba(214,184,119,0.4)' }}>
                          <div className="flex items-center gap-2" style={{ color: '#d6b877' }}>
                            <Icon name="alert" className="w-5 h-5" />
                            <span className="font-medium">{t.pdf_not_available}</span>
                          </div>
                          <p className="m-0 text-sm text-mist/70">{t.pdf_not_generated}</p>
                          {cvData.metadata?.pdf_error && (
                            <p className="m-0 text-xs text-mist/55 mt-1">
                              {t.error_prefix} {cvData.metadata.pdf_error}
                            </p>
                          )}
                        </div>
                      )}
                    </section>
                  )}
                </div>
              )}

              {/* Generated CV PDF, full screen */}
              {showPdfModal && cvData && ReactDOM.createPortal(
                <div className="fixed inset-0 z-50 flex flex-col bg-[#07120D]/95 backdrop-blur-xl text-mist" role="dialog" aria-modal="true" aria-label={t.cv_preview}>
                  <div className="flex items-center justify-between gap-3 p-4 border-b border-white/10">
                    <h3 className="m-0 text-lg font-semibold">{t.cv_preview}</h3>
                    <button
                      type="button"
                      onClick={() => setShowPdfModal(false)}
                      aria-label={t.close}
                      className="sr-btn glass-soft h-11 w-11 inline-flex items-center justify-center rounded-full text-mist/80 hover:text-white"
                    >
                      <Icon name="close" className="w-5 h-5" />
                    </button>
                  </div>

                  <div className="flex-1 overflow-hidden p-2 sm:p-4">
                    <div className="h-full rounded-[20px] overflow-hidden border border-white/10 bg-white keep-light">
                      <iframe
                        src={cvData.metadata?.pdf_path ? `/${cvData.metadata.pdf_path}` : `/cv_generations/${cvData.id}/download_pdf`}
                        title={t.cv_preview}
                        className="w-full h-full pdf-viewer"
                      />
                    </div>
                  </div>
                  <div className="p-4 border-t border-white/10">
                    <div className="flex gap-3 max-w-xl mx-auto">
                      <button
                        type="button"
                        onClick={downloadPdf}
                        className="sr-btn sr-primary flex-1 inline-flex items-center justify-center gap-2 min-h-[48px] px-4 rounded-2xl font-semibold border-0 cursor-pointer"
                      >
                        <Icon name="download" className="w-4 h-4" />
                        {t.download_pdf}
                      </button>
                      <button
                        type="button"
                        onClick={() => setShowPdfModal(false)}
                        className="sr-btn glass-soft min-h-[48px] px-6 rounded-2xl font-medium text-mist cursor-pointer"
                      >
                        {t.close}
                      </button>
                    </div>
                  </div>
                </div>,
                document.body
              )}

              {/* ATS template lightbox */}
              {previewTemplate && (
                <AtsTemplateLightbox
                  template={previewTemplate}
                  onClose={() => setPreviewTemplate(null)}
                  onUse={() => {
                    setSelectedAtsTemplate(previewTemplate.key);
                    setPreviewTemplate(null);
                  }}
                />
              )}

              {/* Saved CV preview */}
              {showPreviewModal && ReactDOM.createPortal(
                <div
                  className="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm p-3 sm:p-6"
                  onClick={(event) => { if (event.target === event.currentTarget) setShowPreviewModal(false); }}
                >
                  <div role="dialog" aria-modal="true" aria-label={previewTitle || t.cv_preview} className="glass rounded-[28px] w-full max-w-4xl max-h-[92vh] flex flex-col text-mist overflow-hidden">
                    <div className="flex items-center justify-between gap-3 p-4 border-b border-white/10">
                      <h2 className="m-0 text-lg font-semibold truncate">{previewTitle || t.cv_preview}</h2>
                      <button
                        type="button"
                        onClick={() => setShowPreviewModal(false)}
                        aria-label={t.close}
                        className="sr-btn glass-soft h-10 w-10 flex-none inline-flex items-center justify-center rounded-full text-mist/80 hover:text-white"
                      >
                        <Icon name="close" className="w-5 h-5" />
                      </button>
                    </div>
                    <div className="flex-1 overflow-hidden relative p-2 sm:p-3">
                      <div id="pdf-loading" className="absolute inset-0 flex items-center justify-center z-10">
                        <GlassLoader label={t.loading_pdf} />
                      </div>
                      <div className="rounded-[18px] overflow-hidden border border-white/10 bg-white keep-light">
                        <iframe
                          className="pdf-preview-frame"
                          src={previewPdfUrl}
                          title={previewTitle || t.cv_preview}
                          style={{ width: '100%', height: '74vh', border: 'none', background: '#ffffff' }}
                          onLoad={() => { const el = document.getElementById('pdf-loading'); if (el) el.style.display = 'none'; }}
                        ></iframe>
                      </div>
                    </div>
                    <div className="flex justify-end gap-2 p-4 border-t border-white/10">
                      <button
                        type="button"
                        className="sr-btn sr-primary inline-flex items-center gap-2 min-h-[44px] px-4 rounded-xl text-sm font-semibold border-0 cursor-pointer"
                        onClick={() => window.open(previewPdfUrl, '_blank', 'noopener')}
                      >
                        <Icon name="external" className="w-4 h-4" />
                        {t.open_in_new_window}
                      </button>
                      <button
                        type="button"
                        className="sr-btn glass-soft min-h-[44px] px-4 rounded-xl text-sm font-medium text-mist cursor-pointer"
                        onClick={() => setShowPreviewModal(false)}
                      >
                        {t.close}
                      </button>
                    </div>
                  </div>
                </div>,
                document.body
              )}
            </div>
          );
        }; // CLOSE CvGeneratorApp function

        // Wait for DOM to be ready
        const startApp = () => {
          try {
            console.log('🚀 Starting React application...');
            const container = document.getElementById('cv-generation-results');
            if (!container) {
              console.error('❌ Could not find root container element!');
              return;
            }

            console.log('📦 Creating React root...');
            const root = ReactDOM.createRoot(container);
            console.log('🎨 Rendering app...');

            root.render(
              <ErrorBoundary>
                <DebugWrapper>
                  <React.StrictMode>
                    <CvGeneratorApp />
                  </React.StrictMode>
                </DebugWrapper>
              </ErrorBoundary>
            );

            container.dataset.mounted = 'true';
            console.log('✅ React app mounted successfully');
          } catch (error) {
            console.error('🔴 Error starting React app:', error);
            const container = document.getElementById('cv-generation-results');
            if (container) {
              container.innerHTML = '<div role="alert" class="glass-soft rounded-2xl p-4 text-red-200" style="border-color: rgba(248,113,113,0.4)"><p class="m-0 font-medium">' + window.cvEscapeHtml(t.render_error || 'Render error') + '</p><p class="m-0 mt-2 text-sm text-red-300/80">' + window.cvEscapeHtml(error.message) + '</p></div>';
            }
          }
        };

        window.addEventListener('error', function(event) {
          const container = document.getElementById('cv-generation-results');
          if (!container || container.dataset.mounted === 'true') return;
          container.innerHTML = '<div role="alert" class="glass-soft rounded-2xl p-4 text-red-200" style="border-color: rgba(248,113,113,0.4)"><p class="m-0 font-medium">' + window.cvEscapeHtml(t.render_error || 'Render error') + '</p><p class="m-0 mt-2 text-sm text-red-300/80">' + window.cvEscapeHtml(event.error?.message || event.message || 'Unknown error') + '</p></div>';
        });

        // Initialize the app when the document is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', startApp);
        } else {
          startApp();
        }
      </script>
</div>

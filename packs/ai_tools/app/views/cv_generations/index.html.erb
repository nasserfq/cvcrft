<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
  <h1 class="text-3xl font-bold text-gray-900">CV Generations</h1>
  <%= link_to "Generate New CV", new_cv_generation_path, 
    class: "bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded-lg transition duration-200 js-hover-target", data: { hoverable: true } %>
  </div>
  <div class="grid gap-6">
    <% if @cv_generations.any? %>
      <% @cv_generations.each do |generation| %>
        <div class="bg-gradient-to-br from-emerald-50 to-emerald-50 rounded-lg shadow-md p-6 border border-emerald-200 relative">
          <!-- AI Generated Badge -->
          <div class="absolute top-4 right-4">
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 border border-emerald-200">
              <i data-lucide="sparkles" class="w-3 h-3"></i>
              AI Generated
            </span>
          </div>
          <div class="flex justify-between items-start mb-4">
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-slate-900 mb-2">
                <span class="inline-flex items-center gap-2">
                  <i data-lucide="wand-2" class="w-5 h-5 text-emerald-600"></i>
                  CV Generated #<%= generation.id %>
                </span>
              </h3>
              <p class="text-sm text-gray-600 mb-2">
                <strong>Status:</strong>
                <span class="px-2 py-1 rounded-full text-xs font-medium
                  <%= case generation.status
                      when 'completed' then 'bg-green-100 text-green-800'
                      when 'processing' then 'bg-yellow-100 text-yellow-800'
                      when 'failed' then 'bg-red-100 text-red-800'
                      when 'cancelled' then 'bg-gray-100 text-gray-800'
                      when 'draft' then 'bg-emerald-100 text-emerald-800'
                      else 'bg-gray-100 text-gray-800'
                      end %>">
                  <%= generation.draft? ? 'مسودة' : generation.status.humanize %>
                </span>
                <% if generation.draft? %>
                  <span class="ml-2 px-2 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                    💾 محفوظة
                  </span>
                <% end %>
              </p>
              <p class="text-sm text-gray-600 mb-2">
                <strong>Created:</strong> <%= generation.created_at.strftime("%B %d, %Y at %I:%M %p") %>
              </p>
              <% if generation.tokens_used %>
                <p class="text-sm text-gray-600 mb-2">
                  <strong>Tokens Used:</strong> <%= number_with_delimiter(generation.tokens_used) %>
                </p>
              <% end %>
            </div>
            <div class="flex space-x-2">
              <% if generation.draft? %>
        <%= link_to "استئناف المسودة", resume_draft_cv_generation_path(generation), 
          method: :post,
          class: "bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-1 rounded text-sm transition duration-200 js-hover-target",
          data: { confirm: "هل تريد استئناف هذه المسودة؟", hoverable: true } %>
        <%= link_to "عرض المسودة", cv_generation_path(generation), 
          class: "bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-1 rounded text-sm transition duration-200 js-hover-target", data: { hoverable: true } %>
              <% else %>
        <%= link_to "View", cv_generation_path(generation), 
          class: "bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-1 rounded text-sm transition duration-200 js-hover-target", data: { hoverable: true } %>
              <% end %>
              <% if generation.metadata&.dig("pdf_generated") %>
        <%= link_to "📄 View PDF", view_pdf_cv_generation_path(generation), 
          target: "_blank",
          class: "bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-sm transition duration-200 js-hover-target", data: { hoverable: true } %>
        <%= link_to "⬇️ Download", download_pdf_cv_generation_path(generation), 
          class: "bg-primary hover:bg-primary text-white px-3 py-1 rounded text-sm transition duration-200 js-hover-target", data: { hoverable: true } %>
              <% end %>
              <% if generation.status == 'failed' %>
        <%= link_to "Retry", retry_cv_generation_path(generation), 
          method: :post,
          class: "bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-1 rounded text-sm transition duration-200 js-hover-target", data: { hoverable: true } %>
              <% end %>
              <% if generation.status == 'processing' %>
        <%= link_to "Cancel", cancel_cv_generation_path(generation), 
          method: :post,
          class: "bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm transition duration-200 js-hover-target", data: { hoverable: true } %>
              <% end %>
        <%= link_to "Delete", cv_generation_path(generation), 
          method: :delete,
          data: { confirm: "Are you sure?", hoverable: true },
          class: "bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm transition duration-200 js-hover-target" %>
            </div>
          </div>
          <div class="mb-4">
            <h4 class="text-sm font-medium text-gray-700 mb-2">Job Description:</h4>
            <p class="text-sm text-gray-600 bg-gray-50 p-3 rounded border">
              <%= truncate(generation.job_description, length: 200) %>
            </p>
          </div>
          <% if generation.draft? && generation.draft_data.present? %>
            <div class="mb-4">
              <h4 class="text-sm font-medium text-gray-700 mb-2">مسودة محفوظة:</h4>
              <div class="bg-emerald-50 p-3 rounded border border-emerald-200">
                <p class="text-sm text-emerald-800 mb-2">
                  <strong>تاريخ الحفظ:</strong>
                  <%= Time.parse(generation.draft_data['saved_at']).strftime("%B %d, %Y at %I:%M %p") rescue 'غير محدد' %>
                </p>
                <p class="text-sm text-emerald-700">
                  <strong>وصف الوظيفة:</strong> <%= truncate(generation.draft_data['job_description'], length: 150) %>
                </p>
                <% if generation.draft_data['resume_id'] %>
                  <p class="text-sm text-emerald-700">
                    <strong>السيرة الذاتية المختارة:</strong> ID <%= generation.draft_data['resume_id'] %>
                  </p>
                <% end %>
              </div>
            </div>
          <% elsif generation.generated_content.present? %>
            <div class="mb-4">
              <h4 class="text-sm font-medium text-gray-700 mb-2">Generated Content:</h4>
              <p class="text-sm text-gray-600 bg-gray-50 p-3 rounded border">
                <%= truncate(generation.generated_content, length: 300) %>
              </p>
            </div>
          <% end %>
          <% if generation.resume_id %>
            <div class="text-sm text-gray-600 mb-2">
              <strong>Resume ID:</strong> <%= generation.resume_id %>
        <%= link_to "View Resume", resume_path(generation.resume_id), 
          class: "text-emerald-600 hover:text-emerald-800 ml-2 js-hover-target", data: { hoverable: true } %>
            </div>
          <% end %>
          <% if generation.metadata&.dig("pdf_generated") %>
            <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded">
              <div class="flex items-center justify-between">
                <div class="flex items-center">
                  <span class="text-green-600 mr-2">📄</span>
                  <span class="text-sm text-green-700">
                    <strong>PDF Ready</strong> - 
                    Size: <%= number_to_human_size(generation.metadata["pdf_size"]) %> | 
                    <%= generation.metadata["pdf_filename"] %>
                  </span>
                </div>
                <div class="flex space-x-2">
                  <%= link_to "Preview", view_pdf_cv_generation_path(generation), 
                      target: "_blank",
                      class: "text-xs bg-green-500 hover:bg-green-600 text-white px-2 py-1 rounded js-hover-target", data: { hoverable: true } %>
                    <%= link_to "Download", download_pdf_cv_generation_path(generation), 
                      class: "text-xs bg-primary hover:bg-primary text-white px-2 py-1 rounded js-hover-target", data: { hoverable: true } %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
        <div class="text-center py-12">
        <div class="text-gray-500 text-lg mb-4">No CV generations found</div>
        <%= link_to "Generate Your First CV", new_cv_generation_path, 
            class: "bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded-lg transition duration-200 js-hover-target", data: { hoverable: true } %>
      </div>
    <% end %>
  </div>
  <div class="mt-8 text-center">
    <%= link_to "View Statistics", stats_cv_generations_path, 
        class: "text-emerald-600 hover:text-emerald-800 font-medium js-hover-target", data: { hoverable: true } %>
  </div>
</div>

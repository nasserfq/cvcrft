<% unless user_signed_in? %>
  <script>
    window.location.href = '/auth/login';
  </script>
<% else %>
<!-- Hero Header -->
<div class="relative pt-6 pb-6 md:pt-8 md:pb-8 px-4 sm:px-6 text-center">
  <h1 class="text-2xl sm:text-3xl md:text-4xl font-medium tracking-tight text-darkBase dark:text-white mb-3">
    <%= t('resume.new_title') %>
  </h1>
  <p class="text-sm sm:text-base md:text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed">
    <%= t('resume.new_description') %>
  </p>
  <div class="max-w-2xl mx-auto mt-6 text-start"><%= render 'shared/flash_alert' %></div>
</div>

<!-- Main Content -->
<div class="relative pb-16 md:pb-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <!-- Form Container -->
    <div dir="<%= text_direction %>">
      <div id="resume-form-root" dir="<%= text_direction %>">
        <!-- React component will render here -->
      </div>
    </div>
  </div>
</div>
<%= vite_javascript_tag 'entrypoints/resume_form.jsx' %>
<script>
  // Pass resume data to JavaScript
  <% if @resume.present? %>
    // For existing resumes (including drafts), pass the resume data
    window.resumeData = <%= raw @resume.to_json(only: [:id, :complete_name, :email, :phone_number, :city, :country, :professional_summary, :professional_summary_english, :is_draft, :draft_data]) %>;
    
    // Add association data if it exists
    <% if @resume.work_experiences.any? %>
      window.resumeData.work_experience = <%= raw @resume.work_experiences.to_json %>;
    <% end %>
    <% if @resume.skills.any? %>
      window.resumeData.skills = <%= raw @resume.skills.to_json %>;
    <% end %>
    <% if @resume.educations.any? %>
      window.resumeData.education = <%= raw @resume.educations.to_json %>;
    <% end %>
    <% if @resume.certifications.any? %>
      window.resumeData.certifications = <%= raw @resume.certifications.to_json %>;
    <% end %>
    <% if @resume.languages.any? %>
      window.resumeData.languages = <%= raw @resume.languages.to_json %>;
    <% end %>
  <% else %>
    // For new resumes, pass null
    window.resumeData = null;
  <% end %>
  
  console.log('=== RAILS: Resume data set ===');
  console.log('Resume data:', window.resumeData);
  console.log('Resume skills:', window.resumeData?.skills);
  console.log('Resume skills detailed:', window.resumeData?.skills?.map(s => ({ 
    category: s.category, 
    skill_names: s.skill_names,
    skill_names_types: s.skill_names?.map(name => ({ value: name, type: typeof name }))
  })));
</script>
<% end %>

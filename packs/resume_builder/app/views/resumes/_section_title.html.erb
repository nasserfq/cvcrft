<%# A résumé list section heading: glass icon tile, title and a mono count chip. %>
<div class="sr-reveal flex items-center gap-3">
  <span class="glass-soft w-11 h-11 rounded-[14px] flex items-center justify-center" style="color: <%= color %>"><%= icon %></span>
  <h2 class="m-0 font-semibold" style="font-size: clamp(20px, 2.4vw, 26px); letter-spacing: -0.02em"><%= title %></h2>
  <span class="sr-mono glass-soft px-3 py-1 rounded-full text-xs font-semibold" style="color: <%= color %>"><%= count %></span>
</div>

<% content_for :title, @resume.complete_name.presence || t('resume.no_name') %>
<% content_for :body_class, "sr-app-long" %>
<%# Long page: the layout lets the ambient scroll with it, so its orbs run the full page height. %>
<% content_for :ambient_scrolls, true %>
<% icons = {
     pen: '<path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"></path>',
     download: '<path d="M12 3v12M7 10l5 5 5-5M4 21h16"></path>',
     eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle>',
     mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>',
     phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"></path>',
     pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle>',
     user: '<circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0116 0"></path>',
     case: '<rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"></path>',
     cap: '<path d="M2 9l10-5 10 5-10 5z"></path><path d="M6 11v5c3 2 9 2 12 0v-5"></path>',
     bulb: '<path d="M9 18h6M10 21h4M12 3a6 6 0 00-3.5 10.9c.6.4 1 1.1 1 1.8V16h5v-.3c0-.7.4-1.4 1-1.8A6 6 0 0012 3z"></path>',
     medal: '<circle cx="12" cy="15" r="5"></circle><path d="M8.5 11L6 3h4l2 5 2-5h4l-2.5 8"></path>',
     globe: '<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18"></path>'
   } %>
<% svg = ->(name, size = 16) { "<svg class=\"shrink-0\" width=\"#{size}\" height=\"#{size}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">#{icons[name]}</svg>".html_safe } %>
<% arrow = '<svg class="sr-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>'.html_safe %>
<% back_arrow = '<svg class="sr-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="rotate: 180deg"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>'.html_safe %>
<% muted = "color: rgba(238,243,238,0.65)" %>
<% primary_class = "sr-btn sr-primary inline-flex items-center justify-center gap-2.5 min-h-[48px] px-5 rounded-2xl font-semibold text-[15px] whitespace-nowrap" %>
<% primary_style = "box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)" %>
<% secondary_class = "sr-btn glass-soft inline-flex items-center justify-center gap-2.5 min-h-[48px] px-[18px] rounded-2xl text-[15px] whitespace-nowrap" %>
<% section_heading_class = "m-0 flex items-center gap-3 pb-3 font-semibold" %>
<% section_heading_style = "font-size: clamp(18px, 2.2vw, 22px); letter-spacing: -0.01em; border-bottom: 1px solid rgba(255,255,255,0.08)" %>
<% icon_tile = "glass-soft w-10 h-10 rounded-[14px] flex items-center justify-center" %>
<% count_chip = "sr-mono glass-soft ms-auto px-2.5 py-0.5 rounded-full text-xs font-semibold" %>

<%# A full résumé is a long read: the wrapper rises without sr-fadeUp's blur so it paints fast on phones. %>
<div dir="<%= text_direction %>" class="sr-page relative overflow-clip leading-relaxed" style="color: #eef3ee; animation-name: sr-riseUp">
  <div class="relative mx-auto max-w-[1040px] px-4 sm:px-6 pt-10 pb-20 flex flex-col gap-8">
    <!-- Header with Actions -->
    <div class="sr-up flex flex-wrap items-center justify-between gap-4" style="animation-delay: 0s">
      <%= link_to resumes_path, class: 'sr-btn glass-soft inline-flex items-center gap-2.5 min-h-[44px] px-4 rounded-2xl text-sm' do %>
        <span class="flex"><%= back_arrow %></span>
        <span><%= t('resume.back_to_list') %></span>
      <% end %>

      <div class="flex flex-wrap items-center gap-2.5">
        <% linkedin_import = @resume.linkedin_import_for_edit %>
        <% edit_link = linkedin_import.present? ? linkedin_import_show_path(linkedin_import) : edit_resume_path(@resume) %>
        <%= link_to edit_link, class: secondary_class do %>
          <%= svg.call(:pen, 18) %>
          <%= t('actions.edit') %>
        <% end %>

        <form action="<%= generate_pdf_resume_path(@resume) %>" method="get" class="flex flex-wrap items-center gap-2.5">
          <select name="template" aria-label="<%= t('cv_generation.ats_template_label') %>" class="glass-soft min-h-[48px] rounded-2xl px-4 text-sm focus:outline-none" style="color: #eef3ee; color-scheme: dark">
            <% AtsTemplatePdfService.template_catalog.each do |template| %>
              <option value="<%= template[:key] %>" style="background: #0f2018; color: #eef3ee"><%= template[:name] %></option>
            <% end %>
          </select>
          <button type="submit" class="<%= primary_class %>" style="<%= primary_style %>">
            <%= svg.call(:download, 18) %>
            <%= t('resume.download_pdf') %>
            <span class="sr-ico flex"><%= arrow %></span>
          </button>
          <button type="submit" name="preview" value="true" class="<%= secondary_class %>" style="color: #eef3ee">
            <%= svg.call(:eye, 18) %>
            <%= t('actions.preview') %>
          </button>
        </form>
      </div>
    </div>

    <!-- Main Resume Card -->
    <article class="glass rounded-[32px] overflow-hidden">
      <!-- Header Section -->
      <header class="relative overflow-hidden flex flex-col gap-4" style="padding: clamp(24px, 5vw, 44px); border-bottom: 1px solid rgba(255,255,255,0.08)">
        <div aria-hidden="true" class="absolute rounded-full pointer-events-none" style="top: -160px; inset-inline-end: -100px; width: 380px; height: 380px; background: radial-gradient(circle, rgba(0,150,85,0.3), rgba(0,150,85,0) 65%); filter: blur(30px)"></div>
        <h1 class="relative m-0 font-semibold" style="font-size: clamp(30px, 4.2vw, 48px); line-height: 1.15; letter-spacing: -0.02em">
          <% delay = 0.1 %>
          <% (@resume.complete_name.presence || t('resume.no_name')).split.each do |word| %><span class="sr-w" style="animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
        </h1>
        <% if @resume.target_position.present? %>
          <p class="sr-up relative m-0 text-[17px] sm:text-[19px] font-light" style="animation-delay: .4s; color: #d6b877"><%= @resume.target_position %></p>
        <% end %>

        <div class="sr-up relative flex flex-wrap items-center gap-2.5 text-sm" style="animation-delay: .5s">
          <% if @resume.email.present? %>
            <span class="glass-soft inline-flex items-center gap-2 px-3.5 py-2 rounded-xl max-w-full" style="color: rgba(238,243,238,0.85)">
              <%= svg.call(:mail) %>
              <span class="truncate"><%= @resume.email %></span>
            </span>
          <% end %>
          <% if @resume.phone_number.present? %>
            <span class="glass-soft inline-flex items-center gap-2 px-3.5 py-2 rounded-xl" style="color: rgba(238,243,238,0.85)">
              <%= svg.call(:phone) %>
              <span class="sr-mono" dir="ltr"><%= @resume.phone_number %></span>
            </span>
          <% end %>
          <% if @resume.city.present? || @resume.country.present? %>
            <span class="glass-soft inline-flex items-center gap-2 px-3.5 py-2 rounded-xl" style="color: rgba(238,243,238,0.85)">
              <%= svg.call(:pin) %>
              <span><%= [@resume.city, @resume.country].compact.join(t('resume.location_separator')) %></span>
            </span>
          <% end %>
        </div>
      </header>

      <!-- Content Sections -->
      <div class="flex flex-col gap-10" style="padding: clamp(24px, 5vw, 44px)">
        <!-- Professional Summary -->
        <% if @resume.professional_summary.present? %>
          <section class="sr-reveal flex flex-col gap-4">
            <h2 class="<%= section_heading_class %>" style="<%= section_heading_style %>">
              <span class="<%= icon_tile %>" style="color: #2fa36b"><%= svg.call(:user, 20) %></span>
              <%= t('resume.professional_summary_title') %>
            </h2>
            <p class="m-0 text-[16px] font-light leading-8" style="color: rgba(238,243,238,0.78)"><%= @resume.professional_summary %></p>
          </section>
        <% end %>

        <!-- Work Experience -->
        <% if @work_experiences.any? %>
          <section class="sr-reveal flex flex-col gap-5">
            <h2 class="<%= section_heading_class %>" style="<%= section_heading_style %>">
              <span class="<%= icon_tile %>" style="color: #2fa36b"><%= svg.call(:case, 20) %></span>
              <%= t('resume.work_experience_title') %>
              <span class="<%= count_chip %>" style="color: #2fa36b"><%= @work_experiences.size %></span>
            </h2>

            <div class="flex flex-col gap-4">
              <% @work_experiences.each do |exp| %>
                <div class="glass-soft rounded-[22px] p-5" style="border-inline-start: 2px solid #2fa36b">
                  <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
                    <div class="flex flex-col gap-0.5 min-w-0">
                      <h3 class="m-0 text-[17px] font-semibold"><%= exp.job_title.presence || exp.position %></h3>
                      <p class="m-0 text-[15px] font-medium" style="color: #2fa36b"><%= exp.company %></p>
                    </div>
                    <span class="sr-mono glass-soft px-2.5 py-1 rounded-lg text-xs" style="<%= muted %>">
                      <%= date_range(exp.start_date, exp.end_date, exp.is_current).presence || '—' %>
                    </span>
                  </div>
                  <% description = exp.arabic_description.presence || exp.english_description.presence || exp.responsibilities %>
                  <% if description.present? %>
                    <p class="m-0 text-[15px] font-light leading-7 whitespace-pre-line" style="color: rgba(238,243,238,0.72)"><%= description %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>

        <!-- Education -->
        <% if @resume.educations.any? %>
          <section class="sr-reveal flex flex-col gap-5">
            <h2 class="<%= section_heading_class %>" style="<%= section_heading_style %>">
              <span class="<%= icon_tile %>" style="color: #d6b877"><%= svg.call(:cap, 20) %></span>
              <%= t('resume.education_title') %>
              <span class="<%= count_chip %>" style="color: #d6b877"><%= @resume.educations.size %></span>
            </h2>

            <div class="flex flex-col gap-4">
              <% @resume.educations.each do |edu| %>
                <div class="glass-soft rounded-[22px] p-5" style="border-inline-start: 2px solid #d6b877">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="flex flex-col gap-0.5 min-w-0">
                      <h3 class="m-0 text-[17px] font-semibold"><%= edu.degree %></h3>
                      <p class="m-0 text-[15px]" style="color: rgba(238,243,238,0.75)"><%= edu.institution %></p>
                      <% if edu.respond_to?(:gpa) && edu.gpa.present? %>
                        <p class="m-0 text-sm" style="<%= muted %>"><%= t('resume.gpa') %>: <span class="sr-mono"><%= edu.gpa %></span></p>
                      <% end %>
                    </div>
                    <span class="sr-mono glass-soft px-2.5 py-1 rounded-lg text-xs" style="<%= muted %>">
                      <%= date_range(edu.start_date, edu.end_date, edu.is_current, :year).presence || '—' %>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>

        <!-- Skills -->
        <% if @skills.any? %>
          <section class="sr-reveal flex flex-col gap-5">
            <h2 class="<%= section_heading_class %>" style="<%= section_heading_style %>">
              <span class="<%= icon_tile %>" style="color: #2fa36b"><%= svg.call(:bulb, 20) %></span>
              <%= t('resume.skills_title') %>
            </h2>

            <div class="flex flex-col gap-4">
              <% @skills.each do |category, skills_list| %>
                <div class="flex flex-col gap-2.5">
                  <% if category.present? && category != t('resume.uncategorized') %>
                    <h4 class="m-0 text-sm font-medium" style="<%= muted %>"><%= category %></h4>
                  <% end %>
                  <div class="flex flex-wrap gap-2">
                    <% skills_list.each do |skill| %>
                      <% skill_items = skill.skill_names.presence || [skill.name].compact %>
                      <% skill_items.each do |skill_name| %>
                        <span class="glass-soft px-3.5 py-1.5 rounded-xl text-sm" style="color: rgba(238,243,238,0.88)">
                          <%= skill_name %>
                        </span>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>

        <!-- Certifications -->
        <% if @resume.respond_to?(:certifications) && @resume.certifications.any? %>
          <section class="sr-reveal flex flex-col gap-5">
            <h2 class="<%= section_heading_class %>" style="<%= section_heading_style %>">
              <span class="<%= icon_tile %>" style="color: #d6b877"><%= svg.call(:medal, 20) %></span>
              <%= t('resume.certifications_title') %>
              <span class="<%= count_chip %>" style="color: #d6b877"><%= @resume.certifications.size %></span>
            </h2>

            <div class="grid gap-3 sm:grid-cols-2">
              <% @resume.certifications.each do |cert| %>
                <div class="glass-soft rounded-[22px] p-5 flex flex-col gap-1">
                  <h3 class="m-0 text-[16px] font-semibold"><%= cert.name %></h3>
                  <% if cert.organization.present? %>
                    <p class="m-0 text-sm" style="color: rgba(238,243,238,0.75)"><%= cert.organization %></p>
                  <% end %>
                  <% if cert.date.present? %>
                    <p class="sr-mono m-0 mt-1 text-xs" style="color: rgba(238,243,238,0.5)"><%= format_date(cert.date) %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>

        <!-- Languages -->
        <% if @resume.respond_to?(:languages) && @resume.languages.any? %>
          <section class="sr-reveal flex flex-col gap-5">
            <h2 class="<%= section_heading_class %>" style="<%= section_heading_style %>">
              <span class="<%= icon_tile %>" style="color: #2fa36b"><%= svg.call(:globe, 20) %></span>
              <%= t('resume.languages_title') %>
            </h2>

            <div class="flex flex-wrap gap-2.5">
              <% @resume.languages.each do |lang| %>
                <div class="glass-soft rounded-xl px-4 py-2">
                  <span class="font-medium"><%= lang.language %></span>
                  <% if lang.proficiency.present? %>
                    <span class="text-sm" style="<%= muted %>"> — <%= lang.proficiency %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>

      <!-- Footer -->
      <footer class="flex flex-wrap items-center justify-between gap-4 px-6 sm:px-11 py-4 text-xs" style="border-top: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); color: rgba(238,243,238,0.5)">
        <span><%= t('resume.last_updated') %> <span class="sr-mono" dir="ltr"><%= @resume.updated_at.strftime("%d/%m/%Y %H:%M") %></span></span>
        <span><%= t('resume.created') %> <span class="sr-mono" dir="ltr"><%= @resume.created_at.strftime("%d/%m/%Y") %></span></span>
      </footer>
    </article>
  </div>
</div>

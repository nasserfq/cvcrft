<% content_for :title, t('resume.my_resume') %>
<% content_for :body_class, "sr-app-long" %>
<%# Long page: the layout lets the ambient scroll with it, so its orbs run the full page height. %>
<% content_for :ambient_scrolls, true %>
<% icons = {
     add: '<path d="M12 5v14M5 12h14"></path>',
     doc: '<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h4"></path>',
     check: '<circle cx="12" cy="12" r="9"></circle><path d="M8 12l3 3 5-6"></path>',
     spark: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"></path>',
     folder: '<path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>',
     trash: '<path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"></path>',
     mail: '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>',
     clock: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>',
     case: '<rect x="3" y="7" width="18" height="13" rx="2"></rect><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"></path>',
     cap: '<path d="M2 9l10-5 10 5-10 5z"></path><path d="M6 11v5c3 2 9 2 12 0v-5"></path>',
     star: '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"></path>',
     medal: '<circle cx="12" cy="15" r="5"></circle><path d="M8.5 11L6 3h4l2 5 2-5h4l-2.5 8"></path>',
     pen: '<path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"></path>',
     linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 014 0v4M12 10v7"></path>'
   } %>
<% svg = ->(name, size = 16) { "<svg class=\"shrink-0\" width=\"#{size}\" height=\"#{size}\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">#{icons[name]}</svg>".html_safe } %>
<% arrow = '<svg class="sr-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>'.html_safe %>
<% muted = "color: rgba(238,243,238,0.6)" %>
<% chip_class = "glass-soft inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs" %>
<% green_chip = "background: rgba(47,163,107,0.12); border-color: rgba(47,163,107,0.35); color: #2fa36b" %>
<% gold_chip = "background: rgba(214,184,119,0.12); border-color: rgba(214,184,119,0.4); color: #d6b877" %>
<% delete_class = "glass-soft absolute top-4 end-4 z-10 w-9 h-9 rounded-xl flex items-center justify-center text-mist/60 hover:text-red-300 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 focus-visible:opacity-100 transition duration-300" %>
<% card_class = "glass sr-lift sr-reveal group relative rounded-[28px] p-5 sm:p-6 flex flex-col" %>
<% primary_class = "sr-btn sr-primary inline-flex items-center justify-center gap-2.5 min-h-[52px] px-5 rounded-2xl font-semibold text-[15px]" %>
<% primary_style = "box-shadow: inset 0 1px 0 rgba(255,255,255,0.5), 0 18px 40px -18px rgba(0,140,78,0.6)" %>
<% secondary_class = "sr-btn glass-soft inline-flex items-center justify-center gap-2.5 min-h-[52px] px-[18px] rounded-2xl text-[15px]" %>
<% total_count = @resumes.size + @drafts.size + @cv_generations.size %>

<%# A list that grows with every résumé: the wrapper rises without sr-fadeUp's blur so long lists paint fast on phones. %>
<div dir="<%= text_direction %>" data-controller="confirm-delete" class="sr-page relative overflow-clip leading-relaxed" style="color: #eef3ee; animation-name: sr-riseUp">
  <div class="relative mx-auto max-w-[1240px] px-4 sm:px-6 pt-10 pb-20 flex flex-col gap-10">
    <%= render 'shared/flash_alert' %>

    <!-- Header with Actions -->
    <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-6">
      <div class="flex flex-col items-start gap-5">
        <span class="glass-soft sr-up inline-flex items-center gap-2.5 px-4 py-2 rounded-full text-sm" style="animation-delay: 0s; color: rgba(238,243,238,0.9)">
          <span class="sr-dot w-2 h-2 rounded-full bg-primary"></span>
          <%= t('resume.manage_resumes') %>
        </span>
        <h1 class="m-0 font-semibold" style="font-size: clamp(34px, 4.6vw, 56px); line-height: 1.15; letter-spacing: -0.02em">
          <% words = t('resume.my_resume').split %>
          <% delay = 0.1 %>
          <% words.each_with_index do |word, i| %><span class="sr-w" style="<%= 'color: #d6b877; ' if i == words.size - 1 && words.size > 1 %>animation-delay: <%= delay.round(2) %>s"><%= word %></span> <% delay += 0.08 %><% end %>
        </h1>
      </div>
      <div class="sr-up" style="animation-delay: .45s">
        <%= link_to new_resume_path, class: primary_class, style: primary_style, data: { hoverable: true } do %>
          <%= svg.call(:add, 18) %>
          <%= t('resume.create_new') %>
          <span class="sr-ico flex"><%= arrow %></span>
        <% end %>
      </div>
    </header>

    <% if total_count > 0 %>
      <!-- Stats Bar -->
      <div class="sr-up grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4" style="animation-delay: .55s">
        <% [
             [ total_count, t('resume.total_resumes'), "#eef3ee" ],
             [ @drafts.size, t('resume.drafts'), "#2fa36b" ],
             [ @resumes.size, t('resume.completed'), "#d6b877" ],
             [ @cv_generations.size, t('resume.ai_generated'), "#2fa36b" ]
           ].each do |value, label, color| %>
          <div class="glass rounded-[24px] p-5 flex flex-col gap-1">
            <span class="sr-mono font-semibold" style="font-size: clamp(26px, 3vw, 34px); line-height: 1.1; color: <%= color %>"><%= value %></span>
            <span class="text-sm" style="<%= muted %>"><%= label %></span>
          </div>
        <% end %>
      </div>

      <!-- Tabs for filtering -->
      <div class="sr-up flex items-center gap-2 flex-wrap" style="animation-delay: .62s">
        <span class="glass-soft inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium" style="<%= green_chip %>">
          <%= svg.call(:folder) %>
          <%= t('resume.all') %>
          <span class="sr-mono px-2 py-0.5 rounded-full text-xs" style="background: rgba(47,163,107,0.18)"><%= total_count %></span>
        </span>
        <% if @drafts.any? %>
          <span class="glass-soft inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium" style="color: rgba(238,243,238,0.8)">
            <%= svg.call(:doc) %>
            <%= t('resume.drafts') %>
            <span class="sr-mono px-2 py-0.5 rounded-full text-xs" style="background: rgba(255,255,255,0.08)"><%= @drafts.size %></span>
          </span>
        <% end %>
      </div>
    <% end %>

    <!-- Drafts Section (if any) -->
    <% if @drafts.any? %>
      <section class="flex flex-col gap-5">
        <%= render "resumes/section_title", icon: svg.call(:doc, 20), title: t('resume.drafts_in_progress'), count: @drafts.size, color: "#2fa36b" %>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          <% @drafts.each do |resume| %>
            <% step = resume.draft_data&.dig('current_step') || 1 %>
            <% progress = ((step.to_f / 4) * 100).round %>
            <div id="resume_<%= resume.id %>" class="<%= card_class %>">
              <!-- Delete Button -->
              <%= button_to resume_path(resume), method: :delete, form: { data: { action: "submit->confirm-delete#intercept", confirm_delete_title_param: t('ux_confirm.draft_title'), confirm_delete_body_param: t('resume.delete_draft_confirm'), confirm_delete_confirm_label_param: t('ux_confirm.draft_confirm') } }, class: delete_class, title: t('actions.delete'), "aria-label": t('actions.delete') do %>
                <%= svg.call(:trash) %>
              <% end %>

              <%= link_to edit_resume_path(resume, step: step), class: 'flex flex-col gap-4 cursor-pointer' do %>
                <!-- Header -->
                <div class="flex items-center gap-2 flex-wrap pe-11">
                  <span class="<%= chip_class %> font-medium" style="<%= green_chip %>"><span class="sr-dot w-1.5 h-1.5 rounded-full" style="background: #2fa36b"></span><%= t('resume.draft') %></span>
                  <span class="<%= chip_class %>" style="color: rgba(238,243,238,0.75)"><%= t('resume.step_of', step: step) %></span>
                  <% if resume.source == "linkedin" %>
                    <span class="<%= chip_class %> font-medium" style="background: rgba(0,119,181,0.22); border-color: rgba(0,119,181,0.5); color: #cfe8f7"><%= svg.call(:linkedin, 12) %>LinkedIn</span>
                  <% end %>
                </div>

                <!-- Name and email -->
                <div class="flex flex-col gap-1 min-w-0">
                  <h3 class="m-0 text-[19px] font-semibold truncate"><%= resume.complete_name.present? ? resume.complete_name : t('resume.no_name_draft') %></h3>
                  <div class="flex items-center gap-2 text-sm min-w-0" style="<%= muted %>">
                    <%= svg.call(:mail) %>
                    <span class="truncate"><%= resume.email.presence || t('resume.email_not_entered') %></span>
                  </div>
                </div>

                <!-- Professional Summary Preview -->
                <% draft_summary = resume.professional_summary_english.presence || resume.professional_summary.presence %>
                <% if draft_summary.present? %>
                  <div class="glass-soft rounded-[18px] p-3.5">
                    <p class="m-0 text-[13px] line-clamp-2 leading-relaxed" style="color: rgba(238,243,238,0.7)"><%= truncate(draft_summary, length: 100) %></p>
                  </div>
                <% end %>

                <!-- Progress Bar -->
                <div class="flex flex-col gap-2">
                  <div class="flex justify-between text-xs">
                    <span style="<%= muted %>"><%= t('resume.creation_progress') %></span>
                    <span class="sr-mono font-semibold" style="color: #2fa36b"><%= progress %>%</span>
                  </div>
                  <div class="w-full h-2 rounded-full overflow-hidden" style="background: rgba(255,255,255,0.08)">
                    <span class="sr-grow h-2 rounded-full" style="width: <%= progress %>%; background: linear-gradient(90deg, #0b7f48, #2fa36b); animation-delay: .3s"></span>
                  </div>
                </div>

                <!-- Stats Row -->
                <div class="flex flex-wrap items-center gap-2 pb-4" style="border-bottom: 1px solid rgba(255,255,255,0.08)">
                  <span class="<%= chip_class %>" style="<%= green_chip %>"><%= svg.call(:case, 14) %><%= t('resume.experiences_count', count: resume.work_experiences.size) %></span>
                  <span class="<%= chip_class %>" style="<%= gold_chip %>"><%= svg.call(:cap, 14) %><%= t('resume.education_count', count: (resume.educations.size rescue 0)) %></span>
                  <span class="<%= chip_class %>" style="<%= green_chip %>"><%= svg.call(:star, 14) %><%= t('resume.skills_count', count: resume.skills.size) %></span>
                </div>

                <!-- Last Updated -->
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2 text-xs" style="color: rgba(238,243,238,0.5)">
                    <%= svg.call(:clock, 14) %>
                    <% if resume.draft_data&.dig('saved_at') %>
                      <span><%= t('resume.last_updated') %> <span class="sr-mono" dir="ltr"><%= (Time.parse(resume.draft_data['saved_at']).strftime("%d/%m/%Y %H:%M") rescue resume.updated_at.strftime("%d/%m/%Y %H:%M")) %></span></span>
                    <% else %>
                      <span><%= t('resume.created') %> <span class="sr-mono" dir="ltr"><%= resume.created_at.strftime("%d/%m/%Y") %></span></span>
                    <% end %>
                  </div>
                  <span class="flex items-center gap-1.5 text-sm font-medium whitespace-nowrap" style="color: #2fa36b">
                    <%= t('resume.continue') %>
                    <span class="flex transition-transform duration-500 group-hover:-translate-x-1 ltr:group-hover:translate-x-1"><%= arrow %></span>
                  </span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- Completed Resumes Section -->
    <% if @resumes.any? %>
      <section class="flex flex-col gap-5">
        <%= render "resumes/section_title", icon: svg.call(:check, 20), title: t('resume.completed_resumes'), count: @resumes.size, color: "#d6b877" %>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          <% @resumes.each do |resume| %>
            <div id="resume_<%= resume.id %>" class="<%= card_class %>">
              <!-- Delete Button -->
              <%= button_to resume_path(resume), method: :delete, form: { data: { action: "submit->confirm-delete#intercept", confirm_delete_title_param: t('ux_confirm.resume_title'), confirm_delete_body_param: t('resume.delete_resume_confirm'), confirm_delete_confirm_label_param: t('ux_confirm.resume_confirm') } }, class: delete_class, title: t('actions.delete'), "aria-label": t('actions.delete') do %>
                <%= svg.call(:trash) %>
              <% end %>

              <% linkedin_import = resume.linkedin_import_for_edit %>
              <% resume_link = linkedin_import.present? ? linkedin_import_show_path(linkedin_import) : resume_path(resume) %>
              <%= link_to resume_link, class: 'flex flex-col gap-4 cursor-pointer' do %>
                <!-- Header -->
                <div class="flex items-center gap-2 flex-wrap pe-11">
                  <span class="<%= chip_class %> font-medium" style="<%= gold_chip %>"><%= svg.call(:check, 12) %><%= t('resume.completed') %></span>
                  <% if resume.source == "linkedin" %>
                    <span class="<%= chip_class %> font-medium" style="background: rgba(0,119,181,0.22); border-color: rgba(0,119,181,0.5); color: #cfe8f7"><%= svg.call(:linkedin, 12) %>LinkedIn</span>
                  <% end %>
                  <span class="inline-flex items-center gap-1.5 text-xs" style="color: rgba(238,243,238,0.5)"><%= svg.call(:clock, 14) %><span class="sr-mono" dir="ltr"><%= resume.updated_at.strftime("%d/%m/%Y") %></span></span>
                </div>

                <!-- Name and email -->
                <div class="flex flex-col gap-1 min-w-0">
                  <h3 class="m-0 text-[19px] font-semibold truncate"><%= resume.complete_name.presence || t('resume.no_name_draft') %></h3>
                  <div class="flex items-center gap-2 text-sm min-w-0" style="<%= muted %>">
                    <%= svg.call(:mail) %>
                    <span class="truncate"><%= resume.email %></span>
                  </div>
                </div>

                <!-- Summary Preview -->
                <% summary = resume.professional_summary_english.presence || resume.professional_summary.presence %>
                <% if summary.present? %>
                  <div class="glass-soft rounded-[18px] p-3.5">
                    <p class="m-0 text-[13px] line-clamp-2 leading-relaxed" style="color: rgba(238,243,238,0.7)"><%= truncate(summary, length: 120) %></p>
                  </div>
                <% end %>

                <!-- Stats Row -->
                <div class="flex flex-wrap items-center gap-2 pb-4" style="border-bottom: 1px solid rgba(255,255,255,0.08)">
                  <span class="<%= chip_class %>" style="<%= green_chip %>"><%= svg.call(:case, 14) %><%= t('resume.experiences_count', count: resume.work_experiences.size) %></span>
                  <span class="<%= chip_class %>" style="<%= gold_chip %>"><%= svg.call(:cap, 14) %><%= t('resume.education_count', count: (resume.educations.size rescue 0)) %></span>
                  <span class="<%= chip_class %>" style="<%= green_chip %>"><%= svg.call(:star, 14) %><%= t('resume.skills_count', count: resume.skills.size) %></span>
                  <% if resume.respond_to?(:certificates) && resume.certificates.any? %>
                    <span class="<%= chip_class %>" style="<%= gold_chip %>"><%= svg.call(:medal, 14) %><%= t('resume.certificates_count', count: resume.certificates.size) %></span>
                  <% end %>
                </div>

                <!-- Footer with CTA -->
                <div class="flex items-center justify-between gap-3">
                  <span class="text-xs" style="color: rgba(238,243,238,0.5)"><%= t('resume.created') %> <span class="sr-mono" dir="ltr"><%= resume.created_at.strftime("%d/%m/%Y") %></span></span>
                  <span class="flex items-center gap-1.5 text-sm font-medium whitespace-nowrap" style="color: #d6b877">
                    <%= t('resume.view_details') %>
                    <span class="flex transition-transform duration-500 group-hover:-translate-x-1 ltr:group-hover:translate-x-1"><%= arrow %></span>
                  </span>
                </div>
              <% end %>

              <!-- Edit Button for completed resumes -->
              <div class="mt-4">
                <% edit_link = linkedin_import.present? ? linkedin_import_show_path(linkedin_import) : edit_resume_path(resume) %>
                <%= link_to edit_link, class: "sr-btn glass-soft w-full inline-flex items-center justify-center gap-2 min-h-[44px] px-4 rounded-2xl text-sm font-medium", style: "color: #eef3ee" do %>
                  <%= svg.call(:pen) %>
                  <%= t('resume.edit_resume') %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <!-- AI Generated CVs Section -->
    <% if @cv_generations.any? %>
      <section class="flex flex-col gap-5">
        <%= render "resumes/section_title", icon: svg.call(:spark, 20), title: t('resume.ai_generated_title'), count: @cv_generations.size, color: "#d6b877" %>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          <% @cv_generations.each do |generation| %>
            <div id="cv_generation_<%= generation.id %>" class="<%= card_class %>">
              <!-- Delete Button -->
              <%= button_to cv_generation_path(generation), method: :delete, form: { data: { action: "submit->confirm-delete#intercept", confirm_delete_title_param: t('actions.delete'), confirm_delete_body_param: t('resume.delete_generated_confirm'), confirm_delete_confirm_label_param: t('ux_confirm.delete') } }, class: delete_class, title: t('actions.delete'), "aria-label": t('actions.delete') do %>
                <%= svg.call(:trash) %>
              <% end %>

              <%= link_to cv_generation_path(generation), class: 'flex flex-col gap-4 cursor-pointer' do %>
                <!-- Header -->
                <div class="flex items-center gap-2 flex-wrap pe-11">
                  <span class="sr-shim <%= chip_class %> font-medium" style="<%= gold_chip %>"><%= svg.call(:spark, 12) %><%= t('resume.artificial_intelligence') %></span>
                  <span class="inline-flex items-center gap-1.5 text-xs" style="color: rgba(238,243,238,0.5)"><%= svg.call(:clock, 14) %><span class="sr-mono" dir="ltr"><%= generation.created_at.strftime("%d/%m/%Y") %></span></span>
                </div>

                <!-- Title -->
                <h3 class="m-0 text-[19px] font-semibold"><%= t('resume.cv_number', id: generation.id) %></h3>

                <!-- Job Description Preview -->
                <% if generation.job_description.present? %>
                  <div class="glass-soft rounded-[18px] p-3.5 flex flex-col gap-1">
                    <p class="m-0 text-xs font-medium" style="color: rgba(238,243,238,0.55)"><%= t('resume.target_job') %></p>
                    <p class="m-0 text-sm line-clamp-2" style="color: rgba(238,243,238,0.8)"><%= truncate(generation.job_description, length: 100) %></p>
                  </div>
                <% end %>

                <!-- Generated Content Preview -->
                <% if generation.generated_content.present? %>
                  <div class="glass-soft rounded-[18px] p-3.5 flex flex-col gap-1" style="background: rgba(47,163,107,0.08); border-color: rgba(47,163,107,0.25)">
                    <p class="m-0 text-xs font-medium" style="color: #2fa36b"><%= t('resume.generated_content') %></p>
                    <p class="m-0 text-[13px] line-clamp-2" style="color: rgba(238,243,238,0.7)"><%= truncate(generation.generated_content, length: 100) %></p>
                  </div>
                <% end %>

                <!-- PDF Status -->
                <% if generation.metadata&.dig("pdf_generated") %>
                  <span class="<%= chip_class %> self-start font-medium" style="<%= gold_chip %>"><%= svg.call(:check, 14) %><%= t('resume.pdf_ready') %></span>
                <% end %>

                <!-- Footer with CTA -->
                <div class="flex items-center justify-between gap-3 pt-4" style="border-top: 1px solid rgba(255,255,255,0.08)">
                  <span class="flex items-center gap-2 text-xs" style="color: #2fa36b">
                    <span class="sr-dot w-2 h-2 rounded-full bg-primary"></span>
                    <%= t('resume.auto_generated') %>
                  </span>
                  <span class="flex items-center gap-1.5 text-sm font-medium whitespace-nowrap" style="color: #2fa36b">
                    <%= t('resume.view_details') %>
                    <span class="flex transition-transform duration-500 group-hover:-translate-x-1 ltr:group-hover:translate-x-1"><%= arrow %></span>
                  </span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if total_count == 0 %>
      <!-- Empty State -->
      <section class="glass sr-up relative overflow-hidden rounded-[32px] flex flex-col items-center text-center gap-6" style="padding: clamp(36px, 6vw, 64px); animation-delay: .55s">
        <div aria-hidden="true" class="absolute rounded-full pointer-events-none" style="top: -160px; inset-inline-end: -100px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(0,150,85,0.32), rgba(0,150,85,0) 65%); filter: blur(30px)"></div>
        <span class="glass-soft sr-float relative w-20 h-20 rounded-[24px] flex items-center justify-center" style="color: #d6b877"><%= svg.call(:doc, 36) %></span>
        <div class="relative flex flex-col gap-2 max-w-[48ch]">
          <h2 class="m-0 font-semibold" style="font-size: clamp(24px, 3vw, 32px); letter-spacing: -0.02em; line-height: 1.2"><%= t('resume.no_resumes_yet') %></h2>
          <p class="m-0 text-[16px] font-light" style="color: rgba(238,243,238,0.7)"><%= t('resume.start_journey') %></p>
        </div>
        <div class="relative grid grid-cols-1 min-[420px]:grid-cols-2 gap-2.5 w-full max-w-[520px]">
          <%= link_to new_resume_path, class: primary_class, style: primary_style do %>
            <%= svg.call(:add, 18) %>
            <%= t('resume.create_new_resume') %>
          <% end %>
          <%= link_to new_cv_generation_path, class: secondary_class, style: "color: #eef3ee" do %>
            <%= svg.call(:spark, 18) %>
            <%= t('resume.generate_with_ai') %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
  <%= render "shared/confirm_dialog" %>
</div>
